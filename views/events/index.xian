{{> head }}
<body class="min-h-screen flex flex-col ss-page-bg">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">
  <style>
    .event-card-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); align-items:stretch; gap:8px; }
    .event-card-actions.event-card-actions-three { grid-template-columns:repeat(3,minmax(0,1fr)); }
    .event-card-actions > form { display:contents; }
    .event-card-actions > a,
    .event-card-actions > form > button { box-sizing:border-box; width:100%; min-width:0; }
  </style>

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <div class="flex items-center justify-between gap-4 animate-fadeup">
    <div class="page-header mb-0">
      <h1>Events</h1>
      <p>All competition events in ScoreSync.</p>
    </div>
    {{#if isAdmin}}
    <a href="/events/create" class="btn-primary text-sm flex-shrink-0">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Event
    </a>
    {{/if}}
  </div>

  {{#if events.length}}

  <!-- -- Filter by Status -- -->
  <div class="flex items-center gap-2 flex-wrap animate-fadeup-1">
    <span class="text-[10px] font-extrabold uppercase tracking-widest flex-shrink-0" style="color:var(--text-faint)">Filter by Status</span>
    <div class="flex gap-2 flex-wrap">
      <button onclick="filterEvents('all')" id="filter-all" class="filter-btn btn-sm btn-solid-green">All</button>
      <button onclick="filterEvents('upcoming')" id="filter-upcoming" class="filter-btn btn-sm btn-sm-gray">Upcoming</button>
      <button onclick="filterEvents('ongoing')" id="filter-ongoing" class="filter-btn btn-sm btn-sm-gray">Ongoing</button>
      <button onclick="filterEvents('completed')" id="filter-completed" class="filter-btn btn-sm btn-sm-gray">Completed</button>
      <button onclick="filterEvents('cancelled')" id="filter-cancelled" class="filter-btn btn-sm btn-sm-gray">Cancelled</button>
    </div>
  </div>

  <div id="events-count" class="text-xs" style="color:var(--text-faint)"></div>

  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5" id="events-grid">
    {{#each events}}
    <div class="overflow-hidden flex flex-col rounded-2xl fm-hover event-card"
      data-status="{{status}}"
      style="background:var(--bg-card);border:1px solid var(--border);box-shadow:0 2px 12px rgba(0,0,0,0.3)">
      <!-- Card Header -->
      <div class="px-5 py-4 relative overflow-hidden"
        style="background:{{themeGradient theme}}{{#if coverPhoto}};min-height:180px{{/if}}">
        {{#if coverPhoto}}
        <img src="{{coverPhoto}}" alt="{{name}}" class="absolute inset-0 w-full h-full object-cover" loading="lazy"/>
        <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(2,8,19,0.22),rgba(2,8,19,0.68))"></div>
        {{/if}}
        <div class="absolute top-0 right-0 w-24 h-24 rounded-full translate-x-8 -translate-y-8" style="background:rgba(255,255,255,0.06)"></div>
        <div class="relative flex items-start justify-between gap-2">
          <div class="flex-1 min-w-0">
            <span class="text-[10px] font-bold uppercase tracking-widest capitalize" style="color:rgba(147,197,253,0.8)">{{#if (eq type 'other')}}{{#if otherType}}{{otherType}}{{else}}Other{{/if}}{{else}}{{type}}{{/if}}</span>
            <h3 class="text-white font-extrabold text-base leading-tight mt-0.5 truncate">{{name}}</h3>
          </div>
          <span class="badge flex-shrink-0 mt-1 {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}{{#if (eq status 'cancelled')}}badge-red{{else}}badge-yellow{{/if}}{{/if}}{{/if}} capitalize">{{status}}</span>
        </div>
      </div>

      <!-- Card Body -->
      <div class="px-5 py-4 flex-1 flex flex-col">
        <div class="space-y-1.5 text-sm flex-1" style="color:var(--text-muted)">
          {{#if venue}}
          <div class="flex items-center gap-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="truncate">{{venue}}</span>
          </div>
          {{/if}}
          {{#if date}}
          <div class="flex items-center gap-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>{{date}}{{#if time}} at {{time}}{{/if}}</span>
          </div>
          {{/if}}
        </div>

        <div class="event-card-actions {{#if ../isAdmin}}{{#if (eq status 'ongoing')}}event-card-actions-three{{else}}{{#if (eq status 'upcoming')}}event-card-actions-three{{/if}}{{/if}}{{/if}} mt-4 pt-4" style="border-top:1px solid rgba(255,255,255,0.06)">
          <a href="/events/{{id}}" class="btn-primary btn-sm justify-center py-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            View
          </a>
          {{#if ../isAdmin}}
            {{#if (eq status 'upcoming')}}
            <form method="POST" action="/events/{{id}}/status">
    <input type="hidden" name="_csrf" value="{{../csrfToken}}">
              <input type="hidden" name="status" value="ongoing">
              <button type="submit" class="btn-sm btn-solid-green w-full justify-center">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg> Start
              </button>
            </form>
            {{/if}}
            {{#if (eq status 'ongoing')}}
            <form method="POST" action="/events/{{id}}/status" onsubmit="return false" data-confirm-title="End Event" data-confirm-msg="Manually end event?" data-confirm-ok="End Event" data-confirm-type="warning">
    <input type="hidden" name="_csrf" value="{{../csrfToken}}">
              <input type="hidden" name="status" value="completed">
              <button type="submit" class="btn-sm btn-solid-blue w-full justify-center">
                End Event
              </button>
            </form>
            {{/if}}
          <a href="/events/{{id}}/edit" class="btn-sm btn-sm-gray justify-center py-2">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit
          </a>
          {{/if}}
        </div>
      </div>
    </div>
    {{/each}}
  </div>

  <div id="events-pagination"></div>

  {{else}}
  <div class="py-20 text-center animate-fadeup-1 rounded-2xl" style="background:var(--bg-card);border:1px solid var(--border)">
    <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5"
      style="background:rgba(59,130,246,0.10);border:1px solid rgba(59,130,246,0.15)">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <p class="font-semibold text-base mb-1" style="color:var(--text-primary)">No events yet</p>
    <p class="text-sm mb-5" style="color:var(--text-faint)">Create your first competition event to get started.</p>
    {{#if isAdmin}}
    <a href="/events/create" class="btn-primary text-sm">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Create First Event
    </a>
    {{/if}}
  </div>
  {{/if}}

</main>
</div>
<script>
var _allVisibleCards = [];
var _eventsCurrentPage = 1;
var _eventsPageSize = 10;

function filterEvents(status) {
  var cards = Array.from(document.querySelectorAll('.event-card'));
  var btns  = document.querySelectorAll('.filter-btn');

  _allVisibleCards = cards.filter(function(card) {
    return status === 'all' || card.dataset.status === status;
  });

  cards.forEach(function(card) { card.style.display = 'none'; });

  btns.forEach(function(btn) {
    var active = btn.id === 'filter-' + status;
    btn.classList.toggle('btn-solid-green', active);
    btn.classList.toggle('btn-sm-gray', !active);
  });

  _eventsCurrentPage = 1;
  renderEventsPage();
}

function renderEventsPage() {
  var cards = Array.from(document.querySelectorAll('.event-card'));
  cards.forEach(function(card) { card.style.display = 'none'; });

  var start = (_eventsCurrentPage - 1) * _eventsPageSize;
  var end   = start + _eventsPageSize;
  var pageCards = _allVisibleCards.slice(start, end);
  pageCards.forEach(function(card) { card.style.display = ''; });

  var total = _allVisibleCards.length;
  var totalPages = Math.ceil(total / _eventsPageSize) || 1;

  var countEl = document.getElementById('events-count');
  if (countEl) {
    var showEnd = Math.min(end, total);
    countEl.textContent = total === 0 ? '0 events' :
      'Showing ' + (start + 1) + '\u2013' + showEnd + ' of ' + total + ' event' + (total !== 1 ? 's' : '');
  }

  var paginationEl = document.getElementById('events-pagination');
  if (!paginationEl) return;
  paginationEl.innerHTML = '';
  if (totalPages <= 1) return;

  paginationEl.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:10px;padding:14px 0';

  var btnsRow = document.createElement('div');
  btnsRow.style.cssText = 'display:flex;gap:4px;flex-wrap:wrap;justify-content:center';

  function mkBtn(label, page, disabled, active) {
    var b = document.createElement('button');
    b.textContent = label;
    b.disabled = disabled;
    b.style.cssText = 'padding:4px 10px;border-radius:8px;font-size:11px;font-weight:700;cursor:' + (disabled ? 'not-allowed' : 'pointer') + ';border:1px solid;'
      + (active
        ? 'background:rgba(16,185,129,0.2);color:#34d399;border-color:rgba(16,185,129,0.4)'
        : 'background:rgba(255,255,255,0.04);color:var(--text-faint);border-color:rgba(255,255,255,0.1)');
    if (!disabled && !active) {
      b.addEventListener('mouseenter', function(){ b.style.background='rgba(255,255,255,0.08)'; });
      b.addEventListener('mouseleave', function(){ b.style.background='rgba(255,255,255,0.04)'; });
    }
    if (!disabled) b.addEventListener('click', function(){ _eventsCurrentPage = page; renderEventsPage(); });
    return b;
  }

  btnsRow.appendChild(mkBtn('Prev', _eventsCurrentPage - 1, _eventsCurrentPage === 1, false));
  for (var p = 1; p <= totalPages; p++) {
    btnsRow.appendChild(mkBtn(String(p), p, false, p === _eventsCurrentPage));
  }
  btnsRow.appendChild(mkBtn('Next', _eventsCurrentPage + 1, _eventsCurrentPage === totalPages, false));
  paginationEl.appendChild(btnsRow);
}

document.addEventListener('DOMContentLoaded', function() {
  _allVisibleCards = Array.from(document.querySelectorAll('.event-card'));
  filterEvents('all');
});
</script>
{{> footer }}
</body>
</html>
