{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0a0f1e">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

  {{#if success_msg}}<div class="alert-success animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg><span>{{{success_msg}}}</span></div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>{{error_msg}}</div>{{/if}}

  <!-- Hero card -->
  <div class="card-flat overflow-hidden animate-fadeup">
    <div class="px-7 py-6 relative overflow-hidden" style="background:{{themeGradient event.theme}}">
      {{#if event.coverPhoto}}
      <img src="{{event.coverPhoto}}" alt="{{event.name}}" class="absolute inset-0 w-full h-full object-cover" style="opacity:0.3"/>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(0,0,0,0.15),rgba(0,0,0,0.6))"></div>
      {{/if}}
      <div class="absolute top-0 right-0 w-48 h-48 rounded-full translate-x-16 -translate-y-16" style="background:rgba(255,255,255,0.05)"></div>
      <div class="relative">
        <div class="breadcrumb mb-3" style="color:rgba(147,197,253,0.8)">
          <a href="/events" style="color:rgba(147,197,253,0.9)">Back to All Events</a>
        </div>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-white text-2xl font-extrabold tracking-tight mb-2">{{event.name}}</h1>
            <div class="flex flex-wrap gap-4 text-blue-200 text-sm">
              {{#if event.venue}}<span class="flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>{{event.venue}}</span>{{/if}}
              {{#if event.date}}<span class="flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{{event.date}}{{#if event.time}} at {{event.time}}{{/if}}</span>{{/if}}
              <span class="capitalize flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>{{#if (eq event.type 'other')}}{{#if event.otherType}}{{event.otherType}}{{else}}Other{{/if}}{{else}}{{event.type}}{{/if}}</span>
              {{#if event.organizer}}<span class="flex items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>{{event.organizer}}</span>{{/if}}
            </div>
            {{#if event.description}}<p class="text-blue-100 text-sm mt-3 max-w-2xl leading-relaxed">{{event.description}}</p>{{/if}}
          </div>
          <span class="badge flex-shrink-0 mt-1 {{#if (eq event.status 'ongoing')}}badge-green{{else}}{{#if (eq event.status 'completed')}}badge-blue{{else}}{{#if (eq event.status 'cancelled')}}badge-red{{else}}badge-yellow{{/if}}{{/if}}{{/if}}">{{event.status}}</span>
          {{#if event.votingOpen}}<span class="badge badge-green flex-shrink-0 mt-1 ml-1">♥ Voting Open</span>{{else}}<span class="badge badge-gray flex-shrink-0 mt-1 ml-1">Voting Off</span>{{/if}}
        </div>
      </div>
    </div>
    <!-- Action toolbar -->
    <div class="px-4 py-3 flex flex-wrap items-center gap-2" style="border-top:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.03);position:relative;overflow:visible;z-index:20">
      {{#if isAdmin}}

      <!-- Primary actions — always visible -->
      {{#if (eq event.status 'upcoming')}}
      <form method="POST" action="/events/{{event.id}}/status" class="inline">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="status" value="ongoing">
        <button type="submit" class="btn-sm bg-emerald-600 hover:bg-emerald-700 text-white font-bold flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg> Start Event
        </button>
      </form>
      {{/if}}
      {{#if (eq event.status 'ongoing')}}
      <form method="POST" action="/events/{{event.id}}/status" class="inline" onsubmit="return confirm('Manually end this event?')">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="status" value="completed">
        <button type="submit" class="btn-sm bg-blue-600 hover:bg-blue-700 text-white font-bold flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> End Event
        </button>
      </form>
      {{/if}}
      {{#if (eq event.status 'completed')}}
      <form id="reopen-event-form" method="POST" action="/events/{{event.id}}/status" class="hidden">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="status" value="ongoing">
      </form>
      <button type="submit" form="reopen-event-form" class="btn-sm btn-sm-gray flex items-center gap-1.5" style="min-height:44px;padding:8px 12px;position:relative;top:8px!important">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg> Re-open
      </button>
      {{/if}}

      <a href="/events/{{event.id}}/contestants/add" class="btn-sm btn-sm-blue flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg> Add Contestant
      </a>
      <a href="/events/{{event.id}}/results" class="btn-sm btn-sm-green flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg> Results
      </a>

      <!-- More dropdown -->
      <div class="relative" id="admin-more-wrap">
        <button type="button" onclick="toggleDropdown('admin-more', this)"
          class="btn-sm btn-sm-gray flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
          More
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
      </div>

      {{/if}}{{#if isJudge}}
      <a href="/events/{{event.id}}/scoring" class="btn-sm btn-sm-purple flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg> Score This Event
      </a>
      <a href="/events/{{event.id}}/results" class="btn-sm btn-sm-green flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg> Results
      </a>
      {{/if}}{{#if isEncoder}}
      <a href="/events/{{event.id}}/contestants/add" class="btn-sm btn-sm-blue flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg> Add Contestant
      </a>
      <a href="/events/{{event.id}}/results" class="btn-sm btn-sm-green flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg> Results
      </a>
      {{/if}}{{#if isOrganizer}}

      <!-- Organizer primary actions -->
      {{#if (eq event.status 'upcoming')}}
      <form method="POST" action="/events/{{event.id}}/status" class="inline">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="status" value="ongoing">
        <button type="submit" class="btn-sm bg-emerald-600 hover:bg-emerald-700 text-white font-bold flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg> Start Event
        </button>
      </form>
      {{/if}}
      {{#if (eq event.status 'ongoing')}}
      <form method="POST" action="/events/{{event.id}}/status" class="inline" onsubmit="return confirm('Are you sure you want to manually end this event?')">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="status" value="completed">
        <button type="submit" class="btn-sm bg-blue-600 hover:bg-blue-700 text-white font-bold flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> End Event
        </button>
      </form>
      {{/if}}
      {{#if (eq event.status 'completed')}}
      <form method="POST" action="/events/{{event.id}}/status" class="inline">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="status" value="ongoing">
        <button type="submit" class="btn-sm btn-sm-gray flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg> Re-open
        </button>
      </form>
      {{/if}}

      <a href="/events/{{event.id}}/contestants/add" class="btn-sm btn-sm-blue flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg> Add Contestant
      </a>
      <a href="/events/{{event.id}}/results" class="btn-sm btn-sm-green flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg> Results
      </a>

      <!-- Organizer More dropdown -->
      <div class="relative" id="org-more-wrap">
        <button type="button" onclick="toggleDropdown('org-more', this)"
          class="btn-sm btn-sm-gray flex items-center gap-1.5" style="min-height:44px;padding:8px 12px">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
          More
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
      </div>

      {{/if}}
    </div>
  </div>

  <div class="grid lg:grid-cols-2 gap-5 animate-fadeup-1">
    <!-- Contestants -->
    <div class="section-card">
      <div class="section-header">
        <h2><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Contestants <span class="ml-1.5 bg-blue-100 text-blue-600 text-xs font-bold px-2 py-0.5 rounded-full">{{contestants.length}}</span></h2>
        {{#if isAdmin}}<a href="/events/{{event.id}}/contestants/add" class="btn-primary btn-sm text-xs px-3 py-1.5"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Add</a>{{/if}}
        {{#if isOrganizer}}<a href="/events/{{event.id}}/contestants/add" class="btn-primary btn-sm text-xs px-3 py-1.5"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Add</a>{{/if}}
      </div>
      {{#if contestants.length}}
      <div class="p-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {{#each contestants}}
        <div class="group relative rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition hover:-translate-y-1"
          style="aspect-ratio:3/4;border:1px solid rgba(255,255,255,0.08);background:#111827">
          <!-- Photo or gradient fallback -->
          {{#if photo}}
          <img src="{{photo}}" alt="{{name}}"
            class="absolute inset-0 w-full h-full object-cover"
            style="object-position:center top"/>
          {{else}}
          <div class="absolute inset-0 flex items-center justify-center" style="background:linear-gradient(160deg,#0f1e3d,#1a2f5a)">
            <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-xl font-black shadow-lg" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">{{number}}</div>
          </div>
          {{/if}}

          <!-- Gradient overlay always -->
          <div class="absolute inset-0" style="background:linear-gradient(0deg,rgba(10,20,60,0.75) 0%,rgba(10,20,60,0.15) 45%,transparent 70%)"></div>

          <!-- Number badge top-left -->
          <div class="absolute top-2 left-2">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-white text-xs font-extrabold shadow-md border border-white/30" style="background:rgba(37,99,235,0.85)">{{number}}</span>
          </div>

          <!-- Admin/Organizer actions top-right -->
          {{#if ../isAdmin}}
          <div class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <a href="/events/{{../event.id}}/contestants/{{id}}/edit"
              class="w-7 h-7 rounded-full flex items-center justify-center shadow transition"
              style="background:rgba(255,255,255,0.85);color:#1e293b"
              onmouseover="this.style.background='rgba(255,255,255,0.95)'" onmouseout="this.style.background='rgba(255,255,255,0.85)'">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </a>
            <form method="POST" action="/events/{{../event.id}}/contestants/{{id}}/delete" class="inline" onsubmit="return confirm('Remove contestant?')">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
              <button class="w-7 h-7 rounded-full flex items-center justify-center bg-red-500/90 hover:bg-red-500 text-white shadow transition">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
              </button>
            </form>
          </div>
          {{/if}}
          {{#if ../isOrganizer}}
          <div class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
            <a href="/events/{{../event.id}}/contestants/{{id}}/edit"
              class="w-7 h-7 rounded-full flex items-center justify-center shadow transition"
              style="background:rgba(255,255,255,0.85);color:#1e293b"
              onmouseover="this.style.background='rgba(255,255,255,0.95)'" onmouseout="this.style.background='rgba(255,255,255,0.85)'">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </a>
            <form method="POST" action="/events/{{../event.id}}/contestants/{{id}}/delete" class="inline" onsubmit="return confirm('Remove contestant?')">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
              <button class="w-7 h-7 rounded-full flex items-center justify-center bg-red-500/90 hover:bg-red-500 text-white shadow transition">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
              </button>
            </form>
          </div>
          {{/if}}

          <!-- Name & details bottom -->
          <div class="absolute bottom-0 left-0 right-0 px-3 py-3">
            <div class="text-white font-extrabold text-sm leading-tight truncate">{{name}}</div>
            <div class="text-white/70 text-[11px] mt-0.5 truncate">
              {{#if barangay}}Brgy. {{barangay}}{{/if}}{{#if age}} &bull; {{age}} yrs{{/if}}
            </div>
            {{#if platform}}
            <div class="mt-1.5">
              <span class="inline-block bg-blue-500/80 text-white text-[10px] font-semibold px-2 py-0.5 rounded-full truncate max-w-full">{{platform}}</span>
            </div>
            {{/if}}
            {{#if registrationFee}}
            <div class="mt-1">
              <span class="inline-flex items-center gap-0.5 text-[10px] font-extrabold px-2 py-0.5 rounded-full" style="background:rgba(16,185,129,0.55);color:#fff">₱{{registrationFee}}</span>
            </div>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="py-10 text-center text-slate-400 text-sm">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#e2e8f0" stroke-width="1.5" class="mx-auto mb-3"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        No contestants added yet.
      </div>
      {{/if}}
    </div>

    <!-- Criteria -->
    <div class="section-card">
      <div class="section-header">
        <h2>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Scoring Criteria
          {{#if criteria.length}}<span class="ml-1.5 text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:rgba(139,92,246,0.15);color:#c4b5fd;border:1px solid rgba(139,92,246,0.25)">{{criteria.length}} categories</span>{{/if}}
        </h2>
        {{#if isAdmin}}<a href="/events/{{event.id}}/criteria" class="btn-sm btn-sm-purple text-xs px-3 py-1.5"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg> Manage</a>{{/if}}
        {{#if isOrganizer}}<a href="/events/{{event.id}}/criteria" class="btn-sm btn-sm-purple text-xs px-3 py-1.5"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg> Manage</a>{{/if}}
      </div>
      {{#if criteria.length}}
      <div class="p-4 space-y-2.5">
        {{#each criteria}}
        <div class="rounded-xl p-3.5 transition" style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06)"
          onmouseover="this.style.background='rgba(139,92,246,0.05)';this.style.borderColor='rgba(139,92,246,0.2)'"
          onmouseout="this.style.background='rgba(255,255,255,0.02)';this.style.borderColor='rgba(255,255,255,0.06)'">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="flex items-center gap-2.5 min-w-0">
              <!-- Color-coded number badge -->
              <div class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 text-white text-[10px] font-extrabold"
                style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">{{add1 @index}}</div>
              <div class="min-w-0">
                <div class="font-bold text-sm leading-tight" style="color:#e2e8f0">{{name}}</div>
                {{#if description}}<div class="text-[11px] mt-0.5 truncate" style="color:#64748b">{{description}}</div>{{/if}}
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <span class="text-xs font-black px-2.5 py-1 rounded-full" style="background:rgba(139,92,246,0.15);color:#c4b5fd;border:1px solid rgba(139,92,246,0.25)">{{weight}}%</span>
              <span class="text-[10px] font-semibold px-2 py-1 rounded-full" style="background:rgba(255,255,255,0.05);color:#64748b;border:1px solid rgba(255,255,255,0.08)">max {{maxScore}}</span>
            </div>
          </div>
          <!-- Weight bar -->
          <div class="h-1.5 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
            <div class="h-full rounded-full" style="width:{{weight}}%;background:linear-gradient(90deg,#7c3aed,#a855f7);transition:width 80ms ease"></div>
          </div>
        </div>
        {{/each}}
        <!-- Total weight indicator -->
        <div class="flex items-center justify-between px-1 pt-1">
          <span class="text-[11px]" style="color:#475569">Total weight</span>
          <span class="text-xs font-extrabold" style="color:#c4b5fd">100%</span>
        </div>
      </div>
      {{else}}
      <div class="py-10 text-center">
        <div class="w-12 h-12 rounded-2xl flex items-center justify-center mx-auto mb-3" style="background:rgba(139,92,246,0.08);border:1px solid rgba(139,92,246,0.15)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <p class="text-sm font-semibold mb-1" style="color:#e2e8f0">No criteria defined</p>
        {{#if isAdmin}}<a href="/events/{{event.id}}/criteria" class="text-xs font-bold" style="color:#a78bfa">Set up scoring criteria →</a>{{/if}}
        {{#if isOrganizer}}<a href="/events/{{event.id}}/criteria" class="text-xs font-bold" style="color:#a78bfa">Set up scoring criteria →</a>{{/if}}
      </div>
      {{/if}}
    </div>
  </div>

  <!-- ══ Audit Trail — admin/organizer only ══ -->
  {{#if isAdmin}}
  {{#if auditLog.length}}
  <div class="section-card animate-fadeup-2">
    <div class="section-header">
      <h2>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/><line x1="9" y1="19" x2="11" y2="19"/></svg>
        Score Submission Audit Trail
        <span class="ml-1.5 text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:rgba(16,185,129,0.12);color:#34d399;border:1px solid rgba(16,185,129,0.2)">{{auditLog.length}} entries</span>
      </h2>
    </div>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th>Judge</th>
            <th>Action</th>
            <th>Scores Submitted</th>
            <th>Timestamp</th>
          </tr>
        </thead>
        <tbody>
          {{#each auditLog}}
          <tr>
            <td>
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
                  {{#if judgeName}}{{judgeName.[0]}}{{else}}J{{/if}}
                </div>
                <span class="text-sm font-semibold" style="color:#e2e8f0">{{judgeName}}</span>
              </div>
            </td>
            <td>
              <span class="badge badge-green text-[10px]">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                Scores Submitted
              </span>
            </td>
            <td class="text-sm font-bold" style="color:#e2e8f0">{{scoreCount}} score(s)</td>
            <td class="text-xs" style="color:#64748b">{{timestampStr}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
  {{/if}}
  {{/if}}

  <!-- ══ Stage Timer — only visible when event is ongoing ══ -->
  <div id="event-meta"
    data-event-id="{{event.id}}"
    data-event-date="{{event.date}}"
    data-event-time="{{event.time}}"
    data-event-end-time="{{event.endTime}}"
    data-event-status="{{event.status}}"
    style="display:none"></div>
  {{#if (eq event.status 'ongoing')}}
  {{#unless isEncoder}}
  <div class="animate-fadeup-1">
    {{> countdown_timer }}
  </div>
  {{/unless}}
  {{/if}}

  {{#if event.prizes}}
  {{#if event.isPrizeType}}
  <div class="grid lg:grid-cols-2 gap-5 animate-fadeup-2">
    <div class="section-card">
      <div class="section-header"><h2><svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>Prizes &amp; Awards</h2></div>
      <div class="px-5 py-4 text-sm whitespace-pre-line leading-relaxed" style="color:#94a3b8">{{event.prizes}}</div>
    </div>
    {{#if event.rules}}
    <div class="section-card">
      <div class="section-header"><h2><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>Rules &amp; Mechanics</h2></div>
      <div class="px-5 py-4 text-sm whitespace-pre-line leading-relaxed" style="color:#94a3b8">{{event.rules}}</div>
    </div>
    {{/if}}
  </div>
  {{/if}}
  {{/if}}

  {{#if event.notes}}
  <div class="section-card animate-fadeup-2">
    <div class="section-header"><h2><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Additional Notes</h2></div>
    <div class="px-5 py-4 text-sm whitespace-pre-line leading-relaxed" style="color:#94a3b8">{{event.notes}}</div>
  </div>
  {{/if}}

  <!-- Payment QR Code Card — only for paid event types that have a QR uploaded -->
  {{#if event.paymentQR}}
  {{#if event.isPaymentType}}
  <div class="section-card animate-fadeup-2" style="border-color:rgba(16,185,129,0.3)">
    <div class="section-header" style="background:rgba(16,185,129,0.08)">
      <h2>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        Payment QR Code
        {{#if event.paymentMethod}}<span class="ml-2 badge badge-green text-[10px]">{{event.paymentMethod}}</span>{{/if}}
      </h2>
      <a href="/events/{{event.id}}/edit" class="btn-sm btn-sm-gray text-xs">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Edit
      </a>
    </div>
    <div class="px-6 py-6 flex flex-col sm:flex-row items-center gap-6">
      <!-- QR Image -->
      <div class="flex-shrink-0 p-3 rounded-2xl shadow-sm" style="background:#fff;border:1px solid rgba(16,185,129,0.2)">
        <img src="{{event.paymentQR}}" alt="Payment QR Code" class="rounded-xl" style="width:160px;height:160px;object-fit:contain"/>
      </div>
      <!-- Details -->
      <div class="flex-1 space-y-3 text-center sm:text-left">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide" style="color:#64748b">How to Pay</p>
          <p class="text-sm mt-1 leading-relaxed" style="color:#94a3b8">Scan the QR code using your <span class="font-bold" style="color:#34d399">{{#if event.paymentMethod}}{{event.paymentMethod}}{{else}}payment app{{/if}}</span> to send your payment directly.</p>
        </div>
        {{#if event.paymentAccountName}}
        <div class="flex items-center gap-2 text-sm">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span style="color:#64748b">Account Name:</span>
          <span class="font-bold" style="color:#e2e8f0">{{event.paymentAccountName}}</span>
        </div>
        {{/if}}
        {{#if event.paymentAccountNumber}}
        <div class="flex items-center gap-2 text-sm">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
          <span style="color:#64748b">Account No.:</span>
          <span class="font-bold font-mono tracking-wide" style="color:#e2e8f0">{{event.paymentAccountNumber}}</span>
        </div>
        {{/if}}
        <div class="flex gap-2 pt-1 justify-center sm:justify-start flex-wrap">
          <a href="{{event.paymentQR}}" download="payment-qr-{{event.id}}.png" class="btn-sm btn-sm-green text-xs">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download QR
          </a>
        </div>
      </div>
    </div>
  </div>
  {{/if}}
  {{/if}}

  <!-- Event URL QR Code Card — only show when a payment QR has been uploaded -->
  {{#if event.paymentQR}}
  {{#if event.isPaymentType}}
  {{#if canManageFinance}}
  <div class="section-card animate-fadeup-2">
    <div class="section-header">
      <h2>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="5" y="5" width="3" height="3" fill="#7c3aed"/><rect x="16" y="5" width="3" height="3" fill="#7c3aed"/><rect x="16" y="16" width="3" height="3" fill="#7c3aed"/><rect x="5" y="16" width="3" height="3" fill="#7c3aed"/></svg>
        Event QR Code
      </h2>
      <button onclick="downloadQR()" class="btn-sm btn-sm-purple text-xs px-3 py-1.5">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download
      </button>
    </div>
    <div class="px-6 py-6 flex flex-col sm:flex-row items-center gap-6">
      <div class="flex-shrink-0 p-3 rounded-2xl shadow-sm" style="background:#fff;border:1px solid rgba(255,255,255,0.1)">
        <canvas id="event-qr-canvas" width="160" height="160"></canvas>
      </div>
      <div class="flex-1 space-y-2 text-center sm:text-left">
        <p class="font-bold text-sm" style="color:#e2e8f0">{{event.name}}</p>
        <p class="text-xs leading-relaxed" style="color:#64748b">Scan this QR code to open the event page directly. Share it with judges, encoders, and participants for instant access.</p>
        <div class="mt-2 px-3 py-2 rounded-lg text-xs font-mono break-all" id="qr-url-display" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:#94a3b8"></div>
        <div class="flex gap-2 pt-1 justify-center sm:justify-start flex-wrap">
          <button onclick="copyEventUrl()" class="btn-sm btn-sm-gray text-xs">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Copy URL
          </button>
          <button onclick="downloadQR()" class="btn-sm btn-sm-purple text-xs">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download QR
          </button>
        </div>
      </div>
    </div>
  </div>
  {{/if}}
  {{/if}}{{!-- /event.isPaymentType --}}
  {{/if}}{{!-- /event.paymentQR --}}

  <!-- ═══════════════════════════════════════════════
       EVENT INCOME & EXPENSE TRACKER
       ═══════════════════════════════════════════════ -->
  {{#if canManageFinance}}
  {{#if event.isPaymentType}}
  {{#if finance.entries.length}}
  <div id="finance" class="animate-fadeup-2">

    <!-- KPI summary row -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">

      <!-- Total Income -->
      <div class="rounded-2xl px-5 py-5 relative overflow-hidden"
        style="background:linear-gradient(135deg,#064e3b,#059669);border:1px solid rgba(16,185,129,0.3);box-shadow:0 6px 24px rgba(5,150,105,0.25)">
        <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.06)"></div>
        <div class="relative">
          <div class="text-[10px] font-extrabold uppercase tracking-widest mb-1" style="color:rgba(110,231,183,0.7)">Total Income</div>
          <div class="text-2xl font-black text-white">₱{{finance.totalIncome}}</div>
          <div class="text-xs mt-1" style="color:rgba(110,231,183,0.6)">All income entries</div>
        </div>
      </div>

      <!-- Total Expenses -->
      <div class="rounded-2xl px-5 py-5 relative overflow-hidden"
        style="background:linear-gradient(135deg,#7f1d1d,#dc2626);border:1px solid rgba(239,68,68,0.3);box-shadow:0 6px 24px rgba(220,38,38,0.2)">
        <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.06)"></div>
        <div class="relative">
          <div class="text-[10px] font-extrabold uppercase tracking-widest mb-1" style="color:rgba(252,165,165,0.7)">Total Expenses</div>
          <div class="text-2xl font-black text-white">₱{{finance.totalExpense}}</div>
          <div class="text-xs mt-1" style="color:rgba(252,165,165,0.6)">All expense entries</div>
        </div>
      </div>

      <!-- Net Balance -->
      <div class="rounded-2xl px-5 py-5 relative overflow-hidden"
        style="{{#if finance.isProfit}}background:linear-gradient(135deg,#1e3a8a,#2563eb);border:1px solid rgba(99,102,241,0.35);box-shadow:0 6px 24px rgba(37,99,235,0.25){{else}}background:linear-gradient(135deg,#4c1d95,#7c3aed);border:1px solid rgba(139,92,246,0.35);box-shadow:0 6px 24px rgba(124,58,237,0.25){{/if}}">
        <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full" style="background:rgba(255,255,255,0.06)"></div>
        <div class="relative">
          <div class="text-[10px] font-extrabold uppercase tracking-widest mb-1" style="color:rgba(165,180,252,0.7)">Net Balance</div>
          <div class="text-2xl font-black text-white flex items-center gap-2">
            {{#if finance.isProfit}}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            {{else}}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fca5a5" stroke-width="2.5"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg>
            {{/if}}
            ₱{{finance.netBalance}}
          </div>
          <div class="text-xs mt-1" style="color:rgba(165,180,252,0.6)">{{#if finance.isProfit}}Surplus / Profit{{else}}Deficit / Loss{{/if}}</div>
        </div>
      </div>

    </div>

    <!-- Main finance card -->
    <div class="rounded-2xl overflow-hidden" style="background:#111827;border:1px solid rgba(255,255,255,0.07)">

      <!-- Header -->
      <div class="px-6 py-4 flex items-center justify-between" style="border-bottom:1px solid rgba(255,255,255,0.06);background:rgba(255,255,255,0.02)">
        <h2 class="text-sm font-extrabold flex items-center gap-2" style="color:#e2e8f0">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Income &amp; Expense Log
          <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)">{{finance.entries.length}} entries</span>
        </h2>
        {{#if canManageFinance}}
        <button onclick="toggleFinanceForm()" class="btn-sm btn-sm-green text-xs">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Entry
        </button>
        {{/if}}
      </div>

      <!-- Add Entry Form (admin + organizer, collapsible) -->
      {{#if canManageFinance}}
      <div id="finance-form-wrap" class="hidden" style="border-bottom:1px solid rgba(255,255,255,0.06);background:rgba(99,102,241,0.04)">
        <form method="POST" action="/events/{{event.id}}/finance" class="px-6 py-5">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">

            <!-- Type toggle -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-2" style="color:#4b5563">Type</label>
              <input type="hidden" name="type" id="fin-type-val" value="income"/>
              <div class="grid grid-cols-2 gap-1.5">
                <button type="button" id="fin-income-btn" onclick="setFinType('income')"
                  class="py-2 rounded-xl text-xs font-extrabold transition"
                  style="background:rgba(16,185,129,0.2);color:#6ee7b7;border:2px solid rgba(16,185,129,0.4)">
                  ↑ Income
                </button>
                <button type="button" id="fin-expense-btn" onclick="setFinType('expense')"
                  class="py-2 rounded-xl text-xs font-extrabold transition"
                  style="background:rgba(255,255,255,0.05);color:#64748b;border:2px solid rgba(255,255,255,0.08)">
                  ↓ Expense
                </button>
              </div>
            </div>

            <!-- Category -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-2" style="color:#4b5563">Category</label>
              <select name="category" id="fin-category" class="form-input-bare w-full text-xs">
                <optgroup label="Income" style="background:#1e293b">
                  <option value="registration">Registration Fee</option>
                  <option value="ticket">Ticket Sales</option>
                  <option value="sponsorship">Sponsorship</option>
                  <option value="donation">Donation</option>
                  <option value="merchandise">Merchandise</option>
                  <option value="grant">LGU Grant / Budget</option>
                </optgroup>
                <optgroup label="Expense" style="background:#1e293b">
                  <option value="venue">Venue / Hall Rental</option>
                  <option value="sound">Sound System / AV</option>
                  <option value="prizes-exp">Prizes / Trophies</option>
                  <option value="logistics">Logistics / Transport</option>
                  <option value="catering">Food / Catering</option>
                  <option value="decorations">Decorations / Props</option>
                  <option value="marketing">Marketing / Printing</option>
                  <option value="staff">Staff / Labor</option>
                  <option value="other-exp">Other Expense</option>
                </optgroup>
              </select>
            </div>

            <!-- Amount -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-2" style="color:#4b5563">Amount (₱) <span style="color:#ef4444">*</span></label>
              <input type="number" name="amount" placeholder="0.00" min="0.01" step="0.01" required class="form-input-bare w-full"/>
            </div>

            <!-- Description -->
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-2" style="color:#4b5563">Description</label>
              <input type="text" name="description" placeholder="e.g. 10 teams × ₱500" class="form-input-bare w-full"/>
            </div>

          </div>
          <div class="flex gap-2 mt-4">
            <button type="submit" class="btn-primary text-sm px-6">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Save Entry
            </button>
            <button type="button" onclick="toggleFinanceForm()" class="btn-secondary text-sm px-5">Cancel</button>
          </div>
        </form>
      </div>
      {{/if}}

      <!-- Entries table -->
      {{#if finance.entries.length}}
      <div class="overflow-x-auto">
        <table class="data-table w-full">
          <thead>
            <tr>
              <th>Type</th>
              <th>Category</th>
              <th>Description</th>
              <th class="text-right">Amount</th>
              {{#if isAdmin}}<th></th>{{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each finance.entries}}
            <tr>
              <td>
                {{#if (eq type 'income')}}
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-extrabold" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)">
                  <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                  Income
                </span>
                {{else}}
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-extrabold" style="background:rgba(239,68,68,0.15);color:#fca5a5;border:1px solid rgba(239,68,68,0.25)">
                  <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg>
                  Expense
                </span>
                {{/if}}
              </td>
              <td><span class="badge badge-gray capitalize text-[11px]">{{category}}</span></td>
              <td class="text-sm" style="color:#94a3b8">{{#if description}}{{description}}{{else}}<span style="color:#1f2937">—</span>{{/if}}</td>
              <td class="text-right font-extrabold text-sm" style="color:{{#if (eq type 'income')}}#6ee7b7{{else}}#fca5a5{{/if}}">
                {{#if (eq type 'income')}}+{{else}}−{{/if}}₱{{amount}}
              </td>
              {{#if ../isAdmin}}
              <td class="text-right">
                <form method="POST" action="/events/{{../event.id}}/finance/{{id}}/delete" class="inline" onsubmit="return confirm('Remove this entry?')">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
                  <button class="btn-sm btn-sm-red text-xs px-2.5 py-1.5">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                  </button>
                </form>
              </td>
              {{/if}}
            </tr>
            {{/each}}
          </tbody>
          <!-- Running totals footer -->
          <tfoot>
            <tr style="border-top:2px solid rgba(16,185,129,0.2)">
              <td colspan="3" class="px-5 py-3 text-xs font-extrabold uppercase tracking-widest text-right" style="color:#4b5563">Total Income</td>
              <td class="px-5 py-3 text-right font-black text-sm" style="color:#6ee7b7">+₱{{finance.totalIncome}}</td>
              {{#if isAdmin}}<td></td>{{/if}}
            </tr>
            <tr style="border-top:1px solid rgba(239,68,68,0.15)">
              <td colspan="3" class="px-5 py-3 text-xs font-extrabold uppercase tracking-widest text-right" style="color:#4b5563">Total Expenses</td>
              <td class="px-5 py-3 text-right font-black text-sm" style="color:#fca5a5">−₱{{finance.totalExpense}}</td>
              {{#if isAdmin}}<td></td>{{/if}}
            </tr>
            <tr style="border-top:2px solid rgba(99,102,241,0.25)">
              <td colspan="3" class="px-5 py-3 text-xs font-extrabold uppercase tracking-widest text-right" style="color:#4b5563">Net Balance</td>
              <td class="px-5 py-3 text-right font-black text-base" style="color:{{#if finance.isProfit}}#a5b4fc{{else}}#f9a8d4{{/if}}">
                {{#if finance.isProfit}}+{{else}}−{{/if}}₱{{finance.netBalance}}
              </td>
              {{#if isAdmin}}<td></td>{{/if}}
            </tr>
          </tfoot>
        </table>
      </div>

      {{else}}
      <!-- Empty state -->
      <div class="py-14 text-center">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4" style="background:rgba(16,185,129,0.10);border:1px solid rgba(16,185,129,0.15)">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <p class="font-bold text-sm mb-1" style="color:#e2e8f0">No finance entries yet</p>
        <p class="text-xs mb-5" style="color:#374151">Track registration fees, sponsorships, expenses, and more.</p>
        {{#if canManageFinance}}
        <button onclick="toggleFinanceForm()" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold transition" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add First Entry
        </button>
        {{/if}}
      </div>
      {{/if}}

    </div><!-- /finance card -->
  </div><!-- /finance section -->
  {{/if}}{{!-- /finance.entries.length --}}
  {{/if}}{{!-- /event.isPaymentType --}}
  {{/if}}{{!-- /canManageFinance --}}

</main>
</div>

<!-- QR Code library (CDN, no install needed) -->
<script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
<style>
.dropdown-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 14px;
  font-size: 12px;
  font-weight: 600;
  color: #cbd5e1;
  text-decoration: none;
  transition: background 80ms ease, color 80ms ease;
  cursor: pointer;
  background: transparent;
  border: none;
  width: 100%;
}
.dropdown-item:hover {
  background: rgba(255,255,255,0.07);
  color: #f1f5f9;
}
</style>
<script>
// Shared dropdown portal — appended to body so overflow:hidden never clips it
var _portal = null;
function getPortal() {
  if (!_portal) {
    _portal = document.createElement('div');
    _portal.id = 'dropdown-portal';
    _portal.style.cssText = 'position:fixed;z-index:99999;top:0;left:0;pointer-events:none';
    document.body.appendChild(_portal);
  }
  return _portal;
}

function toggleDropdown(id, btn) {
  var portal  = getPortal();
  var content = document.getElementById(id + '-content');
  if (!content) return;

  // If already visible, hide it
  if (content.style.display === 'block') {
    content.style.display = 'none';
    portal.style.pointerEvents = 'none';
    return;
  }

  // Hide all other dropdowns
  portal.querySelectorAll('[data-dropdown]').forEach(function(el) { el.style.display = 'none'; });

  // Position it below the button using fixed coords
  var rect      = btn.getBoundingClientRect();
  var menuWidth = 200; // min-width of dropdown
  var rightVal  = window.innerWidth - rect.right;

  content.style.display  = 'block';
  content.style.position = 'fixed';
  content.style.top      = (rect.bottom + 6) + 'px';

  // If anchoring to right would push menu off left edge, anchor left instead
  if (rect.right - menuWidth < 8) {
    content.style.left  = Math.max(8, rect.left) + 'px';
    content.style.right = 'auto';
  } else {
    content.style.right = Math.max(4, rightVal) + 'px';
    content.style.left  = 'auto';
  }
  // Ensure it never goes off screen bottom
  content.style.maxHeight = (window.innerHeight - rect.bottom - 16) + 'px';
  content.style.overflowY = 'auto';
  portal.style.pointerEvents = 'auto';

  // Move into portal if not already there
  if (content.parentNode !== portal) {
    portal.appendChild(content);
  }
}

function closeDropdown(id) {
  var content = document.getElementById(id + '-content');
  if (content) content.style.display = 'none';
  if (_portal) _portal.style.pointerEvents = 'none';
}

// Close when clicking outside
document.addEventListener('click', function(e) {
  if (!_portal) return;
  var inBtn = e.target.closest('[id$="-more-wrap"]');
  var inMenu = e.target.closest('[data-dropdown]');
  if (!inBtn && !inMenu) {
    _portal.querySelectorAll('[data-dropdown]').forEach(function(el) { el.style.display = 'none'; });
    _portal.style.pointerEvents = 'none';
  }
});

// Reposition on scroll/resize
window.addEventListener('scroll', function() {
  if (_portal) _portal.querySelectorAll('[data-dropdown]').forEach(function(el) { el.style.display = 'none'; });
}, true);
</script>
<script>
/* ── Finance form toggle + type switcher ── */
function toggleFinanceForm() {
  const wrap = document.getElementById('finance-form-wrap');
  if (!wrap) return;
  const hidden = wrap.classList.contains('hidden');
  wrap.classList.toggle('hidden', !hidden);
  if (hidden) wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}
function setFinType(type) {
  document.getElementById('fin-type-val').value = type;
  const incBtn = document.getElementById('fin-income-btn');
  const expBtn = document.getElementById('fin-expense-btn');
  if (type === 'income') {
    incBtn.style.cssText = 'background:rgba(16,185,129,0.2);color:#6ee7b7;border:2px solid rgba(16,185,129,0.4);padding:8px;border-radius:12px;font-size:0.75rem;font-weight:800;transition:background 80ms ease,color 80ms ease,border-color 80ms ease';
    expBtn.style.cssText = 'background:rgba(255,255,255,0.05);color:#64748b;border:2px solid rgba(255,255,255,0.08);padding:8px;border-radius:12px;font-size:0.75rem;font-weight:800;transition:background 80ms ease,color 80ms ease,border-color 80ms ease';
  } else {
    expBtn.style.cssText = 'background:rgba(239,68,68,0.2);color:#fca5a5;border:2px solid rgba(239,68,68,0.4);padding:8px;border-radius:12px;font-size:0.75rem;font-weight:800;transition:background 80ms ease,color 80ms ease,border-color 80ms ease';
    incBtn.style.cssText = 'background:rgba(255,255,255,0.05);color:#64748b;border:2px solid rgba(255,255,255,0.08);padding:8px;border-radius:12px;font-size:0.75rem;font-weight:800;transition:background 80ms ease,color 80ms ease,border-color 80ms ease';
  }
}

/* ── Auto-open finance form if redirected with #finance hash ── */
if (window.location.hash === '#finance') {
  document.addEventListener('DOMContentLoaded', () => {
    const wrap = document.getElementById('finance-form-wrap');
    if (wrap) wrap.classList.remove('hidden');
    document.getElementById('finance')?.scrollIntoView({ behavior: 'smooth' });
  });
}
  (function() {
    const eventId  = "{{event.id}}";
    const origin   = window.location.origin;
    const eventUrl = origin + "/events/" + eventId;

    document.getElementById("qr-url-display").textContent = eventUrl;

    QRCode.toCanvas(
      document.getElementById("event-qr-canvas"),
      eventUrl,
      {
        width:            160,
        margin:           2,
        color: { dark: "#1e1b4b", light: "#ffffff" },
        errorCorrectionLevel: "M",
      },
      function(err) {
        if (err) console.error("QR generation error:", err);
      }
    );

    window.downloadQR = function() {
      const canvas = document.getElementById("event-qr-canvas");
      const link   = document.createElement("a");
      link.download = "event-qr-{{event.id}}.png";
      link.href     = canvas.toDataURL("image/png");
      link.click();
    };

    window.copyEventUrl = function() {
      navigator.clipboard.writeText(eventUrl).then(function() {
        const btn = event.target.closest("button");
        const orig = btn.innerHTML;
        btn.innerHTML = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
        setTimeout(function() { btn.innerHTML = orig; }, 1800);
      });
    };
  })();
</script>

<script>
/* ── Timer-end finance auto-record ── */
window._timerEndRecorded = false;
window._onTimerEventEnd = function() {
  if (window._timerEndRecorded) return;
  window._timerEndRecorded = true;
  const timerEl = document.getElementById('event-meta');
  if (!timerEl) return;
  const eventId = timerEl.dataset.eventId;
  if (!eventId) return;
  fetch('/events/' + eventId + '/finance', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    body: JSON.stringify({
      type:        'income',
      category:    'Other',
      description: 'Event ended (auto-recorded by Stage Timer)',
      amount:      0,
    }),
  }).catch(() => {});
};
</script>
<!-- ── Add Judge Modal ── -->
<!-- ── Assign Judge Modal ── -->
<div id="add-judge-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4"
  style="background:rgba(0,0,0,0.7);backdrop-filter:blur(4px)">
  <div class="w-full max-w-md rounded-2xl overflow-hidden shadow-2xl"
    style="background:#111827;border:1px solid rgba(99,102,241,0.3);max-height:90vh;overflow-y:auto;max-width:calc(100vw - 32px)">
    <!-- Header -->
    <div class="px-6 py-4 flex items-center justify-between"
      style="border-bottom:1px solid rgba(255,255,255,0.07);background:rgba(99,102,241,0.08)">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center"
          style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <h3 class="font-extrabold text-sm" style="color:#e2e8f0">Assign Judge</h3>
          <p class="text-[11px]" style="color:#64748b">Select an existing judge to assign to this event</p>
        </div>
      </div>
      <button onclick="closeAddJudgeModal()" class="w-8 h-8 rounded-lg flex items-center justify-center transition hover:bg-white/10" style="color:#64748b">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Assigned judges list -->
    {{#if assignedJudges.length}}
    <div class="px-6 pt-4">
      <p class="text-xs font-bold uppercase tracking-wider mb-2" style="color:#64748b">Currently Assigned</p>
      <div class="space-y-2 mb-4">
        {{#each assignedJudges}}
        <div class="flex items-center justify-between px-3 py-2 rounded-xl" style="background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.2)">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-black" style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">{{name.[0]}}</div>
            <div>
              <div class="text-xs font-bold" style="color:#e2e8f0">{{name}}</div>
              <div class="text-[10px]" style="color:#64748b">{{email}}</div>
            </div>
          </div>
          <form method="POST" action="/events/{{../event.id}}/judges/{{id}}/remove" class="inline">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button type="submit" class="text-[10px] font-bold px-2.5 py-1 rounded-lg transition" style="background:rgba(239,68,68,0.12);color:#fca5a5;border:1px solid rgba(239,68,68,0.2)">Remove</button>
          </form>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    <!-- Assign from available judges -->
    <form method="POST" action="/events/{{event.id}}/judges/assign" class="px-6 py-4 space-y-3">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
      {{#if availableJudges.length}}
      <p class="text-xs font-bold uppercase tracking-wider" style="color:#64748b">Add Judge</p>
      <select name="judgeId" required class="form-input-bare w-full">
        <option value="">— Select a judge —</option>
        {{#each availableJudges}}
        <option value="{{id}}">{{name}} ({{email}})</option>
        {{/each}}
      </select>
      <div class="flex gap-3 pt-1">
        <button type="submit" class="flex-1 py-2.5 rounded-xl font-bold text-sm text-white transition hover:opacity-90"
          style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
          Assign Judge
        </button>
        <button type="button" onclick="closeAddJudgeModal()" class="px-5 py-2.5 rounded-xl font-bold text-sm transition"
          style="background:rgba(255,255,255,0.06);color:#94a3b8;border:1px solid rgba(255,255,255,0.1)">Cancel</button>
      </div>
      {{else}}
      <div class="py-4 text-center text-xs" style="color:#475569">
        All judges are already assigned, or no judge accounts exist yet.
        <br><a href="/users" class="text-indigo-400 font-semibold mt-1 inline-block">Create judge accounts in Users →</a>
      </div>
      <div class="flex justify-end pb-2">
        <button type="button" onclick="closeAddJudgeModal()" class="px-5 py-2.5 rounded-xl font-bold text-sm transition"
          style="background:rgba(255,255,255,0.06);color:#94a3b8;border:1px solid rgba(255,255,255,0.1)">Close</button>
      </div>
      {{/if}}
    </form>
  </div>
</div>

<!-- ── Dropdown content (portaled to body via JS to avoid overflow clipping) ── -->
<div id="admin-more-content" data-dropdown style="display:none;background:#111827;border:1px solid rgba(255,255,255,0.12);border-radius:12px;overflow:hidden;min-width:190px;box-shadow:0 12px 40px rgba(0,0,0,0.7)">
  <a href="/events/{{event.id}}/edit" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit Event</a>
  <button type="button" onclick="openAddJudgeModal();closeDropdown('admin-more')" class="dropdown-item w-full text-left"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Assign Judge</button>
  <a href="/events/{{event.id}}/criteria" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg> Criteria</a>
  <a href="/events/{{event.id}}/display" target="_blank" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg> Display Board</a>
  <a href="/events/{{event.id}}/public" target="_blank" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> Public Results</a>
  <a href="/events/{{event.id}}/self-register" target="_blank" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg> Reg QR</a>
  <a href="/events/{{event.id}}/report" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/><line x1="9" y1="19" x2="11" y2="19"/></svg> Report</a>
  <a href="/events/{{event.id}}/results/export" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Export CSV</a>
  <a href="/analytics?eventId={{event.id}}" class="dropdown-item" style="color:#c4b5fd"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg> AI Score Audit</a>
  <form method="POST" action="/events/{{event.id}}/lock"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button type="submit" class="dropdown-item w-full text-left {{#if event.scoringLocked}}" style="color:#fca5a5{{/if}}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> {{#if event.scoringLocked}}Unlock Scores{{else}}Lock Scores{{/if}}</button></form>
  {{#if event.isPaymentType}}<a href="#finance" onclick="document.getElementById('finance')?.scrollIntoView({behavior:'smooth'});closeDropdown('admin-more')" class="dropdown-item" style="color:#6ee7b7"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg> Finance</a>{{/if}}
  <a href="/events/{{event.id}}/vote/qr" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> Audience Voting</a>
  <form method="POST" action="/events/{{event.id}}/vote/toggle"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button type="submit" class="dropdown-item w-full text-left"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> {{#if event.votingOpen}}Close Voting{{else}}Open Voting{{/if}}</button></form>
  <div style="height:1px;background:rgba(255,255,255,0.07);margin:4px 0"></div>
  <form method="POST" action="/events/{{event.id}}/delete" onsubmit="return confirm('Delete this event? This cannot be undone.')"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button type="submit" class="dropdown-item w-full text-left" style="color:#fca5a5"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg> Delete Event</button></form>
</div>

<div id="org-more-content" data-dropdown style="display:none;background:#111827;border:1px solid rgba(255,255,255,0.12);border-radius:12px;overflow:hidden;min-width:190px;box-shadow:0 12px 40px rgba(0,0,0,0.7)">
  <a href="/events/{{event.id}}/edit" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit Event</a>
  <button type="button" onclick="openAddJudgeModal();closeDropdown('org-more')" class="dropdown-item w-full text-left"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Assign Judge</button>
  <a href="/events/{{event.id}}/criteria" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg> Criteria</a>
  <a href="/events/{{event.id}}/display" target="_blank" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg> Display Board</a>
  <a href="/events/{{event.id}}/public" target="_blank" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg> Public Results</a>
  <a href="/events/{{event.id}}/self-register" target="_blank" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg> Reg QR</a>
  <a href="/events/{{event.id}}/report" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/><line x1="9" y1="19" x2="11" y2="19"/></svg> Report</a>
  <a href="/events/{{event.id}}/results/export" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Export CSV</a>
  {{#if event.isPaymentType}}<a href="#finance" onclick="document.getElementById('finance')?.scrollIntoView({behavior:'smooth'});closeDropdown('org-more')" class="dropdown-item" style="color:#6ee7b7"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg> Finance</a>{{/if}}
  <a href="/events/{{event.id}}/vote/qr" class="dropdown-item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> Audience Voting</a>
  <form method="POST" action="/events/{{event.id}}/vote/toggle"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button type="submit" class="dropdown-item w-full text-left"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg> {{#if event.votingOpen}}Close Voting{{else}}Open Voting{{/if}}</button></form>
  <div style="height:1px;background:rgba(255,255,255,0.07);margin:4px 0"></div>
  <form method="POST" action="/events/{{event.id}}/delete" onsubmit="return confirm('Delete this event? This cannot be undone.')"><input type="hidden" name="_csrf" value="{{csrfToken}}"><button type="submit" class="dropdown-item w-full text-left" style="color:#fca5a5"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg> Delete Event</button></form>
</div>

<script>
function openAddJudgeModal() {
  // Close all dropdowns first
  if (window._portal) {
    window._portal.querySelectorAll('[data-dropdown]').forEach(function(d) { d.style.display = 'none'; });
    window._portal.style.pointerEvents = 'none';
  }
  const m = document.getElementById('add-judge-modal');
  m.classList.remove('hidden');
  m.style.display = 'flex';
  var focusEl = m.querySelector('select, input[type="text"]');
  if (focusEl) focusEl.focus();
}
function closeAddJudgeModal() {
  const m = document.getElementById('add-judge-modal');
  m.classList.add('hidden');
  m.style.display = '';
}
document.getElementById('add-judge-modal').addEventListener('click', function(e) {
  if (e.target === this) closeAddJudgeModal();
});
</script>

{{> footer }}
</body>
</html>
