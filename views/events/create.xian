];

let _multiCategoryEnabled = false;

window.toggleMultiCategory = function() {
  _multiCategoryEnabled = !_multiCategoryEnabled;
  const preview = document.getElementById('multi-cat-preview');
  const flatSection = document.getElementById('flat-criteria-section');
  const btn = document.getElementById('multi-cat-btn');
  const hiddenInput = document.getElementById('use-multi-cat');

  if (_multiCategoryEnabled) {
    preview.classList.remove('hidden');
    flatSection.classList.add('hidden');
    btn.textContent = 'Disable';
    btn.style.background = 'rgba(239,68,68,0.12)';
    btn.style.color = '#fca5a5';
    btn.style.borderColor = 'rgba(239,68,68,0.3)';
    hiddenInput.value = JSON.stringify(MULTI_CATEGORY_TEMPLATE);
  } else {
    preview.classList.add('hidden');
    flatSection.classList.remove('hidden');
    btn.textContent = 'Enable';
    btn.style.background = 'rgba(99,102,241,0.12)';
    btn.style.color = '#a5b4fc';
    btn.style.borderColor = 'rgba(99,102,241,0.3)';
    hiddenInput.value = '';
  }
};

window.addCriteriaRow = function() {
  _criteriaRows.push({ name: '', weight: 0, max: 100 });
  renderCriteriaRows();
};

window.removeCriteriaRow = function(i) {
  _criteriaRows.splice(i, 1);
  renderCriteriaRows();
};

function loadPreset(type) {
  _criteriaRows = (CRITERIA_PRESETS[type] || CRITERIA_PRESETS.other).map(r => ({ ...r }));
  renderCriteriaRows();
}

// Hook into the existing handleEventType function
const _origHandleEventType = handleEventType;
handleEventType = function(sel) {
  _origHandleEventType(sel);
  loadPreset(sel.value);
};

document.addEventListener('DOMContentLoaded', () => {
  const sel = document.getElementById('event-type-select');
  if (sel) loadPreset(sel.value);
});
</script>
