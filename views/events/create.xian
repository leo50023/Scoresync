    { name: 'Cleanliness',      weight: 20, max: 100 },
  ],
  talent: [
    { name: 'Skill & Technique',weight: 35, max: 100 },
    { name: 'Originality',      weight: 25, max: 100 },
    { name: 'Stage Presence',   weight: 25, max: 100 },
    { name: 'Audience Impact',  weight: 15, max: 100 },
  ],
  other: [
    { name: 'Criteria 1',       weight: 34, max: 100 },
    { name: 'Criteria 2',       weight: 33, max: 100 },
    { name: 'Criteria 3',       weight: 33, max: 100 },
  ],
};

let _criteriaRows = [];

function renderCriteriaRows() {
  const container = document.getElementById('criteria-rows');
  if (!container) return;
  container.innerHTML = '';
  _criteriaRows.forEach((row, i) => {
    const div = document.createElement('div');
    div.className = 'flex items-center gap-2';
    div.innerHTML = `
      <input type="text" name="criteria[name]" value="${row.name}"
        placeholder="Criteria name" required
        oninput="_criteriaRows[${i}].name=this.value"
        class="form-input-bare flex-1 text-xs py-2" style="min-width:0;border-radius:12px"/>
      <input type="number" name="criteria[weight]" value="${row.weight}"
        min="1" max="100" placeholder="%" required
        oninput="_criteriaRows[${i}].weight=Number(this.value)||0;updateWeightBadge()"
        class="form-input-bare text-xs py-2 text-center" style="width:76px;min-width:76px;border-radius:12px"/>
      <input type="number" name="criteria[max]" value="${row.max}"
        min="1" placeholder="Max" required
        oninput="_criteriaRows[${i}].max=Number(this.value)||100"
        class="form-input-bare text-xs py-2 text-center" style="width:76px;min-width:76px;border-radius:12px"/>
      <input type="hidden" name="criteria[desc]" value=""/>
      <button type="button" onclick="removeCriteriaRow(${i})"
        class="flex-shrink-0 w-7 h-7 flex items-center justify-center rounded-full text-xs transition"
        style="background:rgba(239,68,68,0.12);color:#fca5a5;border:1px solid rgba(239,68,68,0.25)">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>`;
    container.appendChild(div);
  });
  updateWeightBadge();
}

function updateWeightBadge() {
  const total = _criteriaRows.reduce((s, r) => s + (Number(r.weight) || 0), 0);
  const badge = document.getElementById('criteria-weight-badge');
  if (!badge) return;
  badge.textContent = total + ' / 100%';
  const ok = total === 100;
  badge.style.background    = ok ? 'rgba(16,185,129,0.15)' : 'rgba(139,92,246,0.15)';
  badge.style.color         = ok ? '#6ee7b7'               : '#c4b5fd';
  badge.style.borderColor   = ok ? 'rgba(16,185,129,0.3)'  : 'rgba(139,92,246,0.3)';
}

// ── Multi-category template toggle ──────────────────────────────────────────
