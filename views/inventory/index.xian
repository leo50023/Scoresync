{{> head }}
<body class="min-h-screen flex flex-col ss-page-bg">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

  {{#if success_msg}}<div class="alert-success animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg>{{error_msg}}</div>{{/if}}

  <!-- �� Page Header �� -->
  <div class="flex items-center justify-between animate-fadeup">
    <div class="page-header mb-0">
      <div class="breadcrumb"><a href="/dashboard">Dashboard</a></div>
      <h1>Ticket Sales &amp; Income</h1>
      <p>Payment updates and income tracking per event.</p>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <!-- Event filter -->
      <form method="GET" action="/inventory">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <select name="eventId" onchange="this.form.submit()" class="form-input-bare text-sm" style="min-width:180px">
          <option value="">� All Events �</option>
          {{#each events}}
          <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </form>
      {{#if filterEventId}}
      <a href="/inventory" class="btn-sm btn-sm-gray text-xs">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        Clear
      </a>
      <a href="/inventory/export?eventId={{filterEventId}}" class="btn-sm btn-sm-green text-xs">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        CSV
      </a>
      {{/if}}
      {{#if isAdmin}}
      <button onclick="openAddModal()" class="btn-primary text-sm">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Record
      </button>
      {{/if}}
    </div>
  </div>

  <!-- �� KPI Cards Row �� -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-fadeup-1">

    <!-- Total Income -->
    <div class="card-flat p-5 relative overflow-hidden">
      <div class="absolute inset-0 rounded-2xl pointer-events-none" style="background:linear-gradient(135deg,rgba(16,185,129,0.07),transparent)"></div>
      <div class="relative">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center grad-green">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wide">Total Income</span>
          </div>
          <span class="badge badge-green text-[10px]">+{{items.length}} entries</span>
        </div>
        <div class="text-3xl font-black" style="color:var(--text-primary)">?{{totalValue}}</div>
        <div class="mt-3 h-10" id="sparkline-income"></div>
      </div>
    </div>

    <!-- Tickets Sold -->
    <div class="card-flat p-5 relative overflow-hidden">
      <div class="absolute inset-0 rounded-2xl pointer-events-none" style="background:linear-gradient(135deg,rgba(245,158,11,0.07),transparent)"></div>
      <div class="relative">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center grad-gold">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/></svg>
            </div>
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wide">Tickets Sold</span>
          </div>
          <span class="badge badge-yellow text-[10px]">{{items.length}} records</span>
        </div>
        <div class="text-3xl font-black text-slate-900 tracking-tight">{{totalItems}}</div>
        <div class="mt-3 h-10" id="sparkline-tickets"></div>
      </div>
    </div>

    <!-- Avg per Ticket -->
    <div class="card-flat p-5 relative overflow-hidden">
      <div class="absolute inset-0 rounded-2xl pointer-events-none" style="background:linear-gradient(135deg,rgba(99,102,241,0.07),transparent)"></div>
      <div class="relative">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center grad-purple">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wide">Avg per Ticket</span>
          </div>
          <span class="badge badge-purple text-[10px]">average</span>
        </div>
        <div class="text-3xl font-black text-slate-900 tracking-tight" id="kpi-avg">?0.00</div>
        <div class="mt-3 h-10" id="sparkline-avg"></div>
      </div>
    </div>

  </div>

  <!-- �� Main Content: Chart + Type Breakdown | Recent Records �� -->
  <div class="grid lg:grid-cols-3 gap-5 animate-fadeup-1">

    <!-- LEFT 2/3: Bar Chart + Records Table -->
    <div class="lg:col-span-2 space-y-5">

      <!-- Income Bar Chart -->
      <div class="card-flat p-5">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="font-extrabold text-base" style="color:var(--text-primary)">Income by Record</h2>
            <p class="text-xs mt-0.5" style="color:var(--text-muted)">All ticket sales entries � bar height = total income</p>
          </div>
          <span class="badge badge-green text-xs" id="chart-total-badge">?{{totalValue}} total</span>
        </div>
        <div style="height:200px;position:relative">
          <canvas id="income-bar-chart"></canvas>
        </div>
      </div>

      <!-- Recent Records Table -->
      <div class="section-card">
        <div class="section-header">
          <h2>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/></svg>
            {{#if selectedEvent}}{{selectedEvent.name}} � Records{{else}}All Records{{/if}}
            <span class="ml-2 badge badge-green text-[10px]">{{items.length}}</span>
          </h2>
          {{#if isAdmin}}
          <button onclick="openAddModal()" class="btn-primary btn-sm text-xs px-3 py-1.5">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add
          </button>
          {{/if}}
        </div>

        {{#if items.length}}
        <div class="divide-y" style="border-color:rgba(255,255,255,0.05)">
          {{#each items}}
          <div class="px-5 py-3.5 flex items-center justify-between transition group"
            onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
            <div class="flex items-center gap-3">
              {{#if photo}}
              <img src="{{photo}}" alt="" class="w-9 h-9 rounded-xl object-cover flex-shrink-0" style="border:1px solid rgba(255,255,255,0.1)"/>
              {{else}}
              <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.2)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/></svg>
              </div>
              {{/if}}
              <div>
                <div class="font-semibold text-sm" style="color:var(--text-primary)">{{ticketType}}</div>
                <div class="text-xs mt-0.5" style="color:var(--text-muted)">
                  {{#unless ../filterEventId}}{{eventName}} &bull; {{/unless}}
                  {{quantity}} × ?{{unitPrice}}
                  {{#if notes}} &bull; {{notes}}{{/if}}
                </div>
              </div>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0">
              <span class="font-extrabold text-emerald-400 text-sm">+?{{totalValue}}</span>
              {{#if ../isAdmin}}
              <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition">
                <button type="button"
                  onclick="openEditModal('{{id}}','{{ticketType}}','{{quantity}}','{{unitPrice}}','{{notes}}','{{eventId}}','{{photo}}')"
                  class="btn-sm btn-sm-gray text-xs px-2 py-1">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
                <form method="POST" action="/inventory/{{id}}/delete" class="inline" onsubmit="return confirm('Remove?')">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
                  <input type="hidden" name="eventId" value="{{eventId}}"/>
                  <button class="btn-sm btn-sm-red text-xs px-2 py-1">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                  </button>
                </form>
              </div>
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        <!-- Footer total -->
        <div class="px-5 py-3 flex items-center justify-between" style="border-top:1px solid var(--border);background:rgba(16,185,129,0.05)">
          <span class="text-xs font-extrabold uppercase tracking-wide" style="color:var(--text-muted)">Total · {{totalItems}} tickets</span>
          <span class="font-black text-emerald-400 text-base">?{{totalValue}}</span>
        </div>

        {{else}}
        <div class="py-14 text-center text-slate-400 text-sm">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#e2e8f0" stroke-width="1.5" class="mx-auto mb-4"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/></svg>
          <p class="font-semibold text-slate-500 mb-1">{{#if filterEventId}}No records for this event yet.{{else}}No ticket sales records yet.{{/if}}</p>
          <p class="text-xs text-slate-400 mb-5">{{#if filterEventId}}Add ticket types and sales to track income.{{else}}Select an event or add your first record.{{/if}}</p>
          {{#if isAdmin}}
          <button onclick="openAddModal()" class="btn-primary inline-flex">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Add First Record
          </button>
          {{/if}}
        </div>
        {{/if}}
      </div>
    </div>

    <!-- RIGHT 1/3: Donut breakdown + top types -->
    <div class="space-y-5">

      <!-- Donut: Income breakdown by type -->
      <div class="card-flat p-5">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-extrabold text-sm" style="color:var(--text-primary)">Income Breakdown</h2>
          <span class="text-xs text-slate-400">by type</span>
        </div>
        <div class="flex items-center justify-center my-2" style="height:160px;position:relative">
          <canvas id="income-donut"></canvas>
          <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
            <div class="text-xs font-bold text-slate-400">Total</div>
            <div class="text-xl font-black" style="color:var(--text-primary)" id="donut-center">?{{totalValue}}</div>
          </div>
        </div>
        <div id="donut-legend" class="space-y-2 mt-4"></div>
      </div>

      <!-- Top ticket types list -->
      <div class="section-card">
        <div class="section-header">
          <h2>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            Recent Sales
          </h2>
          <span class="text-xs text-slate-400">See All</span>
        </div>
        {{#if items.length}}
        <div class="divide-y divide-slate-50">
          {{#each items}}
          {{#if @first}}
          <div class="px-5 py-3.5 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0 grad-green shadow-sm">
                {{#if photo}}<img src="{{photo}}" class="w-full h-full rounded-full object-cover"/>{{else}}?{{/if}}
              </div>
              <div>
                <div class="font-semibold text-sm" style="color:var(--text-primary)">{{ticketType}}</div>
                <div class="text-slate-400 text-xs">just now</div>
              </div>
            </div>
            <span class="font-extrabold text-emerald-600 text-sm">+?{{totalValue}}</span>
          </div>
          {{/if}}
          {{#unless @first}}
          {{#if @index}}
          {{#if (lte @index 6)}}
          <div class="px-5 py-3 flex items-center justify-between transition"
            onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0 grad-blue shadow-sm">
                {{#if photo}}<img src="{{photo}}" class="w-full h-full rounded-full object-cover"/>{{else}}T{{/if}}
              </div>
              <div>
                <div class="font-semibold text-sm" style="color:var(--text-primary)">{{ticketType}}</div>
                <div class="text-xs" style="color:var(--text-muted)">{{#unless ../filterEventId}}{{eventName}}{{/unless}}</div>
              </div>
            </div>
            <span class="font-extrabold text-emerald-400 text-sm">+?{{totalValue}}</span>
          </div>
          {{/if}}
          {{/if}}
          {{/unless}}
          {{/each}}
        </div>
        {{else}}
        <div class="px-5 py-8 text-center text-slate-400 text-sm">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#e2e8f0" stroke-width="1.5" class="mx-auto mb-2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/></svg>
          No sales yet
        </div>
        {{/if}}
      </div>

    </div>
  </div>

</main>
</div>

<!-- ══ ADD RECORD MODAL ══ -->
<div id="add-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden" style="background:rgba(0,0,0,0.65);backdrop-filter:blur(4px)">
  <div class="card-flat w-full max-w-md mx-4 shadow-2xl">
    <div class="px-6 py-4 flex items-center gap-3" style="border-bottom:1px solid var(--border)">
      <div class="w-8 h-8 grad-green rounded-lg flex items-center justify-center shadow-sm">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </div>
      <div>
        <h3 class="font-bold" style="color:var(--text-primary)">Add Ticket / Income Record</h3>
        <p class="text-xs" style="color:var(--text-muted)">Record ticket sales or other income</p>
      </div>
      <button onclick="closeAddModal()" class="ml-auto transition" style="color:var(--text-muted)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form method="POST" action="/inventory" class="px-6 py-5 space-y-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Event <span class="text-red-500">*</span></label>
        <select name="eventId" required class="form-input-bare">
          <option value="">Select an event�</option>
          {{#each events}}
          <option value="{{id}}" {{#if (eq id ../filterEventId)}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Ticket / Income Type <span class="text-red-500">*</span></label>
        <input type="text" name="ticketType" placeholder="e.g. General Admission, VIP, Sponsor Fee�" required class="form-input-bare"/>
      </div>
      <!-- Quick presets -->
      <div class="flex flex-wrap gap-1.5">
        <button type="button" onclick="setTicketType('General Admission')" class="preset-pill">General Admission</button>
        <button type="button" onclick="setTicketType('VIP Ticket')"        class="preset-pill">VIP Ticket</button>
        <button type="button" onclick="setTicketType('Student Ticket')"    class="preset-pill">Student Ticket</button>
        <button type="button" onclick="setTicketType('Sponsor Fee')"       class="preset-pill">Sponsor Fee</button>
        <button type="button" onclick="setTicketType('Registration Fee')"  class="preset-pill">Registration Fee</button>
        <button type="button" onclick="setTicketType('Donation')"          class="preset-pill">Donation</button>
        <button type="button" onclick="setTicketType('Merchandise')"       class="preset-pill">Merchandise</button>
        <button type="button" onclick="setTicketType('LGU Grant')"         class="preset-pill">LGU Grant</button>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Quantity</label>
          <input type="number" name="quantity" value="1" min="0" class="form-input-bare" oninput="calcPreview()"/>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Unit Price (?)</label>
          <input type="number" name="unitPrice" placeholder="0.00" min="0" step="0.01" id="add-unit-price" oninput="calcPreview()" class="form-input-bare"/>
        </div>
      </div>
      <!-- Live total -->
      <div class="flex items-center justify-between px-4 py-3 rounded-xl" style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.2)">
        <span class="text-xs font-semibold" style="color:#6ee7b7">Estimated Total</span>
        <span id="add-total-preview" class="font-extrabold text-base" style="color:#6ee7b7">?0.00</span>
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Attachment <span class="font-normal text-[10px] normal-case" style="color:var(--text-faint)">optional</span></label>
        <div id="inv-photo-dropzone" onclick="document.getElementById('inv-photo-file').click()"
          class="flex items-center gap-3 px-4 py-3 rounded-xl cursor-pointer border-2 border-dashed transition"
          style="border-color:rgba(16,185,129,0.3);background:rgba(16,185,129,0.06)"
          onmouseover="this.style.background='rgba(16,185,129,0.1)'" onmouseout="this.style.background='rgba(16,185,129,0.06)'">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <div>
            <div class="text-xs font-semibold" style="color:#6ee7b7">Upload receipt / QR</div>
            <div class="text-[10px]" style="color:var(--text-muted)">PNG/JPG · max 2MB</div>
          </div>
        </div>
        <input type="file" id="inv-photo-file" accept="image/*" class="hidden" onchange="handleInvPhoto(this)"/>
        <input type="hidden" name="photo" id="inv-photo-b64"/>
        <div id="inv-photo-preview" class="hidden mt-2 flex items-center gap-3">
          <img id="inv-photo-img" src="" alt="" class="w-12 h-12 rounded-xl object-cover" style="border:1px solid rgba(255,255,255,0.1)"/>
          <button type="button" onclick="clearInvPhoto()" class="btn-sm btn-sm-red text-xs">Remove</button>
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Notes</label>
        <textarea name="notes" rows="2" placeholder="e.g. Sold at gate, online pre-sale�" class="form-input-bare resize-none"></textarea>
      </div>
      <div class="flex gap-3 pt-1">
        <button type="submit" class="btn-sm btn-solid-green flex-1 justify-center">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Save Record
        </button>
        <button type="button" onclick="closeAddModal()" class="btn-secondary px-5 py-2.5 text-sm">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- ══ EDIT MODAL ══ -->
<div id="edit-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden" style="background:rgba(0,0,0,0.65);backdrop-filter:blur(4px)">
  <div class="card-flat w-full max-w-md mx-4 shadow-2xl">
    <div class="px-6 py-4 flex items-center justify-between" style="border-bottom:1px solid var(--border)">
      <h3 class="font-bold" style="color:var(--text-primary)">Edit Record</h3>
      <button onclick="closeEditModal()" class="transition" style="color:var(--text-muted)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <form id="edit-form" method="POST" action="" class="px-6 py-5 space-y-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="eventId" id="edit-eventId"/>
      <input type="hidden" name="photo"   id="edit-photo-b64"/>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Type <span class="text-red-500">*</span></label>
        <input type="text" name="ticketType" id="edit-ticketType" required class="form-input-bare"/>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Quantity</label>
          <input type="number" name="quantity" id="edit-quantity" min="0" class="form-input-bare"/>
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Unit Price (?)</label>
          <input type="number" name="unitPrice" id="edit-unitPrice" min="0" step="0.01" class="form-input-bare"/>
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Notes</label>
        <textarea name="notes" id="edit-notes" rows="2" class="form-input-bare resize-none"></textarea>
      </div>
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--text-muted)">Attachment</label>
        <div id="edit-photo-existing" class="hidden mb-2">
          <img id="edit-photo-img" src="" alt="" class="w-12 h-12 rounded-lg object-cover" style="border:1px solid rgba(255,255,255,0.1)"/>
        </div>
        <div class="flex gap-2">
          <button type="button" onclick="document.getElementById('edit-photo-file').click()" class="btn-sm btn-sm-gray text-xs flex-1 justify-center">Replace</button>
          <button type="button" onclick="clearEditPhoto()" class="btn-sm btn-sm-red text-xs">Remove</button>
        </div>
        <input type="file" id="edit-photo-file" accept="image/*" class="hidden" onchange="handleEditPhoto(this)"/>
      </div>
      <div class="flex gap-2 pt-1">
        <button type="submit" class="btn-primary flex-1 py-2.5 text-sm justify-center">Save Changes</button>
        <button type="button" onclick="closeEditModal()" class="btn-secondary px-5 py-2.5 text-sm">Cancel</button>
      </div>
    </form>
  </div>
</div>

<style>
.preset-pill {
  padding:4px 10px; border-radius:999px; font-size:0.7rem; font-weight:700;
  cursor:pointer; transition:all 0.15s;
  background:rgba(255,255,255,0.06); color:#94a3b8; border:1px solid rgba(255,255,255,0.1);
}
.preset-pill:hover { background:rgba(16,185,129,0.12); color:#6ee7b7; border-color:rgba(16,185,129,0.3); }
</style>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
/* �� Build chart data from server items �� */
const ITEMS = [
  {{#each items}}
  { label: "{{ticketType}}", total: {{totalValue}}, qty: {{quantity}}, price: {{unitPrice}} },
  {{/each}}
];

const TOTAL_VALUE = {{#if totalValue}}{{totalValue}}{{else}}0{{/if}};
const TOTAL_QTY   = {{#if totalItems}}{{totalItems}}{{else}}0{{/if}};

/* �� KPI avg �� */
const avgEl = document.getElementById('kpi-avg');
if (avgEl) {
  const avg = TOTAL_QTY > 0 ? (TOTAL_VALUE / TOTAL_QTY) : 0;
  avgEl.textContent = '?' + avg.toLocaleString('en-PH', {minimumFractionDigits:2, maximumFractionDigits:2});
}

/* �� Colour palette �� */
const COLORS = ['#10b981','#f59e0b','#6366f1','#ef4444','#3b82f6','#8b5cf6','#ec4899','#14b8a6'];

/* �� Bar chart �� */
const barCtx = document.getElementById('income-bar-chart');
if (barCtx && ITEMS.length) {
  new Chart(barCtx, {
    type: 'bar',
    data: {
      labels: ITEMS.map(i => i.label.length > 16 ? i.label.slice(0,14)+'�' : i.label),
      datasets: [{
        data:            ITEMS.map(i => i.total),
        backgroundColor: ITEMS.map((_, idx) => COLORS[idx % COLORS.length] + '33'),
        borderColor:     ITEMS.map((_, idx) => COLORS[idx % COLORS.length]),
        borderWidth:     2,
        borderRadius:    8,
        borderSkipped:   false,
      }],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: {
        callbacks: { label: ctx => ' ?' + ctx.parsed.y.toLocaleString('en-PH', {minimumFractionDigits:2}) }
      }},
      scales: {
        x: { grid: { display: false }, ticks: { font: { size: 11, weight: '600' }, color: '#94a3b8' } },
        y: { grid: { color: '#f1f5f9' }, ticks: {
          font: { size: 11 }, color: '#94a3b8',
          callback: v => '?' + (v >= 1000 ? (v/1000).toFixed(0)+'K' : v)
        }},
      },
    },
  });
} else if (barCtx) {
  barCtx.parentElement.innerHTML = '<div class="flex items-center justify-center h-full text-slate-300 text-sm font-semibold">No data yet</div>';
}

/* �� Donut chart �� */
const donutCtx = document.getElementById('income-donut');
if (donutCtx && ITEMS.length) {
  // Group by label
  const grouped = {};
  ITEMS.forEach(i => { grouped[i.label] = (grouped[i.label]||0) + i.total; });
  const labels = Object.keys(grouped);
  const values = Object.values(grouped);

  new Chart(donutCtx, {
    type: 'doughnut',
    data: {
      labels,
      datasets: [{ data: values, backgroundColor: COLORS.slice(0, labels.length), borderWidth: 3, borderColor: '#fff', hoverOffset: 6 }],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      cutout: '70%',
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => ' ?' + ctx.parsed.toLocaleString('en-PH', {minimumFractionDigits:2}) } }
      },
    },
  });

  /* Legend */
  const legend = document.getElementById('donut-legend');
  if (legend) {
    labels.forEach((lbl, i) => {
      const pct = TOTAL_VALUE > 0 ? ((values[i]/TOTAL_VALUE)*100).toFixed(0) : 0;
      legend.innerHTML += `
        <div class="flex items-center justify-between text-xs">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background:${COLORS[i%COLORS.length]}"></span>
            <span class="font-semibold truncate max-w-[110px]" style="color:var(--text-secondary)">${lbl}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-bold" style="color:var(--text-primary)">?${values[i].toLocaleString('en-PH',{minimumFractionDigits:2})}</span>
            <span class="text-slate-400">${pct}%</span>
          </div>
        </div>`;
    });
  }
} else if (donutCtx) {
  donutCtx.parentElement.innerHTML = '<div class="flex items-center justify-center h-full text-slate-300 text-sm font-semibold">No data</div>';
}

/* �� Sparklines (mini bar) �� */
['sparkline-income','sparkline-tickets','sparkline-avg'].forEach((id,si) => {
  const el = document.getElementById(id);
  if (!el || !ITEMS.length) return;
  const vals = ITEMS.map(i => si===1 ? i.qty : i.total);
  const max  = Math.max(...vals, 1);
  el.innerHTML = `<svg width="100%" height="40" viewBox="0 0 ${vals.length*12+4} 40" preserveAspectRatio="none">
    ${vals.map((v,i) => {
      const h = Math.max(4, (v/max)*32);
      const colors = ['#10b981','#f59e0b','#6366f1'];
      return `<rect x="${i*12+2}" y="${40-h}" width="8" height="${h}" rx="2" fill="${colors[si]}55"/>`;
    }).join('')}
  </svg>`;
});

/* �� Modals �� */
function openAddModal()  { document.getElementById('add-modal').classList.remove('hidden'); }
function closeAddModal() { document.getElementById('add-modal').classList.add('hidden'); }
document.getElementById('add-modal').addEventListener('click', e => { if(e.target===document.getElementById('add-modal')) closeAddModal(); });

function openEditModal(id, ticketType, qty, unitPrice, notes, eventId, photo) {
  document.getElementById('edit-form').action       = '/inventory/' + id + '/update';
  document.getElementById('edit-ticketType').value  = ticketType;
  document.getElementById('edit-quantity').value    = qty;
  document.getElementById('edit-unitPrice').value   = unitPrice;
  document.getElementById('edit-notes').value       = notes;
  document.getElementById('edit-eventId').value     = eventId;
  document.getElementById('edit-photo-b64').value   = photo || '';
  const imgEl = document.getElementById('edit-photo-img'), imgWrap = document.getElementById('edit-photo-existing');
  if (photo) { imgEl.src = photo; imgWrap.classList.remove('hidden'); } else imgWrap.classList.add('hidden');
  document.getElementById('edit-modal').classList.remove('hidden');
}
function closeEditModal() { document.getElementById('edit-modal').classList.add('hidden'); }
document.getElementById('edit-modal').addEventListener('click', e => { if(e.target===document.getElementById('edit-modal')) closeEditModal(); });

function setTicketType(val) { document.querySelector('[name=ticketType]').value = val; }

function calcPreview() {
  const qty   = parseFloat(document.querySelector('[name=quantity]')?.value || 0);
  const price = parseFloat(document.getElementById('add-unit-price')?.value || 0);
  const el    = document.getElementById('add-total-preview');
  if (el) el.textContent = '?' + (qty*price).toLocaleString('en-PH',{minimumFractionDigits:2});
}
document.querySelector('[name=quantity]')?.addEventListener('input', calcPreview);

function handleInvPhoto(input) {
  const file = input.files[0]; if (!file) return;
  if (file.size > 2*1024*1024) { alert('Max 2MB'); input.value=''; return; }
  const r = new FileReader();
  r.onload = e => {
    document.getElementById('inv-photo-b64').value = e.target.result;
    document.getElementById('inv-photo-img').src   = e.target.result;
    document.getElementById('inv-photo-preview').classList.remove('hidden');
    document.getElementById('inv-photo-dropzone').classList.add('hidden');
  };
  r.readAsDataURL(file);
}
function clearInvPhoto() {
  document.getElementById('inv-photo-b64').value = '';
  document.getElementById('inv-photo-preview').classList.add('hidden');
  document.getElementById('inv-photo-dropzone').classList.remove('hidden');
  document.getElementById('inv-photo-file').value = '';
}
function handleEditPhoto(input) {
  const file = input.files[0]; if (!file) return;
  const r = new FileReader();
  r.onload = e => {
    document.getElementById('edit-photo-b64').value = e.target.result;
    document.getElementById('edit-photo-img').src   = e.target.result;
    document.getElementById('edit-photo-existing').classList.remove('hidden');
  };
  r.readAsDataURL(file);
}
function clearEditPhoto() {
  document.getElementById('edit-photo-b64').value = '';
  document.getElementById('edit-photo-existing').classList.add('hidden');
}
</script>

{{> footer }}
</body>
</html>
