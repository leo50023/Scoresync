<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <link rel="manifest" href="/manifest.json"/>
  <link rel="apple-touch-icon" href="/icon.png?v=7"/>
  <link rel="icon" type="image/png" href="/icon.png?v=7"/>
  <meta name="theme-color" content="#10b981"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
  <meta name="csrf-token" content="{{csrfToken}}"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/fa.embedded.css"/>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <title>{{ title }} — ScoreSync</title>
  <style>
    *, *::before, *::after { font-family: 'Inter', sans-serif; box-sizing: border-box; }
    /* Prevent horizontal overflow at root level */
    html, body { overflow-x: hidden; max-width: 100vw; }
    /* 80ms = ~1.5 frames at 120fps — instant-feel, no perceptible lag */
    a, button { transition: background-color 80ms ease, color 80ms ease, border-color 80ms ease,
                             opacity 80ms ease, box-shadow 80ms ease, transform 80ms ease; }
    /* Larger tap targets on mobile — 44px minimum per WCAG 2.5.5 */
    button, a, [role="button"], label, select { min-height: 44px; }
    /* Remove iOS button styling */
    button, [role="button"], a, label, select {
      -webkit-appearance: none;
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }
    button { cursor: pointer; }
    /* Prevent double-tap zoom on inputs; prevent iOS font bump to 16px+ */
    input, select, textarea {
      font-size: 16px !important;
      min-height: 44px;
      touch-action: manipulation;
    }
    :focus-visible { outline: 2px solid #3b82f6; outline-offset: 2px; border-radius: 6px; }

    /* ── Smooth scrolling + touch ── */
    html { scroll-behavior: smooth; -webkit-tap-highlight-color: transparent; }
    body { background: #0a0f1e; color: #e2e8f0; -webkit-font-smoothing: antialiased; }
    /* GPU compositing for smooth animations */
    .card, .card-flat, .section-card, .kpi-card, .btn-primary, .btn-secondary, .btn-danger {
      will-change: transform;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    /* Prevent horizontal scroll at content level (not body — breaks mobile vertical scroll) */
    main { overflow-x: hidden; }
    /* Active press feedback on ALL buttons */
    button:active, a.btn-primary:active, a.btn-secondary:active, a.btn-sm:active {
      transform: scale(0.97) !important;
      opacity: 0.9 !important;
    }
    /* Smooth image rendering */
    img { image-rendering: -webkit-optimize-contrast; max-width: 100%; height: auto; }

    /* ── Responsive text ── */
    @media (max-width: 480px) {
      .text-5xl { font-size: 1.75rem !important; }
      .text-6xl { font-size: 2rem !important; }
      .px-6, .px-7, .px-8 { padding-left: 1rem !important; padding-right: 1rem !important; }
      .py-6, .py-7, .py-8 { padding-top: 1rem !important; padding-bottom: 1rem !important; }
      .btn-sm { padding: 8px 14px !important; font-size: 0.75rem !important; }
      h1, h2, h3 { word-break: break-word; overflow-wrap: break-word; }
      .grid-cols-2, .grid-cols-3, .grid-cols-4 { grid-template-columns: repeat(2, 1fr) !important; }
      .fixed.inset-0 > div { max-width: 95vw !important; max-height: 90vh !important; overflow-y: auto !important; }
    }
    @media (max-width: 640px) {
      /* Smaller page headers on mobile */
      .page-header h1 { font-size: 1.4rem !important; }
      .page-header p { font-size: 0.8rem !important; }
      /* Tables scroll horizontally */
      .overflow-x-auto { -webkit-overflow-scrolling: touch; overflow-x: auto !important; }
      .data-table { min-width: 500px !important; }
      /* Cards full width with smaller radius */
      .card, .card-flat, .section-card { border-radius: 16px !important; }
      /* Toolbars: wrap buttons */
      .flex.flex-wrap { flex-wrap: wrap !important; }
      /* Button groups wrap with gap */
      .flex.items-center.gap-2, .flex.items-center.gap-3 { flex-wrap: wrap !important; }
      /* Hide breadcrumb on mobile */
      .breadcrumb { font-size: 0.7rem !important; }
      /* Navbar: smaller profile pill */
      .max-w-\[160px\] { max-width: 100px !important; }
      /* Stack lg grids to 1 column */
      .lg\:grid-cols-2, .lg\:grid-cols-3, .lg\:grid-cols-4, .lg\:grid-cols-5 {
        grid-template-columns: 1fr !important;
      }
      /* Smaller gaps on mobile */
      .gap-5, .gap-6 { gap: 0.75rem !important; }
      .space-y-5 > *, .space-y-6 > * { margin-top: 0.75rem !important; }
      /* Hero cards: smaller padding */
      .px-7 { padding-left: 1.25rem !important; padding-right: 1.25rem !important; }
      .py-6 { padding-top: 1rem !important; padding-bottom: 1rem !important; }
      /* Form grids: stack vertically */
      .grid.grid-cols-2 { grid-template-columns: 1fr !important; }
      /* Prevent flex children from overflowing */
      .flex-1 { min-width: 0 !important; }
      /* Section headers: stack on mobile */
      .section-header { flex-direction: column !important; align-items: flex-start !important; gap: 8px !important; }
      /* Sticky elements: less sticky offset */
      .sticky:not(.top-0) { top: 56px !important; }
      /* Inputs and selects: full width */
      input, select, textarea { max-width: 100% !important; }
      /* Badges: smaller */
      .badge { font-size: 0.65rem !important; padding: 2px 8px !important; }
    }
    @media (max-width: 380px) {
      /* Very small phones: KPI cards 1 column */
      .grid-cols-2, .grid-cols-3, .grid-cols-4 { grid-template-columns: 1fr !important; }
      /* Even smaller buttons */
      .btn-sm { padding: 6px 10px !important; font-size: 0.7rem !important; }
    }

    /* ── Gradients ── */
    .grad-brand  { background: linear-gradient(135deg, #0f2156 0%, #1a56db 100%); }
    .grad-blue   { background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%); }
    .grad-gold   { background: linear-gradient(135deg, #b45309 0%, #f59e0b 100%); }
    .grad-green  { background: linear-gradient(135deg, #064e3b 0%, #10b981 100%); }
    .grad-purple { background: linear-gradient(135deg, #4c1d95 0%, #8b5cf6 100%); }
    .grad-rose   { background: linear-gradient(135deg, #881337 0%, #f43f5e 100%); }
    .grad-teal   { background: linear-gradient(135deg, #134e4a 0%, #14b8a6 100%); }
    .grad-mesh   {
      background: linear-gradient(135deg, #0f2156 0%, #1a56db 50%, #2563eb 100%);
      background-size: 200% 200%;
      animation: meshMove 8s ease infinite;
    }

    /* ── Auth panel ── */
    .auth-panel-bg {
      background: linear-gradient(160deg, #060d1f 0%, #0f2156 40%, #1a4db5 75%, #2563eb 100%);
      position: relative; overflow: hidden;
    }
    .auth-panel-bg::before {
      content: ''; position: absolute;
      width: 520px; height: 520px; background: rgba(255,255,255,0.04);
      border-radius: 50%; top: -120px; left: -130px;
    }
    .auth-panel-bg::after {
      content: ''; position: absolute;
      width: 360px; height: 360px; background: rgba(255,255,255,0.04);
      border-radius: 50%; bottom: -90px; right: -90px;
    }

    /* ── Glass / Liquid Glass Morphism ── */
    .glass {
      background: rgba(255,255,255,0.05);
      backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.10);
    }
    /* Reusable liquid-glass utility */
    .liquid-glass {
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(20px) saturate(1.4); -webkit-backdrop-filter: blur(20px) saturate(1.4);
      border: 1px solid rgba(255,255,255,0.09);
      border-radius: 24px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.07);
    }

    /* ── Navbar dark ── */
    nav.dark-nav {
      background: #0d1424 !important;
      border-bottom-color: rgba(255,255,255,0.06) !important;
      box-shadow: 0 1px 0 rgba(255,255,255,0.04), 0 4px 24px rgba(0,0,0,0.4) !important;
    }
    nav.dark-nav .text-slate-800 { color: #e2e8f0 !important; }
    nav.dark-nav .text-slate-700 { color: #cbd5e1 !important; }
    nav.dark-nav .bg-slate-100\\/70 { background: rgba(255,255,255,0.07) !important; }
    nav.dark-nav .border-slate-200\\/80 { border-color: rgba(255,255,255,0.10) !important; }

    /* ── Sidebar ── */
    .sidebar {
      width: 260px;
      background: linear-gradient(180deg, #060e22 0%, #0b1a45 50%, #0f2462 100%);
      transition: transform 80ms ease;
      will-change: transform;
      z-index: 50;
    }
    @media (max-width: 767px) {
      .sidebar { position: fixed; top: 0; bottom: 0; left: 0; height: 100vh; transform: translateX(-100%); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5); }
      .sidebar.open { transform: translateX(0); }
      /* Full viewport main content on mobile */
      main { padding: 12px !important; }
      /* Stack flex rows on mobile */
      .flex-col-mobile { flex-direction: column !important; }
      /* Hide non-essential columns on mobile */
      .hide-mobile { display: none !important; }
    }
    @media (min-width: 768px) {
      body:has(.sidebar) {
        height: 100vh;
        height: 100dvh;
        overflow: hidden;
      }
      body:has(.sidebar) > .flex.flex-1.overflow-hidden {
        flex: 1 1 0;
        height: calc(100vh - 56px);
        height: calc(100dvh - 56px);
        min-height: 0;
      }
      .sidebar {
        position: sticky;
        top: 0;
        align-self: stretch;
        height: 100%;
        min-height: 0;
        max-height: 100%;
        flex-shrink: 0;
        transform: none !important;
        overflow: visible;
        display: flex;
        flex-direction: column;
      }
    }
    /* Sidebar nav scrolls, footer pinned */
    .sidebar > nav { flex: 1 !important; overflow-y: auto !important; min-height: 0 !important; }
    .sidebar > div:last-child { flex-shrink: 0 !important; }
    .sidebar-link {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 13px; border-radius: 10px;
      font-size: 0.855rem; font-weight: 500;
      color: rgba(255,255,255,0.62); text-decoration: none;
      transition: background 60ms ease, color 60ms ease, border-color 60ms ease, transform 60ms ease;
      position: relative; border-left: 2px solid transparent;
    }
    .sidebar-link:hover { background: rgba(255,255,255,0.10); color: #fff; transform: translateX(3px); border-left-color: rgba(255,255,255,0.2); }
    .sidebar-link.active { background: rgba(255,255,255,0.14); color: #fff; border-left-color: #f59e0b; font-weight: 600; }
    .sidebar-icon { width: 17px; text-align: center; flex-shrink: 0; font-size: 0.82rem; }
    .sidebar-section {
      font-size: 9px; font-weight: 800; text-transform: uppercase;
      letter-spacing: 0.14em; color: rgba(148,163,184,0.45);
      padding: 0 13px; margin: 20px 0 6px;
    }

    /* ── Dark Cards — Liquid Glass ── */
    .card {
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(20px) saturate(1.4); -webkit-backdrop-filter: blur(20px) saturate(1.4);
      border-radius: 24px;
      border: 1px solid rgba(255,255,255,0.09);
      box-shadow: 0 8px 32px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.07);
      transition: transform 80ms ease, box-shadow 80ms ease;
    }
    .card:hover { transform: translateY(-3px); box-shadow: 0 16px 48px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.09); }
    .card-flat {
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(18px) saturate(1.3); -webkit-backdrop-filter: blur(18px) saturate(1.3);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 4px 24px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06);
    }

    /* ── KPI Card — Liquid Glass ── */
    .kpi-card {
      border-radius: 24px; padding: 22px 24px;
      position: relative; overflow: hidden;
      backdrop-filter: blur(20px) saturate(1.4); -webkit-backdrop-filter: blur(20px) saturate(1.4);
      box-shadow: 0 8px 32px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.10);
      border: 1px solid rgba(255,255,255,0.10);
      transition: transform 80ms ease, box-shadow 80ms ease;
    }
    .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 18px 52px rgba(0,0,0,0.65), inset 0 1px 0 rgba(255,255,255,0.12); }
    .kpi-card::after { content:''; position:absolute; width:150px; height:150px; border-radius:50%; background:rgba(255,255,255,0.07); bottom:-50px; right:-50px; }
    .kpi-card::before { content:''; position:absolute; width:70px; height:70px; border-radius:50%; background:rgba(255,255,255,0.05); top:-15px; left:50%; }

    /* ── Dark Forms — Liquid Glass ── */
    .form-input {
      width: 100%; padding: 12px 16px 12px 44px;
      border: 1.5px solid rgba(255,255,255,0.13); border-radius: 14px;
      font-size: 0.875rem; color: #e2e8f0; outline: none;
      background: rgba(255,255,255,0.05);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.07), 0 2px 8px rgba(0,0,0,0.25);
      transition: border-color 60ms ease, box-shadow 60ms ease;
    }
    .form-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.22), inset 0 1px 0 rgba(255,255,255,0.07); }
    .form-input-bare {
      width: 100%; padding: 12px 16px;
      border: 1.5px solid rgba(255,255,255,0.13); border-radius: 14px;
      font-size: 0.875rem; color: #e2e8f0; outline: none;
      background: rgba(255,255,255,0.05);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.07), 0 2px 8px rgba(0,0,0,0.25);
      transition: border-color 60ms ease, box-shadow 60ms ease;
    }
    .form-input-bare:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.22), inset 0 1px 0 rgba(255,255,255,0.07); }
    textarea.form-input-bare, textarea.form-input { border-radius: 14px !important; }
    .form-input-bare::placeholder, .form-input::placeholder { color: #475569; }
    select.form-input-bare, select.form-input { appearance: none; cursor: pointer; border-radius: 999px; }
    select.form-input-bare option, select.form-input option { background: #0d1424; color: #e2e8f0; }
    .input-wrap { position: relative; }
    .input-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#475569; font-size:0.8rem; pointer-events:none; z-index:1; font-family:"Font Awesome 6 Free"; font-weight:900; }
    .fa-envelope::before { content:"\f0e0"; }
    .fa-lock::before     { content:"\f023"; }
    .fa-user::before     { content:"\f007"; }
    .fa-id-badge::before { content:"\f2c1"; }
    .fa-key::before      { content:"\f084"; }
    .fa-eye::before      { content:"\f06e"; }
    .fa-eye-slash::before{ content:"\f070"; }

    /* ── Dark Buttons — Liquid Glass ── */
    .btn-primary {
      display:inline-flex; align-items:center; justify-content:center; gap:7px;
      padding:10px 24px; border-radius:999px; font-size:0.875rem; font-weight:600;
      background:linear-gradient(135deg,#1d4ed8,#2563eb);
      color:#fff; border:none; cursor:pointer; text-decoration:none;
      box-shadow:0 4px 18px rgba(37,99,235,0.45), inset 0 1px 0 rgba(255,255,255,0.18);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      transition: opacity 60ms ease, transform 60ms ease, box-shadow 60ms ease;
    }
    .btn-primary:hover { opacity:0.88; transform:translateY(-1px); box-shadow:0 8px 28px rgba(37,99,235,0.6), inset 0 1px 0 rgba(255,255,255,0.2); }
    .btn-primary:active { transform:translateY(0); opacity:1; }
    .btn-secondary {
      display:inline-flex; align-items:center; justify-content:center; gap:7px;
      padding:10px 24px; border-radius:999px; font-size:0.875rem; font-weight:500;
      background:rgba(255,255,255,0.05); color:#94a3b8;
      border:1.5px solid rgba(255,255,255,0.12);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
      cursor:pointer; text-decoration:none;
      transition: background 60ms ease, color 60ms ease, border-color 60ms ease;
    }
    .btn-secondary:hover { background:rgba(255,255,255,0.09); color:#cbd5e1; border-color:rgba(255,255,255,0.20); }
    .btn-danger {
      display:inline-flex; align-items:center; justify-content:center; gap:7px;
      padding:9px 20px; border-radius:999px; font-size:0.825rem; font-weight:600;
      background:linear-gradient(135deg,#dc2626,#ef4444);
      color:#fff; border:none; cursor:pointer; text-decoration:none;
      box-shadow:0 4px 14px rgba(220,38,38,0.4), inset 0 1px 0 rgba(255,255,255,0.15);
      transition: opacity 60ms ease, transform 60ms ease;
    }
    .btn-danger:hover { opacity:0.88; transform:translateY(-1px); }
    .btn-danger:active { transform:translateY(0); opacity:1; }
    .btn-sm {
      padding:6px 14px; border-radius:999px; font-size:0.775rem; font-weight:500;
      display:inline-flex; align-items:center; gap:5px;
      text-decoration:none; cursor:pointer; border:1px solid transparent;
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      transition: background 60ms ease, color 60ms ease, border-color 60ms ease;
    }
    .btn-sm-blue   { background:rgba(59,130,246,0.15); color:#93c5fd; border-color:rgba(59,130,246,0.3); }
    .btn-sm-blue:hover   { background:rgba(59,130,246,0.25); }
    .btn-sm-green  { background:rgba(16,185,129,0.15); color:#6ee7b7; border-color:rgba(16,185,129,0.3); }
    .btn-sm-green:hover  { background:rgba(16,185,129,0.25); }
    .btn-sm-purple { background:rgba(139,92,246,0.15); color:#c4b5fd; border-color:rgba(139,92,246,0.3); }
    .btn-sm-purple:hover { background:rgba(139,92,246,0.25); }
    .btn-sm-red    { background:rgba(239,68,68,0.15); color:#fca5a5; border-color:rgba(239,68,68,0.3); }
    .btn-sm-red:hover    { background:rgba(239,68,68,0.25); }
    .btn-sm-gray   { background:rgba(255,255,255,0.07); color:#94a3b8; border-color:rgba(255,255,255,0.10); }
    .btn-sm-gray:hover   { background:rgba(255,255,255,0.12); color:#cbd5e1; }
    .btn-sm-gold   { background:rgba(245,158,11,0.15); color:#fcd34d; border-color:rgba(245,158,11,0.3); }
    .btn-sm-gold:hover   { background:rgba(245,158,11,0.25); }

    /* ── Dark Badges ── */
    .badge {
      display:inline-flex; align-items:center; gap:4px;
      padding:3px 10px; border-radius:999px;
      font-size:0.7rem; font-weight:700; letter-spacing:0.03em; white-space:nowrap;
    }
    .badge-green  { background:rgba(16,185,129,0.15); color:#6ee7b7; border:1px solid rgba(16,185,129,0.25); }
    .badge-blue   { background:rgba(59,130,246,0.15); color:#93c5fd; border:1px solid rgba(59,130,246,0.25); }
    .badge-yellow { background:rgba(245,158,11,0.15); color:#fcd34d; border:1px solid rgba(245,158,11,0.25); }
    .badge-red    { background:rgba(239,68,68,0.15);  color:#fca5a5; border:1px solid rgba(239,68,68,0.25); }
    .badge-purple { background:rgba(139,92,246,0.15); color:#c4b5fd; border:1px solid rgba(139,92,246,0.25); }
    .badge-gray   { background:rgba(255,255,255,0.08); color:#94a3b8; border:1px solid rgba(255,255,255,0.12); }
    .badge-teal   { background:rgba(20,184,166,0.15); color:#5eead4; border:1px solid rgba(20,184,166,0.25); }

    /* ── Dark Alerts ── */
    .alert-success {
      background:rgba(16,185,129,0.10); border-left:4px solid #10b981; color:#6ee7b7;
      border-radius:10px; padding:13px 16px; font-size:0.875rem;
      display:flex; align-items:center; gap:10px;
    }
    .alert-error {
      background:rgba(244,63,94,0.10); border-left:4px solid #f43f5e; color:#fda4af;
      border-radius:10px; padding:13px 16px; font-size:0.875rem;
      display:flex; align-items:center; gap:10px;
    }

    /* ── Dark Table ── */
    .data-table { width:100%; border-collapse:collapse; font-size:0.875rem; }
    .data-table thead th {
      background:#0d1424; color:#64748b; font-weight:700;
      font-size:0.7rem; text-transform:uppercase; letter-spacing:0.08em;
      padding:11px 20px; text-align:left; border-bottom:2px solid rgba(255,255,255,0.06);
    }
    .data-table tbody tr { border-top:1px solid rgba(255,255,255,0.05); transition:background 60ms ease; }
    .data-table tbody tr:nth-child(even) { background:rgba(255,255,255,0.02); }
    .data-table tbody tr:hover { background:rgba(59,130,246,0.08); }
    .data-table tbody td { padding:13px 20px; color:#cbd5e1; vertical-align:middle; }

    /* ── Dark Page header ── */
    .page-header { margin-bottom:28px; }
    .page-header h1 { font-size:1.6rem; font-weight:900; color:#f1f5f9; letter-spacing:-0.03em; }
    .page-header p  { font-size:0.875rem; color:#64748b; margin-top:5px; }
    .breadcrumb { font-size:0.78rem; color:#475569; margin-bottom:7px; display:flex; align-items:center; gap:4px; }
    .breadcrumb a { color:#60a5fa; text-decoration:none; font-weight:500; }
    .breadcrumb a:hover { text-decoration:underline; }

    /* ── Dark Section Card — Liquid Glass ── */
    .section-card {
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(18px) saturate(1.3); -webkit-backdrop-filter: blur(18px) saturate(1.3);
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 4px 24px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06);
      overflow: hidden;
    }
    .section-header { padding:16px 22px; border-bottom:1px solid rgba(255,255,255,0.07); display:flex; align-items:center; justify-content:space-between; }
    .section-header h2 { font-size:0.94rem; font-weight:700; color:#e2e8f0; display:flex; align-items:center; gap:6px; }

    /* ── Modal glass ── */
    .modal-glass {
      background: rgba(10,15,30,0.7);
      backdrop-filter: blur(24px) saturate(1.5); -webkit-backdrop-filter: blur(24px) saturate(1.5);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 24px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.08);
    }

    /* ── Divider row ── */
    .list-row { padding:13px 22px; border-top:1px solid rgba(255,255,255,0.05); transition:background 60ms ease; }
    .list-row:hover { background:rgba(255,255,255,0.04); }

    /* ── Animations — snappy, no perceivable delay ── */
    @keyframes meshMove { 0%,100%{background-position:0% 50%} 50%{background-position:100% 50%} }
    @keyframes fadeUp   { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
    @keyframes slideIn  { from{opacity:0;transform:translateX(-8px)} to{opacity:1;transform:translateX(0)} }
    .animate-fadeup   { animation: fadeUp 180ms ease both; }
    .animate-fadeup-1 { animation: fadeUp 180ms 40ms ease both; }
    .animate-fadeup-2 { animation: fadeUp 180ms 80ms ease both; }
    .animate-fadeup-3 { animation: fadeUp 180ms 120ms ease both; }

    /* ── Scrollbar ── */
    ::-webkit-scrollbar { width:5px; height:5px; }
    ::-webkit-scrollbar-track { background:#0d1424; }
    ::-webkit-scrollbar-thumb { background:#1e3a5f; border-radius:99px; }
    ::-webkit-scrollbar-thumb:hover { background:#2563eb; }

    /* ── Inline text color helpers for dark mode ── */
    .text-slate-800 { color: #e2e8f0 !important; }
    .text-slate-700 { color: #cbd5e1 !important; }
    .text-slate-600 { color: #94a3b8 !important; }
    .text-slate-500 { color: #64748b !important; }
    .text-slate-400 { color: #475569 !important; }
    .text-slate-900 { color: #f1f5f9 !important; }
    .bg-white {
      background: rgba(255,255,255,0.04) !important;
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255,255,255,0.08) !important;
    }
    .bg-slate-50    { background-color: rgba(13,20,36,0.7) !important; }
    .bg-slate-100   { background-color: rgba(22,32,50,0.7) !important; }
    .bg-slate-200   { background-color: #1e293b !important; }
    .border-slate-100 { border-color: rgba(255,255,255,0.07) !important; }
    .border-slate-200 { border-color: rgba(255,255,255,0.10) !important; }
    .divide-slate-50 > * + * { border-color: rgba(255,255,255,0.05) !important; }
    /* Force selects and inputs dark in all browsers */
    select.bg-white, select.bg-slate-50, select.bg-slate-100,
    select.bg-slate-800, select { background-color: rgba(13,20,36,0.85) !important; color: #e2e8f0 !important; border-radius: 12px !important; }
    select option { background-color: #0d1424; color: #e2e8f0; }
    input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]),
    textarea {
      background: rgba(255,255,255,0.05) !important;
      color: #e2e8f0 !important;
      border: 1.5px solid rgba(255,255,255,0.13) !important;
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    }
    input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]) {
      border-radius: 12px !important;
    }
    textarea { border-radius: 14px !important; }
    input:focus, textarea:focus, select:focus { border-color: #3b82f6 !important; box-shadow: 0 0 0 3px rgba(59,130,246,0.20) !important; outline: none !important; }
    /* Kill Chrome/Edge autofill bright background globally */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active {
      -webkit-box-shadow: 0 0 0 1000px #0d1527 inset !important;
      -webkit-text-fill-color: #e2e8f0 !important;
      caret-color: #e2e8f0 !important;
      background-color: #0d1527 !important;
      transition: background-color 9999s ease-in-out 0s;
    }
    .hover\:bg-slate-50:hover { background-color: rgba(255,255,255,0.03) !important; }
    .hover\:bg-slate-100:hover { background-color: rgba(255,255,255,0.05) !important; }
    /* Card section headers */
    .px-6.py-4.border-b, .px-5.py-4.border-b { border-color: rgba(255,255,255,0.07) !important; }

    /* ── Global modal panel glass ── */
    [id$="-modal"] .bg-white,
    [id$="-modal"] .bg-slate-800,
    .modal-panel, .modal-content, [role="dialog"] {
      background: rgba(10,15,30,0.82) !important;
      backdrop-filter: blur(28px) saturate(1.5) !important; -webkit-backdrop-filter: blur(28px) saturate(1.5) !important;
      border: 1px solid rgba(255,255,255,0.11) !important;
      border-radius: 24px !important;
      box-shadow: 0 24px 64px rgba(0,0,0,0.75), inset 0 1px 0 rgba(255,255,255,0.07) !important;
    }
    /* Emerald/green light variants → dark */
    .bg-emerald-50 { background-color: rgba(16,185,129,0.07) !important; }
    .bg-emerald-100, .hover\:bg-emerald-100:hover { background-color: rgba(16,185,129,0.12) !important; }
    .border-emerald-100 { border-color: rgba(16,185,129,0.2) !important; }
    .border-emerald-200 { border-color: rgba(16,185,129,0.3) !important; }
    .text-emerald-700 { color: #6ee7b7 !important; }
    .bg-blue-50 { background-color: rgba(37,99,235,0.08) !important; }
    .border-blue-200 { border-color: rgba(37,99,235,0.25) !important; }
    .text-blue-700 { color: #93c5fd !important; }
    .bg-purple-50 { background-color: rgba(139,92,246,0.08) !important; }
    .border-purple-200 { border-color: rgba(139,92,246,0.25) !important; }
    .text-purple-700 { color: #c4b5fd !important; }
    .bg-red-50 { background-color: rgba(239,68,68,0.07) !important; }
    .border-red-100 { border-color: rgba(239,68,68,0.15) !important; }
    .border-red-200 { border-color: rgba(239,68,68,0.25) !important; }
    .bg-amber-50, .bg-yellow-50 { background-color: rgba(245,158,11,0.07) !important; }
    .border-amber-100, .border-yellow-100 { border-color: rgba(245,158,11,0.15) !important; }

    /* ── Print ── */
    @media print { .sidebar, nav, .no-print { display:none !important; } main { padding:0 !important; } body { background:#fff !important; color:#000 !important; } }
  </style>
  <script>
    function toggleMobileSidebar() {
      const sidebar = document.querySelector('.sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      if (sidebar) {
        // Always strip collapsed on mobile before opening
        sidebar.classList.remove('collapsed');
        sidebar.style.removeProperty('width');
        sidebar.classList.toggle('open');
      }
      if (overlay) {
        overlay.classList.toggle('hidden');
      }
    }
    // Keep Vercel serverless function warm — ping every 25s to avoid cold starts
    (function keepWarm() {
      fetch('/_health', { method: 'GET', cache: 'no-store' }).catch(() => {});
      setTimeout(keepWarm, 25000);
    })();
    // Register Service Worker for PWA
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
    // bfcache fix: when user navigates back to this page, check if still logged in
    window.addEventListener('pageshow', function(e) {
      if (e.persisted) {
        // Page was restored from bfcache — verify session is still valid
        fetch('/dashboard', { method: 'HEAD', cache: 'no-store', redirect: 'manual' })
          .then(r => { if (r.type === 'opaqueredirect' || r.status === 302 || r.url.includes('/login')) { window.location.replace('/login'); } })
          .catch(() => {});
      }
    });
  </script>
</head>
