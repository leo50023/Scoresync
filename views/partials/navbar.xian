<div id="sidebar-overlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden transition-opacity"></div>

<nav class="h-14 border-b flex items-center px-3 sm:px-5 gap-2.5 sticky top-0 left-0 right-0 z-30"
  style="background:#0d1424;border-bottom-color:rgba(255,255,255,0.06);box-shadow:0 1px 0 rgba(255,255,255,0.04),0 4px 24px rgba(0,0,0,0.4)">

  <!-- Mobile Hamburger -->
  <button type="button" onclick="toggleMobileSidebar()" class="md:hidden p-2 text-slate-300 hover:text-white focus:outline-none rounded-xl hover:bg-white/10 transition flex-shrink-0" aria-label="Toggle Navigation Menu">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <!-- Brand -->
  <a href="/dashboard" class="flex items-center gap-2 flex-shrink-0">
    <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="w-8 h-8 object-cover rounded-full" style="border:1.5px solid rgba(255,255,255,0.15)"/>
    <span class="font-black text-white text-sm tracking-tight hidden sm:block">ScoreSync</span>
  </a>

  <!-- Panel Label — center of navbar -->
  <div class="flex-1 flex justify-center overflow-hidden">
    {{#if isAdmin}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(37,99,235,0.15);color:#93c5fd;border:1px solid rgba(37,99,235,0.3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3 6 6.5 1-4.8 4.5 1.2 6.5L12 16l-5.9 3 1.2-6.5L2.5 8 9 7z"/></svg>
      Admin Panel
    </span>
    {{else}}{{#if isJudge}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(139,92,246,0.15);color:#c4b5fd;border:1px solid rgba(139,92,246,0.3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      Judge Panel
    </span>
    {{else}}{{#if isTabulator}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(234,179,8,0.15);color:#fde047;border:1px solid rgba(234,179,8,0.35);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="m9 10 2 2 4-4"/></svg>
      Tabulator Panel
    </span>
    {{else}}{{#if isOrganizer}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(245,158,11,0.15);color:#fcd34d;border:1px solid rgba(245,158,11,0.3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z"/></svg>
      Organizer Panel
    </span>
    {{else}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z"/></svg>
      Participant Panel
    </span>
    {{/if}}{{/if}}{{/if}}{{/if}}
  </div>

  <!-- Right: Profile Pill -->
  <div class="flex items-center gap-2 flex-shrink-0" style="min-width:0">
    <a id="navbar-profile-pill" href="/settings" class="flex items-center gap-2 pl-1 py-1 rounded-full border transition group"
      style="background:rgba(255,255,255,0.07);border-color:rgba(255,255,255,0.12);padding-right:12px;min-width:0;max-width:160px;flex-wrap:wrap">
      <div class="w-7 h-7 rounded-full overflow-hidden flex-shrink-0 shadow" style="border:1.5px solid rgba(255,255,255,0.2)">
        {{#if userAvatar}}
        <img src="{{userAvatar}}" alt="{{userName}}" class="navbar-avatar-img w-full h-full object-cover" loading="lazy"/>
        {{else}}
        <div class="w-full h-full grad-brand flex items-center justify-center text-white text-xs font-black">{{ userInitial }}</div>
        {{/if}}
      </div>
      <span id="navbar-username-label" class="text-xs font-bold text-slate-300" style="display:none;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ userName }}</span>
    </a>
  </div>

</nav>

<script>
(function() {
  function applyNavbarLayout() {
    var usernameLabel = document.getElementById('navbar-username-label');
    var profilePill   = document.getElementById('navbar-profile-pill');
    if (!usernameLabel) return;
    if (window.innerWidth < 360) {
      usernameLabel.style.display    = 'none';
      profilePill.style.paddingRight = '4px';
    } else {
      usernameLabel.style.display    = 'inline';
      profilePill.style.paddingRight = '12px';
    }
  }
  applyNavbarLayout();
  window.addEventListener('resize', applyNavbarLayout);
})();
</script>
