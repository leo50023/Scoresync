<div id="sidebar-overlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 hidden transition-opacity" aria-hidden="true"></div>
<nav class="h-14 border-b flex items-center px-3 sm:px-5 gap-2.5 sticky top-0 left-0 right-0 z-30"
  style="background:var(--bg-navbar);border-bottom-color:var(--border);box-shadow:0 1px 0 var(--border-subtle),0 4px 24px rgba(0,0,0,0.2)">

  <!-- Mobile Hamburger -->
  <button type="button" onclick="toggleMobileSidebar()" class="md:hidden p-2 text-slate-300 hover:text-white focus:outline-none rounded-xl hover:bg-white/10 transition flex-shrink-0" aria-label="Toggle Navigation Menu">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <!-- Brand -->
  <a href="/dashboard" class="flex items-center gap-2 flex-shrink-0">
    <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="w-8 h-8 object-cover rounded-full" style="border:1.5px solid rgba(255,255,255,0.15)"/>
    <span class="font-black text-white text-sm tracking-tight hidden sm:block">ScoreSync</span>
  </a>

  <!-- Panel Label — center of navbar -->
  <div class="flex-1 flex justify-center overflow-hidden">
    {{#if isAdmin}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(37,99,235,0.15);color:#93c5fd;border:1px solid rgba(37,99,235,0.3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3 6 6.5 1-4.8 4.5 1.2 6.5L12 16l-5.9 3 1.2-6.5L2.5 8 9 7z"/></svg>
      Admin Panel
    </span>
    {{else}}{{#if isJudge}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(139,92,246,0.15);color:#c4b5fd;border:1px solid rgba(139,92,246,0.3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      Judge Panel
    </span>
    {{else}}{{#if isTabulator}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(234,179,8,0.15);color:#fde047;border:1px solid rgba(234,179,8,0.35);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="m9 10 2 2 4-4"/></svg>
      Tabulator Panel
    </span>
    {{else}}{{#if isOrganizer}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(245,158,11,0.15);color:#fcd34d;border:1px solid rgba(245,158,11,0.3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z"/></svg>
      Organizer Panel
    </span>
    {{else}}
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-extrabold flex-shrink-0"
      style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z"/></svg>
      Participant Panel
    </span>
    {{/if}}{{/if}}{{/if}}{{/if}}
  </div>

  <!-- Right: Notifications + Theme toggle + Profile Pill -->
  <div class="flex items-center gap-2 flex-shrink-0" style="min-width:0">

    <!-- Notification Bell (all logged-in users) -->
    <div class="relative" id="notif-wrapper">
      <button type="button" id="notif-btn" onclick="toggleNotifPanel()"
        style="width:36px;height:36px;min-height:unset;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.07);border:1.5px solid rgba(255,255,255,0.15);color:#e2e8f0;cursor:pointer;flex-shrink:0;transition:all 120ms ease;position:relative"
        title="Notifications">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span id="notif-badge" style="display:none;position:absolute;top:-2px;right:-2px;min-width:16px;height:16px;border-radius:999px;background:#ef4444;color:#fff;font-size:9px;font-weight:800;padding:0 3px;align-items:center;justify-content:center;border:2px solid var(--bg-navbar);transition:transform 0.3s cubic-bezier(0.34,1.6,0.64,1)"></span>
      </button>
      <div id="notif-panel" style="display:none;position:fixed;top:60px;right:8px;left:8px;width:auto;max-width:360px;margin-left:auto;border-radius:16px;z-index:9999;border:1px solid rgba(255,255,255,0.1);box-shadow:0 20px 60px rgba(0,0,0,0.5);overflow:hidden;background:#0d1424">
        <div style="padding:12px 16px 10px;border-bottom:1px solid rgba(255,255,255,0.07);display:flex;align-items:center;justify-content:space-between">
          <span style="font-size:0.78rem;font-weight:800;color:#e2e8f0">Notifications</span>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:2px">
            <span id="notif-count-label" style="font-size:0.65rem;font-weight:700;color:#64748b"></span>
            <span id="notif-timestamp" style="font-size:0.6rem;color:#334155"></span>
          </div>
        </div>
        <div id="notif-list" style="max-height:min(340px,60vh);overflow-y:auto;padding:6px 8px">
          <div id="notif-loading" style="padding:24px 16px;text-align:center;color:#64748b;font-size:0.78rem">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;animation:spin 1s linear infinite;vertical-align:-4px"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg>
            Loading...
          </div>
        </div>
        <div style="padding:8px 12px;border-top:1px solid rgba(255,255,255,0.06);text-align:center">
          <a href="/events" style="font-size:0.72rem;font-weight:600;color:#6366f1;text-decoration:none">View all events →</a>
        </div>
      </div>
    </div>

    <a id="navbar-profile-pill" href="/settings" class="flex items-center gap-2 pl-1 py-1 rounded-full border transition group"
      style="background:rgba(255,255,255,0.07);border-color:rgba(255,255,255,0.12);padding-right:12px;min-width:0;max-width:160px;flex-wrap:wrap">
      <div class="w-7 h-7 rounded-full overflow-hidden flex-shrink-0 shadow" style="border:1.5px solid rgba(255,255,255,0.2)">
        {{#if userAvatar}}
        <img src="{{userAvatar}}" alt="{{userName}}" class="navbar-avatar-img w-full h-full object-cover" loading="lazy"/>
        {{else}}
        <div class="w-full h-full grad-brand flex items-center justify-center text-white text-xs font-black">{{ userInitial }}</div>
        {{/if}}
      </div>
      <span id="navbar-username-label" class="text-xs font-bold text-slate-300" style="display:none;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ userName }}</span>
    </a>
  </div>

</nav>

<!-- ── Global Page Loading Indicator (must be inside body) ── -->
<div id="page-loader" aria-hidden="true" style="position:fixed;top:0;left:0;right:0;height:3px;z-index:9999;pointer-events:none;display:none"><div id="page-loader-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#4f46e5,#7c3aed,#06b6d4);background-size:200% 100%;border-radius:0 3px 3px 0;transition:width 0.2s ease"></div></div>
<div id="page-loader-spinner" aria-hidden="true" aria-live="polite" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:9998;flex-direction:column;align-items:center;gap:14px">
  <div class="spinner-ring"></div>
  <span style="font-size:12px;font-weight:700;color:#6366f1;letter-spacing:0.08em;text-transform:uppercase">Loading…</span>
</div>

<script>
(function() {
  // Sync theme toggle icon on load

  function applyNavbarLayout() {
    var usernameLabel = document.getElementById('navbar-username-label');
    var profilePill   = document.getElementById('navbar-profile-pill');
    if (!usernameLabel) return;
    if (window.innerWidth < 360) {
      usernameLabel.style.display    = 'none';
      profilePill.style.paddingRight = '4px';
    } else {
      usernameLabel.style.display    = 'inline';
      profilePill.style.paddingRight = '12px';
    }
  }
  applyNavbarLayout();
  window.addEventListener('resize', applyNavbarLayout);

  // ── Notification System ──────────────────────────────────────────────────
  var notifOpen = false;
  var notifData = [];

  window.toggleNotifPanel = function() {
    var panel = document.getElementById('notif-panel');
    if (!panel) return;
    notifOpen = !notifOpen;
    panel.style.display = notifOpen ? 'block' : 'none';
    if (notifOpen) loadNotifications();
  };

  // Close when clicking outside
  document.addEventListener('click', function(e) {
    var wrapper = document.getElementById('notif-wrapper');
    if (wrapper && !wrapper.contains(e.target)) {
      var panel = document.getElementById('notif-panel');
      if (panel) panel.style.display = 'none';
      notifOpen = false;
    }
  });

  function loadNotifications() {
    fetch('/api/notifications')
      .then(function(r) { return r.ok ? r.json() : { alerts: [], count: 0 }; })
      .then(function(data) {
        notifData = data.alerts || [];
        renderNotifications(notifData);
        updateBadge(data.count || 0);
      })
      .catch(function() { renderNotifications([]); });
  }

  function renderNotifications(alerts) {
    var list = document.getElementById('notif-list');
    var countLabel = document.getElementById('notif-count-label');
    if (!list) return;
    if (countLabel) countLabel.textContent = alerts.length ? alerts.length + ' alert' + (alerts.length > 1 ? 's' : '') : 'All clear';

    if (alerts.length === 0) {
      list.innerHTML = '<div style="padding:28px 16px;text-align:center"><div style="font-size:1.4rem;margin-bottom:8px">✅</div><div style="font-size:0.78rem;font-weight:600;color:#64748b">No alerts right now</div><div style="font-size:0.7rem;color:#475569;margin-top:4px">All judges are on track</div></div>';
      return;
    }

    var colors = { critical: '#ef4444', warning: '#f59e0b', info: '#3b82f6' };
    var bgs    = { critical: 'rgba(239,68,68,0.08)', warning: 'rgba(245,158,11,0.08)', info: 'rgba(59,130,246,0.06)' };
    var borders= { critical: 'rgba(239,68,68,0.25)', warning: 'rgba(245,158,11,0.22)', info: 'rgba(59,130,246,0.18)' };

    list.innerHTML = alerts.map(function(a) {
      var c = colors[a.type] || colors.info;
      var bg = bgs[a.type] || bgs.info;
      var br = borders[a.type] || borders.info;
      var link = a.eventId ? '/events/' + a.eventId : (a.link || '#');
      return '<a href="' + link + '" style="display:block;text-decoration:none;padding:10px 10px;border-radius:10px;margin-bottom:4px;border:1px solid ' + br + ';background:' + bg + ';transition:background 120ms ease" onmouseover="this.style.filter=\'brightness(1.1)\'" onmouseout="this.style.filter=\'\'">'
        + '<div style="display:flex;align-items:flex-start;gap:9px">'
        + '<span style="font-size:1rem;flex-shrink:0;margin-top:1px">' + (a.icon || '🔔') + '</span>'
        + '<div style="min-width:0">'
        + '<div style="font-size:0.75rem;font-weight:800;color:' + c + ';margin-bottom:2px">' + escHtml(a.title) + '</div>'
        + '<div style="font-size:0.68rem;color:#94a3b8;line-height:1.4">' + escHtml(a.message) + '</div>'
        + '</div></div></a>';
    }).join('');
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function updateBadge(count) {
    var badge = document.getElementById('notif-badge');
    if (!badge) return;
    if (count > 0) {
      badge.textContent = count > 9 ? '9+' : count;
      badge.style.display = 'inline-flex';
    } else {
      badge.style.display = 'none';
    }
  }

  // Auto-poll every 30 seconds (real-time) + badge pulse on new alerts
  var _lastNotifCount = 0;

  function pollNotifications() {
    fetch('/api/notifications')
      .then(function(r) { return r.ok ? r.json() : { alerts: [], count: 0 }; })
      .then(function(data) {
        var count = data.count || 0;
        // Pulse badge if new notifications arrived
        if (count > _lastNotifCount) {
          var badge = document.getElementById('notif-badge');
          if (badge) {
            badge.style.transform = 'scale(1.4)';
            setTimeout(function(){ badge.style.transform = ''; }, 300);
          }
        }
        _lastNotifCount = count;
        updateBadge(count);
        // Update list silently if panel is open
        if (notifOpen) {
          notifData = data.alerts || [];
          renderNotifications(notifData);
        }
        // Update last-refreshed timestamp
        var ts = document.getElementById('notif-timestamp');
        if (ts) {
          var now = new Date();
          ts.textContent = 'Updated ' + now.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit',second:'2-digit'});
        }
      })
      .catch(function() {});
  }

  // Initial load after 2s, then every 30s
  setTimeout(pollNotifications, 2000);
  setInterval(pollNotifications, 30000);
})();
</script>
