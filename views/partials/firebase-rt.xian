<script type="module">
(async function() {
  try {
    const cfg = await fetch('/api/firebase-config').then(r => r.json());
    const { initializeApp, getApps, getApp } = await import('https://www.gstatic.com/firebasejs/10.7.0/firebase-app.js');
    const { getFirestore } = await import('https://www.gstatic.com/firebasejs/10.7.0/firebase-firestore.js');
    const app = getApps().length ? getApp() : initializeApp(cfg, 'ss-rt');
    const db = getFirestore(app);
    window._ssDb = db;
    window.dispatchEvent(new CustomEvent('ss-firebase-ready', { detail: { db } }));
  } catch (err) {
    console.warn('[ScoreSync RT] Firebase client init failed:', err);
  }
})();
</script>
