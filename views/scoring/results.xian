{{> head }}
<body class="min-h-screen flex flex-col ss-page-bg">
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 space-y-5">

  <!-- ── Sticky Top Bar ── -->
  <div class="results-toolbar sticky top-0 z-20 -mx-4 sm:-mx-6 px-4 sm:px-6 py-3 no-print" style="background:rgba(7,12,24,0.97);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.07);box-shadow:0 4px 32px rgba(0,0,0,0.5)">
    <div class="results-toolbar-main flex items-center justify-between gap-2" style="min-width:0">
      <div class="flex items-center gap-3 min-w-0">
        <a href="{{#if isTabulator}}/dashboard{{else}}/events/{{event.id}}{{/if}}" class="btn-sm btn-sm-gray text-xs no-print flex items-center gap-1.5 flex-shrink-0">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          Back
        </a>
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 shadow-lg" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <div class="min-w-0">
          <div class="font-extrabold text-sm truncate" style="color:var(--text-primary)">Official Results — {{event.name}}</div>
          <div class="results-meta flex items-center gap-2 mt-0.5">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:rgba(37,99,235,0.15);color:#60a5fa">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              {{judgeCount}} judges
            </span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:rgba(124,58,237,0.15);color:#a78bfa">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              {{ranked.length}} contestants
            </span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:rgba(5,150,105,0.15);color:#34d399">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              {{criteria.length}} criteria
            </span>
          </div>
        </div>
      </div>
      <div class="results-toolbar-actions flex items-center gap-2 flex-shrink-0 overflow-x-auto" style="-webkit-overflow-scrolling:touch;scrollbar-width:none;max-width:calc(100vw - 120px)">
      <style>.no-scroll-bar::-webkit-scrollbar{display:none}</style>
        {{#if isAdmin}}
        <a href="/events/{{event.id}}/report" class="btn-sm btn-sm-purple text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          Report
        </a>
        <a href="/events/{{event.id}}/results/export" class="btn-sm btn-sm-green text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export CSV
        </a>
        <a href="/events/{{event.id}}/announce" class="btn-sm btn-sm-gold text-xs no-print">&#127881; Announce</a>
        <button onclick="window.print()" class="btn-sm btn-sm-gray text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Print
        </button>
        {{/if}}
        {{#if isOrganizer}}
        <a href="/events/{{event.id}}/report" class="btn-sm btn-sm-purple text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          Report
        </a>
        <a href="/events/{{event.id}}/results/export" class="btn-sm btn-sm-green text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export CSV
        </a>
        <a href="/events/{{event.id}}/announce" class="btn-sm btn-sm-gold text-xs no-print">&#127881; Announce</a>
        <button onclick="window.print()" class="btn-sm btn-sm-gray text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Print
        </button>
        {{/if}}
        {{#if isTabulator}}
        <a href="/events/{{event.id}}/report" class="btn-sm btn-sm-purple text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
          Report
        </a>
        <a href="/events/{{event.id}}/results/export" class="btn-sm btn-sm-green text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export CSV
        </a>
        <a href="/events/{{event.id}}/announce" class="btn-sm btn-sm-gold text-xs no-print">&#127881; Announce</a>
        <button onclick="window.print()" class="btn-sm btn-sm-gray text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Print
        </button>
        {{/if}}
      </div>
    </div>
  </div>

  {{#if ranked.length}}

  <!-- ── Podium Hero ── -->
  <div id="podium-container" class="animate-fadeup overflow-hidden rounded-2xl" style="background:linear-gradient(160deg,#060d1f 0%,#0a1535 50%,#0d1e42 100%);border:1px solid rgba(255,255,255,0.07);box-shadow:0 8px 48px rgba(0,0,0,0.6)">
    <!-- Hero header -->
    <div class="relative overflow-hidden px-6 pt-8 pb-6 text-center" style="background:linear-gradient(135deg,#0c1e4a,#1a3a8c,#0c2060)">
      <div class="absolute inset-0" style="background:radial-gradient(ellipse at 50% 0%,rgba(96,165,250,0.12) 0%,transparent 65%)"></div>
      <!-- Decorative stars -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div style="position:absolute;top:12px;left:8%;width:2px;height:2px;border-radius:50%;background:#60a5fa;opacity:.6"></div>
        <div style="position:absolute;top:24px;left:18%;width:3px;height:3px;border-radius:50%;background:#fff;opacity:.3"></div>
        <div style="position:absolute;top:8px;right:12%;width:2px;height:2px;border-radius:50%;background:#a78bfa;opacity:.5"></div>
        <div style="position:absolute;top:32px;right:22%;width:3px;height:3px;border-radius:50%;background:#fff;opacity:.25"></div>
        <div style="position:absolute;top:18px;left:40%;width:2px;height:2px;border-radius:50%;background:#fbbf24;opacity:.4"></div>
      </div>
      <div class="relative">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold mb-4" style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.8);border:1px solid rgba(255,255,255,0.15)">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping inline-block"></span>
          Live Leaderboard
        </div>
        <h2 class="text-white font-black text-2xl tracking-tight mb-1">{{event.name}}</h2>
        <p class="text-blue-300 text-xs opacity-70 tracking-widest uppercase">Official Competition Results</p>
      </div>
    </div>

    <!-- Podium Blocks -->
    <div class="px-6 pt-8 pb-6" data-role="podium-blocks">
      <div class="results-podium-layout flex items-end justify-center gap-4 max-w-2xl mx-auto">

        <!-- 2nd Place -->
        {{#each ranked}}{{#if (eq rank 2)}}
        <div class="flex-1 min-w-0 text-center max-w-[190px]" data-podium-rank="2">
          <div class="text-4xl mb-3 animate-fadeup-1" style="filter:drop-shadow(0 2px 8px rgba(148,163,184,0.4))">🥈</div>
          <div class="rounded-2xl p-5 border transition-all hover:scale-[1.02]" style="border-color:rgba(148,163,184,0.25);background:linear-gradient(160deg,#1a2240,#1e2a4a);box-shadow:0 4px 24px rgba(0,0,0,0.4),inset 0 1px 0 rgba(255,255,255,0.05)">
            <div class="text-[9px] uppercase font-black tracking-[0.2em] mb-3" style="color:rgba(148,163,184,0.7)">2nd Place</div>
            <div class="w-16 h-16 rounded-full overflow-hidden mx-auto mb-3 shadow-xl" style="border:2px solid rgba(148,163,184,0.4);ring:4px solid rgba(148,163,184,0.1)">
              {{#if photo}}
              <img src="{{photo}}" alt="{{name}}" class="w-full h-full object-cover" style="object-position:center top"/>
              {{else}}
              <div class="w-full h-full flex items-center justify-center text-white text-sm font-extrabold" style="background:linear-gradient(135deg,#475569,#94a3b8)">{{number}}</div>
              {{/if}}
            </div>
            <div class="font-extrabold text-sm leading-tight mb-1" style="color:#e2e8f0;overflow-wrap:anywhere">{{name}}</div>
            {{#if barangay}}<div class="text-[10px] mb-3" style="color:rgba(148,163,184,0.6)">Brgy. {{barangay}}</div>{{/if}}
            <div class="text-2xl font-black leading-none mt-3" style="color:#94a3b8"><span data-podium-score>{{finalScoreDisplay}}</span><span class="text-sm font-normal opacity-60">%</span></div>
            <div class="mt-3 h-1 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.07)">
              <div class="h-full rounded-full transition-all duration-1000" style="width:{{finalScoreDisplay}}%;background:linear-gradient(90deg,#64748b,#94a3b8)"></div>
            </div>
          </div>
          <div class="mt-2 h-14 rounded-t-xl mx-6" style="background:linear-gradient(180deg,rgba(148,163,184,0.3),rgba(148,163,184,0.1))"></div>
        </div>
        {{/if}}{{/each}}

        <!-- 1st Place / Champion -->
        {{#each ranked}}{{#if (eq rank 1)}}
        <div class="flex-1 min-w-0 text-center max-w-[210px] -mt-8" data-podium-rank="1">
          <div class="text-5xl mb-3 animate-fadeup" style="filter:drop-shadow(0 4px 16px rgba(251,191,36,0.6))">🏆</div>
          <div class="rounded-2xl p-5 border-2 border-yellow-400/40 transition-all hover:scale-[1.02]" style="background:linear-gradient(160deg,#2a1f05,#3d2a06,#2a1f05);box-shadow:0 8px 40px rgba(245,158,11,0.25),0 0 0 1px rgba(245,158,11,0.15),inset 0 1px 0 rgba(255,255,255,0.08)">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full mb-3" style="background:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.3)">
              <span class="text-[9px] text-yellow-400 uppercase font-black tracking-[0.18em]">Champion</span>
            </div>
            <div class="w-20 h-20 rounded-full overflow-hidden mx-auto mb-3 shadow-2xl" style="border:3px solid rgba(245,158,11,0.6);box-shadow:0 0 24px rgba(245,158,11,0.3)">
              {{#if photo}}
              <img src="{{photo}}" alt="{{name}}" class="w-full h-full object-cover" style="object-position:center top"/>
              {{else}}
              <div class="w-full h-full flex items-center justify-center text-white text-lg font-extrabold" style="background:linear-gradient(135deg,#92400e,#f59e0b)">{{number}}</div>
              {{/if}}
            </div>
            <div class="font-extrabold text-base leading-tight mb-1" style="color:#fef3c7;overflow-wrap:anywhere">{{name}}</div>
            {{#if barangay}}<div class="text-[10px] mb-3" style="color:rgba(251,191,36,0.55)">Brgy. {{barangay}}</div>{{/if}}
            <div class="text-3xl font-black mt-3 leading-none" style="color:#f59e0b"><span data-podium-score>{{finalScoreDisplay}}</span><span class="text-base font-normal opacity-60">%</span></div>
            <div class="mt-3 h-1.5 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.07)">
              <div class="h-full rounded-full transition-all duration-1000" style="width:{{finalScoreDisplay}}%;background:linear-gradient(90deg,#d97706,#fbbf24,#f59e0b)"></div>
            </div>
          </div>
          <div class="mt-2 h-24 rounded-t-xl mx-4" style="background:linear-gradient(180deg,rgba(245,158,11,0.4),rgba(245,158,11,0.1))"></div>
        </div>
        {{/if}}{{/each}}

        <!-- 3rd Place -->
        {{#each ranked}}{{#if (eq rank 3)}}
        <div class="flex-1 min-w-0 text-center max-w-[190px]" data-podium-rank="3">
          <div class="text-4xl mb-3 animate-fadeup-1" style="filter:drop-shadow(0 2px 8px rgba(205,127,50,0.4))">🥉</div>
          <div class="rounded-2xl p-5 border transition-all hover:scale-[1.02]" style="border-color:rgba(205,127,50,0.25);background:linear-gradient(160deg,#1e140a,#261a0c,#1e140a);box-shadow:0 4px 24px rgba(0,0,0,0.4),inset 0 1px 0 rgba(255,255,255,0.04)">
            <div class="text-[9px] uppercase font-black tracking-[0.2em] mb-3" style="color:rgba(205,127,50,0.7)">3rd Place</div>
            <div class="w-16 h-16 rounded-full overflow-hidden mx-auto mb-3 shadow-xl" style="border:2px solid rgba(205,127,50,0.4)">
              {{#if photo}}
              <img src="{{photo}}" alt="{{name}}" class="w-full h-full object-cover" style="object-position:center top"/>
              {{else}}
              <div class="w-full h-full flex items-center justify-center text-white text-sm font-extrabold" style="background:linear-gradient(135deg,#78350f,#f97316)">{{number}}</div>
              {{/if}}
            </div>
            <div class="font-extrabold text-sm leading-tight mb-1" style="color:#fed7aa;overflow-wrap:anywhere">{{name}}</div>
            {{#if barangay}}<div class="text-[10px] mb-3" style="color:rgba(205,127,50,0.6)">Brgy. {{barangay}}</div>{{/if}}
            <div class="text-2xl font-black mt-3 leading-none" style="color:#cd7f32"><span data-podium-score>{{finalScoreDisplay}}</span><span class="text-sm font-normal opacity-60">%</span></div>
            <div class="mt-3 h-1 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.07)">
              <div class="h-full rounded-full transition-all duration-1000" style="width:{{finalScoreDisplay}}%;background:linear-gradient(90deg,#92400e,#f97316)"></div>
            </div>
          </div>
          <div class="mt-2 h-8 rounded-t-xl mx-6" style="background:linear-gradient(180deg,rgba(205,127,50,0.3),rgba(205,127,50,0.08))"></div>
        </div>
        {{/if}}{{/each}}

      </div>
    </div>
  </div>

  <!-- ── All Participants by Rank ── -->
  <div id="standings-container" class="space-y-2 animate-fadeup-1">
    <div class="flex items-center justify-between px-1 mb-3">
      <h3 class="font-extrabold text-sm flex items-center gap-2" style="color:var(--text-primary)">
        <span class="w-6 h-6 rounded-lg flex items-center justify-center" style="background:rgba(37,99,235,0.18)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </span>
        All Participants by Rank
      </h3>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold" style="background:rgba(37,99,235,0.12);color:#60a5fa;border:1px solid rgba(37,99,235,0.2)">{{ranked.length}} contestants</span>
    </div>

    {{#each ranked}}
    <div data-contestant-card="1" class="overflow-hidden transition-all hover:translate-y-[-1px]"
      style="border-radius:14px;background:linear-gradient(135deg,#0d1526,#111827);border:1px solid rgba(255,255,255,0.07);box-shadow:0 2px 12px rgba(0,0,0,0.3);
      {{#if (eq rank 1)}}border-color:rgba(245,158,11,0.35);box-shadow:0 4px 20px rgba(245,158,11,0.12);{{/if}}
      {{#if (eq rank 2)}}border-color:rgba(148,163,184,0.25);{{/if}}
      {{#if (eq rank 3)}}border-color:rgba(205,127,50,0.25);{{/if}}">

      <!-- Contestant row -->
      <div class="results-standing-row px-4 py-3.5 flex items-center gap-3">

        <!-- Rank badge -->
        <div class="flex-shrink-0 w-9 h-9 rounded-full flex items-center justify-center font-black text-sm shadow"
          style="{{#if (eq rank 1)}}background:linear-gradient(135deg,#92400e,#f59e0b);color:#fff{{else}}{{#if (eq rank 2)}}background:linear-gradient(135deg,#334155,#94a3b8);color:#fff{{else}}{{#if (eq rank 3)}}background:linear-gradient(135deg,#78350f,#f97316);color:#fff{{else}}background:rgba(255,255,255,0.06);color:#64748b;border:1px solid rgba(255,255,255,0.1){{/if}}{{/if}}{{/if}}">
          {{rank}}
        </div>

        <!-- Contestant number -->
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-extrabold flex-shrink-0" style="background:linear-gradient(135deg,#1e3a8a,#2563eb);box-shadow:0 2px 8px rgba(37,99,235,0.3)">
          {{number}}
        </div>

        <!-- Name + breakdown -->
        <div class="results-standing-name flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <div class="font-extrabold text-sm leading-tight" style="color:var(--text-primary)">{{name}}</div>
            {{#if tieDetected}}
              {{#if tieBroken}}
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-bold" style="background:rgba(217,119,6,0.18);color:#d97706">⚖ Tie Broken</span>
              {{else}}
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-bold" style="background:rgba(220,38,38,0.18);color:#ef4444">⚖ Tie</span>
              {{/if}}
            {{/if}}
          </div>
          {{#if barangay}}<div class="text-xs mt-0.5" style="color:var(--text-muted)">Brgy. {{barangay}}{{#if age}} &bull; {{age}} yrs{{/if}}</div>{{/if}}
          {{#if tiebreakCriteria}}<div class="text-[10px] mt-0.5" style="color:var(--text-secondary)">Tiebreak via {{tiebreakCriteria}}</div>{{/if}}
          <!-- Criteria pills -->
          {{#if @root.isMultiCategory}}
          <div class="flex gap-1.5 mt-2 flex-wrap">
            {{#each categoryScores}}
            <div class="flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.2)">
              <span style="color:#94a3b8">{{categoryName}}</span>
              <span style="color:#c7d2fe;font-weight:800">{{score}}%</span>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="flex gap-2 mt-2 flex-wrap items-center">
            {{#each breakdown}}
            <div class="flex items-center gap-1" title="{{name}}: {{avg}} pts → {{weighted}}%">
              <span class="text-[9px] font-bold" style="color:{{color}}">{{name}}</span>
              <div class="h-1 rounded-full overflow-hidden" style="width:36px;background:rgba(255,255,255,0.07)">
                <div class="h-full rounded-full" style="width:{{barPct}}%;background:{{color}}"></div>
              </div>
              <span class="text-[9px]" style="color:var(--text-muted)">{{weighted}}%</span>
            </div>
            {{/each}}
          </div>
          {{/if}}
        </div>

        <!-- Score -->
        <div class="results-standing-score flex-shrink-0 text-right">
          <div class="font-black text-xl leading-none
            {{#if (eq rank 1)}}text-yellow-500{{else}}{{#if (eq rank 2)}}text-slate-400{{else}}{{#if (eq rank 3)}}text-orange-500{{else}}text-blue-400{{/if}}{{/if}}{{/if}}">
            {{finalScoreDisplay}}<span class="text-xs font-normal opacity-50">%</span>
          </div>
          <div class="text-[10px] mt-1" style="color:var(--text-muted)">weighted avg</div>
          {{#unless (eq rank 1)}}<div class="text-[10px] font-semibold mt-0.5" style="color:rgba(239,68,68,0.7)">-{{gapToFirst}}%</div>{{/unless}}
        </div>
      </div>

      <!-- Score bar -->
      <div class="h-0.5" style="background:rgba(255,255,255,0.04)">
        <div class="h-full transition-all duration-1000"
          style="width:{{finalScoreDisplay}}%;background:{{#if (eq rank 1)}}linear-gradient(90deg,#d97706,#fbbf24){{else}}{{#if (eq rank 2)}}linear-gradient(90deg,#475569,#94a3b8){{else}}{{#if (eq rank 3)}}linear-gradient(90deg,#c2410c,#fb923c){{else}}linear-gradient(90deg,#1d4ed8,#60a5fa){{/if}}{{/if}}{{/if}}">
        </div>
      </div>

    </div>
    {{/each}}
  </div>

  <!-- ── Official Tabulation Sheet ── -->
  <div class="section-card animate-fadeup-2 print-tabulation-sheet" style="border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,0.07)">
    <div class="section-header no-print flex items-center justify-between px-5 py-4" style="background:linear-gradient(135deg,rgba(13,20,36,0.9),rgba(17,24,39,0.9));border-bottom:1px solid rgba(255,255,255,0.07)">
      <h2 class="flex items-center gap-2 font-extrabold text-sm" style="color:var(--text-primary)">
        <span class="w-6 h-6 rounded-lg flex items-center justify-center" style="background:rgba(59,130,246,0.18)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
        </span>
        Official Tabulation Sheet
      </h2>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold" style="background:rgba(37,99,235,0.12);color:#60a5fa;border:1px solid rgba(37,99,235,0.18)">{{event.name}}</span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold no-print" style="background:rgba(124,58,237,0.12);color:#a78bfa;border:1px solid rgba(124,58,237,0.18)">{{judgeCount}} judge(s)</span>
      </div>
    </div>
    <div class="tabulation-note no-print">
      <span>Cells show average score and weighted contribution per criterion.</span>
      <span class="tabulation-scroll-hint">← Scroll horizontally for all criteria →</span>
    </div>

    <!-- Print title -->
    <div class="hidden print-show px-6 py-4 border-b border-slate-100">
      <div style="text-align:center;margin-bottom:6px">
        <img src="/scoresync-logo.png?v=8" alt="ScoreSync" style="width:40px;height:40px;border-radius:50%;display:inline-block;margin-bottom:6px"/>
      </div>
      <h2 class="font-extrabold text-lg text-slate-900" style="text-align:center">{{event.name}}</h2>
      <p class="text-sm text-slate-500" style="text-align:center">Official Tabulation Sheet &bull; {{judgeCount}} Judge(s) &bull; Generated: <span id="print-date"></span></p>
      {{#if event.date}}<p class="text-xs text-slate-400" style="text-align:center;margin-top:2px">{{event.date}}{{#if event.time}} at {{event.time}}{{/if}}{{#if event.venue}} &bull; {{event.venue}}{{/if}}</p>{{/if}}
    </div>

    <div class="tabulation-scroll" role="region" aria-label="Official tabulation sheet" tabindex="0">
    <table class="data-table tabulation-table min-w-max w-full">
      <caption class="sr-only">Official standings with each criterion's average score, weighted contribution, final score, and gap to first place.</caption>
      <thead>
        <tr>
          <th scope="col" class="tabulation-sticky-rank text-center" style="color:#94a3b8;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase">Rank</th>
          <th scope="col" class="tabulation-sticky-number" style="color:#94a3b8;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase">No.</th>
          <th scope="col" class="tabulation-sticky-contestant" style="color:#94a3b8;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase">Contestant</th>
          <th scope="col" class="hidden sm:table-cell" style="color:#94a3b8;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase">Barangay</th>
          {{#if @root.isMultiCategory}}
          {{#each @root.categoryGroups}}
          <th scope="col" class="text-center text-xs px-3 print-criterion-col">
            <div class="font-bold" style="color:#e2e8f0">{{name}}</div>
            <div class="font-normal text-[10px] mt-0.5" style="color:#64748b">Category Score</div>
          </th>
          {{/each}}
          {{else}}
          {{#each criteria}}
          <th scope="col" class="text-center text-xs px-3 print-criterion-col">
            <div class="font-bold" style="color:#e2e8f0">{{name}}</div>
            <div class="font-normal text-[10px] mt-0.5" style="color:#64748b">{{weight}}% &bull; max {{maxScore}}</div>
          </th>
          {{/each}}
          {{/if}}
          <th scope="col" class="text-center font-extrabold print-final-score" style="color:#60a5fa;font-size:11px">Final Score</th>
          <th scope="col" class="text-center text-xs no-print" style="color:#64748b">Gap to 1st</th>
        </tr>
      </thead>
      <tbody>
        {{#each ranked}}
        <tr style="{{#if (eq rank 1)}}background:rgba(217,119,6,0.07){{else}}{{#if (eq rank 2)}}background:rgba(100,116,139,0.04){{/if}}{{/if}}">
          <td class="text-center tabulation-sticky-rank">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-xs font-black"
              style="{{#if (eq rank 1)}}background:linear-gradient(135deg,#92400e,#f59e0b);color:#fff{{else}}{{#if (eq rank 2)}}background:linear-gradient(135deg,#334155,#94a3b8);color:#fff{{else}}{{#if (eq rank 3)}}background:linear-gradient(135deg,#78350f,#f97316);color:#fff{{else}}background:rgba(255,255,255,0.06);color:#64748b{{/if}}{{/if}}{{/if}}">
              {{rank}}
            </span>
          </td>
          <td class="font-mono text-xs text-center tabulation-sticky-number" style="color:#64748b">{{number}}</td>
          <td class="tabulation-sticky-contestant">
            <div class="font-extrabold text-sm" style="color:var(--text-primary)">{{name}}</div>
            {{#if tieDetected}}
              {{#if tieBroken}}
              <span class="inline-flex items-center px-1 py-0.5 rounded text-[9px] font-bold" style="background:rgba(217,119,6,0.18);color:#d97706">⚖ Tie Broken</span>
              {{else}}
              <span class="inline-flex items-center px-1 py-0.5 rounded text-[9px] font-bold" style="background:rgba(220,38,38,0.18);color:#ef4444">⚖ Tie</span>
              {{/if}}
              {{#if tiebreakCriteria}}<div class="text-[9px]" style="color:var(--text-secondary)">{{tiebreakCriteria}}</div>{{/if}}
            {{/if}}
            {{#if age}}<div class="text-xs" style="color:var(--text-muted)">{{age}} yrs</div>{{/if}}
          </td>
          <td class="text-sm hidden sm:table-cell" style="color:var(--text-muted)">{{barangay}}</td>
          {{#if @root.isMultiCategory}}
          {{#each categoryScores}}
          <td class="text-center px-3 print-criterion-col">
            <div class="font-extrabold text-base" style="color:#60a5fa">{{score}}%</div>
          </td>
          {{/each}}
          {{else}}
          {{#each breakdown}}
          <td class="text-center px-3 print-criterion-col">
            <div class="font-extrabold text-sm" style="color:var(--text-primary)">{{avg}}<span class="tabulation-unit"> avg</span></div>
            <div class="text-[10px] font-bold mt-0.5" style="color:{{color}}">{{weighted}}%<span class="tabulation-unit"> wt.</span></div>
            <div class="mt-1.5 h-1 rounded-full overflow-hidden w-14 mx-auto" style="background:rgba(255,255,255,0.06)">
              <div class="h-full rounded-full" style="width:{{barPct}}%;background:{{color}}"></div>
            </div>
          </td>
          {{/each}}
          {{/if}}
          <td class="text-center print-final-score">
            <span class="tabulation-score font-extrabold text-base
              {{#if (eq rank 1)}}text-yellow-500{{else}}{{#if (eq rank 2)}}text-slate-400{{else}}{{#if (eq rank 3)}}text-orange-500{{else}}text-blue-400{{/if}}{{/if}}{{/if}}">
              {{finalScoreDisplay}}%
            </span>
          </td>
          <td class="text-center no-print">
            {{#if (eq rank 1)}}
            <span class="text-[10px] font-bold" style="color:#64748b">—</span>
            {{else}}
            <span class="text-[11px] font-bold" style="color:rgba(239,68,68,0.75)">-{{gapToFirst}}%</span>
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    </div>
  </div>

  <!-- ── Judge Scoring Progress ── -->
  {{#if ranked.length}}
  <div class="animate-fadeup-2 no-print overflow-hidden" style="border-radius:16px;background:linear-gradient(135deg,#0d1526,#111827);border:1px solid rgba(255,255,255,0.07);box-shadow:0 2px 16px rgba(0,0,0,0.3)">
    <div class="flex items-center justify-between px-5 py-4" style="border-bottom:1px solid rgba(255,255,255,0.06)">
      <h2 class="flex items-center gap-2 font-extrabold text-sm" style="color:var(--text-primary)">
        <span class="w-6 h-6 rounded-lg flex items-center justify-center" style="background:rgba(124,58,237,0.18)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        Judge Scoring Progress
      </h2>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold" style="background:rgba(124,58,237,0.12);color:#a78bfa;border:1px solid rgba(124,58,237,0.2)">
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-ping inline-block"></span>
        Live
      </span>
    </div>
    <div id="judgeProgressList" class="px-5 py-2">
      {{#each judgeProgressData}}
      <div class="flex items-center gap-3 py-3" style="border-top:1px solid rgba(255,255,255,0.05)">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-extrabold flex-shrink-0 shadow grad-purple">
          {{add1 @index}}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between mb-1.5">
            <span class="font-bold text-sm" style="color:var(--text-primary)">{{alias}}</span>
            <span class="text-[10px] font-bold" style="color:#a78bfa">{{completionPct}}%</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="flex-1 h-1.5 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.07)">
              <div class="h-full rounded-full transition-all" style="width:{{completionPct}}%;background:linear-gradient(90deg,#6d28d9,#a78bfa)"></div>
            </div>
            <span class="text-[10px]" style="color:var(--text-muted)">{{scoredCount}}/{{totalContestants}}</span>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
    <script>
      (function() {
        const EVENT_ID = "{{event.id}}";
        async function loadJudgeProgress() {
          try {
            const resp = await fetch('/events/' + EVENT_ID + '/scoring-progress');
            if (!resp.ok) return;
            const data = await resp.json();
            const container = document.getElementById('judgeProgressList');
            if (!container || !Array.isArray(data) || data.length === 0) return;
            const frag = document.createDocumentFragment();
            data.forEach((j, idx) => {
              const pct = Math.min(100, j.completionPct || 0);
              const row = document.createElement('div');
              row.className = 'flex items-center gap-3 py-3';
              row.style.borderTop = '1px solid rgba(255,255,255,0.05)';
              const num = document.createElement('div');
              num.className = 'w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-extrabold flex-shrink-0 shadow grad-purple';
              num.textContent = idx + 1;
              const info = document.createElement('div');
              info.className = 'flex-1 min-w-0';
              const topRow = document.createElement('div');
              topRow.className = 'flex items-center justify-between mb-1';
              const name = document.createElement('span');
              name.className = 'font-bold text-sm';
              name.style.color = '#e2e8f0';
              name.textContent = j.alias || ('Judge ' + (idx + 1));
              const pctLabel = document.createElement('span');
              pctLabel.className = 'text-[10px] font-bold';
              pctLabel.style.color = '#a78bfa';
              pctLabel.textContent = pct + '%';
              topRow.appendChild(name); topRow.appendChild(pctLabel);
              const barRow = document.createElement('div');
              barRow.className = 'flex items-center gap-2';
              const barWrap = document.createElement('div');
              barWrap.className = 'flex-1 h-1.5 rounded-full overflow-hidden';
              barWrap.style.background = 'rgba(255,255,255,0.07)';
              const bar = document.createElement('div');
              bar.className = 'h-full rounded-full transition-all';
              bar.style.cssText = 'width:' + pct + '%;background:linear-gradient(90deg,#6d28d9,#a78bfa)';
              barWrap.appendChild(bar);
              const sub = document.createElement('span');
              sub.className = 'text-[10px]';
              sub.style.color = '#64748b';
              sub.textContent = j.scoredCount + '/' + j.totalContestants;
              barRow.appendChild(barWrap); barRow.appendChild(sub);
              info.appendChild(topRow); info.appendChild(barRow);
              row.appendChild(num); row.appendChild(info);
              frag.appendChild(row);
            });
            container.innerHTML = '';
            container.appendChild(frag);
          } catch(e) {}
        }
        document.addEventListener('DOMContentLoaded', function() {
          loadJudgeProgress();
          setInterval(loadJudgeProgress, 10000);
        });
      })();
    </script>
  </div>
  {{/if}}

  <!-- ── People's Choice ── -->
  {{#if totalAudienceVotes}}
  <div class="animate-fadeup-2 no-print overflow-hidden" style="border-radius:16px;background:linear-gradient(135deg,#0d1526,#111827);border:1px solid rgba(255,255,255,0.07);box-shadow:0 2px 16px rgba(0,0,0,0.3)">
    <div class="flex items-center justify-between px-5 py-4" style="border-bottom:1px solid rgba(255,255,255,0.06)">
      <h2 class="flex items-center gap-2 font-extrabold text-sm" style="color:var(--text-primary)">
        <span class="w-6 h-6 rounded-lg flex items-center justify-center" style="background:rgba(225,29,72,0.15)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fb7185" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </span>
        People's Choice
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold" style="background:rgba(225,29,72,0.15);color:#fb7185;border:1px solid rgba(225,29,72,0.2)">Audience Vote</span>
      </h2>
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold" style="background:rgba(255,255,255,0.06);color:#94a3b8;border:1px solid rgba(255,255,255,0.08)">{{totalAudienceVotes}} votes</span>
    </div>
    <div class="px-5 py-4 space-y-3">
      {{#each ranked}}
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-extrabold flex-shrink-0" style="background:linear-gradient(135deg,#881337,#e11d48);box-shadow:0 2px 8px rgba(225,29,72,0.3)">{{number}}</div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between mb-1.5">
            <span class="font-bold text-sm truncate" style="color:var(--text-primary)">{{name}}</span>
            <span class="text-sm font-extrabold ml-2 flex-shrink-0" style="color:#fb7185">{{lookup ../votesByContestant id}} votes</span>
          </div>
          <div class="h-1.5 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.07)">
            <div class="h-full rounded-full transition-all duration-700" style="background:linear-gradient(90deg,#be185d,#f43f5e);width:{{#if ../totalAudienceVotes}}{{audienceVotePct}}%{{else}}0%{{/if}}"></div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <!-- ── Per-Judge Breakdown ── -->
  {{#if judgeBreakdown.length}}
  <div class="animate-fadeup-2 no-print overflow-hidden" style="border-radius:16px;background:linear-gradient(135deg,#0d1526,#111827);border:1px solid rgba(255,255,255,0.07);box-shadow:0 2px 16px rgba(0,0,0,0.3)">
    <div class="flex items-center justify-between px-5 py-4" style="border-bottom:1px solid rgba(255,255,255,0.06)">
      <h2 class="flex items-center gap-2 font-extrabold text-sm" style="color:var(--text-primary)">
        <span class="w-6 h-6 rounded-lg flex items-center justify-center" style="background:rgba(124,58,237,0.18)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        Judge Breakdown
      </h2>
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold" style="background:rgba(124,58,237,0.12);color:#a78bfa;border:1px solid rgba(124,58,237,0.18)">{{judgeCount}} judges</span>
    </div>
    {{#each judgeBreakdown}}
    <div class="px-5 py-4" style="border-top:1px solid rgba(255,255,255,0.05)">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-xs font-extrabold flex-shrink-0 shadow grad-purple">{{initial}}</div>
        <div class="flex-1 min-w-0">
          {{#if ../isAdmin}}
          <div class="font-bold text-sm" style="color:var(--text-primary)">{{judgeName}}</div>
          {{else}}
          <div class="font-bold text-sm" style="color:var(--text-primary)">{{alias}}</div>
          {{/if}}
          <div class="text-[10px] mt-0.5" style="color:var(--text-muted)">{{scoredCount}} / {{totalContestants}} contestants scored</div>
        </div>
        <div>
          <div class="h-1.5 rounded-full w-24 overflow-hidden" style="background:rgba(255,255,255,0.07)">
            <div class="h-full rounded-full transition-all" style="width:{{completionPct}}%;background:linear-gradient(90deg,#6d28d9,#a78bfa)"></div>
          </div>
          <div class="text-[10px] font-bold text-right mt-0.5" style="color:#a78bfa">{{completionPct}}%</div>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        {{#each topScores}}
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08)">
          <span class="font-bold" style="color:var(--text-primary)">{{contestantName}}</span>
          <span style="color:var(--text-faint)">&bull;</span>
          <span class="font-extrabold" style="color:#a78bfa">{{score}}%</span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{else}}
  <!-- ── No Scores Yet ── -->
  <div class="animate-fadeup-1 overflow-hidden" style="border-radius:16px;border:1px solid rgba(255,255,255,0.07)">
    <div class="px-6 py-20 text-center" style="background:linear-gradient(135deg,#0d1526,#111827)">
      <div class="w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-lg" style="background:linear-gradient(135deg,#1e3a8a,#1e2d5a)">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="1.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </div>
      <h3 class="font-extrabold text-lg mb-2" style="color:var(--text-primary)">No scores yet</h3>
      <p class="text-sm max-w-xs mx-auto" style="color:var(--text-muted)">Judges need to submit scores before results can be displayed here.</p>
      {{#if isAdmin}}
      <a href="/events/{{event.id}}/scoring" class="btn-primary mt-6 inline-flex">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Open Score Entry
      </a>
      {{/if}}
      {{#if isOrganizer}}
      <a href="/events/{{event.id}}/scoring" class="btn-primary mt-6 inline-flex">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Open Score Entry
      </a>
      {{/if}}
    </div>
  </div>
  {{/if}}

</main>
</div>

<style>
.tabulation-note {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 20px;
  color: #64748b;
  font-size: 11px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  background: rgba(0,0,0,0.2);
}
.tabulation-scroll-hint { color: #60a5fa; }
.tabulation-scroll {
  max-width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  -webkit-overflow-scrolling: touch;
}
.tabulation-scroll:focus-visible { outline-offset: -2px; }
.tabulation-table {
  border-collapse: separate;
  border-spacing: 0;
}
.tabulation-table thead th {
  position: sticky;
  top: 0;
  z-index: 3;
  background: #0a1020;
  padding: 10px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.tabulation-table tbody tr {
  transition: background .15s;
}
.tabulation-table tbody tr:hover {
  background: rgba(255,255,255,0.03) !important;
}
.tabulation-table tbody td {
  padding: 10px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.tabulation-table .tabulation-sticky-rank,
.tabulation-table .tabulation-sticky-number,
.tabulation-table .tabulation-sticky-contestant {
  position: sticky;
  z-index: 2;
  background: inherit;
}
.tabulation-table .tabulation-sticky-rank {
  left: 0;
  width: 56px; min-width: 56px; max-width: 56px;
  padding-right: 8px !important;
  padding-left: 8px !important;
}
.tabulation-table .tabulation-sticky-number {
  left: 56px;
  width: 54px; min-width: 54px; max-width: 54px;
  padding-right: 8px !important;
  padding-left: 8px !important;
}
.tabulation-table .tabulation-sticky-contestant {
  left: 110px;
  min-width: 180px;
  box-shadow: 4px 0 12px rgba(0,0,0,0.3);
}
.tabulation-table thead .tabulation-sticky-rank,
.tabulation-table thead .tabulation-sticky-number,
.tabulation-table thead .tabulation-sticky-contestant { z-index: 4; }
.tabulation-unit {
  color: #64748b;
  font-size: 9px;
  font-weight: 500;
}
.tabulation-score {
  display: inline-block;
  min-width: 76px;
  padding: 5px 10px;
  border-radius: 10px;
  background: rgba(37,99,235,0.08);
  border: 1px solid rgba(37,99,235,0.15);
}

/* ── Mobile ── */
@media screen and (max-width: 640px) {
  .results-toolbar { padding-top: 10px; padding-bottom: 10px; }
  .results-toolbar-main { align-items: flex-start; flex-direction: column; gap: 10px; }
  .results-toolbar-actions {
    width: 100%; max-width: none !important;
    flex-wrap: wrap; justify-content: stretch; overflow: visible;
  }
  .results-toolbar-actions > a,
  .results-toolbar-actions > button {
    flex: 1 1 calc(50% - 0.5rem); min-width: 0;
    justify-content: center; text-align: center; white-space: normal;
  }
  .results-meta { flex-wrap: wrap; gap: 4px; }
  [data-role="podium-blocks"] { padding: 16px !important; }
  .results-podium-layout {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch; gap: 10px;
  }
  .results-podium-layout > [data-podium-rank="1"] {
    grid-column: 1 / -1; order: -1; max-width: none; margin-top: 0;
  }
  .results-podium-layout > [data-podium-rank="2"],
  .results-podium-layout > [data-podium-rank="3"] { width: 100%; max-width: none; }
  .results-podium-layout > [data-podium-rank] > div:last-child { display: none; }
  .results-standing-row { gap: 8px !important; padding: 10px 12px !important; }
  .results-standing-score { min-width: 60px; }
  .results-standing-score > div:first-child { font-size: 1rem; }
}

/* ── Print ── */
@media print {
  .tabulation-note { display: none !important; }
  .tabulation-scroll { overflow: visible !important; }
  .tabulation-table thead th,
  .tabulation-table .tabulation-sticky-rank,
  .tabulation-table .tabulation-sticky-number,
  .tabulation-table .tabulation-sticky-contestant {
    position: static !important; left: auto !important; box-shadow: none !important;
  }
  .tabulation-table .tabulation-sticky-rank,
  .tabulation-table .tabulation-sticky-number,
  .tabulation-table .tabulation-sticky-contestant {
    width: auto !important; min-width: 0 !important; max-width: none !important;
  }
  .no-print { display: none !important; }
  .print-show { display: block !important; }
  .sidebar, nav, header, footer { display: none !important; }
  @page { size: A4 landscape; margin: 14mm 12mm; }
  html, body {
    background: #fff !important; color: #111 !important;
    font-size: 11px !important;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  main { padding: 0 !important; margin: 0 auto !important; max-width: 100% !important; overflow: visible !important; }
  .card-flat, .section-card, [style*="border-radius:16px"] {
    box-shadow: none !important; border: 1px solid #e2e8f0 !important;
    border-radius: 8px !important; background: #fff !important;
    page-break-inside: avoid; margin-bottom: 12px !important;
  }
  h1, h2, h3, h4, .font-extrabold, .font-black, .font-bold { color: #111 !important; }
  p, span, td, th, div { color: #334155 !important; }
  table { width: 100% !important; border-collapse: collapse !important; }
  th { background: #f1f5f9 !important; color: #334155 !important; font-size: 10px !important; padding: 6px 10px !important; border: 1px solid #e2e8f0 !important; }
  td { padding: 6px 10px !important; border: 1px solid #f1f5f9 !important; color: #334155 !important; font-size: 11px !important; }
  tbody tr:nth-child(even) { background: #f8fafc !important; }
  .animate-fadeup { display: none !important; }
  .animate-fadeup-1, .animate-fadeup-2, .animate-fadeup-3 { display: block !important; }
  #standings-container { display: block !important; page-break-after: always !important; break-after: always !important; }
  .no-print { display: none !important; }
  .animate-fadeup-2:not(.print-tabulation-sheet) { display: none !important; }
  #standings-container .card-flat { box-shadow: none !important; border: 1px solid #e2e8f0 !important; border-radius: 8px !important; }
  .results-standing-row { padding: 6px 12px !important; }
  .print-tabulation-sheet { page-break-before: always; break-before: always; page-break-inside: auto !important; break-inside: auto !important; }
  .data-table { width: 100% !important; min-width: 0 !important; table-layout: fixed !important; }
  .data-table th, .data-table td { padding: 4px 3px !important; font-size: 8px !important; white-space: normal !important; overflow-wrap: anywhere; }
  .data-table th:nth-child(1), .data-table td:nth-child(1) { width: 32px !important; }
  .data-table th:nth-child(2), .data-table td:nth-child(2) { width: 32px !important; }
  .data-table th:nth-child(3), .data-table td:nth-child(3) { width: 18% !important; }
  .data-table th:nth-child(4), .data-table td:nth-child(4) { width: 12% !important; }
  .data-table .print-final-score { width: 9% !important; }
  .data-table tbody tr { page-break-inside: avoid; break-inside: avoid; }
  .print-show { display: block !important; border-bottom: 2px solid #1e3a8a; padding-bottom: 16px; margin-bottom: 16px; }
  .print-show h2 { font-size: 18px !important; font-weight: 900 !important; color: #1e3a8a !important; text-align: center !important; }
  .print-show p { font-size: 11px !important; color: #64748b !important; text-align: center !important; }
  .section-header { background: #f8fafc !important; border-bottom: 1px solid #e2e8f0 !important; padding: 8px 16px !important; }
  .tabulation-score { background: transparent !important; border: none !important; }
}
.print-show { display: none; }
</style>

<script>
document.getElementById("print-date") && (document.getElementById("print-date").textContent = new Date().toLocaleDateString());
</script>

{{> footer }}
</body>
</html>
