<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    /* ── Base ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: #f1f5f9;
      color: #1e293b;
      min-height: 100vh;
    }

    /* ── Screen wrapper ── */
    .screen-nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(10,15,30,0.97); backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 10px 20px;
      display: flex; align-items: center; gap: 10px;
    }
    .nav-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 7px 14px; border-radius: 10px; font-size: 12px; font-weight: 700;
      text-decoration: none; border: 1px solid; cursor: pointer;
      transition: opacity 0.15s;
    }
    .nav-btn:hover { opacity: 0.8; }
    .btn-back  { background: rgba(255,255,255,0.07); color: #94a3b8; border-color: rgba(255,255,255,0.12); }
    .btn-print { background: linear-gradient(135deg,#2563eb,#7c3aed); color: #fff; border-color: transparent; }
    .nav-title { color: #e2e8f0; font-size: 13px; font-weight: 700; margin-left: auto; margin-right: auto; }

    .page-wrap { max-width: 850px; margin: 80px auto 40px; padding: 0 16px; }

    /* ── Paper card ── */
    .paper {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 4px 32px rgba(0,0,0,0.12), 0 1px 4px rgba(0,0,0,0.08);
      overflow: hidden;
      margin-bottom: 20px;
    }

    /* ── Report header / letterhead ── */
    .report-header {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
      padding: 32px 36px 28px;
      position: relative;
      overflow: hidden;
    }
    .report-header::after {
      content: '';
      position: absolute; top: -60px; right: -60px;
      width: 200px; height: 200px; border-radius: 50%;
      background: rgba(255,255,255,0.05);
    }
    .header-top {
      display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;
    }
    .header-logos { display: flex; align-items: center; gap: 10px; }
    .header-logo {
      width: 44px; height: 44px; border-radius: 50%; object-fit: cover;
      border: 2px solid rgba(255,255,255,0.3);
    }
    .header-brand { color: rgba(255,255,255,0.9); font-size: 11px; font-weight: 700; text-align: right; line-height: 1.5; }
    .header-brand span { display: block; color: rgba(255,255,255,0.5); font-weight: 400; }
    .report-label {
      display: inline-block;
      background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.9);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 6px; padding: 3px 10px;
      font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em;
      margin-bottom: 10px;
    }
    .report-event-name {
      font-size: 28px; font-weight: 900; color: #fff;
      letter-spacing: -.02em; line-height: 1.1; margin-bottom: 12px;
    }
    .header-meta { display: flex; flex-wrap: wrap; gap: 14px; }
    .header-meta-item { display: flex; align-items: center; gap: 5px; font-size: 12px; color: rgba(255,255,255,0.75); }
    .header-meta-item svg { flex-shrink: 0; opacity: 0.7; }
    .header-footer {
      margin-top: 18px; padding-top: 14px;
      border-top: 1px solid rgba(255,255,255,0.15);
      display: flex; align-items: center; justify-content: space-between;
      font-size: 11px; color: rgba(255,255,255,0.5);
    }
    .status-pill {
      display: inline-flex; align-items: center; gap: 5px;
      background: rgba(16,185,129,0.2); color: #6ee7b7;
      border: 1px solid rgba(16,185,129,0.3);
      border-radius: 999px; padding: 3px 10px; font-size: 10px; font-weight: 700;
    }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #34d399; }

    /* ── Section header ── */
    .section-head {
      padding: 14px 20px;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fafc;
      display: flex; align-items: center; gap: 8px;
    }
    .section-icon {
      width: 28px; height: 28px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .section-title { font-size: 13px; font-weight: 800; color: #1e293b; }
    .section-sub   { font-size: 11px; color: #94a3b8; margin-top: 1px; }

    /* ── Table base ── */
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    thead th {
      padding: 10px 14px;
      background: #f8fafc;
      color: #64748b; font-size: 10px; font-weight: 700;
      text-transform: uppercase; letter-spacing: .06em;
      text-align: left;
      border-bottom: 1px solid #e2e8f0;
    }
    thead th.right { text-align: right; }
    thead th.center { text-align: center; }
    tbody tr { border-bottom: 1px solid #f1f5f9; transition: background .1s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #f8fafc; }
    tbody td { padding: 10px 14px; color: #334155; vertical-align: middle; }
    tbody td.right { text-align: right; }
    tbody td.center { text-align: center; }

    /* ── Rank badges ── */
    .rank-1 { background: linear-gradient(135deg,#b45309,#f59e0b); color: #fff; }
    .rank-2 { background: linear-gradient(135deg,#475569,#94a3b8); color: #fff; }
    .rank-3 { background: linear-gradient(135deg,#78350f,#d97706); color: #fff; }
    .rank-other { background: #f1f5f9; color: #64748b; }
    .rank-badge {
      display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px; border-radius: 50%;
      font-size: 11px; font-weight: 900;
    }

    /* ── Score chip ── */
    .score-val { font-weight: 700; color: #3b82f6; }
    .score-empty { color: #cbd5e1; }
    .final-score { font-weight: 800; font-size: 13px; color: #0f766e; }
    .gap-val { color: #94a3b8; }

    /* ── Criteria weight bar ── */
    .weight-bar-wrap { width: 60px; height: 5px; background: #e2e8f0; border-radius: 99px; display: inline-block; vertical-align: middle; margin-left: 6px; }
    .weight-bar { height: 100%; border-radius: 99px; background: linear-gradient(90deg,#6366f1,#a78bfa); }

    /* ── Judge score sheet ── */
    .judge-sheet { margin-bottom: 0; }
    .judge-header { padding: 14px 20px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; }
    .judge-avatar { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg,#1e3a8a,#3b82f6); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 900; font-size: 14px; flex-shrink: 0; }
    .judge-name { font-weight: 800; font-size: 13px; color: #1e293b; }
    .judge-sub  { font-size: 11px; color: #94a3b8; }
    .signed-badge   { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; border-radius: 999px; padding: 3px 10px; font-size: 10px; font-weight: 700; }
    .unsigned-badge { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; border-radius: 999px; padding: 3px 10px; font-size: 10px; font-weight: 700; }

    /* ── Signature block ── */
    .sig-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; padding: 20px; }
    .sig-card {
      border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px;
      background: #fff;
    }
    .sig-card.signed { border-color: #bbf7d0; background: #f0fdf4; }
    .sig-card-name { font-weight: 700; font-size: 13px; color: #1e293b; }
    .sig-card-sub  { font-size: 11px; color: #64748b; margin-top: 2px; }
    .sig-attestation { font-size: 10px; color: #64748b; font-style: italic; margin: 10px 0; line-height: 1.5; }
    .sig-line { border-bottom: 1.5px solid #94a3b8; margin: 10px 0 4px; height: 28px; }
    .sig-label { font-size: 10px; color: #94a3b8; }
    .sig-confirmed { font-size: 10px; color: #16a34a; font-weight: 700; }
    .sign-btn {
      display: block; width: 100%; margin-top: 10px; padding: 8px;
      background: linear-gradient(135deg,#4c1d95,#7c3aed); color: #fff;
      border: none; border-radius: 8px; font-size: 11px; font-weight: 700;
      cursor: pointer; text-align: center;
    }
    .sign-btn:hover { opacity: 0.9; }

    /* ── Footer ── */
    .report-footer { text-align: center; padding: 16px; font-size: 10px; color: #94a3b8; border-top: 1px solid #f1f5f9; }

    /* ── Print styles ── */
    @media print {
      body { background: #fff !important; }
      .screen-nav { display: none !important; }
      .page-wrap { margin-top: 0 !important; padding: 0 !important; max-width: 100% !important; }
      .paper { border-radius: 0 !important; box-shadow: none !important; margin-bottom: 0 !important; page-break-inside: avoid; }
      .judge-sheet { page-break-before: always; }
      .sig-section { page-break-before: always; }
      .no-print { display: none !important; }
      tbody tr:hover { background: transparent !important; }
      .sign-btn { display: none !important; }
    }
  </style>
</head>
<body>

<!-- Screen navigation bar -->
<nav class="screen-nav no-print">
  <a href="/events/{{event.id}}/results" class="nav-btn btn-back">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
    Back to Results
  </a>
  <span class="nav-title">📄 Official Report — {{event.name}}</span>
  <button onclick="window.print()" class="nav-btn btn-print">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
    Print / Save PDF
  </button>
</nav>

<div class="page-wrap">

  <!-- ── Paper 1: Header + Criteria + Rankings ── -->
  <div class="paper">

    <!-- Letterhead -->
    <div class="report-header">
      <div class="header-top">
        <div class="header-logos">
          <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="header-logo"/>
        </div>
        <div class="header-brand">
          ScoreSync
          <span>Official Competition Report</span>
        </div>
      </div>
      <div class="report-label">Official Report</div>
      <div class="report-event-name">{{event.name}}</div>
      <div class="header-meta">
        {{#if event.date}}
        <div class="header-meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          {{event.date}}{{#if event.time}} at {{event.time}}{{/if}}
        </div>
        {{/if}}
        {{#if event.venue}}
        <div class="header-meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {{event.venue}}
        </div>
        {{/if}}
        {{#if event.type}}
        <div class="header-meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <span class="capitalize">{{#if (eq event.type "other")}}{{#if event.otherType}}{{event.otherType}}{{else}}Other{{/if}}{{else}}{{event.type}}{{/if}}</span>
        </div>
        {{/if}}
        {{#if event.organizer}}
        <div class="header-meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          {{event.organizer}}
        </div>
        {{/if}}
      </div>
      <div class="header-footer">
        <span>Generated: {{generatedAt}}</span>
        <div class="status-pill">
          <span class="status-dot"></span>
          {{judgeCount}} judge(s) &bull; {{ranked.length}} contestant(s) &bull; {{criteria.length}} criteria
        </div>
      </div>
    </div>

    <!-- Scoring Criteria -->
    {{#if criteria.length}}
    <div class="section-head">
      <div class="section-icon" style="background:rgba(99,102,241,0.1)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <div>
        <div class="section-title">Scoring Criteria</div>
        <div class="section-sub">{{criteria.length}} criteria — weights must total 100%</div>
      </div>
    </div>
    <table>
      <thead><tr>
        <th class="center" style="width:40px">#</th>
        <th>Criteria Name</th>
        <th class="right">Weight</th>
        <th class="right">Max Score</th>
      </tr></thead>
      <tbody>
        {{#each criteria}}
        <tr>
          <td class="center" style="color:#94a3b8;font-size:11px">{{add1 @index}}</td>
          <td style="font-weight:600;color:#1e293b">{{name}}</td>
          <td class="right">
            <span style="font-weight:700;color:#6366f1">{{weight}}%</span>
            <span class="weight-bar-wrap"><span class="weight-bar" style="width:{{weight}}%"></span></span>
          </td>
          <td class="right" style="color:var(--text-muted)">{{maxScore}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}

    <!-- Official Ranked Results -->
    {{#if ranked.length}}
    <div class="section-head" style="margin-top:1px">
      <div class="section-icon" style="background:rgba(245,158,11,0.1)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
      </div>
      <div>
        <div class="section-title">Official Ranked Results</div>
        <div class="section-sub">Final weighted scores — averaged across all judges</div>
      </div>
    </div>
    <div style="overflow-x:auto">
      <table>
        <thead><tr>
          <th class="center">Rank</th>
          <th class="center">No.</th>
          <th>Name</th>
          <th>Barangay</th>
          {{#each criteria}}<th class="right" style="max-width:80px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{name}}</th>{{/each}}
          <th class="right">Final Score</th>
          <th class="right">Gap</th>
        </tr></thead>
        <tbody>
          {{#each ranked}}
          <tr style="{{#if (eq rank 1)}}background:#fffbeb;{{/if}}">
            <td class="center">
              <span class="rank-badge {{#if (eq rank 1)}}rank-1{{else}}{{#if (eq rank 2)}}rank-2{{else}}{{#if (eq rank 3)}}rank-3{{else}}rank-other{{/if}}{{/if}}{{/if}}">{{rank}}</span>
            </td>
            <td class="center" style="font-weight:700;color:#64748b;font-size:11px">{{number}}</td>
            <td style="font-weight:700;color:#1e293b">
              {{name}}
              {{#if tieBroken}}<span style="font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;background:#fef3c7;color:#92400e;margin-left:4px">⚖ Tie Broken</span>{{/if}}
            </td>
            <td style="font-size:11px;color:#64748b">{{barangay}}</td>
            {{#each breakdown}}<td class="right score-val">{{avg}}</td>{{/each}}
            <td class="right final-score">{{finalScoreDisplay}}%</td>
            <td class="right gap-val" style="font-size:11px">{{#if (eq rank 1)}}—{{else}}-{{gapToFirst}}{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/if}}

    <div class="report-footer">
      ScoreSync — Official Competition Report &bull; Municipality of Gloria, Oriental Mindoro &bull; {{generatedAt}}
    </div>
  </div>

  <!-- ── Per-judge score sheets ── -->
  {{#each judgeBreakdown}}
  <div class="paper judge-sheet">
    <div class="judge-header">
      <div style="display:flex;align-items:center;gap:10px">
        <div class="judge-avatar">{{initial}}</div>
        <div>
          <div class="judge-name">{{alias}} — Individual Score Sheet</div>
          <div class="judge-sub">{{judgeName}} &bull; {{scoredCount}} of {{totalContestants}} contestants scored ({{completionPct}}%)</div>
        </div>
      </div>
      {{#if signed}}
      <span class="signed-badge">✓ Digitally Signed</span>
      {{/if}}
    </div>
    {{#if contestantScores.length}}
    <div style="overflow-x:auto">
      <table>
        <thead><tr>
          <th class="center">No.</th>
          <th>Contestant Name</th>
          <th>Barangay</th>
          {{#each ../criteria}}<th class="right">{{name}}</th>{{/each}}
          <th class="right">Weighted Total</th>
        </tr></thead>
        <tbody>
          {{#each contestantScores}}
          <tr>
            <td class="center" style="font-weight:700;color:#64748b;font-size:11px">{{number}}</td>
            <td style="font-weight:600;color:#1e293b">{{name}}</td>
            <td style="font-size:11px;color:#64748b">{{barangay}}</td>
            {{#each scores}}
            <td class="right">
              {{#if value}}<span class="score-val">{{value}}</span>{{else}}<span class="score-empty">—</span>{{/if}}
            </td>
            {{/each}}
            <td class="right final-score">{{total}}%</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/if}}
    <div class="report-footer">{{alias}} &bull; {{../event.name}} &bull; {{../generatedAt}}</div>
  </div>
  {{/each}}

  <!-- ── Signature block ── -->
  {{#if judgeBreakdown.length}}
  <div class="paper sig-section">
    <div class="section-head">
      <div class="section-icon" style="background:rgba(16,185,129,0.1)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div>
        <div class="section-title">Judge Certification &amp; Digital Signatures</div>
        <div class="section-sub">Each judge certifies that their scores are accurate and reflect their honest evaluation.</div>
      </div>
    </div>
    <div class="sig-grid">
      {{#each judgeBreakdown}}
      <div class="sig-card {{#if signed}}signed{{/if}}">
        <div class="sig-card-name">{{alias}}</div>
        <div class="sig-card-sub">{{judgeName}}</div>
        <div class="sig-card-sub" style="margin-top:4px">{{scoredCount}}/{{totalContestants}} contestants &bull; {{completionPct}}%</div>
        <p class="sig-attestation">"I certify that the above scores are accurate and reflect my honest evaluation of each contestant."</p>
        {{#if signed}}
        <div class="sig-confirmed">✓ Digitally confirmed{{#if signedAt}} — {{signedAt}}{{/if}}</div>
        {{else}}
        <div class="sig-line"></div>
        <div class="sig-label">Signature / Digital Confirmation</div>
        {{#if isSelf}}
        <form method="POST" action="/events/{{../event.id}}/report/sign" class="no-print">
          <input type="hidden" name="_csrf" value="{{../csrfToken}}">
          <button type="submit" class="sign-btn">✍ Confirm &amp; Sign</button>
        </form>
        {{/if}}
        {{/if}}
      </div>
      {{/each}}
    </div>
    <div class="report-footer">
      ScoreSync &bull; Official Competition Report &bull; {{event.name}} &bull; {{generatedAt}}
    </div>
  </div>
  {{/if}}

</div>

{{#if success_msg}}<div style="position:fixed;bottom:20px;right:20px;background:#065f46;color:#6ee7b7;border:1px solid rgba(16,185,129,0.3);border-radius:12px;padding:12px 18px;font-size:12px;font-weight:700;z-index:200;font-family:Inter,sans-serif">{{success_msg}}</div>{{/if}}
{{#if error_msg}}<div style="position:fixed;bottom:20px;right:20px;background:#7f1d1d;color:#fca5a5;border:1px solid rgba(239,68,68,0.3);border-radius:12px;padding:12px 18px;font-size:12px;font-weight:700;z-index:200;font-family:Inter,sans-serif">{{error_msg}}</div>{{/if}}

</body>
</html>
