{{> head}}
<body class="min-h-screen flex flex-col ss-page-bg">
{{> navbar}}
<div class="flex flex-1 overflow-hidden">
{{> sidebar}}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">

  <!-- Sticky toolbar -->
  <div class="sticky top-0 z-20 -mx-4 sm:-mx-6 px-4 sm:px-6 py-3 no-print" style="background:rgba(7,12,24,0.97);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.07);box-shadow:0 4px 32px rgba(0,0,0,0.5)">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-3 min-w-0">
        <a href="/events/{{parentEvent.id}}" class="btn-sm btn-sm-gray text-xs no-print flex items-center gap-1.5 flex-shrink-0">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          Back to {{parentEvent.name}}
        </a>
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 shadow-lg" style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="min-w-0">
          <div class="font-extrabold text-sm truncate" style="color:var(--text-primary)">Overall Results — {{parentEvent.name}}</div>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:rgba(124,58,237,0.15);color:#a78bfa">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              {{overall.length}} contestants
            </span>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:rgba(5,150,105,0.15);color:#34d399">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              {{subEvents.length}} sub-events
            </span>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <button onclick="window.print()" class="btn-sm btn-sm-gray text-xs no-print">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Print
        </button>
      </div>
    </div>
  </div>

  {{#if error_msg}}<div class="alert-error animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>{{error_msg}}</div>{{/if}}

  <!-- Rankings Podium -->
  <div class="card-flat p-6 animate-fadeup">
    <h2 class="font-extrabold text-base mb-5 flex items-center gap-2" style="color:var(--text-primary)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5"><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/><path d="M15 7a3 3 0 1 0-6 0"/><path d="M12 2v5"/><path d="M6.5 7.5H3l1.5 5H7"/><path d="M17.5 7.5H21l-1.5 5H17"/></svg>
      Overall Rankings
    </h2>
    {{#if overall.length}}
    <div class="grid gap-3">
      {{#each overall}}
      <div class="flex items-center gap-4 rounded-xl px-4 py-3 animate-fadeup" style="{{#if (eq rank 1)}}background:linear-gradient(90deg,rgba(234,179,8,0.15),rgba(234,179,8,0.05));border:1px solid rgba(234,179,8,0.3){{else}}{{#if (eq rank 2)}}background:linear-gradient(90deg,rgba(148,163,184,0.12),rgba(148,163,184,0.04));border:1px solid rgba(148,163,184,0.25){{else}}{{#if (eq rank 3)}}background:linear-gradient(90deg,rgba(180,83,9,0.12),rgba(180,83,9,0.04));border:1px solid rgba(180,83,9,0.25){{else}}background:rgba(255,255,255,0.03);border:1px solid var(--border){{/if}}{{/if}}{{/if}}">
        <div class="w-10 h-10 rounded-full flex items-center justify-center font-black text-sm flex-shrink-0" style="{{#if (eq rank 1)}}background:linear-gradient(135deg,#f59e0b,#d97706);color:#1c1917{{else}}{{#if (eq rank 2)}}background:linear-gradient(135deg,#94a3b8,#64748b);color:#0f172a{{else}}{{#if (eq rank 3)}}background:linear-gradient(135deg,#b45309,#92400e);color:#fff{{else}}background:rgba(255,255,255,0.08);color:var(--text-secondary){{/if}}{{/if}}{{/if}}">
          {{rank}}
        </div>
        <div class="flex-1 min-w-0">
          <div class="font-bold text-sm truncate" style="color:var(--text-primary)">{{name}}</div>
          <div class="flex flex-wrap gap-1.5 mt-1">
            {{#each scores}}
            <span class="text-[10px] px-2 py-0.5 rounded-full" style="background:rgba(99,102,241,0.12);color:#a5b4fc;border:1px solid rgba(99,102,241,0.2)">{{subEventName}}: {{score}}%</span>
            {{/each}}
          </div>
        </div>
        <div class="text-right flex-shrink-0">
          <div class="font-black text-xl" style="{{#if (eq rank 1)}}color:#f59e0b{{else}}{{#if (eq rank 2)}}color:#94a3b8{{else}}{{#if (eq rank 3)}}color:#b45309{{else}}color:var(--text-primary){{/if}}{{/if}}{{/if}}">{{average}}%</div>
          <div class="text-[10px]" style="color:var(--text-muted)">overall avg</div>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="text-center py-12" style="color:var(--text-muted)">
      <svg class="mx-auto mb-3" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <p class="text-sm font-medium">No results yet</p>
      <p class="text-xs mt-1">Sub-events need contestants and scores to show overall rankings.</p>
    </div>
    {{/if}}
  </div>

  <!-- Breakdown Table (rendered via JS with embedded JSON) -->
  <div class="card-flat p-6 animate-fadeup-1" id="breakdown-section">
    <h2 class="font-extrabold text-base mb-4 flex items-center gap-2" style="color:var(--text-primary)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      Score Breakdown by Sub-Event
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm" id="breakdown-table" style="border-collapse:collapse">
        <thead id="breakdown-thead"></thead>
        <tbody id="breakdown-tbody"></tbody>
      </table>
    </div>
    <p id="breakdown-empty" class="text-center py-8 text-sm" style="color:var(--text-muted);display:none">No sub-event score data available.</p>
  </div>

  <!-- Embedded data for JS table rendering -->
  <script id="series-data" type="application/json">{
    "overall": {{{overallJson}}},
    "subEventResults": {{{subEventResultsJson}}}
  }</script>

  <script>
  (function() {
    try {
      var data = JSON.parse(document.getElementById('series-data').textContent);
      var overall = data.overall;
      var subEventResults = data.subEventResults;

      if (!overall.length || !subEventResults.length) {
        document.getElementById('breakdown-empty').style.display = '';
        document.getElementById('breakdown-table').style.display = 'none';
        return;
      }

      // Build header: Contest | Contestant1 | Contestant2 ...
      var thead = document.getElementById('breakdown-thead');
      var tr = document.createElement('tr');
      var thContest = document.createElement('th');
      thContest.textContent = 'Sub-Event';
      thContest.style.cssText = 'text-align:left;padding:10px 14px;font-size:0.75rem;font-weight:700;color:var(--text-muted);border-bottom:1px solid var(--border);white-space:nowrap';
      tr.appendChild(thContest);
      overall.forEach(function(c) {
        var th = document.createElement('th');
        th.textContent = c.name;
        th.style.cssText = 'text-align:center;padding:10px 14px;font-size:0.75rem;font-weight:700;color:var(--text-secondary);border-bottom:1px solid var(--border);white-space:nowrap';
        tr.appendChild(th);
      });
      thead.appendChild(tr);

      // Build sub-event rows
      var tbody = document.getElementById('breakdown-tbody');
      subEventResults.forEach(function(ser) {
        var row = document.createElement('tr');
        row.style.cssText = 'border-bottom:1px solid rgba(255,255,255,0.04)';
        var tdName = document.createElement('td');
        tdName.textContent = ser.subEventName;
        tdName.style.cssText = 'padding:10px 14px;font-size:0.8rem;font-weight:600;color:var(--text-primary);white-space:nowrap';
        row.appendChild(tdName);
        overall.forEach(function(c) {
          var td = document.createElement('td');
          var key = c.name.trim().toLowerCase();
          var score = ser.scoreByName[key];
          td.textContent = (score !== undefined && score !== null) ? score + '%' : '—';
          td.style.cssText = 'text-align:center;padding:10px 14px;font-size:0.8rem;color:' + (score > 0 ? 'var(--text-primary)' : 'var(--text-muted)') + ';';
          row.appendChild(td);
        });
        tbody.appendChild(row);
      });

      // Overall average row
      var totalRow = document.createElement('tr');
      totalRow.style.cssText = 'border-top:2px solid rgba(124,58,237,0.3);background:rgba(124,58,237,0.06)';
      var tdLabel = document.createElement('td');
      tdLabel.textContent = 'Overall Score';
      tdLabel.style.cssText = 'padding:12px 14px;font-size:0.8rem;font-weight:800;color:#a78bfa;white-space:nowrap';
      totalRow.appendChild(tdLabel);
      overall.forEach(function(c) {
        var td = document.createElement('td');
        td.textContent = c.average + '%';
        td.style.cssText = 'text-align:center;padding:12px 14px;font-size:0.8rem;font-weight:800;color:#a78bfa';
        totalRow.appendChild(td);
      });
      tbody.appendChild(totalRow);

    } catch(e) {
      console.error('Series breakdown table error:', e);
      document.getElementById('breakdown-empty').style.display = '';
    }
  })();
  </script>

</main>
</div>
{{> footer}}
</body>
