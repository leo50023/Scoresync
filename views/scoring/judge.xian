{{> head }}
<body class="min-h-screen flex flex-col" style="background:#060b18;overflow-x:hidden">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto overflow-x-hidden pb-32" id="scoring-main" style="min-width:0">

  <!-- ══ TOP BAR ══ -->
  <div class="sticky top-0 z-20 no-print" style="background:rgba(6,11,24,0.97);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.06)">

    <!-- Row 1: Event + judge info + ring -->
    <div class="px-4 sm:px-6 py-2.5 flex items-center justify-between gap-3">
      <div class="min-w-0">
        <div class="font-extrabold text-sm truncate" style="color:#e2e8f0">{{event.name}}</div>
        <div class="text-xs" style="color:#475569">
          Judge: <span style="color:#818cf8">{{userName}}</span>
          &bull; Contestant <span id="hdr-pos" style="color:#e2e8f0">1</span> of {{contestants.length}}
          &bull; <span id="hdr-scored" style="color:#6ee7b7">0</span> of {{contestants.length}} scored
        </div>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-xs" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08)">
          <svg id="completion-ring" width="28" height="28" viewBox="0 0 28 28">
            <circle cx="14" cy="14" r="10" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="3"/>
            <circle id="ring-progress" cx="14" cy="14" r="10" fill="none" stroke="#c9a227" stroke-width="3"
              stroke-dasharray="62.83" stroke-dashoffset="62.83" stroke-linecap="round"
              transform="rotate(-90 14 14)" style="transition:stroke-dashoffset 0.5s,stroke 0.3s"/>
          </svg>
          <span id="overall-pct" class="font-extrabold" style="color:#e2e8f0">0%</span>
        </div>
        <a href="/events/{{event.id}}/results" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3)">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          {{#if readOnly}}View Results{{else}}Live Results{{/if}}
        </a>

      </div>
    </div>

    <!-- Row 2: Contestant nav dots -->
    <div class="px-4 sm:px-6 py-2 flex items-center gap-1.5 overflow-x-auto" style="border-top:1px solid rgba(255,255,255,0.04)">
      <span class="text-[10px] font-extrabold uppercase tracking-wider flex-shrink-0 mr-1" style="color:#374151">Go to:</span>
      {{#each contestants}}
      <button type="button"
        class="nav-dot flex-shrink-0 min-w-[32px] h-8 px-2 rounded-full text-[11px] font-extrabold transition-all border"
        data-idx="{{@index}}"
        style="background:rgba(255,255,255,0.05);color:#475569;border-color:rgba(255,255,255,0.08)"
        onclick="goToContestant({{@index}})">{{number}}</button>
      {{/each}}
    </div>
  </div>

  {{#if success_msg}}<div class="alert-success m-4">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error m-4">{{error_msg}}</div>{{/if}}

  {{#if readOnly}}
  <div class="mx-4 mt-3 rounded-xl px-4 py-3 flex flex-wrap items-center justify-between gap-3 no-print" style="background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.25)">
  <div class="text-xs" style="color:#bfdbfe">Event completed. Scores are available in read-only mode.</div>
    <a href="/events/{{event.id}}/results" class="text-xs font-bold" style="color:#6ee7b7">View event results →</a>
  </div>
  {{/if}}

  {{#if hasExistingScores}}
  <div class="mx-4 mt-3 rounded-xl px-4 py-3 flex items-start gap-2.5 no-print" style="background:rgba(201,162,39,0.08);border:1px solid rgba(201,162,39,0.25)">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c9a227" stroke-width="2" class="flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div class="text-xs" style="color:#f0c040">{{#if readOnly}}Your submitted scores are shown below for review.{{else}}You have previously submitted scores for this event. Your existing scores are shown below — you can update them and re-submit.{{/if}}</div>
  </div>
  {{/if}}

  {{#if contestants.length}}
  <form id="scoringForm" method="POST" action="/events/{{event.id}}/scoring">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">

    {{#each contestants}}
    <!-- ══ Contestant Panel ══ -->
    <div class="contestant-panel" data-idx="{{@index}}" data-contestant-id="{{id}}"
      style="background:linear-gradient(160deg,#0a1628 0%,#0d1f3c 100%);border:1px solid rgba(201,162,39,0.2);border-radius:20px;margin:16px;padding:0;overflow:hidden">

      <!-- Two-column layout: photo left, scoring right -->
      <div class="judge-card-inner">

        <!-- ── Left column: Photo ── -->
        <div class="judge-photo-col">
          {{#if photo}}
          <div class="judge-photo-frame" style="position:relative;width:100%;aspect-ratio:3/4;max-height:420px;border-radius:16px;overflow:hidden;background:#081326">
            <img src="{{photo}}" alt="{{name}}"
              style="width:100%;height:100%;object-fit:contain;object-position:center;border-radius:16px;border:2px solid #c9a227;display:block;box-shadow:0 0 0 2px #c9a227,0 0 32px rgba(201,162,39,0.25)"/>
            <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,0.07) 0%,transparent 40%);pointer-events:none;border-radius:16px"></div>
          </div>
          {{else}}
          <div class="judge-photo-frame judge-photo-placeholder" style="width:100%;aspect-ratio:3/4;max-height:420px;border-radius:16px;border:1px solid rgba(201,162,39,0.35);background:radial-gradient(ellipse at 50% 30%,rgba(201,162,39,0.12),transparent 55%),linear-gradient(160deg,#101f38,#091326);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px">
            <div class="judge-photo-placeholder-icon">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/><path d="M4 4.5 5.5 6M20 4.5 18.5 6"/></svg>
            </div>
            <div class="text-center px-3">
              <div style="font-size:0.9rem;font-weight:800;color:#e2e8f0">{{name}}</div>
              <div style="font-size:0.68rem;font-weight:700;color:#94a3b8;margin-top:4px">Contestant #{{number}}</div>
              <div style="font-size:0.6rem;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:0.12em;margin-top:12px">Photo not uploaded</div>
            </div>
          </div>
          {{/if}}
        </div>

        <!-- ── Right column: Scoring ── -->
        <div class="judge-scoring-col" style="position:relative">

          <!-- Crown SVG watermark -->
          <svg width="80" height="80" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="position:absolute;top:12px;right:16px;opacity:0.04;pointer-events:none;z-index:0" stroke="#c9a227" stroke-width="1.2"><path d="M2 20h20M4 20l2-8 6 4 6-4 2 8"/><circle cx="4" cy="10" r="2" fill="#c9a227"/><circle cx="12" cy="6" r="2" fill="#c9a227"/><circle cx="20" cy="10" r="2" fill="#c9a227"/></svg>

          <!-- Header: crown + judging system label -->
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
            <span style="font-size:1.1rem;line-height:1">👑</span>
            <span style="font-size:0.65rem;font-weight:900;letter-spacing:0.22em;text-transform:uppercase;color:#c9a227">Judging System</span>
          </div>

          <!-- Contestant name + number -->
          <div style="margin-bottom:4px;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
            <h2 style="font-size:1.45rem;font-weight:900;letter-spacing:0.01em;color:#f1f5f9;margin:0;line-height:1.15">{{name}}</h2>
            <span style="font-size:1rem;font-weight:900;color:#c9a227">#{{number}}</span>
          </div>

          <!-- Barangay / age -->
          <div style="font-size:0.75rem;color:#94a3b8;margin-bottom:16px">
            {{#if barangay}}<span>Brgy. {{barangay}}</span>{{/if}}
            {{#if age}}<span style="margin-left:6px">&bull; {{age}} yrs</span>{{/if}}
            {{#if platform}}<span style="margin-left:6px">&bull; {{platform}}</span>{{/if}}
          </div>

          <!-- Gold divider -->
          <div style="height:1px;background:linear-gradient(90deg,rgba(201,162,39,0.4),rgba(201,162,39,0.08));margin:0 0 14px 0;border-radius:1px"></div>

          <!-- ── Criteria rows (all visible at once) ── -->
          {{#each scores}}
          <div class="criteria-panel" data-contestant-id="{{../id}}" data-criteria-idx="{{@index}}"
            style="background:rgba(255,255,255,0.04);border:1px solid rgba(201,162,39,0.15);border-radius:10px;padding:14px 16px;margin-bottom:6px;transition:border-color 0.2s,background 0.2s">

            <!-- Criteria name row -->
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;gap:8px;flex-wrap:wrap">
              <span style="font-size:0.86rem;font-weight:700;color:#f1f5f9;text-transform:capitalize">{{criteriaName}}</span>
              <span style="font-size:0.7rem;font-weight:900;background:linear-gradient(135deg,#8b6914,#c9a227);color:#0a1628;padding:3px 12px;border-radius:999px;flex-shrink:0">{{weight}}%</span>
            </div>

            <!-- Progress bar + input row -->
            <div style="display:flex;align-items:center;gap:8px;min-width:0;flex-wrap:wrap">
              <!-- Progress bar -->
              <div style="flex:1;height:8px;border-radius:6px;overflow:hidden;background:rgba(255,255,255,0.06);min-width:0">
                <div class="criteria-bar" style="height:100%;width:0%;border-radius:6px;background:linear-gradient(90deg,#8b6914,#c9a227,#f0c040);background-size:200% auto;animation:shimmer 2.5s linear infinite;transition:width 0.3s ease"></div>
              </div>
              <!-- Visible score input -->
              <div style="display:flex;align-items:center;gap:4px;flex-shrink:0">
                <input type="number"
                  class="score-entry-input"
                  min="0" max="{{maxScore}}" step="0.01"
                  placeholder="0"
                  value="{{value}}"
                  {{#if ../../readOnly}}readonly aria-readonly="true"{{/if}}
                  data-max="{{maxScore}}"
                  oninput="handleScoreInput(this)"
                  style="width:72px;height:44px;font-size:16px !important;font-weight:900;text-align:center;border-radius:10px;border:1.5px solid rgba(201,162,39,0.4);background:rgba(0,0,0,0.35);color:#f0c040;outline:none;-webkit-appearance:none;-moz-appearance:textfield;min-height:44px"/>
                <span style="font-size:0.68rem;font-weight:700;color:#64748b;white-space:nowrap">/{{maxScore}}</span>
              </div>
            </div>

            <!-- Hidden elements for JS compatibility (display:none wrapper) -->
            <div style="display:none">
              <span class="score-display"></span>
              <span class="criteria-pct"></span>
              <span class="criteria-pct-label"></span>
              <span class="weighted-preview"></span>
              <svg><circle class="criteria-ring" stroke-dasharray="163.36" stroke-dashoffset="163.36"/></svg>
              <!-- Actual hidden form input -->
              <input type="number"
                name="scores[{{../id}}][{{criteriaId}}]"
                value="{{value}}"
                min="0" max="{{maxScore}}" step="0.01"
                class="score-input sr-only"
                {{#if ../../readOnly}}readonly{{/if}}
                data-weight="{{weight}}" data-max="{{maxScore}}"
                tabindex="-1"/>
            </div>

          </div>
          {{/each}}

          <!-- Live total display -->
          <div class="contestant-total-display" style="display:flex;align-items:center;justify-content:space-between;padding:12px 0 4px 0;border-top:1px solid rgba(201,162,39,0.15);margin-top:8px">
            <span style="font-size:0.75rem;font-weight:900;text-transform:uppercase;letter-spacing:0.1em;color:#94a3b8">Total</span>
            <div style="display:flex;align-items:center">
              <span class="contestant-total" style="font-size:2rem;font-weight:900;background:linear-gradient(135deg,#f0c040,#c9a227);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">0.00%</span>
              <span class="contestant-fill-label" style="font-size:0.65rem;font-weight:900;background:rgba(201,162,39,0.12);color:#f0c040;border:1px solid rgba(201,162,39,0.25);padding:2px 8px;border-radius:999px;margin-left:8px;white-space:nowrap">0/{{scores.length}} filled</span>
            </div>
          </div>

          <!-- Overall progress bar (thin) -->
          <div style="height:6px;border-radius:2px;overflow:hidden;background:rgba(255,255,255,0.04);margin-bottom:14px;margin-top:4px">
            <div class="contestant-progress-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#8b6914,#c9a227,#f0c040);transition:width 0.5s ease"></div>
          </div>

          <!-- SUBMIT button -->
          {{#unless ../readOnly}}
          <button type="button"
            class="submit-btn"
            onclick="submitContestant({{@index}})"
            style="width:100%;padding:16px;border-radius:14px;background:linear-gradient(135deg,#8b6914,#c9a227,#f0c040,#c9a227);background-size:300% auto;color:#0a1628;font-weight:900;font-size:15px;border:none;cursor:pointer;letter-spacing:0.1em;text-transform:uppercase;box-shadow:0 4px 24px rgba(201,162,39,0.4)">
            ✓ Submit Scores
          </button>
          {{else}}
          <div class="py-3 text-center text-xs font-bold rounded-xl" style="background:rgba(255,255,255,0.04);color:#94a3b8;border:1px solid rgba(255,255,255,0.08)">Read-only score review</div>
          {{/unless}}

        </div><!-- /.judge-scoring-col -->
      </div><!-- /.judge-card-inner -->

    </div>
    {{/each}}

  </form>

  {{else}}
  <div class="p-16 text-center">
    <p style="color:#475569">No contestants yet.</p>
    <a href="/events/{{event.id}}" class="text-indigo-400 text-sm mt-2 inline-block">Back to event</a>
  </div>
  {{/if}}

</main>
</div>

<!-- Sticky bottom nav bar (Prev / Next contestant) -->
<div class="fixed bottom-0 left-0 right-0 z-30 no-print" style="background:rgba(6,11,24,0.97);backdrop-filter:blur(16px);border-top:1px solid rgba(255,255,255,0.06);box-shadow:0 -4px 32px rgba(0,0,0,0.5)">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-3">
    <button type="button" id="btn-prev-contestant"
      class="flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm transition disabled:opacity-30"
      style="background:rgba(255,255,255,0.06);color:#94a3b8;border:1px solid rgba(255,255,255,0.1)"
      onclick="goToContestant(window._currentIdx - 1)">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Previous
    </button>
    <div class="flex-1 text-center text-xs font-bold" style="color:#374151">
      Contestant <span id="bottom-pos" style="color:#c9a227">1</span> / {{contestants.length}}
    </div>
    <button type="button" id="btn-next-contestant"
      class="flex items-center gap-2 px-5 py-2.5 rounded-xl font-extrabold text-sm transition active:scale-[0.98]"
      style="background:linear-gradient(135deg,#8b6914,#c9a227);color:#0a1628;box-shadow:0 4px 16px rgba(201,162,39,0.3)"
      onclick="goToContestant(window._currentIdx + 1)">
      Next →
    </button>
  </div>
</div>

<style>
/* Two-column judge card */
.judge-card-inner {
  display: flex;
  flex-direction: row;
  align-items: stretch;
}
.judge-photo-col {
  width: 280px;
  flex-shrink: 0;
  padding: 20px 0 20px 20px;
  display: flex;
  align-items: center;
}
.judge-photo-col img, .judge-photo-col > div {
  width: 100%;
  border-radius: 14px;
}
.judge-photo-frame {
  max-width: 100%;
}
.judge-photo-placeholder {
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 16px 36px rgba(0,0,0,0.22);
}
.judge-photo-placeholder-icon {
  width: 76px;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d6b54a;
  border: 1px solid rgba(201,162,39,0.28);
  border-radius: 50%;
  background: rgba(201,162,39,0.08);
}
.judge-photo-frame img {
  object-fit: contain;
}
.judge-scoring-col {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  padding: 20px 16px 20px 16px;
  display: flex;
  flex-direction: column;
}

/* Mobile: stack photo on top */
@media (max-width: 640px) {
  .judge-card-inner {
    flex-direction: column;
    grid-template-columns: 1fr;
  }
  .judge-photo-col {
    width: 100%;
    padding: 12px 12px 0 12px;
    display: flex;
    justify-content: center;
  }
  .judge-photo-frame {
    width: min(100%, 240px) !important;
  }
  .judge-photo-placeholder {
    min-height: 280px;
  }
  .judge-photo-col img, .judge-photo-col > div {
    max-height: 320px !important;
  }
  .judge-scoring-col {
    padding: 12px;
  }
  /* Full-width score input on mobile */
  .score-entry-input {
    width: 100% !important;
    min-height: 44px !important;
    font-size: 16px !important;
  }
}

/* Score entry input focus glow */
.score-entry-input:focus {
  border-color: #f0c040 !important;
  box-shadow: 0 0 0 2px rgba(240,192,64,0.25) !important;
}
/* Hide number input spinners */
.score-entry-input::-webkit-outer-spin-button,
.score-entry-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.score-entry-input { -moz-appearance: textfield; }

.nav-dot.scored { background:rgba(16,185,129,0.25) !important;color:#6ee7b7 !important;border-color:rgba(16,185,129,0.5) !important; }
.nav-dot.active-dot { background:rgba(201,162,39,0.25) !important;color:#f0c040 !important;border-color:rgba(201,162,39,0.6) !important; }

/* All interactive elements: fast transitions */
.nav-dot, [onclick] {
  transition: background 60ms ease, color 60ms ease, border-color 60ms ease !important;
  -webkit-tap-highlight-color: transparent;
}
/* Hide scrollbars */
main::-webkit-scrollbar { display:none; }

/* GPU compositing hints */
.nav-dot { will-change: background, transform; }
#scoring-main { will-change: scroll-position; }

/* Criteria panel hover & filled state */
.criteria-panel:hover { border-color: rgba(201,162,39,0.35) !important; background: rgba(255,255,255,0.07) !important; }
.criteria-panel.has-score { border-left: 3px solid #c9a227 !important; }

/* Shimmer animation for progress bar fill */
@keyframes shimmer {
  0%   { background-position: 200% center; }
  100% { background-position: -200% center; }
}

/* Submit button */
.submit-btn {
  background-size: 300% auto;
  transition: background-position 80ms ease, box-shadow 80ms ease, opacity 80ms ease;
}
.submit-btn:hover {
  background-position: right center;
  box-shadow: 0 6px 32px rgba(201,162,39,0.6);
}
</style>

<script>
(function() {
  const CIRC10 = 2 * Math.PI * 10; // r=10 → 62.83
  const storeKey = "scoresync_draft_{{event.id}}_{{judgeId}}";
  let saveTimer;
  window._currentIdx = 0;
  window._currentCriteria = {}; // kept for compatibility, not used for display
  window._hasExistingScores = {{#if hasExistingScores}}true{{else}}false{{/if}};
  const totalContestants = {{contestants.length}};

  /* ══ Pre-fill visible inputs from existing hidden values ══ */
  document.querySelectorAll('.criteria-panel').forEach(panel => {
    const input   = panel.querySelector('.score-input');
    const entryEl = panel.querySelector('.score-entry-input');
    if (!entryEl || !input) return;
    if (input.value) {
      entryEl.value = input.value;
      updateBox(panel);
    }
  });

  /* ══ Handle score text input ══ */
  window.handleScoreInput = function(entryEl) {
    const panel  = entryEl.closest('.criteria-panel');
    const input  = panel.querySelector('.score-input');
    const max    = parseFloat(entryEl.dataset.max) || 100;
    let val      = parseFloat(entryEl.value);

    if (isNaN(val) || entryEl.value === '') {
      input.value = '';
      entryEl.style.borderColor = 'rgba(201,162,39,0.4)';
      updateBox(panel);
      schedSave();
      return;
    }
    if (val < 0) val = 0;
    if (val > max) {
      val = max;
      entryEl.value = max;
      entryEl.style.borderColor = 'rgba(239,68,68,0.6)';
    } else {
      entryEl.style.borderColor = 'rgba(201,162,39,0.7)';
    }
    input.value = val;
    updateBox(panel);
    schedSave();
  };

  /* ══ updateBox: update progress bar + totals ══ */
  function updateBox(panel) {
    const input  = panel.querySelector('.score-input');
    const val    = parseFloat(input.value) || 0;
    const max    = parseFloat(input.dataset.max) || 100;
    const weight = parseFloat(input.dataset.weight) || 0;
    const pct    = max > 0 ? (val / max) * 100 : 0;
    const contrib = (val / max) * weight;

    // Gold progress bar
    const bar = panel.querySelector('.criteria-bar');
    if (bar) { bar.style.width = pct.toFixed(1) + '%'; }

    // Toggle filled state accent
    panel.classList.toggle('has-score', val > 0);

    // Hidden compat elements
    const disp = panel.querySelector('.score-display');
    if (disp) disp.textContent = val > 0 ? val : '—';
    const pctEl = panel.querySelector('.criteria-pct');
    if (pctEl) pctEl.textContent = Math.round(pct) + '%';
    const pctLbl = panel.querySelector('.criteria-pct-label');
    if (pctLbl) pctLbl.textContent = Math.round(pct) + '%';
    const wp = panel.querySelector('.weighted-preview');
    if (wp) wp.textContent = contrib.toFixed(2) + '%';

    updateContestantPanel(panel.closest('.contestant-panel'));
    updateOverallRing();
  }

  /* ══ Contestant panel totals ══ */
  function updateContestantPanel(cp) {
    if (!cp) return;
    const panels = cp.querySelectorAll('.criteria-panel');
    let total = 0, filled = 0;
    panels.forEach(p => {
      const n = p.querySelector('.score-input');
      if (!n) return;
      const v = parseFloat(n.value) || 0;
      const m = parseFloat(n.dataset.max) || 100;
      const w = parseFloat(n.dataset.weight) || 0;
      if (v > 0) filled++;
      total += (v / m) * w;
    });
    const totEl = cp.querySelector('.contestant-total');
    if (totEl) totEl.textContent = total.toFixed(2) + '%';
    const lbl = cp.querySelector('.contestant-fill-label');
    if (lbl) lbl.textContent = filled + '/' + panels.length + ' filled';
    const bar = cp.querySelector('.contestant-progress-bar');
    if (bar) {
      const pct = panels.length > 0 ? (filled / panels.length) * 100 : 0;
      bar.style.width = pct + '%';
      bar.style.background = filled === panels.length
        ? 'linear-gradient(90deg,#10b981,#34d399)'
        : 'linear-gradient(90deg,#8b6914,#c9a227,#f0c040)';
    }
    // Nav dot
    const dot = document.querySelector('.nav-dot[data-idx="' + cp.dataset.idx + '"]');
    if (dot && filled === panels.length && panels.length > 0) dot.classList.add('scored');
    // Update header scored count
    let totalScored = 0;
    document.querySelectorAll('.contestant-panel').forEach(c => {
      const ps = c.querySelectorAll('.criteria-panel');
      const f  = [...ps].filter(p => {
        const n = p.querySelector('.score-input');
        return n && parseFloat(n.value) > 0;
      }).length;
      if (f === ps.length && ps.length > 0) totalScored++;
    });
    const sc = document.getElementById('hdr-scored');
    if (sc) sc.textContent = totalScored;
  }

  /* ══ Overall ring ══ */
  function updateOverallRing() {
    const all    = document.querySelectorAll('.score-input');
    const filled = [...all].filter(i => parseFloat(i.value) > 0).length;
    const pct    = all.length > 0 ? (filled / all.length) * 100 : 0;
    const offset = CIRC10 - (pct / 100) * CIRC10;
    const ring   = document.getElementById('ring-progress');
    if (ring) { ring.style.strokeDashoffset = offset.toFixed(2); ring.style.stroke = pct >= 100 ? '#10b981' : '#c9a227'; }
    const el = document.getElementById('overall-pct');
    if (el) el.textContent = Math.round(pct) + '%';
  }

  /* ══ Navigate contestants ══ */
  window.goToContestant = function(idx) {
    idx = parseInt(idx);
    if (isNaN(idx) || idx < 0 || idx >= totalContestants) return;
    document.querySelectorAll('.contestant-panel').forEach((p, i) => p.style.display = i === idx ? '' : 'none');
    document.querySelectorAll('.nav-dot').forEach((d, i) => {
      d.classList.toggle('active-dot', i === idx);
    });
    window._currentIdx = idx;
    document.getElementById('hdr-pos').textContent    = idx + 1;
    document.getElementById('bottom-pos').textContent = idx + 1;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    updateOverallRing();
  };

  /* ══ nextOrSave — kept for compatibility ══ */
  window.nextOrSave = function(cid, panelIdx, total) {
    submitContestant(panelIdx);
  };

  /* ══ submitContestant ══ */
  window.submitContestant = function(panelIdx) {
    const cp = document.querySelector('.contestant-panel[data-idx="' + panelIdx + '"]');
    const inputs = cp ? cp.querySelectorAll('.score-input') : [];
    const empty = [...inputs].filter(n => !n.value || parseFloat(n.value) < 0);
    if (empty.length && !confirm(empty.length + ' score(s) empty. Submit anyway?')) return;
    try { localStorage.removeItem(storeKey); } catch(e) {}
    document.getElementById('scoringForm').submit();
  };

  window.nextContestant = function(idx) { goToContestant(idx + 1); };

  /* ══ Draft save/restore ══ */
  function schedSave() { clearTimeout(saveTimer); saveTimer = setTimeout(saveDraft, 600); }
  function saveDraft() {
    const data = {};
    document.querySelectorAll('.contestant-panel').forEach(cp => {
      const cid = cp.dataset.contestantId; data[cid] = {};
      cp.querySelectorAll('.score-input').forEach(n => {
        const m = n.name.match(/scores\[([^\]]+)\]\[([^\]]+)\]/);
        if (m) data[cid][m[2]] = n.value;
      });
    });
    try { localStorage.setItem(storeKey, JSON.stringify(data)); } catch(e){}
  }
  function restoreDraft() {
    try {
      const data = JSON.parse(localStorage.getItem(storeKey) || '{}');
      document.querySelectorAll('.criteria-panel').forEach(panel => {
        const cid   = panel.dataset.contestantId;
        const input = panel.querySelector('.score-input');
        if (!input || !data[cid]) return;
        const m = input.name.match(/scores\[([^\]]+)\]\[([^\]]+)\]/);
        if (m && data[cid][m[2]] && input.value === '') {
          input.value = data[cid][m[2]];
          const entryEl = panel.querySelector('.score-entry-input');
          if (entryEl) entryEl.value = data[cid][m[2]];
        }
      });
    } catch(e){}
  }

  /* ══ Init ══ */
  restoreDraft();
  document.querySelectorAll('.criteria-panel').forEach(p => {
    // Sync: if score-entry-input has a pre-filled value from server, push it to score-input
    const entryEl = p.querySelector('.score-entry-input');
    const input   = p.querySelector('.score-input');
    if (entryEl && input && entryEl.value && !input.value) {
      input.value = entryEl.value;
    }
    // If score-input has value but entry doesn't, fill entry
    if (input && entryEl && input.value && !entryEl.value) {
      entryEl.value = input.value;
    }
    updateBox(p);
  });
  goToContestant(0);

  // Auto-close sidebar on mobile
  if (window.innerWidth < 768) {
    var sidebar = document.querySelector('.sidebar');
    var overlay = document.getElementById('sidebar-overlay');
    if (sidebar) { sidebar.classList.remove('open'); }
    if (overlay) { overlay.classList.add('hidden'); }
  }
})();
</script>

{{> footer }}
</body>
</html>
