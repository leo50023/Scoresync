{{> head }}
<body class="min-h-screen flex flex-col" class="ss-page-bg">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto overflow-x-hidden pb-32" id="scoring-main" style="min-width:0">

  <!-- ══ TOP BAR ══ -->
  <div class="sticky top-0 z-20 no-print" style="background:rgba(6,11,24,0.97);backdrop-filter:blur(16px);border-bottom:1px solid var(--border-subtle)">

    <!-- Row 1: Event + judge info + ring -->
    <div class="judge-top-row px-4 sm:px-6 py-2.5 flex items-center justify-between gap-3">
      <div class="judge-top-info min-w-0">
        <div class="font-extrabold text-sm truncate" style="color:var(--text-primary)">{{event.name}}</div>
        <div class="judge-top-meta text-xs">
          <span>{{#if isTabulator}}Tabulator{{else}}Judge{{/if}}: <span class="judge-top-name">{{userName}}</span></span>
          <span>Contestant <span id="hdr-pos">1</span> of {{contestants.length}}</span>
          <span><span id="hdr-scored">0</span> of {{contestants.length}} scored</span>
        </div>
      </div>
      <div class="judge-top-actions flex items-center gap-2 flex-shrink-0">
        <div class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-xs" style="background:rgba(255,255,255,0.05);border:1px solid var(--border)">
          <svg id="completion-ring" width="28" height="28" viewBox="0 0 28 28">
            <circle cx="14" cy="14" r="10" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="3"/>
            <circle id="ring-progress" cx="14" cy="14" r="10" fill="none" stroke="#c9a227" stroke-width="3"
              stroke-dasharray="62.83" stroke-dashoffset="62.83" stroke-linecap="round"
              transform="rotate(-90 14 14)" style="transition:stroke-dashoffset 0.5s,stroke 0.3s"/>
          </svg>
          <span id="overall-pct" class="font-extrabold" style="color:var(--text-primary)">0%</span>
        </div>
        <a href="/events/{{event.id}}/results" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold" style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.3)">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          {{#if readOnly}}View Results{{else}}Live Results{{/if}}
        </a>

      </div>
    </div>

    <!-- Row 2: Search + Contestant nav dots -->
    <div class="px-4 sm:px-6 py-2 space-y-2" style="border-top:1px solid rgba(255,255,255,0.04)">

      {{#if isMultiCategory}}
      <!-- Category tabs -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1">
        <span class="text-[10px] font-extrabold uppercase tracking-wider flex-shrink-0" style="color:#374151">Category:</span>
        {{#each categories}}
        <a href="/events/{{../event.id}}/scoring/{{id}}"
          class="flex-shrink-0 px-3 py-1.5 rounded-full text-[11px] font-bold transition"
          style="{{#if (eq id ../activeCategoryId)}}background:rgba(99,102,241,0.3);color:#c7d2fe;border:1px solid rgba(99,102,241,0.5){{else}}background:rgba(255,255,255,0.06);color:#64748b;border:1px solid rgba(255,255,255,0.1){{/if}}">
          {{name}}
          {{#if scoreCount}}<span class="ml-1 text-[9px] font-black" style="color:#6ee7b7">✓</span>{{/if}}
        </a>
        {{/each}}
      </div>
      {{/if}}
      <!-- Search bar -->
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="contestant-search" type="search" autocomplete="off" placeholder="Search contestant by name or number…"
          class="w-full rounded-xl pl-9 pr-3 py-2 text-xs outline-none"
          style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:var(--text-primary)"
          oninput="filterContestants(this.value)"
        />
      </div>
      <!-- Nav dots -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5">
        <span class="text-[10px] font-extrabold uppercase tracking-wider flex-shrink-0 mr-1" style="color:var(--text-faint)">Go to:</span>
        {{#each contestants}}
        <button type="button"
          class="nav-dot flex-shrink-0 min-w-[32px] h-8 px-2 rounded-full text-[11px] font-extrabold transition-all border"
          data-idx="{{@index}}" data-name="{{name}}" data-number="{{number}}"
          style="background:rgba(255,255,255,0.05);color:var(--text-faint);border-color:rgba(255,255,255,0.08)"
          onclick="goToContestant({{@index}})">{{number}}</button>
        {{/each}}
      </div>
    </div>
  </div>

  {{#if success_msg}}<div class="alert-success m-4">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error m-4">{{error_msg}}</div>{{/if}}

  {{#if readOnly}}
  <div class="mx-4 mt-3 rounded-xl px-4 py-3 flex flex-wrap items-center justify-between gap-3 no-print" style="background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.25)">
  <div class="text-xs" style="color:#bfdbfe">{{#if isTabulator}}Scoring is locked. Scores are available in read-only mode.{{else}}Event completed. Scores are available in read-only mode.{{/if}}</div>
    <a href="/events/{{event.id}}/results" class="text-xs font-bold" style="color:#6ee7b7">View event results →</a>
  </div>
  {{/if}}

  {{#if hasExistingScores}}
  <div class="mx-4 mt-3 rounded-xl px-4 py-3 flex items-start gap-2.5 no-print" style="background:rgba(201,162,39,0.08);border:1px solid rgba(201,162,39,0.25)">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c9a227" stroke-width="2" class="flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <div class="text-xs" style="color:#f0c040">{{#if readOnly}}Your submitted scores are shown below for review.{{else}}You have previously submitted scores for this event. Your existing scores are shown below — you can update them and re-submit.{{/if}}</div>
  </div>
  {{/if}}

  {{#if contestants.length}}
  <form id="scoringForm" method="POST" action="/events/{{event.id}}/scoring{{#if activeCategoryId}}/{{activeCategoryId}}{{/if}}">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">

    {{#each contestants}}
    <!-- ══ Contestant Panel ══ -->
    <div class="contestant-panel" data-idx="{{@index}}" data-contestant-id="{{id}}">

      <!-- Two-column layout: photo left, scoring right -->
      <div class="judge-card-inner">

        <!-- ── Left column: Photo ── -->
        <div class="judge-photo-col">
          {{#if photo}}
          <div class="judge-photo-frame">
            <img src="{{photo}}" alt="{{name}}"
              style="object-position:center 20%"/>
          </div>
          {{else}}
          <div class="judge-photo-frame judge-photo-placeholder">
            <div class="judge-photo-placeholder-icon">
              <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/><path d="M4 4.5 5.5 6M20 4.5 18.5 6"/></svg>
            </div>
            <div class="text-center px-3">
              <div style="font-size:0.9rem;font-weight:800;color:var(--text-primary)">{{name}}</div>
              <div style="font-size:0.68rem;font-weight:700;color:var(--text-secondary);margin-top:4px">Contestant #{{number}}</div>
              <div style="font-size:0.6rem;font-weight:800;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.12em;margin-top:12px">Photo not uploaded</div>
            </div>
          </div>
          {{/if}}
        </div>

        <!-- ── Right column: Scoring ── -->
        <div class="judge-scoring-col">

          <!-- Header: crown + judging system label -->
          <div class="judge-card-eyebrow">
            <span class="judge-card-eyebrow-dot"></span>
            <span>Judge evaluation</span>
          </div>

          <!-- Contestant name + number -->
          <div class="judge-contestant-heading">
            <h2>{{name}}</h2>
            <span>#{{number}}</span>
          </div>

          <!-- Barangay / age -->
          <div class="judge-contestant-meta">
            {{#if barangay}}<span>Brgy. {{barangay}}</span>{{/if}}
            {{#if age}}<span style="margin-left:6px">&bull; {{age}} yrs</span>{{/if}}
            {{#if platform}}<span style="margin-left:6px">&bull; {{platform}}</span>{{/if}}
          </div>

          <!-- Gold divider -->
          <div class="judge-card-divider"></div>

          <!-- ── Criteria rows (all visible at once) ── -->
          {{#each scores}}
          <div class="criteria-panel" data-contestant-id="{{../id}}" data-criteria-idx="{{@index}}">

            <!-- Criteria name row -->
            <div class="judge-criteria-heading">
              <span>{{criteriaName}}</span>
              <span class="judge-weight-badge">{{weight}}%</span>
            </div>

            <!-- Progress bar + input row -->
            <div class="judge-score-row">
              <!-- Progress bar -->
              <div class="judge-score-track">
                <div class="criteria-bar"></div>
              </div>
              <!-- Visible score input -->
              <div class="judge-score-entry">
                <input type="number"
                  class="score-entry-input"
                  min="0" max="{{maxScore}}" step="0.01"
                  placeholder="0"
                  value="{{value}}"
                  {{#if ../../readOnly}}readonly aria-readonly="true"{{/if}}
                  data-max="{{maxScore}}"
                  oninput="handleScoreInput(this)"
                />
                <span>/ {{maxScore}}</span>
              </div>
            </div>

            <!-- Hidden elements for JS compatibility (display:none wrapper) -->
            <div style="display:none">
              <span class="score-display"></span>
              <span class="criteria-pct"></span>
              <span class="criteria-pct-label"></span>
              <span class="weighted-preview"></span>
              <svg><circle class="criteria-ring" stroke-dasharray="163.36" stroke-dashoffset="163.36"/></svg>
              <!-- Actual hidden form input -->
              <input type="number"
                name="scores[{{../id}}][{{criteriaId}}]"
                value="{{value}}"
                min="0" max="{{maxScore}}" step="0.01"
                class="score-input sr-only"
                {{#if ../../readOnly}}readonly{{/if}}
                data-weight="{{weight}}" data-max="{{maxScore}}"
                tabindex="-1"/>
            </div>

          </div>
          {{/each}}

          <!-- Live total display -->
          <div class="contestant-total-display">
            <span class="judge-total-label">Total score</span>
            <div class="judge-total-value">
              <span class="contestant-total">0.00%</span>
              <span class="contestant-fill-label">0/{{scores.length}} filled</span>
            </div>
          </div>

          <!-- Overall progress bar (thin) -->
          <div class="judge-overall-track">
            <div class="contestant-progress-bar"></div>
          </div>

          <!-- SUBMIT button -->
          {{#unless ../readOnly}}
          <button type="button"
            class="submit-btn"
            onclick="submitContestant({{@index}})">
            Submit scores
          </button>
          {{else}}
          <div class="py-3 text-center text-xs font-bold rounded-xl" style="background:rgba(255,255,255,0.04);color:var(--text-secondary);border:1px solid var(--border)">Read-only score review</div>
          {{/unless}}

        </div><!-- /.judge-scoring-col -->
      </div><!-- /.judge-card-inner -->

    </div>
    {{/each}}

  </form>

  {{else}}
  <div class="p-16 text-center">
    <p style="color:var(--text-faint)">No contestants yet.</p>
    <a href="/events/{{event.id}}" class="text-indigo-400 text-sm mt-2 inline-block">Back to event</a>
  </div>
  {{/if}}

</main>
</div>

<!-- Sticky bottom nav bar (Prev / Next contestant) -->
<div class="judge-bottom-nav fixed bottom-0 left-0 right-0 z-30 no-print" style="background:rgba(6,11,24,0.97);backdrop-filter:blur(16px);border-top:1px solid rgba(255,255,255,0.06);box-shadow:0 -4px 32px rgba(0,0,0,0.5)">
  <div class="judge-bottom-nav-inner max-w-screen-xl mx-auto px-4 sm:px-6 py-3 flex items-center gap-3">
    <button type="button" id="btn-prev-contestant"
      class="judge-bottom-button flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm transition disabled:opacity-30"
      style="background:rgba(255,255,255,0.06);color:var(--text-secondary);border:1px solid rgba(255,255,255,0.1)"
      onclick="goToContestant(window._currentIdx - 1)">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
      Previous
    </button>
    <div class="judge-bottom-position flex-1 text-center text-xs font-bold" style="color:var(--text-secondary)">
      Contestant <span id="bottom-pos" style="color:#e5c45a">1</span> / {{contestants.length}}
    </div>
    <button type="button" id="btn-next-contestant"
      class="judge-bottom-button flex items-center gap-2 px-5 py-2.5 rounded-xl font-extrabold text-sm transition active:scale-[0.98]"
      style="background:linear-gradient(135deg,#8b6914,#c9a227);color:#0a1628;box-shadow:0 4px 16px rgba(201,162,39,0.3)"
      onclick="goToContestant(window._currentIdx + 1)">
      Next →
    </button>
  </div>
</div>

<style>
/* Judge scoring card */
.contestant-panel {
  margin: 16px;
  overflow: hidden;
  border: 1px solid rgba(148,163,184,0.16);
  border-radius: 18px;
  background: linear-gradient(145deg,#101c30 0%,#0b1424 100%);
  box-shadow: 0 12px 32px rgba(0,0,0,0.16);
}
.judge-top-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 8px;
  row-gap: 2px;
  margin-top: 2px;
  color: #94a3b8;
  line-height: 1.4;
}
.judge-top-meta > span {
  min-width: 0;
}
.judge-top-name {
  color: #a5b4fc;
  overflow-wrap: anywhere;
}
#hdr-pos {
  color: #e2e8f0;
}
#hdr-scored {
  color: #6ee7b7;
}
.judge-card-inner {
  display: grid;
  grid-template-columns: 260px minmax(0,1fr);
  align-items: start;
  overflow: hidden;
}
.judge-photo-col {
  min-width: 0;
  width: 260px;
  max-width: 260px;
  padding: 22px;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  background: rgba(4,10,20,0.24);
  border-right: 1px solid rgba(255,255,255,0.06);
  overflow: hidden;
}
.judge-photo-col img {
  width: 100%;
  height: auto;
  display: block;
}
.judge-photo-frame {
  width: 100%;
  max-width: 216px;
  height: 270px;
  max-height: 270px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.1);
  background: #101827;
  box-shadow: 0 8px 24px rgba(0,0,0,0.2);
}
.judge-photo-placeholder {
  flex-direction: column;
  gap: 12px;
  background: linear-gradient(160deg,#17243a,#101827);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
}
.judge-photo-placeholder > .text-center {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  overflow-wrap: anywhere;
}
.judge-photo-placeholder-icon {
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #cbd5e1;
  border: 1px solid rgba(148,163,184,0.2);
  border-radius: 50%;
  background: rgba(148,163,184,0.08);
}
.judge-photo-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 20%;
  border: 0;
  display: block;
}
.judge-scoring-col {
  min-width: 0;
  padding: 24px 26px;
}
.judge-card-eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 7px;
  color: #94a3b8;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.judge-card-eyebrow-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #c9a227;
}
.judge-contestant-heading {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 9px;
  margin-bottom: 4px;
}
.judge-contestant-heading h2 {
  margin: 0;
  color: #f1f5f9;
  font-size: 1.35rem;
  font-weight: 850;
  line-height: 1.2;
  overflow-wrap: anywhere;
}
.judge-contestant-heading > span {
  color: #d6b54a;
  font-size: 0.9rem;
  font-weight: 800;
}
.judge-contestant-meta {
  min-height: 18px;
  margin-bottom: 16px;
  color: #94a3b8;
  font-size: 0.75rem;
}
.judge-card-divider {
  height: 1px;
  margin-bottom: 14px;
  background: rgba(255,255,255,0.08);
}
.criteria-panel {
  margin-bottom: 8px;
  padding: 12px 14px;
  border: 1px solid rgba(148,163,184,0.13);
  border-left: 3px solid transparent;
  border-radius: 12px;
  background: rgba(255,255,255,0.025);
  transition: border-color 0.2s,background 0.2s;
}
.criteria-panel:hover {
  border-color: rgba(148,163,184,0.24);
  background: rgba(255,255,255,0.04);
}
.criteria-panel.has-score {
  border-left-color: #c9a227;
}
.criteria-panel:focus-within {
  border-color: rgba(201,162,39,0.4);
  background: rgba(255,255,255,0.04);
}
.criteria-panel.has-score:focus-within {
  border-left-color: #c9a227;
}
.judge-criteria-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 9px;
  color: #e2e8f0;
  font-size: 0.88rem;
  font-weight: 700;
}
.judge-weight-badge {
  flex-shrink: 0;
  padding: 3px 9px;
  border: 1px solid rgba(201,162,39,0.2);
  border-radius: 999px;
  background: rgba(201,162,39,0.1);
  color: #e5c45a;
  font-size: 0.68rem;
  font-weight: 800;
}
.judge-score-row {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}
.judge-score-track, .judge-overall-track {
  height: 7px;
  min-width: 0;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255,255,255,0.07);
}
.judge-score-track {
  flex: 1;
}
.judge-score-track .criteria-bar, .judge-overall-track .contestant-progress-bar {
  width: 0%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg,#a17b1c,#d6b54a);
  transition: width 0.35s ease;
}
.judge-score-entry {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}
.judge-score-entry input {
  width: 76px;
  height: 42px;
  min-height: 42px;
  border: 1px solid rgba(148,163,184,0.24);
  border-radius: 10px;
  outline: none;
  background: #0a1220;
  color: #f1f5f9;
  font-size: 16px !important;
  font-weight: 800;
  text-align: center;
  -moz-appearance: textfield;
}
.judge-score-entry input:focus {
  border-color: #c9a227;
  box-shadow: 0 0 0 3px rgba(201,162,39,0.12);
}
.judge-score-entry input::-webkit-inner-spin-button,
.judge-score-entry input::-webkit-outer-spin-button {
  margin: 0;
  -webkit-appearance: none;
}
.judge-score-entry > span {
  color: #64748b;
  font-size: 0.7rem;
  font-weight: 700;
  white-space: nowrap;
}
.contestant-total-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  padding: 12px 0 5px;
  border-top: 1px solid rgba(255,255,255,0.08);
}
.judge-total-label {
  color: #94a3b8;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.judge-total-value {
  display: flex;
  align-items: center;
  gap: 9px;
}
.contestant-total {
  color: #e5c45a;
  font-size: 1.65rem;
  font-weight: 850;
}
.contestant-fill-label {
  padding: 3px 8px;
  border: 1px solid rgba(201,162,39,0.18);
  border-radius: 999px;
  background: rgba(201,162,39,0.08);
  color: #d6b54a;
  font-size: 0.65rem;
  font-weight: 750;
  white-space: nowrap;
}
.judge-overall-track {
  margin: 2px 0 14px;
  height: 5px;
}
.submit-btn {
  width: 100%;
  min-height: 46px;
  padding: 11px 16px;
  border: 1px solid rgba(214,181,74,0.35);
  border-radius: 11px;
  background: #c9a227;
  color: #111827;
  cursor: pointer;
  font-size: 0.8rem;
  font-weight: 850;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  transition: background 0.18s,transform 0.18s;
}
.submit-btn:hover {
  background: #d8b43d;
}
.submit-btn:active {
  transform: translateY(1px);
}

/* Mobile / narrow: stack photo on top */
@media (max-width: 767px) {
  #scoring-main {
    padding: 0 0 calc(88px + env(safe-area-inset-bottom)) !important;
  }
}
@media (max-width: 900px) {
  .judge-top-row {
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .judge-top-info {
    flex: 1 1 100%;
  }
  .judge-top-actions {
    width: 100%;
    justify-content: flex-end;
  }
  /* Stack photo above scoring column on smaller screens */
  .judge-card-inner {
    grid-template-columns: 1fr;
  }
  .judge-photo-col {
    padding: 14px 16px;
    border-right: 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    /* Keep photo compact — don't let it dominate the view */
    max-height: 220px;
    overflow: hidden;
  }
  .judge-photo-frame {
    width: min(100%, 160px);
    max-height: 200px;
    aspect-ratio: 3/4;
  }
  .judge-photo-placeholder {
    min-height: 160px;
  }
  .judge-scoring-col {
    padding: 18px 16px;
  }
  .contestant-panel {
    margin: 12px 10px;
    border-radius: 15px;
  }
  .judge-score-entry input {
    width: 68px;
  }
  .judge-bottom-nav {
    padding-bottom: env(safe-area-inset-bottom);
  }
  .judge-bottom-nav-inner {
    gap: 8px;
    padding-left: 10px;
    padding-right: 10px;
  }
  .judge-bottom-button {
    flex-shrink: 0;
    gap: 6px;
    padding: 9px 10px;
    font-size: 0.75rem;
  }
  .judge-bottom-position {
    min-width: 0;
    font-size: 0.7rem;
    white-space: nowrap;
  }
}
@media (max-width: 480px) {
  .judge-score-entry input {
    width: 60px;
    font-size: 15px !important;
  }
}
@media (max-width: 380px) {
  .judge-bottom-nav-inner {
    gap: 5px;
    padding-left: 8px;
    padding-right: 8px;
  }
  .judge-bottom-button {
    gap: 4px;
    padding: 8px;
    font-size: 0.7rem;
  }
}

.nav-dot.scored { background:rgba(16,185,129,0.25) !important;color:#6ee7b7 !important;border-color:rgba(16,185,129,0.5) !important; }
.nav-dot.active-dot { background:rgba(201,162,39,0.25) !important;color:#f0c040 !important;border-color:rgba(201,162,39,0.6) !important; }

/* Keep navigation feedback responsive without overriding control-specific transitions. */
.nav-dot {
  transition: background 60ms ease, color 60ms ease, border-color 60ms ease;
  -webkit-tap-highlight-color: transparent;
}
/* Hide scrollbars */
main::-webkit-scrollbar { display:none; }

/* GPU compositing hints */
.nav-dot { will-change: background, transform; }
#scoring-main { will-change: scroll-position; }

/* Shimmer animation for progress bar fill */
@keyframes shimmer {
  0%   { background-position: 200% center; }
  100% { background-position: -200% center; }
}
</style>

<script>
(function() {
  const CIRC10 = 2 * Math.PI * 10; // r=10 → 62.83
  const storeKey = "scoresync_draft_{{event.id}}_{{judgeId}}";
  let saveTimer;
  window._currentIdx = 0;
  window._currentCriteria = {}; // kept for compatibility, not used for display
  window._hasExistingScores = {{#if hasExistingScores}}true{{else}}false{{/if}};
  const totalContestants = {{contestants.length}};

  /* ══ Pre-fill visible inputs from existing hidden values ══ */
  document.querySelectorAll('.criteria-panel').forEach(panel => {
    const input   = panel.querySelector('.score-input');
    const entryEl = panel.querySelector('.score-entry-input');
    if (!entryEl || !input) return;
    if (input.value) {
      entryEl.value = input.value;
      updateBox(panel);
    }
  });

  /* ══ Handle score text input ══ */
  window.handleScoreInput = function(entryEl) {
    const panel  = entryEl.closest('.criteria-panel');
    const input  = panel.querySelector('.score-input');
    const max    = parseFloat(entryEl.dataset.max) || 100;
    let val      = parseFloat(entryEl.value);

    if (isNaN(val) || entryEl.value === '') {
      input.value = '';
      entryEl.style.borderColor = 'rgba(201,162,39,0.4)';
      updateBox(panel);
      schedSave();
      return;
    }
    if (val < 0) val = 0;
    if (val > max) {
      val = max;
      entryEl.value = max;
      entryEl.style.borderColor = 'rgba(239,68,68,0.6)';
    } else {
      entryEl.style.borderColor = 'rgba(201,162,39,0.7)';
    }
    input.value = val;
    updateBox(panel);
    schedSave();
  };

  /* ══ updateBox: update progress bar + totals ══ */
  function updateBox(panel) {
    const input  = panel.querySelector('.score-input');
    const val    = parseFloat(input.value) || 0;
    const max    = parseFloat(input.dataset.max) || 100;
    const weight = parseFloat(input.dataset.weight) || 0;
    const pct    = max > 0 ? (val / max) * 100 : 0;
    const contrib = (val / max) * weight;

    // Gold progress bar
    const bar = panel.querySelector('.criteria-bar');
    if (bar) { bar.style.width = pct.toFixed(1) + '%'; }

    // Toggle filled state accent
    panel.classList.toggle('has-score', val > 0);

    // Hidden compat elements
    const disp = panel.querySelector('.score-display');
    if (disp) disp.textContent = val > 0 ? val : '—';
    const pctEl = panel.querySelector('.criteria-pct');
    if (pctEl) pctEl.textContent = Math.round(pct) + '%';
    const pctLbl = panel.querySelector('.criteria-pct-label');
    if (pctLbl) pctLbl.textContent = Math.round(pct) + '%';
    const wp = panel.querySelector('.weighted-preview');
    if (wp) wp.textContent = contrib.toFixed(2) + '%';

    updateContestantPanel(panel.closest('.contestant-panel'));
    updateOverallRing();
  }

  /* ══ Contestant panel totals ══ */
  function updateContestantPanel(cp) {
    if (!cp) return;
    const panels = cp.querySelectorAll('.criteria-panel');
    let total = 0, filled = 0;
    panels.forEach(p => {
      const n = p.querySelector('.score-input');
      if (!n) return;
      const v = parseFloat(n.value) || 0;
      const m = parseFloat(n.dataset.max) || 100;
      const w = parseFloat(n.dataset.weight) || 0;
      if (v > 0) filled++;
      total += (v / m) * w;
    });
    const totEl = cp.querySelector('.contestant-total');
    if (totEl) totEl.textContent = total.toFixed(2) + '%';
    const lbl = cp.querySelector('.contestant-fill-label');
    if (lbl) lbl.textContent = filled + '/' + panels.length + ' filled';
    const bar = cp.querySelector('.contestant-progress-bar');
    if (bar) {
      const pct = panels.length > 0 ? (filled / panels.length) * 100 : 0;
      bar.style.width = pct + '%';
      bar.style.background = filled === panels.length
        ? 'linear-gradient(90deg,#10b981,#34d399)'
        : 'linear-gradient(90deg,#8b6914,#c9a227,#f0c040)';
    }
    // Nav dot
    const dot = document.querySelector('.nav-dot[data-idx="' + cp.dataset.idx + '"]');
    if (dot && filled === panels.length && panels.length > 0) dot.classList.add('scored');
    // Update header scored count
    let totalScored = 0;
    document.querySelectorAll('.contestant-panel').forEach(c => {
      const ps = c.querySelectorAll('.criteria-panel');
      const f  = [...ps].filter(p => {
        const n = p.querySelector('.score-input');
        return n && parseFloat(n.value) > 0;
      }).length;
      if (f === ps.length && ps.length > 0) totalScored++;
    });
    const sc = document.getElementById('hdr-scored');
    if (sc) sc.textContent = totalScored;
  }

  /* ══ Overall ring ══ */
  function updateOverallRing() {
    const all    = document.querySelectorAll('.score-input');
    const filled = [...all].filter(i => parseFloat(i.value) > 0).length;
    const pct    = all.length > 0 ? (filled / all.length) * 100 : 0;
    const offset = CIRC10 - (pct / 100) * CIRC10;
    const ring   = document.getElementById('ring-progress');
    if (ring) { ring.style.strokeDashoffset = offset.toFixed(2); ring.style.stroke = pct >= 100 ? '#10b981' : '#c9a227'; }
    const el = document.getElementById('overall-pct');
    if (el) el.textContent = Math.round(pct) + '%';
  }

  /* ══ Search / filter contestants ══ */
  window.filterContestants = function(query) {
    const q = query.trim().toLowerCase();
    const dots = document.querySelectorAll('.nav-dot');
    if (!q) {
      // Show current contestant, restore all dots
      dots.forEach(d => { d.style.display = ''; });
      return;
    }
    let firstMatch = -1;
    dots.forEach(d => {
      const name   = (d.dataset.name   || '').toLowerCase();
      const number = (d.dataset.number || '').toLowerCase();
      const matches = name.includes(q) || number.includes(q);
      d.style.display = matches ? '' : 'none';
      if (matches && firstMatch < 0) firstMatch = parseInt(d.dataset.idx);
    });
    if (firstMatch >= 0) goToContestant(firstMatch);
  };

  /* ══ Navigate contestants ══ */
  window.goToContestant = function(idx) {
    idx = parseInt(idx);
    if (isNaN(idx) || idx < 0 || idx >= totalContestants) return;
    document.querySelectorAll('.contestant-panel').forEach((p, i) => p.style.display = i === idx ? '' : 'none');
    document.querySelectorAll('.nav-dot').forEach((d, i) => {
      d.classList.toggle('active-dot', i === idx);
    });
    window._currentIdx = idx;
    document.getElementById('hdr-pos').textContent    = idx + 1;
    document.getElementById('bottom-pos').textContent = idx + 1;
    window.scrollTo({ top: 0, behavior: 'smooth' });
    updateOverallRing();
  };

  /* ══ nextOrSave — kept for compatibility ══ */
  window.nextOrSave = function(cid, panelIdx, total) {
    submitContestant(panelIdx);
  };

  /* ══ submitContestant ══ */
  window.submitContestant = function(panelIdx) {
    const cp = document.querySelector('.contestant-panel[data-idx="' + panelIdx + '"]');
    const inputs = cp ? cp.querySelectorAll('.score-input') : [];
    const empty = [...inputs].filter(n => !n.value || parseFloat(n.value) < 0);
    if (empty.length > 0) {
      // Highlight empty fields
      empty.forEach(n => {
        const panel = n.closest('.criteria-panel');
        const entryEl = panel ? panel.querySelector('.score-entry-input') : null;
        if (entryEl) entryEl.style.borderColor = 'rgba(239,68,68,0.8)';
      });
      if (!confirm(empty.length + ' score(s) are empty. Submit anyway? Empty scores will count as 0.')) return;
    }
    try { localStorage.removeItem(storeKey); } catch(e) {}
    // Save next contestant index so we auto-jump after page reload
    const nextIdx = panelIdx + 1;
    if (nextIdx < totalContestants) {
      try { localStorage.setItem('ss_next_contestant_' + '{{event.id}}', nextIdx); } catch(e) {}
    }
    document.getElementById('scoringForm').submit();
  };

  window.nextContestant = function(idx) { goToContestant(idx + 1); };

  /* ══ Draft save/restore ══ */
  function schedSave() { clearTimeout(saveTimer); saveTimer = setTimeout(saveDraft, 600); }
  function saveDraft() {
    const data = {};
    document.querySelectorAll('.contestant-panel').forEach(cp => {
      const cid = cp.dataset.contestantId; data[cid] = {};
      cp.querySelectorAll('.score-input').forEach(n => {
        const m = n.name.match(/scores\[([^\]]+)\]\[([^\]]+)\]/);
        if (m) data[cid][m[2]] = n.value;
      });
    });
    try { localStorage.setItem(storeKey, JSON.stringify(data)); } catch(e){}
  }
  function restoreDraft() {
    try {
      const data = JSON.parse(localStorage.getItem(storeKey) || '{}');
      document.querySelectorAll('.criteria-panel').forEach(panel => {
        const cid   = panel.dataset.contestantId;
        const input = panel.querySelector('.score-input');
        if (!input || !data[cid]) return;
        const m = input.name.match(/scores\[([^\]]+)\]\[([^\]]+)\]/);
        if (m && data[cid][m[2]] && input.value === '') {
          input.value = data[cid][m[2]];
          const entryEl = panel.querySelector('.score-entry-input');
          if (entryEl) entryEl.value = data[cid][m[2]];
        }
      });
    } catch(e){}
  }

  /* ══ Init ══ */
  restoreDraft();
  document.querySelectorAll('.criteria-panel').forEach(p => {
    // Sync: if score-entry-input has a pre-filled value from server, push it to score-input
    const entryEl = p.querySelector('.score-entry-input');
    const input   = p.querySelector('.score-input');
    if (entryEl && input && entryEl.value && !input.value) {
      input.value = entryEl.value;
    }
    // If score-input has value but entry doesn't, fill entry
    if (input && entryEl && input.value && !entryEl.value) {
      entryEl.value = input.value;
    }
    updateBox(p);
  });
  goToContestant(0);

  // Auto-jump to next contestant after submit
  (function() {
    var nextKey = 'ss_next_contestant_' + '{{event.id}}';
    try {
      var nextIdx = localStorage.getItem(nextKey);
      if (nextIdx !== null) {
        localStorage.removeItem(nextKey);
        var idx = parseInt(nextIdx);
        if (!isNaN(idx) && idx > 0 && idx < totalContestants) {
          goToContestant(idx);
          return;
        }
      }
    } catch(e) {}
  })();

  // Auto-close sidebar on mobile
  if (window.innerWidth < 768) {
    var sidebar = document.querySelector('.sidebar');
    var overlay = document.getElementById('sidebar-overlay');
    if (sidebar) { sidebar.classList.remove('open'); }
    if (overlay) { overlay.classList.add('hidden'); }
  }
})();
</script>

{{> footer }}
</body>
</html>
