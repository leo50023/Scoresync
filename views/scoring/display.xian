<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{event.name}} — Live Scoreboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800;900&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { font-family: 'Inter', sans-serif; box-sizing: border-box; }
    body { background: #020813; color: #e2e8f0; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
    @keyframes fadeUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
    @keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }
    @keyframes shimmer { 0% { background-position:-200% center; } 100% { background-position:200% center; } }
    .animate-in { animation: fadeUp 0.5s ease both; }
    .live-dot { animation: pulse 1.5s ease infinite; }
    .rank-1 { background: linear-gradient(135deg,#92400e,#f59e0b,#fbbf24); }
    .rank-2 { background: linear-gradient(135deg,#374151,#6b7280,#9ca3af); }
    .rank-3 { background: linear-gradient(135deg,#7c2d12,#c2410c,#f97316); }
    .rank-other { background: linear-gradient(135deg,#1e3a5f,#2563eb); }
    .score-bar { transition: width 1s cubic-bezier(0.4,0,0.2,1); }
    .gold-text { background: linear-gradient(90deg,#f59e0b,#fbbf24,#f59e0b); background-size:200%; -webkit-background-clip:text; -webkit-text-fill-color:transparent; animation: shimmer 3s ease infinite; }
    #display-podium { display:none; }
    @media screen and (max-width:640px) {
      .display-rank-row { gap:10px !important; padding:12px !important; }
      .display-rank-name { overflow-wrap:anywhere; }
      .display-rank-score { min-width:64px !important; }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Reload progress bar at very top -->
  <div class="fixed top-0 left-0 right-0 z-50 h-1" style="background:rgba(255,255,255,0.06)">
    <div id="reload-bar" class="h-full transition-none" style="width:100%;background:linear-gradient(90deg,#10b981,#34d399);transform-origin:left"></div>
  </div>

  <!-- Header -->
  <div class="flex-shrink-0 px-6 py-4 flex items-center justify-between mt-1" style="background:rgba(255,255,255,0.03);border-bottom:1px solid rgba(255,255,255,0.07)">
    <div class="flex items-center gap-4">
      <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="w-12 h-12 rounded-full shadow-xl" style="border:2px solid rgba(255,255,255,0.2)"/>
      <div>
        <div class="text-xs font-bold uppercase tracking-widest" style="color:#34d399">Live Scoreboard</div>
        <h1 class="text-2xl font-black tracking-tight text-white">{{event.name}}</h1>
        <div class="text-xs mt-0.5" style="color:#475569">{{event.venue}} {{#if event.date}}&bull; {{event.date}}{{/if}}</div>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <!-- Live badge -->
      <div class="flex items-center gap-2 px-3 py-1.5 rounded-full" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25)">
        <span class="w-2 h-2 rounded-full bg-emerald-400 live-dot"></span>
        <span class="text-sm font-bold" style="color:#34d399">LIVE</span>
      </div>
      <!-- Reload indicator -->
      <div class="flex flex-col items-center gap-1">
        <div class="relative w-12 h-12">
          <svg class="w-12 h-12 -rotate-90" viewBox="0 0 44 44">
            <circle cx="22" cy="22" r="18" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="3.5"/>
            <circle id="ring-arc" cx="22" cy="22" r="18" fill="none" stroke="#34d399" stroke-width="3.5"
              stroke-dasharray="113.1" stroke-dashoffset="0" stroke-linecap="round"
              style="transition:stroke-dashoffset 0.9s linear, stroke 0.3s"/>
          </svg>
          <!-- Reload icon in center -->
          <div class="absolute inset-0 flex items-center justify-center">
            <svg id="reload-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round">
              <path d="M21.5 2v6h-6"/>
              <path d="M21.34 15.57a10 10 0 1 1-.57-8.38"/>
            </svg>
          </div>
        </div>
        <div id="ring-num" class="text-[10px] font-extrabold" style="color:#34d399">10s</div>
      </div>
      <!-- Manual refresh button -->
      <button onclick="window.location.reload()" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold transition"
        style="background:rgba(255,255,255,0.06);color:#94a3b8;border:1px solid rgba(255,255,255,0.1)"
        onmouseover="this.style.background='rgba(16,185,129,0.12)';this.style.color='#34d399'"
        onmouseout="this.style.background='rgba(255,255,255,0.06)';this.style.color='#94a3b8'">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6"/><path d="M21.34 15.57a10 10 0 1 1-.57-8.38"/></svg>
        Refresh
      </button>
    </div>
  </div>

  <!-- Scoreboard -->
  <div class="flex-1 px-6 py-6 overflow-y-auto">

    {{#if ranked.length}}

    <!-- Top 3 Podium -->
    {{#if (gte ranked.length 3)}}
    <div id="display-podium" class="flex items-end justify-center gap-4 mb-8 max-w-3xl mx-auto">

      <!-- 2nd -->
      {{#each ranked}}{{#if (eq rank 2)}}
      <div class="flex-1 min-w-0 text-center animate-in" style="animation-delay:0.1s">
        <div class="text-3xl mb-2">🥈</div>
        <div class="rounded-2xl p-4" style="background:rgba(100,116,139,0.15);border:2px solid rgba(100,116,139,0.3)">
          {{#if photo}}<img src="{{photo}}" alt="{{name}}" class="w-16 h-16 rounded-full object-cover mx-auto mb-2 shadow-lg" style="border:2px solid #94a3b8;object-position:center top"/>
          {{else}}<div class="w-16 h-16 rounded-full flex items-center justify-center text-white font-black text-lg mx-auto mb-2" style="background:linear-gradient(135deg,#475569,#94a3b8)">{{number}}</div>{{/if}}
          <div class="text-base font-extrabold text-white" style="overflow-wrap:anywhere">{{name}}</div>
          {{#if barangay}}<div class="text-xs mt-0.5" style="color:#94a3b8">Brgy. {{barangay}}</div>{{/if}}
          <div class="text-2xl font-black mt-2" style="color:#e2e8f0">{{finalScoreDisplay}}<span class="text-sm font-normal" style="color:#64748b">%</span></div>
        </div>
        <div class="h-12 mt-2 rounded-t-xl mx-6" style="background:rgba(100,116,139,0.3)"></div>
      </div>
      {{/if}}{{/each}}

      <!-- 1st -->
      {{#each ranked}}{{#if (eq rank 1)}}
      <div class="flex-1 min-w-0 text-center animate-in" style="animation-delay:0s;margin-bottom:0">
        <div class="text-4xl mb-2" style="filter:drop-shadow(0 4px 12px rgba(251,191,36,0.5))">🏆</div>
        <div class="rounded-2xl p-5" style="background:linear-gradient(160deg,rgba(146,64,14,0.2),rgba(245,158,11,0.15));border:2px solid rgba(245,158,11,0.5)">
          {{#if photo}}<img src="{{photo}}" alt="{{name}}" class="w-20 h-20 rounded-full object-cover mx-auto mb-2 shadow-xl" style="border:3px solid #f59e0b;object-position:center top"/>
          {{else}}<div class="w-20 h-20 rounded-full flex items-center justify-center text-white font-black text-xl mx-auto mb-2" style="background:linear-gradient(135deg,#92400e,#f59e0b)">{{number}}</div>{{/if}}
          <div class="text-[10px] font-black uppercase tracking-widest mb-1" style="color:#fbbf24">Champion</div>
          <div class="text-xl font-black text-white" style="overflow-wrap:anywhere">{{name}}</div>
          {{#if barangay}}<div class="text-xs mt-0.5" style="color:#fbbf24">Brgy. {{barangay}}</div>{{/if}}
          <div class="text-3xl font-black mt-2 gold-text">{{finalScoreDisplay}}%</div>
        </div>
        <div class="h-20 mt-2 rounded-t-xl mx-4" style="background:linear-gradient(180deg,rgba(245,158,11,0.4),rgba(245,158,11,0.15))"></div>
      </div>
      {{/if}}{{/each}}

      <!-- 3rd -->
      {{#each ranked}}{{#if (eq rank 3)}}
      <div class="flex-1 min-w-0 text-center animate-in" style="animation-delay:0.2s">
        <div class="text-3xl mb-2">🥉</div>
        <div class="rounded-2xl p-4" style="background:rgba(124,45,18,0.15);border:2px solid rgba(249,115,22,0.3)">
          {{#if photo}}<img src="{{photo}}" alt="{{name}}" class="w-16 h-16 rounded-full object-cover mx-auto mb-2 shadow-lg" style="border:2px solid #f97316;object-position:center top"/>
          {{else}}<div class="w-16 h-16 rounded-full flex items-center justify-center text-white font-black text-lg mx-auto mb-2" style="background:linear-gradient(135deg,#7c2d12,#f97316)">{{number}}</div>{{/if}}
          <div class="text-base font-extrabold text-white" style="overflow-wrap:anywhere">{{name}}</div>
          {{#if barangay}}<div class="text-xs mt-0.5" style="color:#fb923c">Brgy. {{barangay}}</div>{{/if}}
          <div class="text-2xl font-black mt-2" style="color:#fb923c">{{finalScoreDisplay}}<span class="text-sm font-normal" style="color:#64748b">%</span></div>
        </div>
        <div class="h-8 mt-2 rounded-t-xl mx-6" style="background:rgba(249,115,22,0.3)"></div>
      </div>
      {{/if}}{{/each}}

    </div>
    {{/if}}

    <!-- All participants, ranked by score -->
    <div class="max-w-4xl mx-auto space-y-2">
      <div class="flex items-center justify-between px-1">
        <h2 class="text-sm font-extrabold text-white">All Participants by Rank</h2>
        <span class="px-3 py-1 rounded-full text-xs font-bold" style="background:rgba(59,130,246,0.12);color:#93c5fd">{{ranked.length}} participants</span>
      </div>
      {{#each ranked}}
      <div class="display-rank-row flex items-center gap-4 px-5 py-3.5 rounded-2xl animate-in"
        style="animation-delay:{{@index}}0ms;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07)">

        <!-- Rank -->
        <div class="w-10 h-10 rounded-xl flex items-center justify-center font-black text-sm text-white flex-shrink-0
          {{#if (eq rank 1)}}rank-1{{else}}{{#if (eq rank 2)}}rank-2{{else}}{{#if (eq rank 3)}}rank-3{{else}}rank-other{{/if}}{{/if}}{{/if}}">
          {{rank}}
        </div>

        <!-- Photo -->
        {{#if photo}}
        <img src="{{photo}}" alt="{{name}}" class="w-10 h-10 rounded-xl object-cover flex-shrink-0 shadow" style="object-position:center top"/>
        {{else}}
        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white text-xs font-bold flex-shrink-0" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">{{number}}</div>
        {{/if}}

        <!-- Name -->
        <div class="display-rank-name flex-1 min-w-0">
          <div class="font-bold text-sm" style="color:#e2e8f0">{{name}}</div>
          {{#if barangay}}<div class="text-xs" style="color:#475569">Brgy. {{barangay}}</div>{{/if}}
        </div>

        <!-- Score bar -->
        <div class="flex-1 hidden sm:block">
          <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
            <div class="h-full rounded-full score-bar
              {{#if (eq rank 1)}}{{else}}{{/if}}"
              style="width:{{finalScoreDisplay}}%;background:{{#if (eq rank 1)}}linear-gradient(90deg,#f59e0b,#fbbf24){{else}}{{#if (eq rank 2)}}linear-gradient(90deg,#64748b,#94a3b8){{else}}{{#if (eq rank 3)}}linear-gradient(90deg,#c2410c,#f97316){{else}}linear-gradient(90deg,#1e40af,#3b82f6){{/if}}{{/if}}{{/if}}"></div>
          </div>
        </div>

        <!-- Score -->
        <div class="display-rank-score text-right flex-shrink-0 min-w-[80px]">
          <div class="text-lg font-black {{#if (eq rank 1)}}gold-text{{/if}}" style="{{#unless (eq rank 1)}}color:#e2e8f0{{/unless}}">{{finalScoreDisplay}}%</div>
          {{#if gapToFirst}}{{#unless (eq rank 1)}}<div class="text-[10px]" style="color:#374151">-{{gapToFirst}}%</div>{{/unless}}{{/if}}
        </div>

      </div>
      {{/each}}
    </div>

    {{else}}
    <div class="flex flex-col items-center justify-center h-64 text-center">
      <div class="text-6xl mb-4">⏳</div>
      <h2 class="text-2xl font-black text-white mb-2">Waiting for scores...</h2>
      <p style="color:#475569">Judges are currently submitting scores. Results will appear here.</p>
    </div>
    {{/if}}

  </div>

  <!-- Footer -->
  <div class="flex-shrink-0 px-8 py-3 flex items-center justify-between text-xs" style="background:rgba(255,255,255,0.02);border-top:1px solid rgba(255,255,255,0.06);color:#374151">
    <span>ScoreSync — Official Tabulation System · Gloria, Oriental Mindoro</span>
    <span>{{criteria.length}} criteria · {{judgeCount}} judge(s)</span>
  </div>

</body>
<script>
// Auto-refresh countdown with progress bar + ring
(function() {
  const TOTAL = 10;
  let secs = TOTAL;
  const arc  = document.getElementById('ring-arc');
  const num  = document.getElementById('ring-num');
  const bar  = document.getElementById('reload-bar');
  const icon = document.getElementById('reload-icon');
  const circ = 113.1; // 2 * PI * 18

  function tick() {
    secs--;
    // Update ring
    if (num) num.textContent = secs + 's';
    if (arc) {
      const pct = secs / TOTAL;
      arc.style.strokeDashoffset = circ - (circ * pct);
      // Turn orange when < 3s
      arc.style.stroke = secs <= 3 ? '#f97316' : '#34d399';
      if (num) num.style.color = secs <= 3 ? '#f97316' : '#34d399';
    }
    // Update progress bar (shrinks from 100% to 0%)
    if (bar) bar.style.width = ((secs / TOTAL) * 100) + '%';

    if (secs <= 0) {
      // Spin the reload icon before reload
      if (icon) {
        icon.style.animation = 'spin 0.5s linear';
        icon.style.stroke = '#f97316';
      }
      if (bar) { bar.style.background = 'linear-gradient(90deg,#f97316,#fbbf24)'; bar.style.width = '100%'; }
      setTimeout(() => window.location.reload(), 400);
      return;
    }
    setTimeout(tick, 1000);
  }
  setTimeout(tick, 1000);
})();
</script>
<style>
@keyframes spin { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
</style>
</html>
