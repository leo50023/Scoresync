{{> head }}
<body class="min-h-screen flex flex-col ss-page-bg">
  <header class="h-14 border-b flex items-center justify-between px-4 sm:px-6" style="background:#0d1424;border-bottom-color:rgba(255,255,255,0.06)">
    <a href="/" class="flex items-center gap-2">
      <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="w-8 h-8 object-cover rounded-full" style="border:1.5px solid rgba(255,255,255,0.15)"/>
      <span class="font-black text-white text-sm tracking-tight">ScoreSync</span>
    </a>
    <a href="{{eventPath}}" class="btn-sm btn-sm-gray" aria-label="Back to event management">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/><path d="M20 12H9"/>
      </svg>
      <span>Back to event</span>
    </a>
  </header>

  <main id="qr-page" data-vote-path="{{votePath}}" class="flex-1 flex items-center justify-center p-4">
    <section class="card-flat w-full max-w-lg p-6 sm:p-10 text-center">
      <div class="flex justify-center mb-4">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#fb7185" stroke-width="1.8">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <p class="text-xs font-bold uppercase tracking-widest mb-2" style="color:#93c5fd">Audience Voting</p>
      <h1 class="text-2xl sm:text-3xl font-black text-white">{{event.name}}</h1>
      <p class="mt-2 text-sm" style="color:var(--text-secondary)">Scan this code with your phone to vote for your favorite contestant.</p>

      {{#if peopleChoiceCriterionMissing}}
      <div class="mt-6 rounded-2xl p-5 text-left" style="background:rgba(248,113,113,0.08);border:1px solid rgba(248,113,113,0.18)" role="status">
        <p class="text-sm font-bold" style="color:#fecaca">Audience voting is unavailable</p>
        <p class="mt-1 text-sm leading-relaxed" style="color:var(--text-secondary)">Add a <strong class="text-white">People�s Choice</strong> criterion in the event settings before opening audience voting.</p>
      </div>
      {{else}}
        {{#if votingOpen}}
        <div class="inline-flex items-center gap-2 mt-5 badge badge-green">
          <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
          Voting Open � ready to share
        </div>
        <div class="mt-6 inline-flex items-center justify-center rounded-2xl p-4" style="background:#fff;min-width:296px;min-height:296px">
          <canvas id="vote-qr" aria-label="QR code linking to the public audience voting page"></canvas>
        </div>
        <p id="qr-error" class="hidden mt-4 text-sm" style="color:#fca5a5" role="alert">QR code could not be generated. Please refresh this page and try again.</p>
        <p id="vote-url" class="mt-4 text-xs break-all" style="color:var(--text-muted)"></p>
        <p class="mt-2 text-xs" style="color:var(--text-muted)">Scanning opens the public ballot. Admin tools are not shown to voters.</p>
        {{else}}
        <div class="mt-6 rounded-2xl p-5 text-left" style="background:rgba(96,165,250,0.08);border:1px solid rgba(96,165,250,0.18)" role="status">
          <p class="text-sm font-bold" style="color:#bfdbfe">Voting is not open yet</p>
          <p class="mt-1 text-sm leading-relaxed" style="color:var(--text-secondary)">Open audience voting from the event page to generate a shareable QR code.</p>
        </div>
        {{/if}}
      {{/if}}
    </section>
  </main>

  {{#if votingOpen}}
  <script>
  (function () {
    var path = document.getElementById('qr-page').getAttribute('data-vote-path');
    var publicUrl = window.location.origin + path;
    var urlLabel = document.getElementById('vote-url');
    var errorLabel = document.getElementById('qr-error');
    if (urlLabel) urlLabel.textContent = publicUrl;

    function renderCode() {
      if (!window.QRCode) {
        errorLabel.classList.remove('hidden');
        return;
      }
      window.QRCode.toCanvas(
        document.getElementById('vote-qr'),
        publicUrl,
        { width: 264, margin: 1, color: { dark: '#0f2156', light: '#ffffff' } }
      ).catch(function (error) {
        console.error('Could not generate audience voting QR code:', error);
        errorLabel.classList.remove('hidden');
      });
    }

    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js';
    script.onload = renderCode;
    script.onerror = function () {
      console.error('Could not load the QR code library.');
      errorLabel.classList.remove('hidden');
    };
    document.head.appendChild(script);
  })();
  </script>
  {{/if}}
</body>
</html>
