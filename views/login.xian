{{> head }}
<style>
  /* ── Page ── */
  body.auth-page {
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center; justify-content: center;
    padding: 40px 20px;
    position: relative; isolation: isolate;
    overflow-y: auto; overflow-x: hidden;
    background: #060c1a;
  }

  /* ── Mesh gradient background ── */
  .auth-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
  }
  .auth-bg::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 12% 20%, rgba(88,56,255,0.28) 0%, transparent 52%),
      radial-gradient(ellipse at 88% 78%, rgba(6,182,212,0.18) 0%, transparent 52%),
      radial-gradient(ellipse at 55%  5%, rgba(124,58,237,0.18) 0%, transparent 45%),
      radial-gradient(ellipse at 5%  80%, rgba(99,102,241,0.12) 0%, transparent 45%),
      radial-gradient(ellipse at 90% 15%, rgba(14,165,233,0.12) 0%, transparent 40%);
    animation: bgPulse 18s ease-in-out infinite alternate;
  }
  .auth-bg::after {
    content: '';
    position: absolute; inset: 0;
    background-image:
      radial-gradient(rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
    opacity: 0.6;
  }
  @keyframes bgPulse {
    0%   { opacity: 0.85; transform: scale(1); }
    100% { opacity: 1;    transform: scale(1.04); }
  }

  /* ── Shell ── */
  .auth-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 420px;
    display: flex; flex-direction: column; align-items: center;
  }

  /* ── Logo ── */
  .auth-logomark {
    width: 68px; height: 68px; border-radius: 20px;
    overflow: hidden; flex-shrink: 0; margin-bottom: 18px;
    box-shadow:
      0 0 0 1px rgba(124,58,237,0.35),
      0 0 24px rgba(124,58,237,0.3),
      0 8px 32px rgba(0,0,0,0.5);
    animation: logoPulse 5s ease-in-out infinite;
  }
  .auth-logomark img { width: 100%; height: 100%; object-fit: cover; }
  @keyframes logoPulse {
    0%,100% { box-shadow: 0 0 0 1px rgba(124,58,237,0.35), 0 0 24px rgba(124,58,237,0.3), 0 8px 32px rgba(0,0,0,0.5); }
    50%      { box-shadow: 0 0 0 1px rgba(124,58,237,0.5),  0 0 36px rgba(124,58,237,0.45), 0 8px 40px rgba(0,0,0,0.6); }
  }

  /* ── Eyebrow ── */
  .auth-eyebrow {
    font-size: 11px; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: rgba(167,139,250,0.7);
    margin-bottom: 8px; display: flex; align-items: center; gap: 8px;
  }
  .auth-eyebrow::before, .auth-eyebrow::after {
    content: ''; flex: 1; max-width: 28px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(167,139,250,0.4));
  }
  .auth-eyebrow::after { background: linear-gradient(90deg, rgba(167,139,250,0.4), transparent); }

  /* ── Title ── */
  .auth-title {
    font-size: 30px; font-weight: 800;
    letter-spacing: -0.025em; line-height: 1.15;
    color: #ffffff; margin-bottom: 6px; text-align: center;
    text-shadow: 0 2px 20px rgba(124,58,237,0.25);
  }
  .auth-subtitle {
    font-size: 14px; color: rgba(148,163,184,0.75);
    text-align: center; margin-bottom: 28px;
  }

  /* ── Tab switcher ── */
  .auth-tab-wrap {
    display: flex; gap: 4px;
    padding: 5px; border-radius: 14px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 20px; width: 100%;
    backdrop-filter: blur(12px);
  }
  .auth-tab {
    flex: 1; padding: 10px 16px; border-radius: 10px;
    font-size: 14px; font-weight: 600;
    text-align: center; text-decoration: none;
    color: rgba(148,163,184,0.7);
    transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
  }
  .auth-tab:not(.active):hover { color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.05); }
  .auth-tab.active {
    background: linear-gradient(135deg, rgba(124,58,237,0.85), rgba(99,102,241,0.85));
    color: #fff;
    box-shadow: 0 4px 20px rgba(124,58,237,0.4), inset 0 1px 0 rgba(255,255,255,0.15);
  }

  /* ── Card — glassmorphism ── */
  .auth-card {
    background: rgba(255,255,255,0.055);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 24px; padding: 32px 28px;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.06) inset,
      0 32px 80px rgba(0,0,0,0.55),
      0 8px 24px rgba(0,0,0,0.3),
      0 1px 0 rgba(255,255,255,0.1) inset;
    backdrop-filter: blur(40px) saturate(180%);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    width: 100%;
    animation: cardIn 0.7s cubic-bezier(0.16,1,0.3,1) both;
    animation-delay: 0.1s;
  }
  @keyframes cardIn {
    from { opacity:0; transform:translateY(24px) scale(0.97); }
    to   { opacity:1; transform:translateY(0)    scale(1);    }
  }

  /* ── Label ── */
  .auth-label {
    display: block; font-size: 12px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(148,163,184,0.9); margin-bottom: 8px;
  }

  /* ── Input ── */
  .input-icon-wrap { position: relative; }
  .input-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: rgba(148,163,184,0.45); pointer-events: none; z-index: 1;
    transition: color 0.25s ease;
  }
  .input-icon-wrap:focus-within .input-icon { color: rgba(167,139,250,0.9); }
  .auth-input {
    width: 100%; height: 50px;
    padding: 0 14px 0 46px;
    background: rgba(255,255,255,0.06) !important;
    border: 1.5px solid rgba(255,255,255,0.1) !important;
    border-radius: 13px !important;
    font-size: 14.5px; color: #f1f5f9 !important;
    outline: none;
    transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
    -webkit-text-fill-color: #f1f5f9;
  }
  .auth-input:hover { border-color: rgba(255,255,255,0.18) !important; }
  .auth-input:focus {
    background: rgba(255,255,255,0.09) !important;
    border-color: rgba(124,58,237,0.65) !important;
    box-shadow: 0 0 0 4px rgba(124,58,237,0.15), 0 2px 8px rgba(0,0,0,0.2) !important;
  }
  .auth-input::placeholder { color: rgba(100,116,139,0.6); }
  .auth-input:-webkit-autofill,
  .auth-input:-webkit-autofill:hover,
  .auth-input:-webkit-autofill:focus,
  .auth-input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 1000px rgba(15,20,40,0.92) inset !important;
    -webkit-text-fill-color: #f1f5f9 !important;
    caret-color: #f1f5f9 !important;
    transition: background-color 9999s ease-in-out 0s;
  }
  .auth-input-pr { padding-right: 48px; }

  /* ── Button ── */
  .auth-btn {
    width: 100%; height: 52px;
    border-radius: 14px; font-size: 15px; font-weight: 700;
    color: #fff; border: none; cursor: pointer;
    background: linear-gradient(135deg, #7c3aed 0%, #6366f1 55%, #3b82f6 100%);
    box-shadow: 0 6px 24px rgba(124,58,237,0.45), 0 2px 8px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
    display: flex; align-items: center; justify-content: center; gap: 8px;
    letter-spacing: 0.01em;
    position: relative; overflow: hidden;
  }
  .auth-btn::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 60%);
    opacity: 0; transition: opacity 0.3s ease;
  }
  .auth-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(124,58,237,0.55), 0 4px 12px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.25);
  }
  .auth-btn:hover::before { opacity: 1; }
  .auth-btn:active { transform: translateY(0); transition-duration: 0.1s; }
  .auth-btn.loading { opacity: 0.8; cursor: not-allowed; pointer-events: none; }
  .auth-btn .btn-spinner {
    display: none; width: 18px; height: 18px;
    border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff;
    border-radius: 50%; animation: spin 0.7s linear infinite;
  }
  .auth-btn.loading .btn-spinner { display: block; }
  .auth-btn.loading .btn-text { opacity: 0.8; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Remember + Forgot ── */
  .auth-remember-forgot {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 22px;
  }
  .auth-remember {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: rgba(148,163,184,0.8); cursor: pointer;
  }
  .auth-remember input[type="checkbox"] { width: 16px; height: 16px; accent-color: #7c3aed; cursor: pointer; }
  .auth-forgot { font-size: 13px; color: rgba(167,139,250,0.9) !important; text-decoration: none; font-weight: 600; transition: color 0.2s ease; }
  .auth-forgot:hover { color: #c4b5fd !important; }

  /* ── Footer ── */
  .auth-footer { margin-top: 24px; text-align: center; }
  .auth-footer p { color: rgba(100,116,139,0.8); font-size: 13.5px; margin-bottom: 14px; }
  .auth-footer a { color: rgba(167,139,250,0.95) !important; font-weight: 600; text-decoration: none; transition: color 0.2s ease; }
  .auth-footer a:hover { color: #c4b5fd !important; }
  .auth-home-link {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    height: 40px; padding: 0 20px;
    border: 1px solid rgba(255,255,255,0.1); border-radius: 999px;
    background: rgba(255,255,255,0.04); color: rgba(148,163,184,0.7);
    font-size: 13px; font-weight: 600; text-decoration: none;
    transition: all 0.3s ease;
  }
  .auth-home-link:hover { background: rgba(255,255,255,0.08); color: #fff; border-color: rgba(255,255,255,0.18); }

  /* ── Trust badges ── */
  .auth-trust {
    display: flex; align-items: center; justify-content: center; gap: 20px;
    font-size: 11.5px; color: rgba(100,116,139,0.6);
    margin-top: 20px; flex-wrap: wrap;
    padding: 10px 16px; border-radius: 12px;
    background: rgba(255,255,255,0.025);
    border: 1px solid rgba(255,255,255,0.06);
  }
  .auth-trust span { display: inline-flex; align-items: center; gap: 6px; }

  /* ── Loader ── */
  .auth-loader { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 9999; background: rgba(255,255,255,0.06); overflow: hidden; opacity: 0; transition: opacity 0.2s ease; }
  .auth-loader.active { opacity: 1; }
  .auth-loader-bar { height: 100%; width: 0%; background: linear-gradient(90deg, #7c3aed, #a78bfa, #6366f1, #3b82f6); background-size: 200% 100%; animation: shimmer 1.5s linear infinite; border-radius: 0 3px 3px 0; box-shadow: 0 0 16px rgba(124,58,237,0.9); transition: width 0.3s ease; }
  @keyframes shimmer { from{background-position:200% 0} to{background-position:-200% 0} }

  /* ── Mobile ── */
  @media (max-width: 480px) {
    body.auth-page { padding: 16px 16px 20px; align-items: flex-start; }
    .auth-shell { width: calc(100% - 24px); margin: 0 auto; max-width: 100%; }
    .auth-logomark { width: 54px; height: 54px; border-radius: 15px; margin-bottom: 12px; animation: none; }
    .auth-title { font-size: 22px; }
    .auth-subtitle { font-size: 13px; margin-bottom: 18px; }
    .auth-tab-wrap { margin-bottom: 14px; }
    .auth-card { padding: 22px 18px; border-radius: 18px; animation: none; }
    .auth-card .space-y-5 > * + * { margin-top: 14px !important; }
    .auth-input { height: 46px !important; font-size: 16px !important; }
    .auth-btn { height: 48px; font-size: 14.5px; }
    .auth-footer { margin-top: 16px; }
    .auth-trust { margin-top: 14px; font-size: 11px; gap: 14px; }
  }
  @media (max-width: 360px) {
    body.auth-page { padding: 12px 12px 16px; }
    .auth-title { font-size: 20px; }
  }
</style>

<div class="auth-bg"></div>
<div class="auth-loader" id="auth-loader"><div class="auth-loader-bar" id="auth-loader-bar"></div></div>

<body class="auth-page" style="overflow-x:hidden">
<div class="auth-shell fm-fade-up">

  <div class="auth-logomark">
    <img src="/scoresync-logo.png?v=8" alt="ScoreSync"/>
  </div>
  <div class="auth-eyebrow">ScoreSync</div>
  <h1 class="auth-title">Welcome back</h1>
  <p class="auth-subtitle">Sign in to continue to your account</p>

  <div class="auth-tab-wrap">
    <a href="/login"    class="auth-tab active" aria-current="page">Sign In</a>
    <a href="/register" class="auth-tab">Register</a>
  </div>

  {{#if error_msg}}
  <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.25);border-radius:12px;padding:12px 16px;margin-bottom:16px;color:#fca5a5;font-size:13px;display:flex;align-items:center;gap:8px;width:100%;box-sizing:border-box;backdrop-filter:blur(12px)">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>{{error_msg}}</span>
  </div>
  {{/if}}
  {{#if success_msg}}
  <div style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.25);border-radius:12px;padding:12px 16px;margin-bottom:16px;color:#86efac;font-size:13px;display:flex;align-items:center;gap:8px;width:100%;box-sizing:border-box">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
    <span>{{success_msg}}</span>
  </div>
  {{/if}}

  <div class="auth-card fm-scale-in fm-delay-2">
    <form method="POST" action="/login">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">

      <div style="margin-bottom:20px">
        <label class="auth-label">Email address</label>
        <div class="input-icon-wrap">
          <span class="input-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="auth-input"/>
        </div>
      </div>

      <div style="margin-bottom:6px">
        <label class="auth-label">Password</label>
        <div class="input-icon-wrap" style="position:relative">
          <span class="input-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <input type="password" name="password" id="passwordInput" placeholder="Enter your password" required autocomplete="current-password" class="auth-input auth-input-pr"/>
          <button type="button" id="eyeBtn" onclick="togglePwd()"
            style="position:absolute;right:14px;top:50%;transform:translateY(-50%);color:rgba(100,116,139,0.6);background:none;border:none;cursor:pointer;padding:4px;display:flex;align-items:center;justify-content:center;transition:color 0.2s ease"
            onmouseover="this.style.color='rgba(167,139,250,0.9)'" onmouseout="this.style.color='rgba(100,116,139,0.6)'">
            <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <div class="auth-remember-forgot">
        <label class="auth-remember">
          <input type="checkbox" name="remember"> Remember me
        </label>
        <a href="/forgot-password" class="auth-forgot">Forgot password?</a>
      </div>

      <button type="submit" class="auth-btn fm-tap" data-loading="Signing in...">
        <div class="btn-spinner"></div>
        <span class="btn-text">Sign in</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>
  </div>

  <div class="auth-footer">
    <p>Don't have an account? <a href="/register">Create one</a></p>
    <a href="/" class="auth-home-link">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/></svg>
      Back to homepage
    </a>
  </div>

  <div class="auth-trust">
    <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/></svg>Secure login</span>
    <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Encrypted</span>
    <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>Real-time sync</span>
  </div>

</div>

<script>
const eyeOpen='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePwd(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){i.type='text';b.innerHTML=eyeClose;}
  else{i.type='password';b.innerHTML=eyeOpen;}
}
function startLoader(){
  var l=document.getElementById('auth-loader'),b=document.getElementById('auth-loader-bar');
  if(!l||!b)return; l.classList.add('active'); b.style.width='0%';
  setTimeout(function(){b.style.width='35%'},60);
  setTimeout(function(){b.style.width='65%'},350);
  setTimeout(function(){b.style.width='82%'},900);
}
document.querySelectorAll('.auth-card form').forEach(function(f){
  f.addEventListener('submit',function(){
    startLoader();
    var btn=f.querySelector('.auth-btn');
    if(btn){btn.classList.add('loading');var t=btn.querySelector('.btn-text');if(t)t.textContent=btn.dataset.loading||'Please wait...';}
  });
});
</script>
</body>
</html>
