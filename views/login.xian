{{> head }}
<style>
  /* ── Base ── */
  body.auth-page {
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center; justify-content: center;
    padding: clamp(20px,4vh,48px) 16px;
    position: relative; isolation: isolate; overflow: hidden;
    background: #060c1a;
  }

  /* ── Animated background ── */
  .auth-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
  }
  .auth-bg-orb {
    position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.55;
    animation: orbFloat 8s ease-in-out infinite;
  }
  .auth-bg-orb-1 {
    width: 480px; height: 480px; top: -140px; left: -100px;
    background: radial-gradient(circle, rgba(79,70,229,0.4), transparent 70%);
    animation-delay: 0s;
  }
  .auth-bg-orb-2 {
    width: 360px; height: 360px; bottom: -80px; right: -80px;
    background: radial-gradient(circle, rgba(14,165,233,0.3), transparent 70%);
    animation-delay: -3s;
  }
  .auth-bg-orb-3 {
    width: 280px; height: 280px; top: 40%; left: 55%;
    background: radial-gradient(circle, rgba(139,92,246,0.2), transparent 70%);
    animation-delay: -5s;
  }
  @keyframes orbFloat {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-24px) scale(1.04); }
  }
  .auth-bg-grid {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(148,163,184,0.12) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 72%);
    opacity: 0.22;
  }

  /* ── Shell ── */
  .auth-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 420px;
    display: flex; flex-direction: column;
  }

  /* ── Logo mark ── */
  .auth-logomark {
    width: 72px; height: 72px; border-radius: 22px;
    overflow: hidden; flex-shrink: 0; margin-bottom: 20px;
    box-shadow: 0 8px 32px rgba(79,70,229,0.35), 0 0 0 1px rgba(255,255,255,0.1);
    background: linear-gradient(135deg,#1e2d5c,#2d3d7a);
    display: flex; align-items: center; justify-content: center;
  }
  .auth-logomark img { width: 100%; height: 100%; object-fit: cover; }

  /* ── Eyebrow ── */
  .auth-eyebrow {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.62rem; font-weight: 800;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: #818cf8; margin-bottom: 8px;
  }
  .auth-eyebrow::before {
    content: ""; width: 18px; height: 1px;
    background: linear-gradient(90deg, transparent, #818cf8);
  }

  /* ── Heading ── */
  .auth-title {
    font-size: 1.9rem; font-weight: 900;
    letter-spacing: -0.04em; line-height: 1.1;
    color: #f1f5f9; margin-bottom: 6px;
  }
  .auth-subtitle { font-size: 0.83rem; color: #94a3b8; }

  /* ── Tab switcher ── */
  .auth-tab-wrap {
    display: flex; gap: 4px;
    padding: 4px; border-radius: 14px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 24px;
  }
  .auth-tab {
    flex: 1; padding: 10px 12px; border-radius: 11px;
    font-size: 0.82rem; font-weight: 700;
    text-align: center; text-decoration: none;
    color: #94a3b8;
    transition: all 160ms ease;
  }
  .auth-tab:not(.active):hover { background: rgba(255,255,255,0.06); color: #e2e8f0; }
  .auth-tab.active {
    background: linear-gradient(135deg,#4f46e5,#6366f1);
    color: #fff;
    box-shadow: 0 4px 14px rgba(79,70,229,0.4), inset 0 1px 0 rgba(255,255,255,0.2);
  }

  /* ── Card ── */
  .auth-card {
    background: linear-gradient(160deg, rgba(18,26,48,0.98), rgba(12,18,34,0.98));
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    padding: 32px 28px;
    box-shadow: 0 32px 80px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.04), inset 0 1px 0 rgba(255,255,255,0.07);
    backdrop-filter: blur(20px);
  }
  @media (max-width: 400px) { .auth-card { padding: 24px 18px; } }

  /* ── Label ── */
  .auth-label {
    display: block; font-size: 0.67rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #64748b; margin-bottom: 7px;
  }

  /* ── Input ── */
  .input-icon-wrap { position: relative; }
  .input-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #475569; pointer-events: none; z-index: 1;
    transition: color 160ms ease;
  }
  .input-icon-wrap:focus-within .input-icon { color: #818cf8; }

  .auth-input {
    width: 100%;
    min-height: 52px;
    padding: 14px 14px 14px 44px;
    background: rgba(8,13,26,0.7) !important;
    border: 1.5px solid rgba(148,163,184,0.14) !important;
    border-radius: 13px !important;
    font-size: 0.9rem;
    color: #e2e8f0 !important;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
    -webkit-text-fill-color: #e2e8f0;
  }
  .auth-input:focus {
    background: rgba(13,22,42,0.98) !important;
    border-color: rgba(129,140,248,0.75) !important;
    box-shadow: 0 0 0 4px rgba(99,102,241,0.15), 0 4px 20px rgba(0,0,0,0.2) !important;
  }
  .auth-input::placeholder { color: #374151; }
  .auth-input:-webkit-autofill,
  .auth-input:-webkit-autofill:hover,
  .auth-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #0d1527 inset !important;
    -webkit-text-fill-color: #e2e8f0 !important;
    caret-color: #e2e8f0 !important;
    transition: background-color 9999s ease-in-out 0s;
  }
  .auth-input-pr { padding-right: 48px; }

  /* ── Divider ── */
  .auth-divider {
    display: flex; align-items: center; gap: 12px;
    font-size: 0.7rem; color: #334155; margin: 4px 0;
  }
  .auth-divider::before, .auth-divider::after {
    content: ""; flex: 1; height: 1px;
    background: rgba(255,255,255,0.07);
  }

  /* ── Button ── */
  .auth-btn {
    width: 100%; min-height: 52px; padding: 14px;
    border-radius: 14px;
    font-size: 0.92rem; font-weight: 800;
    color: #fff; border: none; cursor: pointer;
    background: linear-gradient(110deg,#4338ca,#5b51f0 50%,#7c73f5);
    box-shadow: 0 10px 28px rgba(79,70,229,0.32), inset 0 1px 0 rgba(255,255,255,0.25);
    transition: filter 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    letter-spacing: -0.01em; position: relative; overflow: hidden;
  }
  .auth-btn::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
    opacity: 0; transition: opacity 160ms ease;
  }
  .auth-btn:hover { filter: brightness(1.1); transform: translateY(-1px); box-shadow: 0 16px 36px rgba(79,70,229,0.42); }
  .auth-btn:hover::after { opacity: 1; }
  .auth-btn:active { transform: translateY(0); filter: brightness(0.97); }

  /* ── Footer links ── */
  .auth-home-link {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 42px; padding: 0 20px;
    border: 1px solid rgba(165,180,252,0.2);
    border-radius: 999px;
    background: rgba(99,102,241,0.07);
    color: #a5b4fc; font-size: 0.8rem; font-weight: 600;
    text-decoration: none;
    transition: all 160ms ease;
  }
  .auth-home-link:hover {
    background: rgba(99,102,241,0.16);
    border-color: rgba(165,180,252,0.45);
    color: #e0e7ff; transform: translateY(-1px);
  }
  .auth-footer { color: #64748b; }
  .auth-footer a:not(.auth-home-link) {
    color: #818cf8 !important; font-weight: 700;
    transition: color 160ms ease;
  }
  .auth-footer a:not(.auth-home-link):hover { color: #c7d2fe !important; }

  /* ── Trust badges ── */
  .auth-trust {
    display: flex; align-items: center; justify-content: center; gap: 16px;
    font-size: 0.68rem; color: #475569; margin-top: 20px; flex-wrap: wrap;
  }
  .auth-trust span {
    display: inline-flex; align-items: center; gap: 5px;
  }

  /* ── Focus rings ── */
  .auth-tab:focus-visible, .auth-home-link:focus-visible {
    outline: 2px solid #a5b4fc; outline-offset: 3px;
  }
</style>

<div class="auth-bg">
  <div class="auth-bg-grid"></div>
  <div class="auth-bg-orb auth-bg-orb-1"></div>
  <div class="auth-bg-orb auth-bg-orb-2"></div>
  <div class="auth-bg-orb auth-bg-orb-3"></div>
</div>

<body class="auth-page">
  <div class="auth-shell animate-fadeup">

    <!-- Logo + heading -->
    <div class="flex flex-col items-center text-center mb-8">
      <div class="auth-logomark">
        <img src="/scoresync-logo.png?v=8" alt="ScoreSync"/>
      </div>
      <span class="auth-eyebrow">ScoreSync</span>
      <h1 class="auth-title">Welcome back</h1>
      <p class="auth-subtitle">Sign in to your account to continue</p>
    </div>

    <!-- Tab switcher -->
    <div class="auth-tab-wrap">
      <a href="/login" class="auth-tab active" aria-current="page">Sign In</a>
      <a href="/register" class="auth-tab">Register</a>
    </div>

    {{#if error_msg}}
    <div class="alert-error mb-4 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}
    {{#if success_msg}}
    <div class="alert-success mb-4 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
      <span>{{success_msg}}</span>
    </div>
    {{/if}}

    <!-- Card -->
    <div class="auth-card">
      <form method="POST" action="/login" class="space-y-5">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <!-- Email -->
        <div>
          <label class="auth-label">Email Address</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="auth-input"/>
          </div>
        </div>

        <!-- Password -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="auth-label" style="margin-bottom:0">Password</label>
            <a href="/forgot-password" class="text-[11px] font-semibold" style="color:#818cf8;text-decoration:none;transition:color 160ms ease" onmouseover="this.style.color='#c7d2fe'" onmouseout="this.style.color='#818cf8'">Forgot password?</a>
          </div>
          <div class="input-icon-wrap" style="position:relative">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" name="password" id="passwordInput" placeholder="Your password" required autocomplete="current-password" class="auth-input auth-input-pr"/>
            <button type="button" id="eyeBtn" onclick="togglePwd()"
              style="position:absolute;right:14px;top:50%;transform:translateY(-50%);color:#475569;background:none;border:none;cursor:pointer;padding:4px;display:flex;align-items:center;justify-content:center;border-radius:6px;transition:color 120ms ease;height:28px;width:28px">
              <svg id="eyeIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <!-- Remember me -->
        <label class="flex items-center gap-2.5 text-xs font-medium cursor-pointer select-none" style="color:#64748b">
          <input type="checkbox" class="w-4 h-4 rounded" style="accent-color:#6366f1;flex-shrink:0"> Remember me for 30 days
        </label>

        <!-- Submit -->
        <button type="submit" class="auth-btn">
          Sign In
          <svg style="display:inline;margin-left:8px;vertical-align:-2px" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>

      </form>
    </div>

    <!-- Footer -->
    <div class="auth-footer mt-6 text-center space-y-3 text-xs">
      <p>Don't have an account? <a href="/register">Register here</a></p>
      <a href="/" class="auth-home-link">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/></svg>
        Back to homepage
      </a>
    </div>

    <!-- Trust badges -->
    <div class="auth-trust">
      <span><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/></svg> Secure login</span>
      <span><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Encrypted</span>
      <span><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Real-time sync</span>
    </div>

  </div>

<script>
const eyeOpen='<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePwd(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){i.type='text';b.innerHTML=eyeClose;}
  else{i.type='password';b.innerHTML=eyeOpen;}
}
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('input').forEach(el=>{
    el.style.setProperty('background-color','rgba(8,13,26,0.7)','important');
    el.style.setProperty('color','#e2e8f0','important');
    setTimeout(()=>{
      el.style.setProperty('background-color','rgba(8,13,26,0.7)','important');
      el.style.setProperty('color','#e2e8f0','important');
    },300);
  });
});
</script>
</body>
</html>
