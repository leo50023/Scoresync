{{> head }}
<style>
  /* ── Page ── */
  body.auth-page {
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center; justify-content: center;
    padding: 24px 20px;
    position: relative; isolation: isolate; overflow: hidden;
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 25%, #1e3a5f 75%, #0f172a 100%);
  }

  /* ── Animated gradient orbs ── */
  .auth-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .auth-bg::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 20% 20%, rgba(139,92,246,0.4) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 80%, rgba(59,130,246,0.3) 0%, transparent 50%),
      radial-gradient(ellipse at 60% 10%, rgba(99,102,241,0.25) 0%, transparent 40%),
      radial-gradient(ellipse at 10% 80%, rgba(168,85,247,0.2) 0%, transparent 40%);
    animation: bgShift 12s ease-in-out infinite alternate;
  }
  @keyframes bgShift {
    0%   { opacity: 0.8; transform: scale(1) rotate(0deg); }
    100% { opacity: 1;   transform: scale(1.06) rotate(2deg); }
  }

  /* ── Shell ── */
  .auth-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 420px;
    display: flex; flex-direction: column; align-items: center;
  }

  /* ── Logo ── */
  .auth-logomark {
    width: 64px; height: 64px; border-radius: 16px;
    overflow: hidden; flex-shrink: 0; margin-bottom: 20px;
    box-shadow: 0 8px 32px rgba(139,92,246,0.3);
    animation: logoPulse 4s ease-in-out infinite;
  }
  .auth-logomark img { width: 100%; height: 100%; object-fit: cover; }
  @keyframes logoPulse {
    0%,100% { box-shadow: 0 8px 32px rgba(139,92,246,0.3); }
    50%      { box-shadow: 0 8px 40px rgba(139,92,246,0.5), 0 0 20px rgba(139,92,246,0.3); }
  }

  /* ── Title ── */
  .auth-title {
    font-size: 28px; font-weight: 800;
    letter-spacing: -0.02em; line-height: 1.2;
    color: #ffffff; margin-bottom: 8px; text-align: center;
  }
  .auth-subtitle { font-size: 14px; color: rgba(255,255,255,0.6); text-align: center; margin-bottom: 24px; }

  /* ── Tab switcher ── */
  .auth-tab-wrap {
    display: flex; gap: 0;
    padding: 6px; border-radius: 12px;
    background: rgba(15,23,42,0.6);
    border: 1px solid rgba(148,163,184,0.1);
    margin-bottom: 24px; width: 100%;
  }
  .auth-tab {
    flex: 1; padding: 10px 16px; border-radius: 8px;
    font-size: 14px; font-weight: 600;
    text-align: center; text-decoration: none;
    color: rgba(255,255,255,0.5);
    transition: all 200ms ease;
  }
  .auth-tab:not(.active):hover { color: rgba(255,255,255,0.8); }
  .auth-tab.active {
    background: rgba(139,92,246,0.2);
    color: #fff;
    border: 1px solid rgba(139,92,246,0.3);
  }

  /* ── Card ── */
  .auth-card {
    background: rgba(15,23,42,0.6);
    border: 1px solid rgba(148,163,184,0.1);
    border-radius: 20px; padding: 28px 24px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    width: 100%;
  }

  /* ─ Label ── */
  .auth-label {
    display: block; font-size: 13px; font-weight: 600;
    color: rgba(255,255,255,0.8); margin-bottom: 8px;
  }

  /* ── Input ── */
  .input-icon-wrap { position: relative; }
  .input-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: rgba(255,255,255,0.4); pointer-events: none; z-index: 1;
    transition: color 150ms ease;
  }
  .input-icon-wrap:focus-within .input-icon { color: rgba(139,92,246,0.8); }
  .auth-input {
    width: 100%; height: 48px;
    padding: 0 14px 0 44px;
    background: rgba(15,23,42,0.8) !important;
    border: 1px solid rgba(148,163,184,0.2) !important;
    border-radius: 12px !important;
    font-size: 14px; color: #ffffff !important;
    outline: none;
    transition: all 160ms ease;
    -webkit-text-fill-color: #ffffff;
  }
  .auth-input:focus {
    background: rgba(30,27,75,0.9) !important;
    border-color: rgba(139,92,246,0.6) !important;
    box-shadow: 0 0 0 3px rgba(139,92,246,0.15) !important;
  }
  .auth-input::placeholder { color: rgba(255,255,255,0.4); }
  .auth-input:-webkit-autofill,
  .auth-input:-webkit-autofill:hover,
  .auth-input:-webkit-autofill:focus,
  .auth-input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 1000px rgba(15,23,42,0.9) inset !important;
    -webkit-text-fill-color: #ffffff !important;
    caret-color: #ffffff !important;
    transition: background-color 9999s ease-in-out 0s;
  }
  .auth-input-pr { padding-right: 44px; }

  /* ── Button ── */
  .auth-btn {
    width: 100%; height: 48px;
    border-radius: 12px; font-size: 15px; font-weight: 700;
    color: #fff; border: none; cursor: pointer;
    background: linear-gradient(135deg, #7c3aed 0%, #6366f1 50%, #3b82f6 100%);
    box-shadow: 0 4px 16px rgba(124,58,237,0.4);
    transition: all 180ms ease;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .auth-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(124,58,237,0.5);
  }
  .auth-btn:active { transform: translateY(0); }

  /* ── Footer ── */
  .auth-footer {
    margin-top: 24px;
    text-align: center;
  }
  .auth-footer p {
    color: rgba(255,255,255,0.6);
    font-size: 14px;
    margin-bottom: 16px;
  }
  .auth-footer a {
    color: #a78bfa !important;
    font-weight: 600;
    text-decoration: none;
  }
  .auth-footer a:hover {
    color: #c4b5fd !important;
  }
  .auth-home-link {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 40px; padding: 0 20px;
    border: 1px solid rgba(148,163,184,0.2); border-radius: 999px;
    background: rgba(15,23,42,0.4); color: rgba(255,255,255,0.6);
    font-size: 13px; font-weight: 600; text-decoration: none;
    transition: all 150ms ease;
  }
  .auth-home-link:hover { 
    background: rgba(15,23,42,0.6); 
    color: #fff; 
    border-color: rgba(148,163,184,0.3); 
  }

  /* ─ Trust ── */
  .auth-trust {
    display: flex; align-items: center; justify-content: center; gap: 20px;
    font-size: 12px; color: rgba(255,255,255,0.4); margin-top: 20px; flex-wrap: wrap;
    background: rgba(15,23,42,0.4);
    padding: 12px 20px;
    border-radius: 12px;
    border: 1px solid rgba(148,163,184,0.1);
  }
  .auth-trust span { display: inline-flex; align-items: center; gap: 6px; }

  /* ── Remember + Forgot ── */
  .auth-remember-forgot {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 20px;
  }
  .auth-remember {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: rgba(255,255,255,0.6);
    cursor: pointer;
  }
  .auth-remember input[type="checkbox"] {
    width: 16px; height: 16px;
    accent-color: #7c3aed;
    cursor: pointer;
  }
  .auth-forgot {
    font-size: 13px;
    color: #a78bfa !important;
    text-decoration: none;
    font-weight: 600;
  }
  .auth-forgot:hover {
    color: #c4b5fd !important;
  }

  /* ── Loading ── */
  .auth-loader {
    position: fixed; top: 0; left: 0; right: 0;
    height: 3px; z-index: 9999;
    background: rgba(255,255,255,0.1);
    overflow: hidden;
    opacity: 0; transition: opacity 200ms ease;
  }
  .auth-loader.active { opacity: 1; }
  .auth-loader-bar {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, #7c3aed, #a78bfa, #3b82f6, #7c3aed);
    background-size: 200% 100%;
    animation: loaderShimmer 1.4s linear infinite;
    border-radius: 0 3px 3px 0;
    box-shadow: 0 0 12px rgba(124,58,237,0.8);
    transition: width 300ms ease;
  }
  @keyframes loaderShimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .auth-btn.loading {
    opacity: 0.85; cursor: not-allowed; pointer-events: none;
  }
  .auth-btn .btn-spinner {
    display: none; width: 18px; height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  .auth-btn.loading .btn-spinner { display: block; }
  .auth-btn.loading .btn-text { opacity: 0.8; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ─ Card entrance ── */
  .auth-card {
    animation: cardIn 0.5s cubic-bezier(0.22,1,0.36,1) both;
  }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(16px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)    scale(1);    }
  }

  /* ── Mobile ── */
  @media (max-width: 480px) {
    body.auth-page {
      padding: 16px 16px 16px;
      align-items: flex-start;
    }
    .auth-shell {
      max-width: 100%;
      width: calc(100% - 24px);
      margin: 0 auto;
    }
    .auth-logomark { width: 46px; height: 46px; border-radius: 13px; margin-bottom: 6px; animation: none; }
    .auth-eyebrow { font-size: 0.55rem; margin-bottom: 3px; }
    .auth-eyebrow::before, .auth-eyebrow::after { width: 12px; }
    .auth-title { font-size: 1.5rem; margin-bottom: 2px; }
    .auth-subtitle { font-size: 0.74rem; margin-bottom: 0; }
    .flex.flex-col.items-center.text-center { margin-bottom: 10px !important; }
    .auth-tab-wrap { margin-top: 0 !important; margin-bottom: 10px; padding: 3px; }
    .auth-tab { padding: 8px 10px; font-size: 0.76rem; }
    .auth-card { padding: 16px 14px; border-radius: 14px; margin-top: 0; animation: none; }
    .auth-card .space-y-5 > * + * { margin-top: 11px !important; }
    .auth-label { font-size: 0.63rem; margin-bottom: 4px; }
    .auth-input { height: 43px !important; font-size: 16px !important; padding: 0 14px 0 40px !important; border-radius: 10px !important; }
    .input-icon { left: 10px; }
    .auth-card label.flex.items-center { font-size: 0.76rem !important; }
    .auth-btn { height: 45px; font-size: 0.85rem; border-radius: 10px; }
    .auth-footer { margin-top: 10px !important; }
    .auth-footer p { font-size: 0.76rem; margin-bottom: 6px !important; }
    .auth-footer.space-y-3 > * + * { margin-top: 5px !important; }
    .auth-home-link { height: 34px; font-size: 0.72rem; padding: 0 14px; }
    .auth-trust { margin-top: 10px; gap: 12px; font-size: 0.58rem; padding: 0; }
    .auth-bg-orb-1, .auth-bg-orb-2, .auth-bg-orb-3 { display: none; }
  }

  @media (max-width: 360px) {
    body.auth-page {
      padding: 16px 12px;
      padding-top: 30px;
    }
    .auth-card {
      padding: 20px 16px;
    }
    .auth-title {
      font-size: 24px;
    }
  }
</style>

<div class="auth-bg"></div>
<div class="auth-loader" id="auth-loader">
  <div class="auth-loader-bar" id="auth-loader-bar"></div>
</div>

<body class="auth-page">
  <div class="auth-shell">
    <!-- Logo -->
    <div class="auth-logomark">
      <img src="/scoresync-logo.png?v=8" alt="ScoreSync"/>
    </div>

    <!-- Title -->
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Sign in to continue to your account</p>

    <!-- Tabs -->
    <div class="auth-tab-wrap">
      <a href="/login" class="auth-tab active" aria-current="page">Sign In</a>
      <a href="/register" class="auth-tab">Register</a>
    </div>

    {{#if error_msg}}
    <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#fca5a5;font-size:13px;display:flex;align-items:center;gap:8px;width:100%;box-sizing:border-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}
    {{#if success_msg}}
    <div style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:10px;padding:12px 16px;margin-bottom:20px;color:#86efac;font-size:13px;display:flex;align-items:center;gap:8px;width:100%;box-sizing:border-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      <span>{{success_msg}}</span>
    </div>
    {{/if}}

    <!-- Card -->
    <div class="auth-card">
      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <div style="margin-bottom:20px">
          <label class="auth-label">Email address</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="auth-input"/>
          </div>
        </div>

        <div style="margin-bottom:4px">
          <label class="auth-label">Password</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" name="password" id="passwordInput" placeholder="Enter your password" required autocomplete="current-password" class="auth-input auth-input-pr"/>
            <button type="button" id="eyeBtn" onclick="togglePwd()"
              style="position:absolute;right:14px;top:50%;transform:translateY(-50%);color:rgba(255,255,255,0.4);background:none;border:none;cursor:pointer;padding:4px;display:flex;align-items:center;justify-content:center">
              <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <div class="auth-remember-forgot">
          <label class="auth-remember">
            <input type="checkbox" name="remember"> Remember me
          </label>
          <a href="/forgot-password" class="auth-forgot">Forgot password?</a>
        </div>

        <button type="submit" class="auth-btn" data-loading="Signing in...">
          <div class="btn-spinner"></div>
          <span class="btn-text">Sign in</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </form>
    </div>

    <!-- Footer -->
    <div class="auth-footer">
      <p>Don't have an account? <a href="/register">Create one</a></p>
      <a href="/" class="auth-home-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/></svg>
        Back to homepage
      </a>
    </div>

    <!-- Trust -->
    <div class="auth-trust">
      <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/></svg>Secure login</span>
      <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Encrypted</span>
      <span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>Real-time sync</span>
    </div>
  </div>

<script>
const eyeOpen='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePwd(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){i.type='text';b.innerHTML=eyeClose;}
  else{i.type='password';b.innerHTML=eyeOpen;}
}

function startLoader() {
  var loader = document.getElementById('auth-loader');
  var bar = document.getElementById('auth-loader-bar');
  if (!loader || !bar) return;
  loader.classList.add('active');
  bar.style.width = '0%';
  setTimeout(function(){ bar.style.width = '30%'; }, 50);
  setTimeout(function(){ bar.style.width = '60%'; }, 300);
  setTimeout(function(){ bar.style.width = '80%'; }, 800);
}

document.querySelectorAll('.auth-card form').forEach(function(form) {
  form.addEventListener('submit', function() {
    startLoader();
    var btn = form.querySelector('.auth-btn');
    if (btn) {
      btn.classList.add('loading');
      var textEl = btn.querySelector('.btn-text');
      if (textEl) textEl.textContent = btn.dataset.loading || 'Please wait...';
    }
  });
});
</script>
</body>
</html>