{{> head }}
<style>
  /* Auth-page overrides â€” scoped so they don't bleed globally */
  .auth-input {
    width: 100%;
    padding: 13px 14px 13px 44px;
    background: #0d1527 !important;
    border: 1.5px solid rgba(255,255,255,0.10) !important;
    border-radius: 14px !important;
    font-size: 0.9rem;
    color: #e2e8f0 !important;
    outline: none;
    transition: border-color 60ms ease, box-shadow 60ms ease;
    -webkit-text-fill-color: #e2e8f0;
  }
  .auth-input:focus {
    border-color: #6366f1 !important;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.18) !important;
  }
  .auth-input::placeholder { color: #475569; }
  /* Kill browser autofill blue/yellow tint */
  .auth-input:-webkit-autofill,
  .auth-input:-webkit-autofill:hover,
  .auth-input:-webkit-autofill:focus,
  .auth-input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0 1000px #0d1527 inset !important;
    -webkit-text-fill-color: #e2e8f0 !important;
    caret-color: #e2e8f0 !important;
    border-color: rgba(255,255,255,0.10) !important;
    background-color: #0d1527 !important;
    transition: background-color 9999s ease-in-out 0s;
  }
  .auth-input-pr { padding-right: 48px; }
  .auth-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 24px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);
    padding: 32px 28px;
  }
  @media (max-width: 400px) { .auth-card { padding: 24px 18px; } }
  .auth-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #475569;
    margin-bottom: 6px;
  }
  .auth-btn {
    width: 100%; padding: 14px;
    border-radius: 14px;
    font-size: 0.95rem; font-weight: 800;
    color: #fff; border: none; cursor: pointer;
    background: linear-gradient(135deg,#4f46e5,#6366f1);
    box-shadow: 0 6px 20px rgba(79,70,229,0.35), inset 0 1px 0 rgba(255,255,255,0.18);
    transition: opacity 60ms ease, transform 60ms ease, box-shadow 60ms ease;
    letter-spacing: -0.01em;
  }
  .auth-btn:hover { opacity: 0.88; transform: translateY(-1px); box-shadow: 0 10px 28px rgba(79,70,229,0.5); }
  .auth-btn:active { transform: translateY(0); opacity: 1; }
  .auth-tab-wrap {
    display: flex;
    border-radius: 14px;
    padding: 4px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 24px;
  }
  .auth-tab {
    flex: 1; padding: 10px;
    border-radius: 11px;
    font-size: 0.85rem; font-weight: 700;
    text-align: center; text-decoration: none;
    color: #cbd5e1;
    transition: background 160ms ease, color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }
  .auth-tab:not(.active):hover {
    color: #fff;
    background: rgba(255,255,255,0.08);
  }
  .auth-tab:focus-visible, .auth-home-link:focus-visible, .auth-footer a:focus-visible {
    outline: 2px solid #a5b4fc;
    outline-offset: 3px;
  }
  .auth-tab.active {
    background: linear-gradient(135deg,#4f46e5,#6366f1);
    color: #fff;
    box-shadow: 0 4px 16px rgba(79,70,229,0.4), inset 0 1px 0 rgba(255,255,255,0.2);
  }
  .auth-home-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid rgba(165,180,252,0.24);
    border-radius: 999px;
    background: rgba(99,102,241,0.09);
    color: #c7d2fe;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }
  .auth-home-link:hover {
    background: rgba(99,102,241,0.18);
    border-color: rgba(165,180,252,0.5);
    color: #fff;
    transform: translateY(-1px);
  }
  .auth-home-link svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .auth-footer {
    color: #94a3b8;
  }
  .auth-footer a:not(.auth-home-link) {
    color: #a5b4fc !important;
    transition: color 160ms ease;
  }
  .auth-footer a:not(.auth-home-link):hover {
    color: #c7d2fe !important;
  }
  .input-icon-wrap { position: relative; }
  .input-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #374151; pointer-events: none; z-index: 1;
  }
  body.auth-page {
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 50% 4%, rgba(79,70,229,0.18), transparent 34%),
      radial-gradient(ellipse at 100% 60%, rgba(14,165,233,0.06), transparent 38%),
      #080d19 !important;
  }
  body.auth-page::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(148,163,184,0.16) 0.7px, transparent 0.7px);
    background-size: 24px 24px;
    content: "";
    opacity: 0.18;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, black, transparent 78%);
  }
  .auth-shell {
    position: relative;
    z-index: 1;
    max-width: 400px;
    margin-block: auto;
  }
  .auth-page {
    min-height: 100vh;
    min-height: 100svh;
    padding-top: clamp(24px, 4vh, 40px);
    padding-bottom: 28px;
  }
  .auth-logo {
    background: transparent;
    border: 0;
    box-shadow: none;
  }
  .auth-logo img {
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 12px 22px rgba(0,0,0,0.38));
  }
  .auth-kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 9px;
    color: #a5b4fc;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .auth-kicker::before {
    width: 16px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #818cf8);
    content: "";
  }
  .auth-title { font-size: 1.65rem; line-height: 1.15; letter-spacing: -0.04em; }
  .auth-subtitle { color: #94a3b8 !important; font-size: 0.82rem; margin-top: 7px; }
  .auth-input {
    min-height: 52px;
    background: rgba(8,13,25,0.72) !important;
    border-color: rgba(148,163,184,0.2) !important;
    border-radius: 13px !important;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }
  .auth-input:focus {
    background: rgba(13,21,39,0.95) !important;
    border-color: rgba(129,140,248,0.8) !important;
    box-shadow: 0 0 0 4px rgba(99,102,241,0.14), 0 8px 24px rgba(0,0,0,0.16) !important;
  }
  .auth-card {
    background: linear-gradient(155deg, rgba(20,27,44,0.96), rgba(14,20,34,0.96));
    border-color: rgba(148,163,184,0.16);
    box-shadow: 0 28px 70px rgba(0,0,0,0.42), inset 0 1px 0 rgba(255,255,255,0.08);
  }
  .auth-label { color: #94a3b8; margin-bottom: 8px; }
  .auth-btn {
    min-height: 52px;
    background: linear-gradient(110deg,#5146e5,#665cf2 58%,#7875ff);
    box-shadow: 0 10px 26px rgba(79,70,229,0.28), inset 0 1px 0 rgba(255,255,255,0.28);
    transition: filter 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }
  .auth-btn:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
    box-shadow: 0 14px 32px rgba(79,70,229,0.38), inset 0 1px 0 rgba(255,255,255,0.3);
  }
  .auth-btn:active { transform: translateY(0); filter: brightness(0.98); }
  .auth-tab-wrap { background: rgba(17,24,39,0.82); border-color: rgba(148,163,184,0.14); }
  .auth-tab { color: #d1d9e6; }
  .input-icon { color: #71809a; }
</style>
<body class="auth-page min-h-screen flex items-center justify-center px-4 py-10">

  <div class="auth-shell w-full animate-fadeup">

    <!-- Logo -->
    <div class="flex flex-col items-center mb-7">
      <div class="auth-logo w-20 h-20 sm:w-28 sm:h-28 rounded-full overflow-hidden mb-4 flex-shrink-0">
        <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="w-full h-full object-cover"/>
      </div>
      <span class="auth-kicker">ScoreSync account</span>
      <h1 class="auth-title font-black text-white">Welcome back</h1>
      <p class="auth-subtitle text-center">Sign in to your ScoreSync account</p>
    </div>

    <!-- Tab switcher -->
    <div class="auth-tab-wrap">
      <a href="/login" class="auth-tab active" aria-current="page">Sign In</a>
      <a href="/register" class="auth-tab">Register</a>
    </div>

    {{#if error_msg}}
    <div class="alert-error mb-4 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}
    {{#if success_msg}}
    <div class="alert-success mb-4 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
      <span>{{success_msg}}</span>
    </div>
    {{/if}}

    <!-- Card -->
    <div class="auth-card">
      <form method="POST" action="/login" class="space-y-5">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <!-- Email -->
        <div>
          <label class="auth-label">Email Address</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="auth-input"/>
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="auth-label">Password</label>
          <div class="input-icon-wrap" style="position:relative">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" name="password" id="passwordInput" placeholder="" required autocomplete="current-password" class="auth-input auth-input-pr"/>
            <button type="button" id="eyeBtn" onclick="togglePwd()"
              style="position:absolute;right:14px;top:50%;transform:translateY(-50%);color:#475569;background:none;border:none;cursor:pointer;padding:4px;display:flex;align-items:center;justify-content:center;border-radius:6px;transition:color 60ms ease">
              <!-- eye-open: tap to show password -->
              <svg id="eyeIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <!-- Remember + Forgot -->
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 text-xs font-medium cursor-pointer select-none" style="color:#475569">
            <input type="checkbox" class="w-3.5 h-3.5 rounded" style="accent-color:#6366f1;flex-shrink:0"> Remember me
          </label>
          <a href="/forgot-password" class="text-xs font-semibold" style="color:#818cf8">Forgot password?</a>
        </div>

        <!-- Submit -->
        <button type="submit" class="auth-btn">Sign In</button>

      </form>
    </div>

    <!-- Footer -->
    <div class="auth-footer mt-5 text-center space-y-3">
      <p class="text-xs">
        Don't have an account?
        <a href="/register" class="font-bold ml-1">Register here</a>
      </p>
      <a href="/" class="auth-home-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/></svg>
        Back to homepage
      </a>
    </div>

  </div>

<script>
const eyeOpen='<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePwd(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){ i.type='text'; b.innerHTML=eyeClose; }
  else { i.type='password'; b.innerHTML=eyeOpen; }
}
// Force-clear autofill background on all inputs as soon as DOM is ready
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('input').forEach(el => {
    el.style.setProperty('background-color', 'rgba(255,255,255,0.04)', 'important');
    el.style.setProperty('color', '#e2e8f0', 'important');
    // Re-apply after a short delay (Chrome applies autofill ~100ms after load)
    setTimeout(() => {
      el.style.setProperty('background-color', 'rgba(255,255,255,0.04)', 'important');
      el.style.setProperty('color', '#e2e8f0', 'important');
    }, 200);
    setTimeout(() => {
      el.style.setProperty('background-color', 'rgba(255,255,255,0.04)', 'important');
      el.style.setProperty('color', '#e2e8f0', 'important');
    }, 500);
  });
});
</script>
</body>
</html>


