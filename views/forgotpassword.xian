{{> head }}
<style>
  .auth-input {
    width: 100%;
    padding: 13px 14px 13px 44px;
    background: rgba(255,255,255,0.04) !important;
    border: 1.5px solid rgba(255,255,255,0.10) !important;
    border-radius: 14px !important;
    font-size: 0.9rem; color: #e2e8f0 !important;
    outline: none;
    transition: border-color 60ms ease, box-shadow 60ms ease;
    -webkit-text-fill-color: #e2e8f0;
  }
  .auth-input:focus { border-color: #6366f1 !important; box-shadow: 0 0 0 3px rgba(99,102,241,0.18) !important; }
  .auth-input::placeholder { color: #475569; }
  .auth-input:-webkit-autofill,
  .auth-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #0d1424 inset !important;
    -webkit-text-fill-color: #e2e8f0 !important;
    border-color: rgba(255,255,255,0.10) !important;
    transition: background-color 9999s ease;
  }
  .auth-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 24px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);
    padding: 28px 24px;
  }
  .auth-label { display:block; font-size:0.7rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#475569; margin-bottom:6px; }
  .auth-btn {
    width:100%; padding:13px; border-radius:14px; font-size:0.9rem; font-weight:800;
    color:#fff; border:none; cursor:pointer;
    background:linear-gradient(135deg,#4f46e5,#6366f1);
    box-shadow:0 6px 20px rgba(79,70,229,0.35),inset 0 1px 0 rgba(255,255,255,0.18);
    transition:opacity 60ms ease,transform 60ms ease;
  }
  .auth-btn:hover { opacity:0.88; transform:translateY(-1px); }
  .auth-btn:active { transform:translateY(0); opacity:1; }
  .input-icon-wrap { position:relative; }
  .input-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#374151; pointer-events:none; }
</style>
<body class="min-h-screen flex items-center justify-center px-4 py-10" style="background:#0a0f1e">

  <div class="w-full max-w-[380px] animate-fadeup">

    <!-- Logo -->
    <div class="flex flex-col items-center mb-7">
      <div class="w-20 h-20 sm:w-28 sm:h-28 rounded-full overflow-hidden shadow-2xl mb-3 flex-shrink-0" style="border:3px solid rgba(99,102,241,0.5)">
        <img src="/scoresync-logo.png?v=7" alt="ScoreSync" class="w-full h-full object-cover"/>
      </div>
      <h1 class="text-xl font-black tracking-tight text-white">Reset Password</h1>
      <p class="text-xs mt-1 text-center" style="color:#475569">We'll send a reset link to your email</p>
    </div>

    {{#if error_msg}}
    <div class="alert-error mb-4 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}
    {{#if success_msg}}
    <div class="alert-success mb-4 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
      <span>{{success_msg}}</span>
    </div>
    {{/if}}

    <div class="auth-card space-y-4">

      <!-- Info box -->
      <div class="flex items-start gap-3 p-3.5 rounded-xl" style="background:rgba(99,102,241,0.07);border:1px solid rgba(99,102,241,0.18)">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0" style="background:rgba(99,102,241,0.18)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <p class="text-xs leading-relaxed" style="color:#94a3b8">A password reset link will be sent to your email. Check your inbox and spam folder.</p>
      </div>

      <form method="POST" action="/forgot-password" class="space-y-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div>
          <label class="auth-label">Email Address</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <input type="email" name="email" placeholder="you@example.com" required class="auth-input"/>
          </div>
        </div>
        <button type="submit" class="auth-btn">Send Reset Link â†’</button>
      </form>

    </div>

    <div class="mt-5 text-center">
      <a href="/login" class="inline-flex items-center gap-1 text-xs font-semibold" style="color:#818cf8">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Sign In
      </a>
    </div>

  </div>
</body>
</html>






