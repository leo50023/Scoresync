{{> head }}
<style>
  body.auth-page {
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center; justify-content: center;
    padding: clamp(20px,4vh,48px) 16px;
    position: relative; isolation: isolate; overflow: hidden;
    background: #060c1a;
  }
  .auth-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .auth-bg-orb {
    position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.5;
    animation: orbFloat 8s ease-in-out infinite;
  }
  .auth-bg-orb-1 {
    width: 480px; height: 480px; top: -140px; left: -100px;
    background: radial-gradient(circle, rgba(79,70,229,0.38), transparent 70%);
    animation-delay: 0s;
  }
  .auth-bg-orb-2 {
    width: 360px; height: 360px; bottom: -80px; right: -80px;
    background: radial-gradient(circle, rgba(14,165,233,0.28), transparent 70%);
    animation-delay: -3s;
  }
  @keyframes orbFloat {
    0%,100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.04); }
  }
  .auth-bg-grid {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(148,163,184,0.12) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 70%);
    opacity: 0.2;
  }
  .auth-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 400px;
    display: flex; flex-direction: column;
  }
  .auth-logomark {
    width: 68px; height: 68px; border-radius: 20px;
    overflow: hidden; flex-shrink: 0; margin-bottom: 18px;
    box-shadow: 0 8px 32px rgba(79,70,229,0.35), 0 0 0 1px rgba(255,255,255,0.1);
  }
  .auth-logomark img { width: 100%; height: 100%; object-fit: cover; }
  .auth-eyebrow {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.62rem; font-weight: 800;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: #818cf8; margin-bottom: 6px;
  }
  .auth-eyebrow::before {
    content: ""; width: 18px; height: 1px;
    background: linear-gradient(90deg, transparent, #818cf8);
  }
  .auth-title {
    font-size: 1.9rem; font-weight: 900;
    letter-spacing: -0.04em; line-height: 1.1;
    color: #f1f5f9; margin-bottom: 6px;
  }
  .auth-subtitle { font-size: 0.83rem; color: #94a3b8; }
  .auth-card {
    background: linear-gradient(160deg, rgba(18,26,48,0.98), rgba(12,18,34,0.98));
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px; padding: 32px 28px;
    box-shadow: 0 32px 80px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.07);
    backdrop-filter: blur(20px);
  }
  @media (max-width: 400px) { .auth-card { padding: 24px 18px; } }
  .auth-label {
    display: block; font-size: 0.67rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #64748b; margin-bottom: 7px;
  }
  .input-icon-wrap { position: relative; }
  .input-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #475569; pointer-events: none; z-index: 1;
    transition: color 160ms ease;
  }
  .input-icon-wrap:focus-within .input-icon { color: #818cf8; }
  .auth-input {
    width: 100%; min-height: 52px;
    padding: 14px 14px 14px 44px;
    background: rgba(8,13,26,0.7) !important;
    border: 1.5px solid rgba(148,163,184,0.14) !important;
    border-radius: 13px !important;
    font-size: 0.9rem; color: #e2e8f0 !important;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
    -webkit-text-fill-color: #e2e8f0;
  }
  .auth-input:focus {
    background: rgba(13,22,42,0.98) !important;
    border-color: rgba(129,140,248,0.75) !important;
    box-shadow: 0 0 0 4px rgba(99,102,241,0.14), 0 4px 20px rgba(0,0,0,0.18) !important;
  }
  .auth-input::placeholder { color: #374151; }
  .auth-input:-webkit-autofill,
  .auth-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #0d1527 inset !important;
    -webkit-text-fill-color: #e2e8f0 !important;
    caret-color: #e2e8f0 !important;
    transition: background-color 9999s ease-in-out 0s;
  }
  .auth-btn {
    width: 100%; min-height: 52px; padding: 14px;
    border-radius: 14px; font-size: 0.92rem; font-weight: 800;
    color: #fff; border: none; cursor: pointer;
    background: linear-gradient(110deg,#4338ca,#5b51f0 50%,#7c73f5);
    box-shadow: 0 10px 28px rgba(79,70,229,0.32), inset 0 1px 0 rgba(255,255,255,0.25);
    transition: filter 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    letter-spacing: -0.01em; display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .auth-btn:hover { filter: brightness(1.1); transform: translateY(-1px); box-shadow: 0 16px 36px rgba(79,70,229,0.42); }
  .auth-btn:active { transform: translateY(0); filter: brightness(0.97); }
  .auth-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; filter: none; }
  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.8rem; font-weight: 600; color: #818cf8;
    text-decoration: none; transition: color 160ms ease, gap 160ms ease;
  }
  .back-link:hover { color: #c7d2fe; gap: 8px; }

  /* Success state */
  .success-state { display: none; text-align: center; }
  .success-icon {
    width: 64px; height: 64px; border-radius: 20px;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
    background: linear-gradient(135deg,rgba(16,185,129,0.15),rgba(5,150,105,0.1));
    border: 1px solid rgba(52,211,153,0.25);
    box-shadow: 0 8px 32px rgba(16,185,129,0.15);
  }
</style>

<div class="auth-bg">
  <div class="auth-bg-grid"></div>
  <div class="auth-bg-orb auth-bg-orb-1"></div>
  <div class="auth-bg-orb auth-bg-orb-2"></div>
</div>

<body class="auth-page">
  <div class="auth-shell animate-fadeup">

    <!-- Logo + heading -->
    <div class="flex flex-col items-center text-center mb-8">
      <div class="auth-logomark">
        <img src="/scoresync-logo.png?v=8" alt="ScoreSync"/>
      </div>
      <span class="auth-eyebrow">ScoreSync</span>
      <h1 class="auth-title">Reset password</h1>
      <p class="auth-subtitle">We'll send a reset link to your email</p>
    </div>

    {{#if error_msg}}
    <div class="alert-error mb-4 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}

    {{#if success_msg}}
    <!-- Success state shown when email was sent -->
    <div class="auth-card text-center" id="successCard">
      <div class="success-icon" style="display:flex">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M22 7.98V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h2 class="font-extrabold text-base mb-2" style="color:#e2e8f0">Check your inbox</h2>
      <p class="text-sm mb-6" style="color:#64748b;line-height:1.6">
        A password reset link has been sent to your email address. Check your inbox and spam folder.
      </p>
      <div class="flex items-center gap-3 p-3.5 rounded-xl mb-6" style="background:rgba(16,185,129,0.07);border:1px solid rgba(52,211,153,0.18)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span class="text-xs" style="color:#6ee7b7">The link expires in 1 hour. Request a new one if needed.</span>
      </div>
      <a href="/login" class="auth-btn" style="text-decoration:none;display:inline-flex">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Sign In
      </a>
    </div>
    {{else}}

    <!-- Form card -->
    <div class="auth-card" id="formCard">

      <!-- Info notice -->
      <div class="flex items-start gap-3 p-3.5 rounded-xl mb-5" style="background:rgba(99,102,241,0.07);border:1px solid rgba(99,102,241,0.18)">
        <div class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(99,102,241,0.2)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <p class="text-xs leading-relaxed" style="color:#94a3b8">Enter the email address linked to your account and we'll send you a reset link instantly.</p>
      </div>

      <form method="POST" action="/forgot-password" class="space-y-5" id="resetForm">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <div>
          <label class="auth-label">Email Address</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="auth-input" id="emailInput"/>
          </div>
        </div>

        <button type="submit" class="auth-btn" id="submitBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Send Reset Link
        </button>

      </form>
    </div>
    {{/if}}

    <!-- Back link -->
    <div class="mt-6 text-center">
      <a href="/login" class="back-link">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        Back to Sign In
      </a>
    </div>

  </div>

<script>
// Loading state on submit
const form = document.getElementById('resetForm');
const btn  = document.getElementById('submitBtn');
if (form && btn) {
  form.addEventListener('submit', function() {
    btn.disabled = true;
    btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 0.8s linear infinite"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg> Sending...';
  });
}
</script>
<style>
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>
</body>
</html>
