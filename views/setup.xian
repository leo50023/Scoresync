{{> head }}
<body class="min-h-screen flex" class="ss-page-bg">
  <div class="hidden lg:flex lg:w-[44%] auth-panel-bg flex-col justify-between p-10 relative">
    <div class="relative z-10">
      <div class="flex items-center gap-3 mb-14">
        <div class="w-14 h-14 rounded-full overflow-hidden flex-shrink-0 shadow-2xl" style="border:3px solid rgba(255,255,255,0.25)">
          <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="w-full h-full object-cover"/>
        </div>
        <div>
          <div class="text-white font-black text-xl tracking-tight leading-none">ScoreSync</div>
          <div class="text-blue-300 text-xs font-medium mt-0.5" style="opacity:0.75">First-time Setup</div>
        </div>
      </div>
      <h2 class="text-white text-3xl font-black leading-tight tracking-tight mb-4">First-time<br/>Setup</h2>
      <p class="text-blue-200 text-sm leading-relaxed max-w-xs">Create the administrator account that will manage all events, users, and scoring criteria.</p>
    </div>
    <div class="relative z-10 space-y-3">
      <div class="flex items-center gap-3 rounded-2xl px-4 py-3" style="background:rgba(255,255,255,0.09);border:1px solid rgba(255,255,255,0.12)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span class="text-blue-100 text-sm">This runs <strong>once</strong> — after an admin exists, this page is locked.</span>
      </div>
      <p class="text-blue-300 text-xs" style="opacity:0.6">&copy; 2026 ScoreSync &mdash; Gloria, Oriental Mindoro</p>
    </div>
  </div>

  <div class="flex-1 flex items-center justify-center px-6 py-10">
    <div class="w-full max-w-[420px] animate-fadeup">
      {{#if hasUsers}}
      <div class="text-center">
        <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-lg" style="background:linear-gradient(135deg,#064e3b,#059669)">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h1 class="text-2xl font-black mb-2" style="color:#f1f5f9">Setup Already Complete</h1>
        <p class="text-sm mb-6" style="color:var(--text-faint)">An admin account already exists. Please sign in normally.</p>
        <a href="/login" class="btn-primary text-sm">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Go to Login
        </a>
      </div>
      {{else}}
      <div class="flex items-center gap-3 justify-center mb-7 lg:hidden">
        <div class="w-12 h-12 rounded-full overflow-hidden flex-shrink-0 shadow-xl" style="border:2px solid rgba(255,255,255,0.2)">
          <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="w-full h-full object-cover"/>
        </div>
        <div>
          <div class="font-black text-xl text-white tracking-tight">ScoreSync</div>
          <div class="text-xs" style="color:var(--text-faint)">First-time Setup</div>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-2xl" style="background:#111827;border:1px solid rgba(255,255,255,0.10)">
        <div class="h-1.5" style="background:linear-gradient(90deg,#1d4ed8,#6366f1,#f59e0b)"></div>
        <div class="p-7 sm:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 grad-gold rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
            </div>
            <div>
              <h1 class="text-xl font-black tracking-tight" style="color:#f1f5f9">Create Admin Account</h1>
              <p class="text-xs mt-0.5" style="color:var(--text-faint)">This account will have full access to ScoreSync.</p>
            </div>
          </div>
          {{#if error_msg}}<div class="alert-error mb-5"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg><span>{{error_msg}}</span></div>{{/if}}
          <form method="POST" action="/setup" class="space-y-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Full Name</label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:var(--text-faint)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
                <input type="text" name="name" placeholder="e.g. Juan dela Cruz" required autocomplete="name" class="w-full"
                  style="padding:11px 14px 11px 40px;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;font-size:0.875rem;color:var(--text-primary);outline:none;background:#1e293b;"
                  onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.20)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.10)';this.style.boxShadow='none'"/>
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widest mb-1.5" style="color:#4b5563">Email Address</label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:var(--text-faint)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
                <input type="email" name="email" placeholder="admin@yourdomain.com" required autocomplete="email" class="w-full"
                  style="padding:11px 14px 11px 40px;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;font-size:0.875rem;color:var(--text-primary);outline:none;background:#1e293b;"
                  onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.20)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.10)';this.style.boxShadow='none'"/>
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-extrabold uppercase tracking-widests mb-1.5" style="color:#4b5563">Password</label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color:var(--text-faint)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                <input type="password" name="password" placeholder="Min. 6 characters" required minlength="6" autocomplete="new-password" class="w-full"
                  style="padding:11px 14px 11px 40px;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;font-size:0.875rem;color:var(--text-primary);outline:none;background:#1e293b;"
                  onfocus="this.style.borderColor='#3b82f6';this.style.boxShadow='0 0 0 3px rgba(59,130,246,0.20)'"
                  onblur="this.style.borderColor='rgba(255,255,255,0.10)';this.style.boxShadow='none'"/>
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-xl px-4 py-3" style="background:rgba(59,130,246,0.10);border:1px solid rgba(59,130,246,0.2)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <div>
                <div class="text-sm font-semibold" style="color:#93c5fd">Role: Administrator</div>
                <div class="text-xs" style="color:var(--text-faint)">Automatically assigned for first account</div>
              </div>
            </div>
            <button type="submit" class="btn-primary w-full justify-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
              Create Admin &amp; Enter ScoreSync
            </button>
          </form>
        </div>
      </div>
      <p class="text-center text-sm mt-5" style="color:var(--text-faint)">
        Already have an account? <a href="/login" class="font-semibold hover:underline" style="color:#60a5fa">Sign in</a>
      </p>
      {{/if}}
    </div>
  </div>
</body>
</html>
