                    </div>
                    <div class="hiw-score-row">
                      <span class="hiw-criteria-label" style="color:#a78bfa">Talent</span>
                      <div class="hiw-score-bar-wrap"><div class="hiw-score-bar" style="width:92%;background:linear-gradient(90deg,#7c3aed,#a78bfa)" id="hiw-bar-1"></div></div>
                      <span class="hiw-score-val" id="hiw-score-1">92</span>
                    </div>
                    <div class="hiw-score-row">
