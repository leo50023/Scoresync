                      <div style="flex:1"><div style="font-size:11px;font-weight:800;color:#fde047">Maria Santos</div><div style="font-size:9px;color:#92400e">Champion</div></div>
                      <span style="font-size:14px;font-weight:900;color:#fbbf24">91.25%</span>
                    </div>
