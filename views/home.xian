<script>
// -- FAQ toggle --
window.toggleFaq = function(btn) {
  var item = btn.closest('.faq-item');
  var isOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item.open').forEach(function(i){ i.classList.remove('open'); });
  if(!isOpen) item.classList.add('open');
};

// -- Animated score preview in hero card --
(function(){
  var scores = [
    { el: null, target: 78.4, current: 0 },
    { el: null, target: 65.2, current: 0 },
    { el: null, target: 52.8, current: 0 }
  ];
  var scoreEls = document.querySelectorAll('.preview-inner .space-y-4 span[style*="color:#60a5fa"], .preview-inner .space-y-4 span[style*="color:#a78bfa"], .preview-inner .space-y-4 span[style*="color:#34d399"]');
  scoreEls.forEach(function(el, i){ if(scores[i]) scores[i].el = el; });
  var triggered = false;
  var io = new IntersectionObserver(function(entries){
    if(triggered) return;
    entries.forEach(function(e){
      if(e.isIntersecting){
        triggered = true;
        scores.forEach(function(s){
          if(!s.el) return;
          var start = null, dur = 1800;
          function step(ts){
            if(!start) start = ts;
            var prog = Math.min((ts-start)/dur, 1);
            var ease = 1 - Math.pow(1-prog, 3);
            s.el.textContent = (s.current + (s.target - s.current) * ease).toFixed(1);
            if(prog < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        });
        io.disconnect();
      }
    });
  }, {threshold: 0.4});
  var card = document.querySelector('.preview-card');
  if(card) io.observe(card);
})();

// -- Floating particles --
(function(){
  var wrap=document.getElementById('home-particles');
  if(!wrap)return;
  var colors=['rgba(124,58,237,0.5)','rgba(99,102,241,0.45)','rgba(14,165,233,0.4)','rgba(167,139,250,0.4)','rgba(96,165,250,0.35)','rgba(255,255,255,0.2)'];
  for(var i=0;i<32;i++){
    var p=document.createElement('div');
    p.className='hp';
    var sz=(Math.random()*2.5+0.8).toFixed(1);
    p.style.left=Math.random()*100+'%';
    p.style.width=sz+'px'; p.style.height=sz+'px';
    p.style.background=colors[Math.floor(Math.random()*colors.length)];
    p.style.animationDuration=(Math.random()*14+9)+'s';
    p.style.animationDelay=(-Math.random()*14)+'s';
    if(Math.random()>0.5) p.style.filter='blur(0.8px)';
    wrap.appendChild(p);
  }
})();

// -- Scroll-reveal observer --
(function(){
  var els=document.querySelectorAll('.sr');
  if(!els.length)return;
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); }
    });
  },{threshold:0.12});
  els.forEach(function(el){ io.observe(el); });
})();

// -- Animate progress bars when preview card scrolls in --
(function(){
  var bars=document.querySelectorAll('.prog-bar');
  if(!bars.length)return;
  var triggered=false;
  var io=new IntersectionObserver(function(entries){
    if(triggered)return;
    entries.forEach(function(e){
      if(e.isIntersecting){
        triggered=true;
        setTimeout(function(){
          bars.forEach(function(b){ b.classList.add('animated'); });
        },300);
        io.disconnect();
      }
    });
  },{threshold:0.3});
  bars[0].closest('.preview-card')&&io.observe(bars[0].closest('.preview-card'));
})();

// -- Stat counter animation --
(function(){
  var nums=document.querySelectorAll('.stat-num');
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(!e.isIntersecting)return;
      var el=e.target, text=el.textContent.trim();
      var num=parseFloat(text), suffix=text.replace(/[\d.]/g,'');
      if(isNaN(num)||num===0)return;
      var start=0, dur=1600, begin=null;
      function step(ts){
        if(!begin)begin=ts;
        var prog=Math.min((ts-begin)/dur,1);
        var ease=1-Math.pow(1-prog,3);
        var val=start+(num-start)*ease;
        el.textContent=(Number.isInteger(num)?Math.round(val):val.toFixed(1))+suffix;
        if(prog<1)requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
      io.unobserve(el);
    });
  },{threshold:0.5});
  nums.forEach(function(n){
    var t=n.textContent.trim();
    if(/^\d/.test(t))io.observe(n);
  });
})();
</script>
</body>
</html>
