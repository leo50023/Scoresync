      <div class="feature-card sr sr-delay-3">
        <div class="feature-icon" style="background:linear-gradient(135deg,#065f46,#059669)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <div class="feature-title">Live Tabulation</div>
        <p class="feature-desc">Scores aggregated and ranked in real-time as judges submit. No manual tallying, no delays.</p>
