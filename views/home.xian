{{> head }}
<style>
  /* ── Reset & base ── */
  *, *::before, *::after { box-sizing: border-box; }

  /* ── Navbar ── */
  .nav-bar {
    position: sticky; top: 0; z-index: 50;
    background: rgba(6,12,26,0.92);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 1px 0 rgba(255,255,255,0.04), 0 8px 32px rgba(0,0,0,0.3);
  }
  .nav-link {
    font-size: 0.85rem; font-weight: 600; color: #94a3b8;
    text-decoration: none; padding: 6px 2px;
    border-bottom: 2px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .nav-link:hover { color: #e2e8f0; border-color: rgba(99,102,241,0.5); }

  /* ── Hero ── */
  .hero-section {
    position: relative; overflow: hidden;
    background: #060c1a;
    padding: clamp(64px,10vw,120px) 24px clamp(80px,12vw,140px);
  }
  .hero-bg-glow-1 {
    position: absolute; top: -180px; left: -120px;
    width: 700px; height: 700px; border-radius: 50%;
    background: radial-gradient(circle, rgba(79,70,229,0.22), transparent 65%);
    filter: blur(60px); pointer-events: none;
    animation: heroGlow1 10s ease-in-out infinite;
  }
  .hero-bg-glow-2 {
    position: absolute; bottom: -100px; right: -80px;
    width: 500px; height: 500px; border-radius: 50%;
    background: radial-gradient(circle, rgba(14,165,233,0.15), transparent 65%);
    filter: blur(60px); pointer-events: none;
    animation: heroGlow2 12s ease-in-out infinite;
  }
  .hero-bg-glow-3 {
    position: absolute; top: 30%; left: 42%;
    width: 380px; height: 380px; border-radius: 50%;
    background: radial-gradient(circle, rgba(139,92,246,0.1), transparent 65%);
    filter: blur(50px); pointer-events: none;
  }
  @keyframes heroGlow1 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(30px,-20px) scale(1.06)} }
  @keyframes heroGlow2 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-20px,24px) scale(1.05)} }
  .hero-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(148,163,184,0.1) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, transparent 65%);
    opacity: 0.25;
  }

  /* ── Badge ── */
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 14px; border-radius: 999px;
    background: rgba(96,165,250,0.08);
    border: 1px solid rgba(147,197,253,0.18);
    font-size: 0.68rem; font-weight: 800;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: #93c5fd; margin-bottom: 28px;
  }
  .hero-badge-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #60a5fa;
    box-shadow: 0 0 8px #60a5fa;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.6;transform:scale(0.85)} }

  /* ── Hero title ── */
  .hero-title {
    font-size: clamp(2.6rem,6vw,4.2rem);
    font-weight: 900; line-height: 1.06;
    letter-spacing: -0.04em; color: #f8fafc;
    margin-bottom: 22px;
  }
  .hero-title-accent { color: #93c5fd; }
  .hero-title-gold { color: #fbbf24; }

  /* ── Hero sub ── */
  .hero-sub {
    font-size: clamp(0.95rem,2vw,1.1rem);
    color: #94a3b8; line-height: 1.7;
    max-width: 520px; margin-bottom: 36px;
  }

  /* ── CTA buttons ── */
  .btn-hero-primary {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 28px; border-radius: 14px;
    font-size: 0.92rem; font-weight: 800; color: #fff;
    background: linear-gradient(135deg,#2563eb,#4f46e5);
    box-shadow: 0 10px 32px rgba(37,99,235,0.38), inset 0 1px 0 rgba(255,255,255,0.2);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
  }
  .btn-hero-primary:hover { transform: translateY(-2px); filter: brightness(1.1); box-shadow: 0 16px 40px rgba(37,99,235,0.5); }
  .btn-hero-secondary {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 24px; border-radius: 14px;
    font-size: 0.92rem; font-weight: 700; color: #e2e8f0;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    text-decoration: none;
    transition: background 160ms ease, transform 160ms ease;
  }
  .btn-hero-secondary:hover { background: rgba(255,255,255,0.11); transform: translateY(-1px); }

  /* ── Trust row ── */
  .trust-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 20px;
    margin-top: 32px; font-size: 0.75rem; font-weight: 600; color: #64748b;
  }
  .trust-item { display: inline-flex; align-items: center; gap: 6px; }

  /* ── Preview card ── */
  .preview-card {
    background: linear-gradient(145deg, rgba(16,26,52,0.95), rgba(8,14,30,0.98));
    border: 1px solid rgba(148,163,184,0.14);
    border-radius: 24px;
    box-shadow: 0 40px 100px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.06);
    backdrop-filter: blur(20px);
    padding: 24px;
    position: relative;
  }
  .preview-inner {
    background: rgba(4,8,20,0.6);
    border: 1px solid rgba(148,163,184,0.1);
    border-radius: 16px; padding: 20px;
  }

  /* ── Stats row ── */
  .stats-row {
    display: grid; grid-template-columns: repeat(3,1fr);
    border-radius: 20px; overflow: hidden;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(148,163,184,0.12);
    margin-top: clamp(40px,6vw,72px);
  }
  .stat-cell {
    padding: clamp(16px,3vw,28px) 16px;
    text-align: center; position: relative;
  }
  .stat-cell + .stat-cell { border-left: 1px solid rgba(148,163,184,0.1); }
  .stat-num {
    font-size: clamp(1.6rem,4vw,2.4rem);
    font-weight: 900; letter-spacing: -0.03em;
    background: linear-gradient(135deg,#93c5fd,#6366f1);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .stat-label { font-size: 0.7rem; color: #64748b; font-weight: 600; margin-top: 4px; }

  /* ── Section shell ── */
  .section-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

  /* ── Features ── */
  .features-section {
    padding: clamp(72px,10vw,112px) 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(30,64,175,0.1), transparent 50%), #080f1e;
  }
  .section-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.65rem; font-weight: 800;
    letter-spacing: 0.18em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 999px;
    margin-bottom: 16px;
  }
  .section-title {
    font-size: clamp(1.8rem,4vw,2.8rem);
    font-weight: 900; letter-spacing: -0.03em;
    color: #f1f5f9; line-height: 1.1;
  }
  .section-sub {
    font-size: 0.95rem; color: #94a3b8;
    line-height: 1.7; max-width: 520px; margin: 14px auto 0;
  }

  /* ── Feature card ── */
  .feature-card {
    background: linear-gradient(145deg, rgba(16,24,44,0.96), rgba(10,16,30,0.98));
    border: 1px solid rgba(148,163,184,0.1);
    border-radius: 20px; padding: 28px 24px;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
    position: relative; overflow: hidden;
  }
  .feature-card::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,0.04), transparent 60%);
    opacity: 0; transition: opacity 200ms ease;
    pointer-events: none;
  }
  .feature-card:hover { transform: translateY(-4px); border-color: rgba(99,102,241,0.25); box-shadow: 0 20px 48px rgba(0,0,0,0.35); }
  .feature-card:hover::before { opacity: 1; }
  .feature-icon {
    width: 48px; height: 48px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }
  .feature-title { font-size: 0.95rem; font-weight: 800; color: #e2e8f0; margin-bottom: 10px; }
  .feature-desc { font-size: 0.85rem; color: #64748b; line-height: 1.65; }

  /* ── How it works ── */
  .how-section {
    padding: clamp(72px,10vw,112px) 0;
    background: #070d1b;
    position: relative; overflow: hidden;
  }
  .how-section::before {
    content: ""; position: absolute;
    top: -200px; left: 50%; transform: translateX(-50%);
    width: 800px; height: 400px; border-radius: 50%;
    background: radial-gradient(ellipse, rgba(16,185,129,0.06), transparent 65%);
    filter: blur(40px); pointer-events: none;
  }
  .step-card {
    background: linear-gradient(145deg, rgba(14,22,42,0.96), rgba(9,15,28,0.98));
    border: 1px solid rgba(148,163,184,0.1);
    border-radius: 20px; padding: 32px 24px;
    text-align: center; position: relative;
    transition: transform 200ms ease, border-color 200ms ease;
  }
  .step-card:hover { transform: translateY(-3px); border-color: rgba(148,163,184,0.22); }
  .step-number {
    width: 56px; height: 56px; border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; font-weight: 900; color: #fff;
    margin: 0 auto 20px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.4);
  }
  .step-connector {
    display: none;
  }
  @media (min-width: 768px) {
    .step-connector {
      display: flex; align-items: center; justify-content: center;
      color: #1e3a5a; font-size: 1.5rem; flex-shrink: 0;
      margin-top: -20px;
    }
  }

  /* ── CTA section ── */
  .cta-section {
    padding: clamp(72px,10vw,112px) 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(59,130,246,0.18), transparent 55%),
                linear-gradient(135deg,#060e1f,#0c1a36);
    position: relative; overflow: hidden;
  }
  .cta-section::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(148,163,184,0.07) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
    opacity: 0.4;
  }

  /* ── Footer ── */
  .home-footer {
    background: #040810;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 32px 24px;
    text-align: center;
    font-size: 0.78rem; color: #334155;
  }

  /* ── Responsive hero layout ── */
  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px,6vw,80px);
    max-width: 1200px; margin: 0 auto;
  }
  @media (max-width: 900px) {
    .hero-layout { grid-template-columns: 1fr; text-align: center; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .hero-cta-row { justify-content: center; }
    .trust-row { justify-content: center; }
    .preview-card { max-width: 500px; margin: 0 auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-glow-1, .hero-bg-glow-2, .feature-card, .step-card { animation: none; transition: none; }
    .feature-card:hover, .step-card:hover { transform: none; }
  }
</style>

<body class="flex flex-col min-h-screen" style="background:#060c1a;color:#e2e8f0">

<!-- ── Navbar ── -->
<header class="nav-bar">
  <div class="section-wrap">
    <div class="flex items-center justify-between h-16 gap-4">

      <!-- Brand -->
      <a href="/" class="flex items-center gap-3 flex-shrink-0 text-decoration-none" style="text-decoration:none">
        <div class="w-9 h-9 rounded-xl overflow-hidden flex-shrink-0 shadow-lg" style="border:1.5px solid rgba(255,255,255,0.15)">
          <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="w-full h-full object-cover"/>
        </div>
        <span class="font-black text-base tracking-tight text-white hidden sm:block">ScoreSync</span>
      </a>

      <!-- Nav links -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="#features" class="nav-link">Features</a>
        <a href="#how" class="nav-link">How it works</a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <a href="/login" class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-sm font-semibold transition"
          style="color:#94a3b8;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);text-decoration:none"
          onmouseover="this.style.color='#e2e8f0';this.style.background='rgba(255,255,255,0.09)'"
          onmouseout="this.style.color='#94a3b8';this.style.background='rgba(255,255,255,0.04)'">
          Sign In
        </a>
        <a href="/register" class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-sm font-extrabold text-white transition"
          style="background:linear-gradient(135deg,#1d4ed8,#4f46e5);box-shadow:0 4px 14px rgba(37,99,235,0.35);text-decoration:none"
          onmouseover="this.style.filter='brightness(1.1)'"
          onmouseout="this.style.filter=''">
          Get Started
        </a>
      </div>

    </div>
  </div>
</header>

<!-- ── Hero ── -->
<section class="hero-section">
  <div class="hero-grid"></div>
  <div class="hero-bg-glow-1"></div>
  <div class="hero-bg-glow-2"></div>
  <div class="hero-bg-glow-3"></div>

  <div class="hero-layout relative z-10">

    <!-- Copy -->
    <div class="animate-fadeup">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Competition management, made clear
      </div>
      <h1 class="hero-title">
        Every score.<br/>
        <span class="hero-title-accent">Every moment.</span><br/>
        <span class="hero-title-gold">ScoreSync.</span>
      </h1>
      <p class="hero-sub">
        Run competitions with confident scoring, transparent tabulation, and results your audience can trust — from setup to the final reveal.
      </p>
      <div class="hero-cta-row flex flex-wrap gap-3">
        <a href="/register" class="btn-hero-primary">
          Get Started Free
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/login" class="btn-hero-secondary">
          Sign In
        </a>
      </div>
      <div class="trust-row">
        <span class="trust-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/><path d="m9 12 2 2 4-4"/></svg>
          Clear, accountable scoring
        </span>
        <span class="trust-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          Live results
        </span>
        <span class="trust-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Encrypted & secure
        </span>
      </div>
    </div>

    <!-- Preview card -->
    <div class="preview-card animate-fadeup-1">
      <!-- Glow -->
      <div style="position:absolute;top:-60px;right:-40px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(59,130,246,0.14),transparent 70%);filter:blur(30px);pointer-events:none"></div>

      <!-- Header -->
      <div class="flex items-center justify-between mb-5">
        <div>
          <div class="text-[10px] uppercase tracking-[0.18em] font-bold mb-1" style="color:#60a5fa">Live Preview</div>
          <div class="text-white text-sm font-bold">ScoreSync in action</div>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[10px] font-bold" style="color:#a7f3d0;background:rgba(16,185,129,0.1);border:1px solid rgba(52,211,153,0.2)">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" style="animation:pulse 2s infinite"></span>
          LIVE
        </span>
      </div>

      <!-- Scores preview -->
      <div class="preview-inner">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs font-semibold" style="color:#64748b">Weighted Criteria</span>
          <span class="text-[10px] font-semibold" style="color:#475569">SCORING OVERVIEW</span>
        </div>
        <div class="space-y-4">
          <div>
            <div class="flex justify-between text-xs mb-1.5">
              <span style="color:#94a3b8">Performance</span>
              <span class="font-bold" style="color:#e2e8f0">40% &nbsp;<span style="color:#60a5fa">78.4</span></span>
            </div>
            <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
              <div class="h-full rounded-full" style="width:78%;background:linear-gradient(90deg,#1d4ed8,#60a5fa);box-shadow:0 0 8px rgba(96,165,250,0.4)"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs mb-1.5">
              <span style="color:#94a3b8">Presentation</span>
              <span class="font-bold" style="color:#e2e8f0">35% &nbsp;<span style="color:#a78bfa">65.2</span></span>
            </div>
            <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
              <div class="h-full rounded-full" style="width:65%;background:linear-gradient(90deg,#5b21b6,#a78bfa);box-shadow:0 0 8px rgba(167,139,250,0.3)"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs mb-1.5">
              <span style="color:#94a3b8">Creativity</span>
              <span class="font-bold" style="color:#e2e8f0">25% &nbsp;<span style="color:#34d399">52.8</span></span>
            </div>
            <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
              <div class="h-full rounded-full" style="width:52%;background:linear-gradient(90deg,#065f46,#34d399);box-shadow:0 0 8px rgba(52,211,153,0.25)"></div>
            </div>
          </div>
        </div>

        <!-- Judge avatars -->
        <div class="flex items-center gap-3 mt-5 pt-4" style="border-top:1px solid rgba(255,255,255,0.07)">
          <div class="flex -space-x-2">
            <span class="w-8 h-8 rounded-full flex items-center justify-center text-[10px] font-black text-white" style="background:linear-gradient(135deg,#1e3a8a,#3b82f6);border:2px solid #080f1e">J1</span>
            <span class="w-8 h-8 rounded-full flex items-center justify-center text-[10px] font-black text-white" style="background:linear-gradient(135deg,#4c1d95,#7c3aed);border:2px solid #080f1e">J2</span>
            <span class="w-8 h-8 rounded-full flex items-center justify-center text-[10px] font-black text-white" style="background:linear-gradient(135deg,#064e3b,#10b981);border:2px solid #080f1e">J3</span>
          </div>
          <div class="text-[11px] leading-snug" style="color:#64748b">3 judges scoring independently.<br/><span style="color:#94a3b8">Results stay organized.</span></div>
        </div>
      </div>

      <!-- Mini steps -->
      <div class="grid grid-cols-3 gap-2 mt-4">
        <div class="rounded-xl px-2 py-3 text-center" style="background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.15)">
          <div class="text-[10px] font-extrabold text-blue-400 mb-0.5">DEFINE</div>
          <div class="text-[9px]" style="color:#475569">Your criteria</div>
        </div>
        <div class="rounded-xl px-2 py-3 text-center" style="background:rgba(124,58,237,0.08);border:1px solid rgba(124,58,237,0.15)">
          <div class="text-[10px] font-extrabold text-purple-400 mb-0.5">SCORE</div>
          <div class="text-[9px]" style="color:#475569">With confidence</div>
        </div>
        <div class="rounded-xl px-2 py-3 text-center" style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15)">
          <div class="text-[10px] font-extrabold text-emerald-400 mb-0.5">REVEAL</div>
          <div class="text-[9px]" style="color:#475569">Clear results</div>
        </div>
      </div>

      <!-- Floating tag -->
      <div class="hidden sm:flex absolute -bottom-5 -left-6 items-center gap-2 rounded-xl px-3 py-2 text-xs font-semibold text-white"
        style="background:#0d1a33;border:1px solid rgba(52,211,153,0.25);box-shadow:0 8px 28px rgba(0,0,0,0.4)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><path d="m5 12 4 4L19 6"/></svg>
        Transparent by design
      </div>
    </div>

  </div>

  <!-- Stats -->
  <div class="stats-row" style="max-width:1200px;margin-left:auto;margin-right:auto;margin-top:clamp(48px,7vw,80px)">
    <div class="stat-cell">
      <div class="stat-num">100%</div>
      <div class="stat-label">Digital Scoring</div>
    </div>
    <div class="stat-cell">
      <div class="stat-num" style="background:linear-gradient(135deg,#34d399,#059669);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Live</div>
      <div class="stat-label">Real-time Results</div>
    </div>
    <div class="stat-cell">
      <div class="stat-num" style="background:linear-gradient(135deg,#c084fc,#7c3aed);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">5+</div>
      <div class="stat-label">User Roles</div>
    </div>
  </div>
</section>

<!-- ── Features ── -->
<section id="features" class="features-section">
  <div class="section-wrap">
    <div class="text-center mb-14">
      <div class="section-eyebrow" style="background:rgba(59,130,246,0.1);color:#93c5fd;border:1px solid rgba(96,165,250,0.2)">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        The Platform
      </div>
      <h2 class="section-title">Everything your event needs</h2>
      <p class="section-sub">From the first setup to the final reveal — keep every part of your competition clear and connected.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">

      <div class="feature-card">
        <div class="feature-icon" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div class="feature-title">Event Management</div>
        <p class="feature-desc">Create events with categories, schedules, venues, prizes, and contestant rosters — all in one place.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon" style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <div class="feature-title">Custom Scoring Criteria</div>
        <p class="feature-desc">Define weighted criteria per event — beauty, talent, intelligence, or any custom category you need.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon" style="background:linear-gradient(135deg,#065f46,#059669)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <div class="feature-title">Live Tabulation</div>
        <p class="feature-desc">Scores aggregated and ranked in real-time as judges submit. No manual tallying, no delays.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon" style="background:linear-gradient(135deg,#1e40af,#3b82f6)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="feature-title">Role-Based Access</div>
        <p class="feature-desc">Separate portals for Admins, Organizers, Judges, and Tabulators — each with the right permissions.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon" style="background:linear-gradient(135deg,#78350f,#d97706)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
        </div>
        <div class="feature-title">Podium & Results</div>
        <p class="feature-desc">Official rankings with a cinematic reveal, podium display, and printable tabulation sheets.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon" style="background:linear-gradient(135deg,#134e4a,#0d9488)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
        <div class="feature-title">Cloud-Powered</div>
        <p class="feature-desc">Built on Firebase — secure, synced across every device, always available when your event is live.</p>
      </div>

    </div>
  </div>
</section>

<!-- ── How it works ── -->
<section id="how" class="how-section">
  <div class="section-wrap">
    <div class="text-center mb-14">
      <div class="section-eyebrow" style="background:rgba(16,185,129,0.08);color:#6ee7b7;border:1px solid rgba(52,211,153,0.18)">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Simple workflow
      </div>
      <h2 class="section-title">From setup to results</h2>
      <p class="section-sub">A straightforward process that keeps organizers, judges, and audiences in perfect sync.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-5 relative">
      <!-- Connector line (desktop only) -->
      <div class="hidden md:block absolute top-[52px] left-[calc(16.6%+28px)] right-[calc(16.6%+28px)] h-px" style="background:linear-gradient(90deg,transparent,rgba(99,102,241,0.3),transparent)"></div>

      <div class="step-card">
        <div class="step-number" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">1</div>
        <h3 class="font-extrabold text-sm mb-3" style="color:#e2e8f0">Create an Event</h3>
        <p class="text-sm" style="color:#64748b;line-height:1.65">Admin sets up the event, adds contestants, and defines scoring criteria with weights and categories.</p>
      </div>

      <div class="step-card">
        <div class="step-number" style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">2</div>
        <h3 class="font-extrabold text-sm mb-3" style="color:#e2e8f0">Judges Score</h3>
        <p class="text-sm" style="color:#64748b;line-height:1.65">Judges log in independently and enter scores per contestant per criterion — from any device, in real time.</p>
      </div>

      <div class="step-card">
        <div class="step-number" style="background:linear-gradient(135deg,#78350f,#d97706)">3</div>
        <h3 class="font-extrabold text-sm mb-3" style="color:#e2e8f0">Results Revealed</h3>
        <p class="text-sm" style="color:#64748b;line-height:1.65">ScoreSync computes weighted averages, breaks ties, and reveals rankings with a cinematic announcement screen.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── CTA ── -->
<section class="cta-section">
  <div class="section-wrap relative z-10">
    <div class="max-w-2xl mx-auto text-center">
      <div class="w-16 h-16 rounded-2xl overflow-hidden mx-auto mb-8 shadow-2xl" style="border:1px solid rgba(255,255,255,0.12);box-shadow:0 20px 48px rgba(0,0,0,0.5),0 0 0 1px rgba(255,255,255,0.08)">
        <img src="/scoresync-logo.png?v=8" alt="ScoreSync" class="w-full h-full object-cover"/>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-5" style="color:#f8fafc;letter-spacing:-0.03em">
        Make your next event<br/>run perfectly.
      </h2>
      <p class="text-base mb-10 leading-relaxed" style="color:#94a3b8;max-width:440px;margin-left:auto;margin-right:auto">
        Bring confident scoring and transparent results to competitions everywhere.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/register" class="btn-hero-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
          Start for Free
        </a>
        <a href="/login" class="btn-hero-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Sign In
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ── Footer ── -->
<footer class="home-footer">
  <div class="flex items-center justify-center gap-2 mb-3">
    <div class="w-6 h-6 rounded-lg overflow-hidden" style="border:1px solid rgba(255,255,255,0.1)">
      <img src="/scoresync-logo.png?v=8" alt="" class="w-full h-full object-cover"/>
    </div>
    <span class="font-black text-sm" style="color:#334155">ScoreSync</span>
  </div>
  <p style="color:#1e293b">&copy; {{currentYear}} ScoreSync. All rights reserved.</p>
</footer>

{{> footer }}
</body>
</html>
