                      <span class="hiw-score-val" id="hiw-score-2">85</span>
                    </div>
                    <div class="hiw-score-row">
                      <span class="hiw-criteria-label" style="color:#fbbf24">Q&amp;A</span>
                      <div class="hiw-score-bar-wrap"><div class="hiw-score-bar" style="width:95%;background:linear-gradient(90deg,#d97706,#fbbf24)" id="hiw-bar-3"></div></div>
                      <span class="hiw-score-val" id="hiw-score-3">95</span>
                    </div>
                  </div>
                  <div style="margin-top:10px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:space-between">
                    <span style="font-size:10px;color:#64748b">Weighted Total</span>
                    <span style="font-size:16px;font-weight:900;color:#fbbf24" id="hiw-total">91.25%</span>
                  </div>
