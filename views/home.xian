{{> head }}
<style>
  /* -- Reset & base -- */
  *, *::before, *::after { box-sizing: border-box; }

  /* -- Navbar -- */
  .nav-bar {
    position: sticky; top: 0; z-index: 50;
    background: rgba(6,12,26,0.92);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 1px 0 rgba(255,255,255,0.04), 0 8px 32px rgba(0,0,0,0.3);
  }
  .nav-link {
    font-size: 0.85rem; font-weight: 600; color: #94a3b8;
    text-decoration: none; padding: 6px 2px;
    border-bottom: 2px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .nav-link:hover { color: #e2e8f0; border-color: rgba(99,102,241,0.5); }

  /* -- Hero -- */
  .hero-section {
    position: relative; overflow: hidden;
    background: #0f1117;
    padding: clamp(64px,10vw,120px) 24px clamp(80px,12vw,140px);
  }
  .hero-bg-glow-1 {
    position: absolute; top: -180px; left: -120px;
    width: 700px; height: 700px; border-radius: 50%;
    background: radial-gradient(circle, rgba(79,70,229,0.22), transparent 65%);
    filter: blur(60px); pointer-events: none;
    animation: heroGlow1 10s ease-in-out infinite;
  }
  .hero-bg-glow-2 {
    position: absolute; bottom: -100px; right: -80px;
    width: 500px; height: 500px; border-radius: 50%;
    background: radial-gradient(circle, rgba(14,165,233,0.15), transparent 65%);
    filter: blur(60px); pointer-events: none;
    animation: heroGlow2 12s ease-in-out infinite;
  }
  .hero-bg-glow-3 {
    position: absolute; top: 30%; left: 42%;
    width: 380px; height: 380px; border-radius: 50%;
    background: radial-gradient(circle, rgba(139,92,246,0.1), transparent 65%);
    filter: blur(50px); pointer-events: none;
  }
  @keyframes heroGlow1 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(30px,-20px) scale(1.06)} }
  @keyframes heroGlow2 { 0%,100%{transform:translate(0,0) scale(1)} 50%{transform:translate(-20px,24px) scale(1.05)} }
  .hero-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(148,163,184,0.1) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, transparent 65%);
    opacity: 0.25;
  }

  /* -- Badge -- */
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 14px; border-radius: 999px;
    background: rgba(96,165,250,0.08);
    border: 1px solid rgba(147,197,253,0.18);
    font-size: 0.68rem; font-weight: 800;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: #93c5fd; margin-bottom: 28px;
  }
  .hero-badge-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #60a5fa;
    box-shadow: 0 0 8px #60a5fa;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.6;transform:scale(0.85)} }

  /* -- Hero title -- */
  .hero-title {
    font-size: clamp(2.6rem,6vw,4.2rem);
    font-weight: 900; line-height: 1.06;
    letter-spacing: -0.04em; color: #f8fafc;
    margin-bottom: 22px;
  }
  .hero-title-accent { color: #93c5fd; }
  .hero-title-gold { color: #fbbf24; }

  /* -- Hero sub -- */
  .hero-sub {
    font-size: clamp(0.95rem,2vw,1.1rem);
    color: #94a3b8; line-height: 1.7;
    max-width: 520px; margin-bottom: 36px;
  }

  /* -- CTA buttons -- */
  .btn-hero-primary {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 28px; border-radius: 14px;
    font-size: 0.92rem; font-weight: 800; color: #fff;
    background: linear-gradient(135deg,#2563eb,#4f46e5);
    box-shadow: 0 10px 32px rgba(37,99,235,0.38), inset 0 1px 0 rgba(255,255,255,0.2);
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
  }
  .btn-hero-primary:hover { transform: translateY(-2px); filter: brightness(1.1); box-shadow: 0 16px 40px rgba(37,99,235,0.5); }
  .btn-hero-secondary {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 24px; border-radius: 14px;
    font-size: 0.92rem; font-weight: 700; color: #e2e8f0;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    text-decoration: none;
    transition: background 160ms ease, transform 160ms ease;
  }
  .btn-hero-secondary:hover { background: rgba(255,255,255,0.11); transform: translateY(-1px); }

  /* -- Trust row -- */
  .trust-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 20px;
    margin-top: 32px; font-size: 0.75rem; font-weight: 600; color: #64748b;
  }
  .trust-item { display: inline-flex; align-items: center; gap: 6px; }

  /* -- Preview card -- */
  .preview-card {
    background: linear-gradient(145deg, rgba(16,26,52,0.95), rgba(8,14,30,0.98));
    border: 1px solid rgba(148,163,184,0.14);
    border-radius: 24px;
    box-shadow: 0 40px 100px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.06);
    backdrop-filter: blur(20px);
    padding: 24px;
    position: relative;
  }
  .preview-inner {
    background: rgba(4,8,20,0.6);
    border: 1px solid rgba(148,163,184,0.1);
    border-radius: 16px; padding: 20px;
  }

  /* -- Stats row -- */
  .stats-row {
    display: grid; grid-template-columns: repeat(3,1fr);
    border-radius: 20px; overflow: hidden;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(148,163,184,0.12);
    margin-top: clamp(40px,6vw,72px);
  }
  .stat-cell {
    padding: clamp(16px,3vw,28px) 16px;
    text-align: center; position: relative;
  }
  .stat-cell + .stat-cell { border-left: 1px solid rgba(148,163,184,0.1); }
  .stat-num {
    font-size: clamp(1.6rem,4vw,2.4rem);
    font-weight: 900; letter-spacing: -0.03em;
    background: linear-gradient(135deg,#93c5fd,#6366f1);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .stat-label { font-size: 0.7rem; color: #64748b; font-weight: 600; margin-top: 4px; }

  /* -- Section shell -- */
  .section-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

  /* -- Features -- */
  .features-section {
    padding: clamp(72px,10vw,112px) 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(30,64,175,0.1), transparent 50%), #0d1119;
  }
  .section-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.65rem; font-weight: 800;
    letter-spacing: 0.18em; text-transform: uppercase;
    padding: 6px 14px; border-radius: 999px;
    margin-bottom: 16px;
  }
  .section-title {
    font-size: clamp(1.8rem,4vw,2.8rem);
    font-weight: 900; letter-spacing: -0.03em;
    color: #f1f5f9; line-height: 1.1;
  }
  .section-sub {
    font-size: 0.95rem; color: #94a3b8;
    line-height: 1.7; max-width: 520px; margin: 14px auto 0;
  }

  /* -- Feature card -- */
  .feature-card {
    background: linear-gradient(145deg, rgba(16,24,44,0.96), rgba(10,16,30,0.98));
    border: 1px solid rgba(148,163,184,0.1);
    border-radius: 20px; padding: 28px 24px;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
    position: relative; overflow: hidden;
  }
  .feature-card::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,0.04), transparent 60%);
    opacity: 0; transition: opacity 200ms ease;
    pointer-events: none;
  }
  .feature-card:hover { transform: translateY(-4px); border-color: rgba(99,102,241,0.25); box-shadow: 0 20px 48px rgba(0,0,0,0.35); }
  .feature-card:hover::before { opacity: 1; }
  .feature-icon {
    width: 48px; height: 48px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }
  .feature-title { font-size: 0.95rem; font-weight: 800; color: #e2e8f0; margin-bottom: 10px; }
  .feature-desc { font-size: 0.85rem; color: #64748b; line-height: 1.65; }

  /* -- How it works -- */
  .how-section {
    padding: clamp(72px,10vw,112px) 0;
    background: #0c1018;
    position: relative; overflow: hidden;
  }
  .how-section::before {
    content: ""; position: absolute;
    top: -200px; left: 50%; transform: translateX(-50%);
    width: 800px; height: 400px; border-radius: 50%;
    background: radial-gradient(ellipse, rgba(16,185,129,0.06), transparent 65%);
    filter: blur(40px); pointer-events: none;
  }
  .step-card {
    background: linear-gradient(145deg, rgba(14,22,42,0.96), rgba(9,15,28,0.98));
    border: 1px solid rgba(148,163,184,0.1);
    border-radius: 20px; padding: 32px 24px;
    text-align: center; position: relative;
    transition: transform 200ms ease, border-color 200ms ease;
  }
  .step-card:hover { transform: translateY(-3px); border-color: rgba(148,163,184,0.22); }
  .step-number {
    width: 56px; height: 56px; border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; font-weight: 900; color: #fff;
    margin: 0 auto 20px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.4);
  }
  .step-connector {
    display: none;
  }
  @media (min-width: 768px) {
    .step-connector {
      display: flex; align-items: center; justify-content: center;
      color: #1e3a5a; font-size: 1.5rem; flex-shrink: 0;
      margin-top: -20px;
    }
  }

  /* -- CTA section -- */
  .cta-section {
    padding: clamp(72px,10vw,112px) 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(59,130,246,0.18), transparent 55%),
                linear-gradient(135deg,#0f1117,#0c1a36);
    position: relative; overflow: hidden;
  }
  .cta-section::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(148,163,184,0.07) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
    opacity: 0.4;
  }

  /* -- Footer -- */
  .home-footer {
    background: #040810;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 32px 24px;
    text-align: center;
    font-size: 0.78rem; color: #334155;
  }

  /* -- Responsive hero layout -- */
  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px,6vw,80px);
    max-width: 1200px; margin: 0 auto;
  }
  @media (max-width: 900px) {
    .hero-layout { grid-template-columns: 1fr; text-align: center; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .hero-cta-row { justify-content: center; }
    .trust-row { justify-content: center; }
    .preview-card { max-width: 500px; margin: 0 auto; }
  }
  /* -- Social proof bar -- */
  .social-proof-bar {
    background: rgba(255,255,255,0.025);
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding: 14px 24px;
  }
  .social-proof-inner {
    max-width: 1200px; margin: 0 auto;
    display: flex; align-items: center; justify-content: center;
    gap: 32px; flex-wrap: wrap;
  }
  .sp-label {
    font-size: 0.65rem; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; color: #475569; white-space: nowrap;
  }
  .sp-divider { width: 1px; height: 18px; background: rgba(255,255,255,0.08); flex-shrink: 0; }
  .sp-tags { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .sp-tag {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 999px;
    font-size: 0.72rem; font-weight: 700;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    color: #94a3b8;
    transition: border-color 0.2s, color 0.2s;
  }
  .sp-tag:hover { border-color: rgba(99,102,241,0.3); color: #c7d2fe; }
  .sp-tag-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }

  /* -- FAQ section -- */
  .faq-section {
    padding: clamp(64px,9vw,100px) 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(79,70,229,0.08), transparent 60%), #0f1117;
  }
  .faq-item {
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    background: rgba(255,255,255,0.025);
    overflow: hidden;
    transition: border-color 0.2s;
    margin-bottom: 10px;
  }
  .faq-item:hover { border-color: rgba(99,102,241,0.2); }
  .faq-btn {
    width: 100%; text-align: left;
    padding: 18px 22px; background: none; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    font-size: 0.92rem; font-weight: 700; color: #e2e8f0;
    transition: color 0.2s;
  }
  .faq-btn:hover { color: #fff; }
  .faq-icon {
    width: 24px; height: 24px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(99,102,241,0.12);
    border: 1px solid rgba(99,102,241,0.2);
    color: #a78bfa; font-size: 14px; font-weight: 700;
    transition: transform 0.3s ease, background 0.2s;
  }
  .faq-item.open .faq-icon { transform: rotate(45deg); background: rgba(99,102,241,0.25); }
  .faq-body {
    max-height: 0; overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16,1,0.3,1), padding 0.35s ease;
    padding: 0 22px;
  }
  .faq-item.open .faq-body { max-height: 200px; padding: 0 22px 18px; }
  .faq-body p { font-size: 0.88rem; color: #64748b; line-height: 1.7; }

  /* -- Footer upgrade -- */
  .home-footer {
    background: #020608;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 48px 24px 28px;
  }
  .footer-inner {
    max-width: 1200px; margin: 0 auto;
  }
  .footer-top {
    display: grid; grid-template-columns: 1fr auto;
    gap: 32px; margin-bottom: 32px;
    align-items: start;
  }
  .footer-brand-name {
    font-size: 1rem; font-weight: 900; color: #e2e8f0; margin-bottom: 6px;
  }
  .footer-brand-desc {
    font-size: 0.8rem; color: #334155; line-height: 1.6; max-width: 280px;
  }
  .footer-links {
    display: flex; gap: 24px; flex-wrap: wrap; justify-content: flex-end;
  }
  .footer-link {
    font-size: 0.8rem; font-weight: 600; color: #334155;
    text-decoration: none; transition: color 0.2s;
  }
  .footer-link:hover { color: #94a3b8; }
  .footer-bottom {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
    padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 0.72rem; color: #94a3b8;
  }
  @media (max-width: 600px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-links { justify-content: flex-start; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-glow-1, .hero-bg-glow-2, .feature-card, .step-card { animation: none; transition: none; }
    .feature-card:hover, .step-card:hover { transform: none; }
  }

  /* -- Floating particles -- */
  #home-particles {
    position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
  }
  .hp {
    position: absolute; border-radius: 50%;
    animation: hpFloat linear infinite;
  }
  @keyframes hpFloat {
    0%   { transform: translateY(100vh) scale(0); opacity: 0; }
    8%   { opacity: 1; }
    92%  { opacity: 0.4; }
    100% { transform: translateY(-40px) scale(1.4); opacity: 0; }
  }

  /* -- Scroll reveal -- */
  .sr {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s cubic-bezier(0.16,1,0.3,1),
                transform 0.65s cubic-bezier(0.16,1,0.3,1);
  }
  .sr.visible { opacity: 1; transform: translateY(0); }
  .sr-delay-1 { transition-delay: 0.08s; }
  .sr-delay-2 { transition-delay: 0.16s; }
  .sr-delay-3 { transition-delay: 0.24s; }
  .sr-delay-4 { transition-delay: 0.32s; }
  .sr-delay-5 { transition-delay: 0.40s; }
  .sr-delay-6 { transition-delay: 0.48s; }

  /* -- Progress bar animate -- */
  .prog-bar { width: 0% !important; transition: width 1.4s cubic-bezier(0.16,1,0.3,1); }
  .prog-bar.animated { width: var(--pw) !important; }

  /* -- Stat counter glow -- */
  .stat-num { transition: text-shadow 0.4s ease; }
  .stat-cell:hover .stat-num {
    text-shadow: 0 0 20px rgba(96,165,250,0.5);
    filter: brightness(1.15);
  }

  /* -- Logo float (CTA section) -- */
  .cta-logo-wrap {
    animation: ctaLogoFloat 6s ease-in-out infinite, ctaLogoPulse 5s ease-in-out infinite;
  }
  @keyframes ctaLogoFloat {
    0%,100% { transform: translateY(0); }
    50%     { transform: translateY(-8px); }
  }
  @keyframes ctaLogoPulse {
    0%   { box-shadow: 0 20px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.08), 0 0 20px rgba(124,58,237,0.2); }
    50%  { box-shadow: 0 20px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(99,102,241,0.35), 0 0 32px rgba(99,102,241,0.35); }
    100% { box-shadow: 0 20px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.08), 0 0 20px rgba(124,58,237,0.2); }
  }

  /* -- Feature card shimmer on hover -- */
  .feature-card::after {
    content: ''; position: absolute;
    top: 0; left: -100%; width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.04), transparent);
    transform: skewX(-20deg);
    transition: left 0.6s cubic-bezier(0.16,1,0.3,1);
    pointer-events: none;
  }
  .feature-card:hover::after { left: 150%; }

  /* -- Step card number pulse -- */
  .step-card:hover .step-number {
    animation: stepNumPop 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  @keyframes stepNumPop {
    0%   { transform: scale(1); }
    50%  { transform: scale(1.12); }
    100% { transform: scale(1); }
  }

  /* -- Badge dot enhanced -- */
  .hero-badge-dot {
    animation: badgeDot 2s ease-in-out infinite !important;
  }
  @keyframes badgeDot {
    0%,100% { box-shadow: 0 0 6px #60a5fa; transform: scale(1); }
    50%     { box-shadow: 0 0 14px #60a5fa, 0 0 24px rgba(96,165,250,0.4); transform: scale(1.3); }
  }

  /* -- CTA primary button pulse -- */
  .btn-hero-primary {
    animation: btnGlow 3s ease-in-out infinite;
  }
  @keyframes btnGlow {
    0%,100% { box-shadow: 0 10px 32px rgba(37,99,235,0.38), inset 0 1px 0 rgba(255,255,255,0.2); }
    50%     { box-shadow: 0 10px 40px rgba(79,70,229,0.55), inset 0 1px 0 rgba(255,255,255,0.2); }
  }
  .btn-hero-primary:hover { animation: none; }
</style>

<body class="flex flex-col min-h-screen" style="background:#0f1117;color:#e2e8f0">
<div id="home-particles"></div>

<!-- -- Navbar -- -->
<header class="nav-bar">
  <div class="section-wrap">
    <div class="flex items-center justify-between h-16 gap-4">

      <!-- Brand -->
      <a href="/" class="flex items-center gap-3 flex-shrink-0 text-decoration-none" style="text-decoration:none">
        <div style="border-radius:9999px;width:36px;height:36px;flex-shrink:0;overflow:hidden;box-shadow:0 0 14px rgba(29,78,216,0.4);border:1.5px solid rgba(37,99,235,0.4)">
          <img src="/scoresync-logo.png?v=8" alt="ScoreSync" width="36" height="36" style="display:block;width:100%;height:100%;object-fit:cover"/>
        </div>
        <span class="font-black text-base tracking-tight text-white hidden sm:block">ScoreSync</span>
      </a>

      <!-- Nav links -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="#features" class="nav-link">Features</a>
        <a href="#how" class="nav-link">How it works</a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <a href="/login" class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-sm font-semibold transition"
          style="color:#94a3b8;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);text-decoration:none"
          onmouseover="this.style.color='#e2e8f0';this.style.background='rgba(255,255,255,0.09)'"
          onmouseout="this.style.color='#94a3b8';this.style.background='rgba(255,255,255,0.04)'">
          Sign In
        </a>
        <a href="/register" class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-sm font-extrabold text-white transition"
          style="background:linear-gradient(135deg,#1d4ed8,#4f46e5);box-shadow:0 4px 14px rgba(37,99,235,0.35);text-decoration:none"
          onmouseover="this.style.filter='brightness(1.1)'"
          onmouseout="this.style.filter=''">
          Get Started
