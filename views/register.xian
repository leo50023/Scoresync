{{> head }}
<style>
  /* ─── Base ─── */
  body.auth-page {
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center; justify-content: center;
    padding: 24px 20px;
    position: relative; isolation: isolate; overflow-x: hidden;
    background: #060c1a;
  }

  /* ─── Background ─── */
  .auth-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .auth-bg-orb {
    position: absolute; border-radius: 50%; filter: blur(90px);
    animation: orbFloat 10s ease-in-out infinite;
  }
  .auth-bg-orb-1 { width: 500px; height: 500px; top: -160px; left: -120px; opacity: 0.5; background: radial-gradient(circle, rgba(99,102,241,0.45), transparent 65%); }
  .auth-bg-orb-2 { width: 380px; height: 380px; bottom: -100px; right: -80px; opacity: 0.38; background: radial-gradient(circle, rgba(14,165,233,0.4), transparent 65%); animation-delay: -4s; }
  .auth-bg-orb-3 { width: 260px; height: 260px; top: 40%; left: 52%; opacity: 0.22; background: radial-gradient(circle, rgba(139,92,246,0.35), transparent 65%); animation-delay: -7s; }
  @keyframes orbFloat { 0%,100%{transform:translateY(0) scale(1)} 50%{transform:translateY(-28px) scale(1.04)} }
  .auth-bg-grid {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.055) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, transparent 65%);
  }

  /* ─── Shell ─── */
  .auth-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 420px;
    display: flex; flex-direction: column; align-items: center;
  }

  /* ─── Logo ─── */
  .auth-logomark {
    width: 72px; height: 72px; border-radius: 18px;
    overflow: hidden; flex-shrink: 0; margin-bottom: 12px;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.12), 0 0 0 4px rgba(99,102,241,0.18), 0 10px 36px rgba(79,70,229,0.38);
  }
  .auth-logomark img { width: 100%; height: 100%; object-fit: cover; }

  /* ─── Eyebrow ─── */
  .auth-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.62rem; font-weight: 800;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: #a5b4fc; margin-bottom: 8px;
  }
  .auth-eyebrow::before, .auth-eyebrow::after {
    content: ""; width: 22px; height: 1.5px;
    background: linear-gradient(90deg, transparent, #818cf8);
  }
  .auth-eyebrow::after { background: linear-gradient(90deg, #818cf8, transparent); }

  /* ─── Title ─── */
  .auth-title {
    font-size: 2rem; font-weight: 900;
    letter-spacing: -0.03em; line-height: 1.1;
    color: #ffffff; margin-bottom: 6px; text-align: center;
  }
  .auth-subtitle { font-size: 0.82rem; color: #64748b; text-align: center; }

  /* ─── Tab switcher ─── */
  .auth-tab-wrap {
    display: flex; gap: 4px; padding: 4px; border-radius: 14px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    margin-top: 20px; margin-bottom: 16px; width: 100%;
  }
  .auth-tab {
    flex: 1; padding: 10px 14px; border-radius: 11px;
    font-size: 0.85rem; font-weight: 700;
    text-align: center; text-decoration: none; color: #475569;
    transition: all 150ms ease;
  }
  .auth-tab:not(.active):hover { background: rgba(255,255,255,0.06); color: #94a3b8; }
  .auth-tab.active {
    background: linear-gradient(135deg,#4338ca,#6366f1); color: #fff;
    box-shadow: 0 4px 14px rgba(79,70,229,0.42), inset 0 1px 0 rgba(255,255,255,0.18);
  }

  /* ─── Card ─── */
  .auth-card {
    background: #0d1528;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 18px; padding: 22px 20px;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.04), 0 20px 60px rgba(0,0,0,0.65), inset 0 1px 0 rgba(255,255,255,0.07);
    width: 100%;
  }

  /* ─── Label ─── */
  .auth-label {
    display: block; font-size: 0.65rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #94a3b8; margin-bottom: 6px;
  }

  /* ─── Input ─── */
  .input-icon-wrap { position: relative; }
  .input-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #334155; pointer-events: none; z-index: 1; transition: color 150ms ease;
  }
  .input-icon-wrap:focus-within .input-icon { color: #6366f1; }
  .auth-input {
    width: 100%; height: 50px;
    padding: 0 14px 0 44px;
    background: #0a1020 !important;
    border: 1px solid rgba(255,255,255,0.1) !important;
    border-radius: 12px !important;
    font-size: 0.92rem; color: #f1f5f9 !important;
    outline: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
    -webkit-text-fill-color: #f1f5f9;
  }
  .auth-input:focus {
    border-color: rgba(99,102,241,0.65) !important;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.16) !important;
  }
  .auth-input::placeholder { color: #2d3748; }
  .auth-input:-webkit-autofill, .auth-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #0a1020 inset !important;
    -webkit-text-fill-color: #f1f5f9 !important;
    transition: background-color 9999s ease-in-out 0s;
  }
  .auth-input-pr { padding-right: 48px; }

  /* ─── Role cards ─── */
  .role-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .role-grid-full { grid-column: 1 / -1; }
  .role-card-label { cursor: pointer; }
  .role-card {
    border-radius: 13px; padding: 14px 12px;
    background: #0a1020;
    border: 1px solid rgba(255,255,255,0.1);
    text-align: center;
    transition: all 150ms ease; user-select: none;
  }
  .role-card:hover { border-color: rgba(255,255,255,0.2); background: #0e1630; transform: translateY(-1px); }
  input[type="radio"].sr-only:checked + .role-card {
    border-color: rgba(99,102,241,0.7) !important;
    background: rgba(99,102,241,0.1) !important;
    box-shadow: 0 0 0 1px rgba(99,102,241,0.25);
  }
  input[type="radio"].sr-only:checked + .role-card-tabulator {
    border-color: rgba(245,158,11,0.7) !important;
    background: rgba(245,158,11,0.08) !important;
    box-shadow: 0 0 0 1px rgba(245,158,11,0.25);
  }
  input[type="radio"].sr-only:checked + .role-card-organizer {
    border-color: rgba(16,185,129,0.7) !important;
    background: rgba(16,185,129,0.08) !important;
    box-shadow: 0 0 0 1px rgba(16,185,129,0.25);
  }
  .role-icon {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 10px;
  }

  /* ─── Button ─── */
  .auth-btn {
    width: 100%; height: 52px;
    border-radius: 13px; font-size: 0.95rem; font-weight: 800;
    color: #fff; border: none; cursor: pointer;
    background: linear-gradient(135deg,#4338ca 0%,#6366f1 55%,#818cf8 100%);
    box-shadow: 0 8px 24px rgba(79,70,229,0.42), inset 0 1px 0 rgba(255,255,255,0.18);
    transition: all 180ms ease;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .auth-btn:hover { filter: brightness(1.1); transform: translateY(-1px); }
  .auth-btn:active { transform: translateY(0); filter: none; }

  /* ─── Footer ─── */
  .auth-home-link {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    height: 40px; padding: 0 20px;
    border: 1px solid rgba(255,255,255,0.1); border-radius: 999px;
    background: rgba(255,255,255,0.04); color: #64748b;
    font-size: 0.8rem; font-weight: 600; text-decoration: none;
    transition: all 150ms ease;
  }
  .auth-home-link:hover { background: rgba(255,255,255,0.08); color: #e2e8f0; }
  .auth-footer { color: #334155; }
  .auth-footer a:not(.auth-home-link) { color: #818cf8 !important; font-weight: 700; transition: color 150ms ease; }
  .auth-footer a:not(.auth-home-link):hover { color: #a5b4fc !important; }

  /* ─── Focus ─── */
  .auth-tab:focus-visible { outline: 2px solid #6366f1; outline-offset: 3px; }
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border-width:0 }

  /* ─── Mobile ─── */
  @media (max-width: 480px) {
    body.auth-page {
      padding: 18px 28px 22px;
      align-items: flex-start;
    }
    .auth-shell { max-width: 100%; }
    .auth-logomark { width: 68px; height: 68px; }
    .auth-title { font-size: 1.8rem; }
    .auth-subtitle { font-size: 0.82rem; }
    .auth-tab-wrap { margin-top: 16px; margin-bottom: 12px; }
    .auth-tab { padding: 11px 14px; font-size: 0.84rem; }
    .auth-card {
      padding: 20px 16px;
      border-radius: 16px;
      width: 100%;
    }
    .auth-card .space-y-4 > * + * { margin-top: 12px !important; }
    .auth-label { font-size: 0.65rem; margin-bottom: 6px; }
    .auth-input {
      height: 50px !important;
      font-size: 16px !important;
      border-radius: 12px !important;
    }
    .auth-btn { height: 52px; font-size: 0.93rem; border-radius: 13px; }
    .role-grid { gap: 10px; }
    .role-card { padding: 14px 12px; border-radius: 13px; }
    .role-icon { width: 36px; height: 36px; border-radius: 10px; margin-bottom: 8px; }
    .role-card .font-bold.text-xs { font-size: 0.8rem !important; }
    .role-card .text-\[10px\] { font-size: 0.68rem !important; }
    .role-grid-full .role-card { padding: 12px 14px; }
    .auth-footer { margin-top: 14px !important; }
    .auth-home-link { height: 40px; font-size: 0.78rem; }
    .auth-bg-orb-1 { width: 260px; height: 260px; }
    .auth-bg-orb-2 { width: 200px; height: 200px; }
    .auth-bg-orb-3 { display: none; }
  }
</style>

<div class="auth-bg">
  <div class="auth-bg-grid"></div>
  <div class="auth-bg-orb auth-bg-orb-1"></div>
  <div class="auth-bg-orb auth-bg-orb-2"></div>
  <div class="auth-bg-orb auth-bg-orb-3"></div>
</div>

<body class="auth-page" style="overflow-x:hidden">
  <div class="auth-shell animate-fadeup">

    <div class="auth-logomark">
      <img src="/scoresync-logo.png?v=8" alt="ScoreSync"/>
    </div>
    <span class="auth-eyebrow">ScoreSync</span>
    <h1 class="auth-title">Create your account</h1>
    <p class="auth-subtitle">Request access and join the platform</p>

    <div class="auth-tab-wrap">
      <a href="/login" class="auth-tab">Sign In</a>
      <a href="/register" class="auth-tab active" aria-current="page">Register</a>
    </div>

    {{#if error_msg}}
    <div class="alert-error mb-3 text-sm w-full">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}
    {{#if success_msg}}
    <div class="alert-success mb-3 text-sm w-full">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
      <span>{{success_msg}}</span>
    </div>
    {{/if}}

    <div class="auth-card">
      <form method="POST" action="/register" class="space-y-4">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <div>
          <label class="auth-label">Full Name</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <input type="text" name="name" placeholder="Juan dela Cruz" required class="auth-input"/>
          </div>
        </div>

        <div>
          <label class="auth-label">Email Address</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="auth-input"/>
          </div>
        </div>

        <div>
          <label class="auth-label">Password</label>
          <div class="input-icon-wrap" style="position:relative">
            <span class="input-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" name="password" id="passwordInput" placeholder="Min. 6 characters" required minlength="6" autocomplete="new-password" class="auth-input auth-input-pr"/>
            <button type="button" id="eyeBtn" onclick="togglePwd()"
              style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:#334155;background:none;border:none;cursor:pointer;padding:4px;display:flex;align-items:center;justify-content:center;border-radius:6px;height:28px;width:28px">
              <svg id="eyeIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <div>
          <label class="auth-label">Select Your Role</label>
          <div class="role-grid">

            <label class="role-card-label">
              <input type="radio" name="role" value="judge" class="sr-only" required/>
              <div class="role-card">
                <div class="role-icon" style="background:linear-gradient(135deg,#3730a3,#6366f1)">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                </div>
                <div class="font-bold text-xs text-white mb-0.5">Judge</div>
                <div class="text-[10px]" style="color:#475569">Score contestants</div>
              </div>
            </label>

            <label class="role-card-label">
              <input type="radio" name="role" value="tabulator" class="sr-only"/>
              <div class="role-card role-card-tabulator">
                <div class="role-icon" style="background:linear-gradient(135deg,#78350f,#d97706)">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <div class="font-bold text-xs text-white mb-0.5">Tabulator</div>
                <div class="text-[10px]" style="color:#475569">Review scores</div>
              </div>
            </label>

            <label class="role-card-label role-grid-full">
              <input type="radio" name="role" value="organizer" class="sr-only"/>
              <div class="role-card role-card-organizer" style="text-align:left;display:flex;align-items:center;gap:12px;padding:12px 14px">
                <div class="role-icon flex-shrink-0" style="background:linear-gradient(135deg,#065f46,#10b981);margin:0">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <div class="flex-1">
                  <div class="font-bold text-xs text-white mb-0.5">Organizer</div>
                  <div class="text-[10px]" style="color:#475569">Create &amp; manage events</div>
                </div>
                <span class="text-[9px] font-extrabold px-2 py-0.5 rounded-full flex-shrink-0" style="background:rgba(16,185,129,0.14);color:#34d399;border:1px solid rgba(16,185,129,0.22)">FULL ACCESS</span>
              </div>
            </label>

          </div>
        </div>

        <button type="submit" class="auth-btn">
          Request Account
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>

        <p class="text-[10px] text-center" style="color:#334155">
          Your account will be reviewed by an admin before activation.
        </p>
      </form>
    </div>

    <div class="auth-footer mt-4 text-center space-y-3 text-xs w-full">
      <p>Already have an account? <a href="/login">Sign in</a></p>
      <a href="/" class="auth-home-link">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/></svg>
        Back to homepage
      </a>
    </div>

  </div>

<script>
const eyeOpen='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePwd(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){i.type='text';b.innerHTML=eyeClose;}
  else{i.type='password';b.innerHTML=eyeOpen;}
}
document.querySelectorAll('input[name="role"]').forEach(radio=>{
  radio.addEventListener('change',()=>{
    document.querySelectorAll('.role-card').forEach(c=>{c.style.borderColor='';c.style.background='';c.style.boxShadow='';});
    const card=radio.nextElementSibling; if(!card) return;
    const colors={
      judge:     ['rgba(99,102,241,0.7)','rgba(99,102,241,0.1)','0 0 0 1px rgba(99,102,241,0.25)'],
      tabulator: ['rgba(245,158,11,0.7)','rgba(245,158,11,0.08)','0 0 0 1px rgba(245,158,11,0.25)'],
      organizer: ['rgba(16,185,129,0.7)','rgba(16,185,129,0.08)','0 0 0 1px rgba(16,185,129,0.25)'],
    };
    if(colors[radio.value]){card.style.borderColor=colors[radio.value][0];card.style.background=colors[radio.value][1];card.style.boxShadow=colors[radio.value][2];}
  });
});
</script>
</body>
</html>
