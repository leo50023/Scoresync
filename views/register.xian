{{> head }}
<style>
  body.auth-page {
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center; justify-content: center;
    padding: clamp(16px,3vh,40px) 16px;
    position: relative; isolation: isolate; overflow: hidden;
    background: #060c1a;
  }
  .auth-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
  }
  .auth-bg-orb {
    position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.5;
    animation: orbFloat 8s ease-in-out infinite;
  }
  .auth-bg-orb-1 {
    width: 500px; height: 500px; top: -160px; left: -120px;
    background: radial-gradient(circle, rgba(79,70,229,0.38), transparent 70%);
    animation-delay: 0s;
  }
  .auth-bg-orb-2 {
    width: 380px; height: 380px; bottom: -100px; right: -80px;
    background: radial-gradient(circle, rgba(14,165,233,0.28), transparent 70%);
    animation-delay: -3s;
  }
  .auth-bg-orb-3 {
    width: 260px; height: 260px; top: 38%; left: 58%;
    background: radial-gradient(circle, rgba(139,92,246,0.18), transparent 70%);
    animation-delay: -5.5s;
  }
  @keyframes orbFloat {
    0%,100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.04); }
  }
  .auth-bg-grid {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(148,163,184,0.12) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 70%);
    opacity: 0.2;
  }
  .auth-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 440px;
    display: flex; flex-direction: column;
  }
  .auth-logomark {
    width: 68px; height: 68px; border-radius: 20px;
    overflow: hidden; flex-shrink: 0; margin-bottom: 18px;
    box-shadow: 0 8px 32px rgba(79,70,229,0.35), 0 0 0 1px rgba(255,255,255,0.1);
  }
  .auth-logomark img { width: 100%; height: 100%; object-fit: cover; }
  .auth-eyebrow {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.62rem; font-weight: 800;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: #818cf8; margin-bottom: 6px;
  }
  .auth-eyebrow::before {
    content: ""; width: 18px; height: 1px;
    background: linear-gradient(90deg, transparent, #818cf8);
  }
  .auth-title {
    font-size: 1.8rem; font-weight: 900;
    letter-spacing: -0.04em; line-height: 1.1;
    color: #f1f5f9; margin-bottom: 5px;
  }
  .auth-subtitle { font-size: 0.82rem; color: #94a3b8; }
  .auth-tab-wrap {
    display: flex; gap: 4px; padding: 4px; border-radius: 14px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    margin-bottom: 20px;
  }
  .auth-tab {
    flex: 1; padding: 10px 12px; border-radius: 11px;
    font-size: 0.82rem; font-weight: 700;
    text-align: center; text-decoration: none; color: #94a3b8;
    transition: all 160ms ease;
  }
  .auth-tab:not(.active):hover { background: rgba(255,255,255,0.06); color: #e2e8f0; }
  .auth-tab.active {
    background: linear-gradient(135deg,#4f46e5,#6366f1); color: #fff;
    box-shadow: 0 4px 14px rgba(79,70,229,0.4), inset 0 1px 0 rgba(255,255,255,0.2);
  }
  .auth-card {
    background: linear-gradient(160deg, rgba(18,26,48,0.98), rgba(12,18,34,0.98));
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px; padding: 28px 28px;
    box-shadow: 0 32px 80px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.07);
    backdrop-filter: blur(20px);
  }
  @media (max-width: 400px) { .auth-card { padding: 22px 16px; } }
  .auth-label {
    display: block; font-size: 0.67rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #64748b; margin-bottom: 7px;
  }
  .input-icon-wrap { position: relative; }
  .input-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #475569; pointer-events: none; z-index: 1;
    transition: color 160ms ease;
  }
  .input-icon-wrap:focus-within .input-icon { color: #818cf8; }
  .auth-input {
    width: 100%; min-height: 50px;
    padding: 13px 14px 13px 44px;
    background: rgba(8,13,26,0.7) !important;
    border: 1.5px solid rgba(148,163,184,0.14) !important;
    border-radius: 13px !important;
    font-size: 0.88rem; color: #e2e8f0 !important;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
    -webkit-text-fill-color: #e2e8f0;
  }
  .auth-input:focus {
    background: rgba(13,22,42,0.98) !important;
    border-color: rgba(129,140,248,0.75) !important;
    box-shadow: 0 0 0 4px rgba(99,102,241,0.14), 0 4px 20px rgba(0,0,0,0.18) !important;
  }
  .auth-input::placeholder { color: #374151; }
  .auth-input:-webkit-autofill,
  .auth-input:-webkit-autofill:hover,
  .auth-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #0d1527 inset !important;
    -webkit-text-fill-color: #e2e8f0 !important;
    caret-color: #e2e8f0 !important;
    transition: background-color 9999s ease-in-out 0s;
  }
  .auth-input-pr { padding-right: 48px; }

  /* ── Role cards ── */
  .role-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .role-grid-full { grid-column: 1 / -1; }
  .role-card-label { cursor: pointer; }
  .role-card {
    border-radius: 14px; padding: 14px 12px;
    background: rgba(10,16,32,0.7);
    border: 1.5px solid rgba(148,163,184,0.12);
    text-align: center;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    user-select: none;
  }
  .role-card:hover {
    background: rgba(20,30,56,0.85);
    border-color: rgba(148,163,184,0.25);
    transform: translateY(-1px);
  }
  input[type="radio"].sr-only:checked + .role-card {
    border-color: #6366f1 !important;
    background: rgba(99,102,241,0.12) !important;
    box-shadow: 0 0 0 1px rgba(99,102,241,0.3), 0 4px 16px rgba(79,70,229,0.2);
  }
  input[type="radio"].sr-only:checked + .role-card-tabulator {
    border-color: #f59e0b !important;
    background: rgba(245,158,11,0.1) !important;
    box-shadow: 0 0 0 1px rgba(245,158,11,0.3), 0 4px 16px rgba(245,158,11,0.15);
  }
  input[type="radio"].sr-only:checked + .role-card-organizer {
    border-color: #10b981 !important;
    background: rgba(16,185,129,0.1) !important;
    box-shadow: 0 0 0 1px rgba(16,185,129,0.3), 0 4px 16px rgba(16,185,129,0.15);
  }
  .role-icon {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 10px;
  }
  .role-card-inline {
    border-radius: 14px; padding: 12px 16px;
    background: rgba(10,16,32,0.7);
    border: 1.5px solid rgba(148,163,184,0.12);
    display: flex; align-items: center; gap: 14px;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
    cursor: pointer;
  }
  .role-card-inline:hover {
    background: rgba(20,30,56,0.85);
    border-color: rgba(148,163,184,0.25);
    transform: translateY(-1px);
  }

  /* ── Button ── */
  .auth-btn {
    width: 100%; min-height: 52px; padding: 14px;
    border-radius: 14px; font-size: 0.92rem; font-weight: 800;
    color: #fff; border: none; cursor: pointer;
    background: linear-gradient(110deg,#4338ca,#5b51f0 50%,#7c73f5);
    box-shadow: 0 10px 28px rgba(79,70,229,0.32), inset 0 1px 0 rgba(255,255,255,0.25);
    transition: filter 160ms ease, transform 160ms ease, box-shadow 160ms ease;
    letter-spacing: -0.01em;
  }
  .auth-btn:hover { filter: brightness(1.1); transform: translateY(-1px); box-shadow: 0 16px 36px rgba(79,70,229,0.42); }
  .auth-btn:active { transform: translateY(0); filter: brightness(0.97); }

  /* ── Footer ── */
  .auth-home-link {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 42px; padding: 0 20px;
    border: 1px solid rgba(165,180,252,0.2); border-radius: 999px;
    background: rgba(99,102,241,0.07); color: #a5b4fc;
    font-size: 0.8rem; font-weight: 600; text-decoration: none;
    transition: all 160ms ease;
  }
  .auth-home-link:hover {
    background: rgba(99,102,241,0.16); border-color: rgba(165,180,252,0.45);
    color: #e0e7ff; transform: translateY(-1px);
  }
  .auth-footer { color: #64748b; }
  .auth-footer a:not(.auth-home-link) { color: #818cf8 !important; font-weight: 700; transition: color 160ms ease; }
  .auth-footer a:not(.auth-home-link):hover { color: #c7d2fe !important; }

  /* ── Compact on small height ── */
  @media (max-height: 820px) {
    body.auth-page { padding-top: 12px; padding-bottom: 12px; align-items: flex-start; }
    .auth-logomark { width: 56px; height: 56px; margin-bottom: 12px; }
    .auth-title { font-size: 1.5rem; }
    .auth-card { padding: 20px 20px; }
    .auth-input { min-height: 44px; }
    .role-card { padding: 10px 8px; }
  }
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border-width:0 }
</style>

<div class="auth-bg">
  <div class="auth-bg-grid"></div>
  <div class="auth-bg-orb auth-bg-orb-1"></div>
  <div class="auth-bg-orb auth-bg-orb-2"></div>
  <div class="auth-bg-orb auth-bg-orb-3"></div>
</div>

<body class="auth-page">
  <div class="auth-shell animate-fadeup">

    <!-- Logo + heading -->
    <div class="flex flex-col items-center text-center mb-7">
      <div class="auth-logomark">
        <img src="/scoresync-logo.png?v=8" alt="ScoreSync"/>
      </div>
      <span class="auth-eyebrow">ScoreSync</span>
      <h1 class="auth-title">Create your account</h1>
      <p class="auth-subtitle">Request access and join the platform</p>
    </div>

    <!-- Tab switcher -->
    <div class="auth-tab-wrap">
      <a href="/login" class="auth-tab">Sign In</a>
      <a href="/register" class="auth-tab active" aria-current="page">Register</a>
    </div>

    {{#if error_msg}}
    <div class="alert-error mb-4 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}
    {{#if success_msg}}
    <div class="alert-success mb-4 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
      <span>{{success_msg}}</span>
    </div>
    {{/if}}

    <!-- Card -->
    <div class="auth-card">
      <form method="POST" action="/register" class="space-y-4">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <!-- Full Name -->
        <div>
          <label class="auth-label">Full Name</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <input type="text" name="name" placeholder="Juan dela Cruz" required class="auth-input"/>
          </div>
        </div>

        <!-- Email -->
        <div>
          <label class="auth-label">Email Address</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="auth-input"/>
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="auth-label">Password</label>
          <div class="input-icon-wrap" style="position:relative">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" name="password" id="passwordInput" placeholder="Min. 6 characters" required minlength="6" autocomplete="new-password" class="auth-input auth-input-pr"/>
            <button type="button" id="eyeBtn" onclick="togglePwd()"
              style="position:absolute;right:14px;top:50%;transform:translateY(-50%);color:#475569;background:none;border:none;cursor:pointer;padding:4px;display:flex;align-items:center;justify-content:center;border-radius:6px;transition:color 120ms ease;height:28px;width:28px">
              <svg id="eyeIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <!-- Role -->
        <div>
          <label class="auth-label">Select Your Role</label>
          <div class="role-grid">

            <!-- Judge -->
            <label class="role-card-label">
              <input type="radio" name="role" value="judge" class="sr-only" required/>
              <div class="role-card">
                <div class="role-icon" style="background:linear-gradient(135deg,#3730a3,#6366f1)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                </div>
                <div class="font-bold text-xs text-white mb-0.5">Judge</div>
                <div class="text-[10px]" style="color:#64748b">Score contestants</div>
              </div>
            </label>

            <!-- Tabulator -->
            <label class="role-card-label">
              <input type="radio" name="role" value="tabulator" class="sr-only"/>
              <div class="role-card role-card-tabulator">
                <div class="role-icon" style="background:linear-gradient(135deg,#78350f,#d97706)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <div class="font-bold text-xs text-white mb-0.5">Tabulator</div>
                <div class="text-[10px]" style="color:#64748b">Review scores</div>
              </div>
            </label>

            <!-- Organizer (full width) -->
            <label class="role-card-label role-grid-full">
              <input type="radio" name="role" value="organizer" class="sr-only"/>
              <div class="role-card role-card-organizer" style="text-align:left;display:flex;align-items:center;gap:14px;padding:12px 16px">
                <div class="role-icon flex-shrink-0" style="background:linear-gradient(135deg,#065f46,#10b981);margin:0">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <div class="flex-1">
                  <div class="font-bold text-xs text-white mb-0.5">Organizer</div>
                  <div class="text-[10px]" style="color:#64748b">Create &amp; manage events</div>
                </div>
                <span class="text-[9px] font-extrabold px-2 py-0.5 rounded-full flex-shrink-0" style="background:rgba(16,185,129,0.15);color:#34d399;border:1px solid rgba(16,185,129,0.25)">FULL ACCESS</span>
              </div>
            </label>

          </div>
        </div>

        <button type="submit" class="auth-btn">
          Request Account
          <svg style="display:inline;margin-left:8px;vertical-align:-2px" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>

        <p class="text-[10px] text-center" style="color:#475569">
          Your account will be reviewed before activation.
        </p>

      </form>
    </div>

    <!-- Footer -->
    <div class="auth-footer mt-5 text-center space-y-3 text-xs">
      <p>Already have an account? <a href="/login">Sign in</a></p>
      <a href="/" class="auth-home-link">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/></svg>
        Back to homepage
      </a>
    </div>

  </div>

<script>
const eyeOpen='<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePwd(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){i.type='text';b.innerHTML=eyeClose;}
  else{i.type='password';b.innerHTML=eyeOpen;}
}
// Role card visual state via JS (radio change)
document.querySelectorAll('input[name="role"]').forEach(radio=>{
  radio.addEventListener('change',()=>{
    document.querySelectorAll('.role-card,.role-card-organizer').forEach(c=>{
      c.style.borderColor=''; c.style.background=''; c.style.boxShadow='';
    });
    const card = radio.nextElementSibling;
    if(!card) return;
    const v = radio.value;
    const colors = { judge:['#6366f1','rgba(99,102,241,0.12)','0 0 0 1px rgba(99,102,241,0.3),0 4px 16px rgba(79,70,229,0.2)'], tabulator:['#f59e0b','rgba(245,158,11,0.1)','0 0 0 1px rgba(245,158,11,0.3),0 4px 14px rgba(245,158,11,0.15)'], organizer:['#10b981','rgba(16,185,129,0.1)','0 0 0 1px rgba(16,185,129,0.3),0 4px 14px rgba(16,185,129,0.15)'] };
    if(colors[v]){ card.style.borderColor=colors[v][0]; card.style.background=colors[v][1]; card.style.boxShadow=colors[v][2]; }
  });
});
</script>
</body>
</html>
