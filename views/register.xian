{{> head }}
<style>
  body.auth-page {
    min-height: 100vh; min-height: 100svh;
    display: flex; align-items: center; justify-content: center;
    padding: clamp(16px,3vh,40px) clamp(16px,4vw,24px);
    position: relative; isolation: isolate; overflow-x: hidden;
    background: #050913;
  }

  /* ── Background ── */
  .auth-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .auth-bg-orb {
    position: absolute; border-radius: 50%; filter: blur(100px);
    animation: orbFloat 10s ease-in-out infinite;
  }
  .auth-bg-orb-1 {
    width: 560px; height: 560px; top: -180px; left: -140px; opacity: 0.55;
    background: radial-gradient(circle, rgba(99,102,241,0.5), transparent 65%);
  }
  .auth-bg-orb-2 {
    width: 420px; height: 420px; bottom: -100px; right: -100px; opacity: 0.4;
    background: radial-gradient(circle, rgba(14,165,233,0.45), transparent 65%);
    animation-delay: -4s;
  }
  .auth-bg-orb-3 {
    width: 300px; height: 300px; top: 45%; left: 50%; opacity: 0.25;
    background: radial-gradient(circle, rgba(139,92,246,0.4), transparent 65%);
    animation-delay: -7s;
  }
  @keyframes orbFloat {
    0%,100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-30px) scale(1.05); }
  }
  .auth-bg-grid {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, transparent 60%);
  }

  /* ── Shell ── */
  .auth-shell {
    position: relative; z-index: 1;
    width: 100%; max-width: 420px;
    display: flex; flex-direction: column;
  }

  /* ── Logo ── */
  .auth-logomark {
    width: 68px; height: 68px; border-radius: 20px;
    overflow: hidden; flex-shrink: 0; margin-bottom: 14px;
    box-shadow: 0 0 0 1px rgba(255,255,255,0.12), 0 0 0 4px rgba(99,102,241,0.15), 0 12px 40px rgba(79,70,229,0.4);
  }
  .auth-logomark img { width: 100%; height: 100%; object-fit: cover; }

  /* ── Eyebrow ── */
  .auth-eyebrow {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 0.65rem; font-weight: 800;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: #a5b4fc; margin-bottom: 5px;
  }
  .auth-eyebrow::before {
    content: ""; width: 20px; height: 1.5px;
    background: linear-gradient(90deg, transparent, #818cf8);
  }
  .auth-eyebrow::after {
    content: ""; width: 20px; height: 1.5px;
    background: linear-gradient(90deg, #818cf8, transparent);
  }

  /* ── Title ── */
  .auth-title {
    font-size: 1.9rem; font-weight: 900;
    letter-spacing: -0.04em; line-height: 1.1;
    color: #ffffff; margin-bottom: 5px;
  }
  .auth-subtitle { font-size: 0.82rem; color: #64748b; }

  /* ── Tab switcher ── */
  .auth-tab-wrap {
    display: flex; gap: 3px; padding: 4px; border-radius: 14px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    margin-bottom: 16px;
  }
  .auth-tab {
    flex: 1; padding: 10px 12px; border-radius: 11px;
    font-size: 0.82rem; font-weight: 700;
    text-align: center; text-decoration: none; color: #475569;
    transition: all 160ms ease;
  }
  .auth-tab:not(.active):hover { background: rgba(255,255,255,0.05); color: #94a3b8; }
  .auth-tab.active {
    background: linear-gradient(135deg,#4338ca,#6366f1); color: #fff;
    box-shadow: 0 4px 16px rgba(79,70,229,0.45), inset 0 1px 0 rgba(255,255,255,0.2);
  }

  /* ── Card ── */
  .auth-card {
    background: rgba(11,17,35,0.95);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px; padding: 24px 22px;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04),
      0 24px 64px rgba(0,0,0,0.7),
      0 8px 24px rgba(0,0,0,0.4),
      inset 0 1px 0 rgba(255,255,255,0.08);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }

  /* ── Label ── */
  .auth-label {
    display: block; font-size: 0.67rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #94a3b8; margin-bottom: 5px;
  }

  /* ── Input ── */
  .input-icon-wrap { position: relative; }
  .input-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: #374151; pointer-events: none; z-index: 1;
    transition: color 160ms ease;
  }
  .input-icon-wrap:focus-within .input-icon { color: #6366f1; }

  .auth-input {
    width: 100%; height: 46px;
    padding: 0 14px 0 44px;
    background: rgba(255,255,255,0.04) !important;
    border: 1px solid rgba(255,255,255,0.1) !important;
    border-radius: 12px !important;
    font-size: 0.9rem; color: #f1f5f9 !important;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
    -webkit-text-fill-color: #f1f5f9;
  }
  .auth-input:focus {
    background: rgba(255,255,255,0.07) !important;
    border-color: rgba(99,102,241,0.7) !important;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.18), 0 2px 8px rgba(0,0,0,0.3) !important;
  }
  .auth-input::placeholder { color: #374151; }
  .auth-input:-webkit-autofill,
  .auth-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px #0a1122 inset !important;
    -webkit-text-fill-color: #f1f5f9 !important;
    transition: background-color 9999s ease-in-out 0s;
  }
  .auth-input-pr { padding-right: 48px; }

  /* ── Role cards ── */
  .role-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .role-grid-full { grid-column: 1 / -1; }
  .role-card-label { cursor: pointer; }
  .role-card {
    border-radius: 12px; padding: 12px 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    text-align: center;
    transition: all 160ms ease;
    user-select: none;
  }
  .role-card:hover {
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.16);
    transform: translateY(-1px);
  }
  input[type="radio"].sr-only:checked + .role-card {
    border-color: rgba(99,102,241,0.7) !important;
    background: rgba(99,102,241,0.1) !important;
    box-shadow: 0 0 0 1px rgba(99,102,241,0.3), 0 4px 14px rgba(79,70,229,0.2);
  }
  input[type="radio"].sr-only:checked + .role-card-tabulator {
    border-color: rgba(245,158,11,0.7) !important;
    background: rgba(245,158,11,0.08) !important;
    box-shadow: 0 0 0 1px rgba(245,158,11,0.3), 0 4px 14px rgba(245,158,11,0.15);
  }
  input[type="radio"].sr-only:checked + .role-card-organizer {
    border-color: rgba(16,185,129,0.7) !important;
    background: rgba(16,185,129,0.08) !important;
    box-shadow: 0 0 0 1px rgba(16,185,129,0.3), 0 4px 14px rgba(16,185,129,0.15);
  }
  .role-icon {
    width: 34px; height: 34px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 8px;
  }

  /* ── Button ── */
  .auth-btn {
    width: 100%; height: 48px;
    border-radius: 12px; font-size: 0.92rem; font-weight: 800;
    color: #fff; border: none; cursor: pointer;
    background: linear-gradient(135deg,#4338ca 0%,#6366f1 60%,#818cf8 100%);
    box-shadow: 0 8px 24px rgba(79,70,229,0.4), 0 2px 6px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
    transition: all 180ms ease; letter-spacing: 0.01em;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .auth-btn:hover {
    background: linear-gradient(135deg,#4f46e5 0%,#6d71f7 60%,#8b8eff 100%);
    box-shadow: 0 12px 32px rgba(79,70,229,0.55), inset 0 1px 0 rgba(255,255,255,0.25);
    transform: translateY(-1px);
  }
  .auth-btn:active { transform: translateY(0); }

  /* ── Footer ── */
  .auth-home-link {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    height: 40px; padding: 0 20px;
    border: 1px solid rgba(255,255,255,0.08); border-radius: 999px;
    background: rgba(255,255,255,0.03); color: #64748b;
    font-size: 0.8rem; font-weight: 600; text-decoration: none;
    transition: all 160ms ease;
  }
  .auth-home-link:hover {
    background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.15);
    color: #e2e8f0; transform: translateY(-1px);
  }
  .auth-footer { color: #374151; }
  .auth-footer a:not(.auth-home-link) { color: #818cf8 !important; font-weight: 700; transition: color 160ms ease; }
  .auth-footer a:not(.auth-home-link):hover { color: #a5b4fc !important; }

  /* ── Focus ── */
  .auth-tab:focus-visible, .auth-home-link:focus-visible { outline: 2px solid #6366f1; outline-offset: 3px; }
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border-width:0 }

  /* ── Mobile ── */
  @media (max-width: 480px) {
    body.auth-page { padding: 10px 12px 14px; align-items: flex-start; }
    .auth-shell { max-width: 100%; }
    /* Header */
    .auth-logomark { width: 44px; height: 44px; border-radius: 13px; margin-bottom: 8px;
      box-shadow: 0 0 0 1px rgba(255,255,255,0.1), 0 0 0 3px rgba(99,102,241,0.12), 0 6px 20px rgba(79,70,229,0.3); }
    .auth-eyebrow { font-size: 0.58rem; margin-bottom: 3px; gap: 5px; }
    .auth-eyebrow::before, .auth-eyebrow::after { width: 14px; }
    .auth-title { font-size: 1.3rem; margin-bottom: 2px; }
    .auth-subtitle { font-size: 0.74rem; }
    .flex.flex-col.items-center.text-center.mb-7 { margin-bottom: 10px !important; }
    /* Tabs */
    .auth-tab-wrap { margin-bottom: 10px; padding: 3px; border-radius: 11px; }
    .auth-tab { padding: 7px 10px; font-size: 0.76rem; border-radius: 9px; }
    /* Card */
    .auth-card { padding: 14px 13px; border-radius: 16px; }
    .auth-card .space-y-4 > * + * { margin-top: 9px !important; }
    /* Labels */
    .auth-label { font-size: 0.6rem; margin-bottom: 4px; letter-spacing: 0.08em; }
    /* Inputs */
    .auth-input { height: 40px !important; font-size: 15px !important;
      padding-left: 36px !important; border-radius: 10px !important; }
    .input-icon { left: 9px; }
    .input-icon svg { width: 13px; height: 13px; }
    /* Button */
    .auth-btn { height: 42px; font-size: 0.84rem; border-radius: 11px; gap: 6px; }
    .auth-btn svg { width: 13px; height: 13px; }
    /* Role cards */
    .role-grid { gap: 6px; }
    .role-card { padding: 9px 8px; border-radius: 10px; }
    .role-icon { width: 28px; height: 28px; border-radius: 8px; margin-bottom: 6px; }
    .role-icon svg { width: 12px !important; height: 12px !important; }
    .role-card .font-bold.text-xs { font-size: 0.68rem !important; }
    .role-card .text-\[10px\] { font-size: 0.6rem !important; }
    .role-grid-full .role-card { padding: 8px 10px; gap: 10px; }
    /* Approval note */
    .auth-card > form > p { font-size: 0.6rem !important; margin-top: 6px !important; }
    /* Footer */
    .auth-footer { margin-top: 10px !important; }
    .auth-footer .space-y-3 > * + * { margin-top: 6px !important; }
    .auth-home-link { height: 34px; font-size: 0.72rem; padding: 0 14px; }
    /* Orbs */
    .auth-bg-orb-1 { width: 220px; height: 220px; }
    .auth-bg-orb-2 { width: 170px; height: 170px; }
    .auth-bg-orb-3 { display: none; }
  }
</style>

<div class="auth-bg">
  <div class="auth-bg-grid"></div>
  <div class="auth-bg-orb auth-bg-orb-1"></div>
  <div class="auth-bg-orb auth-bg-orb-2"></div>
  <div class="auth-bg-orb auth-bg-orb-3"></div>
</div>

<body class="auth-page" style="overflow-x:hidden">
  <div class="auth-shell animate-fadeup">

    <!-- Logo + heading -->
    <div class="flex flex-col items-center text-center mb-7">
      <div class="auth-logomark">
        <img src="/scoresync-logo.png?v=8" alt="ScoreSync"/>
      </div>
      <span class="auth-eyebrow">ScoreSync</span>
      <h1 class="auth-title">Create your account</h1>
      <p class="auth-subtitle">Request access and join the platform</p>
    </div>

    <!-- Tab switcher -->
    <div class="auth-tab-wrap">
      <a href="/login" class="auth-tab">Sign In</a>
      <a href="/register" class="auth-tab active" aria-current="page">Register</a>
    </div>

    {{#if error_msg}}
    <div class="alert-error mb-3 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span>{{error_msg}}</span>
    </div>
    {{/if}}
    {{#if success_msg}}
    <div class="alert-success mb-3 text-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
      <span>{{success_msg}}</span>
    </div>
    {{/if}}

    <!-- Card -->
    <div class="auth-card">
      <form method="POST" action="/register" class="space-y-4">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <!-- Full Name -->
        <div>
          <label class="auth-label">Full Name</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <input type="text" name="name" placeholder="Juan dela Cruz" required class="auth-input"/>
          </div>
        </div>

        <!-- Email -->
        <div>
          <label class="auth-label">Email Address</label>
          <div class="input-icon-wrap">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <input type="email" name="email" placeholder="you@example.com" required autocomplete="email" class="auth-input"/>
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="auth-label">Password</label>
          <div class="input-icon-wrap" style="position:relative">
            <span class="input-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" name="password" id="passwordInput" placeholder="Min. 6 characters" required minlength="6" autocomplete="new-password" class="auth-input auth-input-pr"/>
            <button type="button" id="eyeBtn" onclick="togglePwd()"
              style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:#374151;background:none;border:none;cursor:pointer;padding:4px;display:flex;align-items:center;justify-content:center;border-radius:6px;transition:color 120ms ease;height:28px;width:28px">
              <svg id="eyeIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>

        <!-- Role -->
        <div>
          <label class="auth-label">Select Your Role</label>
          <div class="role-grid">

            <!-- Judge -->
            <label class="role-card-label">
              <input type="radio" name="role" value="judge" class="sr-only" required/>
              <div class="role-card">
                <div class="role-icon" style="background:linear-gradient(135deg,#3730a3,#6366f1)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                </div>
                <div class="font-bold text-xs text-white mb-0.5">Judge</div>
                <div class="text-[10px]" style="color:#475569">Score contestants</div>
              </div>
            </label>

            <!-- Tabulator -->
            <label class="role-card-label">
              <input type="radio" name="role" value="tabulator" class="sr-only"/>
              <div class="role-card role-card-tabulator">
                <div class="role-icon" style="background:linear-gradient(135deg,#78350f,#d97706)">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <div class="font-bold text-xs text-white mb-0.5">Tabulator</div>
                <div class="text-[10px]" style="color:#475569">Review scores</div>
              </div>
            </label>

            <!-- Organizer -->
            <label class="role-card-label role-grid-full">
              <input type="radio" name="role" value="organizer" class="sr-only"/>
              <div class="role-card role-card-organizer" style="text-align:left;display:flex;align-items:center;gap:12px;padding:10px 14px">
                <div class="role-icon flex-shrink-0" style="background:linear-gradient(135deg,#065f46,#10b981);margin:0">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <div class="flex-1">
                  <div class="font-bold text-xs text-white mb-0.5">Organizer</div>
                  <div class="text-[10px]" style="color:#475569">Create &amp; manage events</div>
                </div>
                <span class="text-[9px] font-extrabold px-2 py-0.5 rounded-full flex-shrink-0" style="background:rgba(16,185,129,0.12);color:#34d399;border:1px solid rgba(16,185,129,0.2)">FULL ACCESS</span>
              </div>
            </label>

          </div>
        </div>

        <button type="submit" class="auth-btn">
          Request Account
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>

        <p class="text-[10px] text-center" style="color:#374151">
          Your account will be reviewed by an admin before activation.
        </p>

      </form>
    </div>

    <!-- Footer -->
    <div class="auth-footer mt-4 text-center space-y-3 text-xs">
      <p>Already have an account? <a href="/login">Sign in</a></p>
      <a href="/" class="auth-home-link">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m3 10 9-7 9 7"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/></svg>
        Back to homepage
      </a>
    </div>

  </div>

<script>
const eyeOpen='<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
const eyeClose='<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
function togglePwd(){
  const i=document.getElementById('passwordInput'),b=document.getElementById('eyeBtn');
  if(i.type==='password'){i.type='text';b.innerHTML=eyeClose;}
  else{i.type='password';b.innerHTML=eyeOpen;}
}
// Role card JS highlight
document.querySelectorAll('input[name="role"]').forEach(radio=>{
  radio.addEventListener('change',()=>{
    document.querySelectorAll('.role-card').forEach(c=>{
      c.style.borderColor=''; c.style.background=''; c.style.boxShadow='';
    });
    const card=radio.nextElementSibling; if(!card) return;
    const colors={
      judge:  ['rgba(99,102,241,0.7)','rgba(99,102,241,0.1)','0 0 0 1px rgba(99,102,241,0.3),0 4px 14px rgba(79,70,229,0.2)'],
      tabulator: ['rgba(245,158,11,0.7)','rgba(245,158,11,0.08)','0 0 0 1px rgba(245,158,11,0.3),0 4px 14px rgba(245,158,11,0.15)'],
      organizer: ['rgba(16,185,129,0.7)','rgba(16,185,129,0.08)','0 0 0 1px rgba(16,185,129,0.3),0 4px 14px rgba(16,185,129,0.15)'],
    };
    if(colors[radio.value]){
      card.style.borderColor=colors[radio.value][0];
      card.style.background=colors[radio.value][1];
      card.style.boxShadow=colors[radio.value][2];
    }
  });
});
</script>
</body>
</html>
