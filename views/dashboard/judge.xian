{{> head }}
<body class="min-h-screen flex flex-col ss-page-bg">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- ── Hero Header ── -->
  <div class="relative rounded-2xl overflow-hidden animate-fadeup"
    style="background:linear-gradient(135deg,#1e1b4b 0%,#2e1065 40%,#1e3a8a 100%);border:1px solid rgba(139,92,246,0.25)">
    <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background:rgba(139,92,246,0.15)"></div>
    <div class="absolute -left-8 -bottom-8 w-48 h-48 rounded-full blur-3xl pointer-events-none" style="background:rgba(37,99,235,0.12)"></div>
    <div class="relative px-6 sm:px-8 py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-extrabold"
          style="background:rgba(139,92,246,0.2);color:#c4b5fd;border:1px solid rgba(139,92,246,0.35)">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          {{#if isTabulator}}Official Tabulator Panel{{else}}Official Judge Panel{{/if}}
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight">
          Welcome, <span style="background:linear-gradient(90deg,#a78bfa,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent">{{userName}}</span>
        </h1>
        <p class="text-sm font-medium" style="color:rgba(196,181,253,0.7)">
          {{#if isTabulator}}Review and correct scores for any event from this panel.{{else}}Score your assigned events below — work through one contestant at a time.{{/if}}
        </p>
      </div>
      <div class="flex items-center gap-3 flex-wrap flex-shrink-0">
        <div class="rounded-2xl px-5 py-4 text-center min-w-[90px]" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1)">
          <div class="text-2xl font-black text-white">{{recentEvents.length}}</div>
          <div class="text-[10px] font-bold uppercase tracking-wider mt-0.5" style="color:rgba(196,181,253,0.7)">Events</div>
        </div>
        <div class="rounded-2xl px-5 py-4 text-center min-w-[90px]" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.2)">
          <div class="text-2xl font-black" style="color:#6ee7b7">{{readyEventCount}}</div>
          <div class="text-[10px] font-bold uppercase tracking-wider mt-0.5" style="color:rgba(110,231,183,0.7)">Ready to score</div>
        </div>
      </div>
    </div>
  </div>

  {{#unless isTabulator}}
  <!-- ── How It Works — 3-step flow ── -->
  <div class="animate-fadeup-1">
    <div class="flex items-center gap-2 mb-3 px-1">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span class="text-xs font-bold uppercase tracking-widest" style="color:#a78bfa">How scoring works</span>
    </div>
    <div class="grid grid-cols-3 gap-3" id="step-flow">

      <div class="step-card rounded-2xl p-4 relative overflow-hidden" data-step="1"
        style="background:linear-gradient(145deg,rgba(79,70,229,0.12),rgba(99,102,241,0.06));border:1px solid rgba(99,102,241,0.2)">
        <div class="absolute top-3 right-3 text-[10px] font-black px-2 py-0.5 rounded-full" style="background:rgba(99,102,241,0.2);color:#818cf8">STEP 1</div>
        <div class="w-9 h-9 rounded-xl flex items-center justify-center mb-3 shadow" style="background:linear-gradient(135deg,#4f46e5,#6366f1)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div class="font-extrabold text-sm mb-1" style="color:#e2e8f0">Pick an Event</div>
        <p class="text-[11px] leading-relaxed" style="color:#64748b">Find an <span class="font-bold" style="color:#34d399">Ongoing</span> event assigned to you below.</p>
      </div>

      <!-- Arrow connector -->
      <div class="step-card rounded-2xl p-4 relative overflow-hidden" data-step="2"
        style="background:linear-gradient(145deg,rgba(16,185,129,0.1),rgba(5,150,105,0.05));border:1px solid rgba(16,185,129,0.18)">
        <div class="absolute top-3 right-3 text-[10px] font-black px-2 py-0.5 rounded-full" style="background:rgba(16,185,129,0.2);color:#34d399">STEP 2</div>
        <div class="w-9 h-9 rounded-xl flex items-center justify-center mb-3 shadow" style="background:linear-gradient(135deg,#065f46,#10b981)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <div class="font-extrabold text-sm mb-1" style="color:#e2e8f0">Score Contestants</div>
        <p class="text-[11px] leading-relaxed" style="color:#64748b">Enter scores for each contestant across all criteria — one at a time.</p>
      </div>

      <div class="step-card rounded-2xl p-4 relative overflow-hidden" data-step="3"
        style="background:linear-gradient(145deg,rgba(245,158,11,0.1),rgba(217,119,6,0.05));border:1px solid rgba(245,158,11,0.18)">
        <div class="absolute top-3 right-3 text-[10px] font-black px-2 py-0.5 rounded-full" style="background:rgba(245,158,11,0.2);color:#fbbf24">STEP 3</div>
        <div class="w-9 h-9 rounded-xl flex items-center justify-center mb-3 shadow" style="background:linear-gradient(135deg,#78350f,#d97706)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="font-extrabold text-sm mb-1" style="color:#e2e8f0">Submit &amp; Done</div>
        <p class="text-[11px] leading-relaxed" style="color:#64748b">Hit <span class="font-bold" style="color:#fbbf24">Submit Scores</span> when all contestants are scored. You're done.</p>
      </div>

    </div>
  </div>
  {{/unless}}

  <!-- ── Events List ── -->
  <div class="space-y-4 animate-fadeup-2">
    <div class="flex items-center justify-between px-1">
      <h2 class="font-extrabold text-base flex items-center gap-2" style="color:var(--text-primary)">
        {{#if isTabulator}}All Event Scores{{else}}Your Events{{/if}}
      </h2>
      <span id="judge-event-count" class="text-xs font-bold" style="color:var(--text-muted)" aria-live="polite">{{recentEvents.length}} event(s)</span>
    </div>

    {{#if recentEvents.length}}
    <div class="rounded-2xl p-3 sm:p-4 space-y-3" style="background:var(--bg-card);border:1px solid var(--border)">
      <div class="flex flex-col sm:flex-row gap-3">
        <label class="relative flex-1">
          <span class="sr-only">Search events</span>
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input id="judge-event-search" type="search" autocomplete="off" placeholder="Search by event, venue, or type"
            class="w-full rounded-xl pl-10 pr-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500"
            style="background:#0a0f1e;border:1px solid rgba(255,255,255,0.1);color:var(--text-primary)">
        </label>
        <div class="flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter events">
          <button type="button" data-event-filter="all" aria-pressed="true" class="judge-event-filter btn-sm btn-sm-indigo whitespace-nowrap">
            All <span data-filter-count="all">{{recentEvents.length}}</span>
          </button>
          <button type="button" data-event-filter="ready" aria-pressed="false" class="judge-event-filter btn-sm btn-sm-gray whitespace-nowrap">
            Ready <span data-filter-count="ready">{{readyEventCount}}</span>
          </button>
          <button type="button" data-event-filter="ongoing" aria-pressed="false" class="judge-event-filter btn-sm btn-sm-gray whitespace-nowrap">
            Ongoing <span data-filter-count="ongoing">{{ongoingCount}}</span>
          </button>
          <button type="button" data-event-filter="completed" aria-pressed="false" class="judge-event-filter btn-sm btn-sm-gray whitespace-nowrap">
            Completed <span data-filter-count="completed">{{completedEventCount}}</span>
          </button>
        </div>
      </div>
    </div>

    <div id="judge-event-list" class="space-y-3">
      {{#each recentEvents}}

      <div class="rounded-2xl overflow-hidden transition-all duration-200
        {{#if (eq status 'ongoing')}}hover:-translate-y-0.5 hover:shadow-xl{{/if}}"
        data-judge-event
        data-status="{{status}}"
        data-assigned="{{isAssigned}}"
        data-sort="{{#if (eq status 'ongoing')}}0{{else}}{{#if (eq status 'completed')}}2{{else}}1{{/if}}{{/if}}"
        style="background:var(--bg-card);border:1px solid {{#if (eq status 'ongoing')}}rgba(16,185,129,0.3){{else}}{{#if (eq status 'completed')}}rgba(59,130,246,0.18){{else}}rgba(255,255,255,0.07){{/if}}{{/if}};box-shadow:{{#if (eq status 'ongoing')}}0 4px 24px rgba(16,185,129,0.1){{else}}none{{/if}}">

        {{!-- Ongoing label stripe at top --}}
        {{#if (eq status 'ongoing')}}
        <div class="flex items-center gap-2 px-5 pt-3 pb-0">
          <span class="w-2 h-2 rounded-full bg-emerald-400 flex-shrink-0" style="animation:ping 1.5s cubic-bezier(0,0,.2,1) infinite"></span>
          <span class="text-[10px] font-extrabold uppercase tracking-widest" style="color:#34d399">Live — Scoring Open</span>
        </div>
        {{/if}}

        <div class="px-5 sm:px-6 py-4 flex flex-col sm:flex-row sm:items-center gap-4">

          <!-- Icon + info -->
          <div class="flex items-center gap-4 flex-1 min-w-0">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg"
              style="background:{{themeGradient theme}}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                <h3 class="font-extrabold text-base truncate" style="color:var(--text-primary)">{{name}}</h3>
                <span class="badge {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}{{#if (eq status 'cancelled')}}badge-red{{else}}badge-yellow{{/if}}{{/if}}{{/if}} capitalize text-xs flex-shrink-0">
                  {{status}}
                </span>
              </div>

              <div class="flex flex-wrap items-center gap-2 text-xs" style="color:var(--text-muted)">
                {{#if venue}}<span class="flex items-center gap-1"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/></svg>{{venue}}</span>{{/if}}
                {{#if date}}<span class="flex items-center gap-1"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{{date}}{{#if time}} at {{time}}{{/if}}</span>{{/if}}
                <span class="capitalize px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:rgba(255,255,255,0.07);color:var(--text-secondary)">{{#if (eq type 'other')}}{{#if otherType}}{{otherType}}{{else}}Other{{/if}}{{else}}{{type}}{{/if}}</span>
              </div>

              <!-- Contestant / criteria counts -->
              {{#if contestantCount}}
              <div class="flex items-center gap-3 mt-1.5 flex-wrap">
                <span class="flex items-center gap-1 text-[11px] font-semibold" style="color:var(--text-secondary)">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                  {{contestantCount}} contestant{{#if (gt contestantCount 1)}}s{{/if}}
                </span>
                <span class="flex items-center gap-1 text-[11px] font-semibold" style="color:var(--text-secondary)">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                  {{criteriaCount}} criteri{{#if (gt criteriaCount 1)}}a{{else}}on{{/if}}
                </span>
                {{#if myScoreCount}}
                <span class="flex items-center gap-1 text-[11px] font-bold" style="color:#6ee7b7">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  {{myScoreCount}} scored
                </span>
                {{/if}}
              </div>
              {{/if}}

              <!-- Progress bar (ongoing only) -->
              {{#unless @root.isTabulator}}
              {{#if (eq status 'ongoing')}}
              {{#if contestantCount}}
              <div class="mt-3">
                <div class="flex justify-between text-[10px] mb-1.5" style="color:var(--text-muted)">
                  <span>Your progress</span>
                  <span class="font-extrabold" style="color:{{#if (gte completionPct 100)}}#34d399{{else}}var(--text-primary){{/if}}">
                    {{myScoreCount}}/{{contestantCount}} contestants &nbsp;·&nbsp; {{completionPct}}%
                  </span>
                </div>
                <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.07)">
                  <div class="h-full rounded-full transition-all duration-700"
                    style="width:{{completionPct}}%;background:{{#if (gte completionPct 100)}}linear-gradient(90deg,#059669,#34d399){{else}}linear-gradient(90deg,#6366f1,#8b5cf6){{/if}}"></div>
                </div>
              </div>
              {{/if}}
              {{/if}}
              {{/unless}}
            </div>
          </div>

          <!-- Action area -->
          <div class="flex flex-col items-end gap-1.5 self-end sm:self-center flex-shrink-0 min-w-[140px]">
            {{#if @root.isTabulator}}
              <a href="/events/{{id}}/results" class="btn-sm btn-sm-blue text-xs w-full text-center">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                View Results
              </a>
            {{else}}
              {{#if (eq status 'ongoing')}}
                {{#if isAssigned}}
                  <a href="/events/{{id}}/scoring" class="btn-solid-indigo btn-sm w-full text-center justify-center">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    {{#if (gte completionPct 100)}}Review Scores{{else}}{{#if myScoreCount}}Continue Scoring{{else}}Score Now{{/if}}{{/if}}
                  </a>
                  <!-- Context hint below button -->
                  <span class="text-[10px] font-semibold text-center w-full" style="color:{{#if (gte completionPct 100)}}#34d399{{else}}#94a3b8{{/if}}">
                    {{#if (gte completionPct 100)}}
                      ✓ All {{contestantCount}} scored
                    {{else}}
                      {{myScoreCount}} of {{contestantCount}} done
                    {{/if}}
                  </span>
                {{else}}
                  <div class="w-full">
                    <span class="inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-xl font-extrabold text-xs cursor-not-allowed"
                      style="background:rgba(239,68,68,0.08);color:#fca5a5;border:1px solid rgba(239,68,68,0.2)">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                      Not Assigned
                    </span>
                    <p class="text-[10px] text-center mt-1.5 leading-snug" style="color:#64748b">
                      Ask your administrator<br/>to assign you to this event.
                    </p>
                  </div>
                {{/if}}
              {{else}}
                {{#if (eq status 'completed')}}
                  <div class="flex flex-col gap-1.5 w-full">
                    {{#if hasScored}}
                    <a href="/events/{{id}}/scoring" class="btn-sm btn-sm-gray text-xs w-full text-center">Review My Scores</a>
                    {{/if}}
                    <a href="/events/{{id}}/results" class="btn-sm btn-sm-blue text-xs w-full text-center">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                      View Results
                    </a>
                  </div>
                {{else}}
                  <div class="w-full text-center">
                    <span class="btn-sm btn-sm-gray text-xs opacity-50 cursor-not-allowed w-full inline-flex justify-center">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                      Not Started
                    </span>
                    <p class="text-[10px] mt-1" style="color:#475569">Waiting for the event<br/>to go live.</p>
                  </div>
                {{/if}}
              {{/if}}
            {{/if}}
          </div>

        </div>

        <!-- Bottom accent for ongoing -->
        {{#if (eq status 'ongoing')}}
        <div class="h-0.5" style="background:linear-gradient(90deg,rgba(16,185,129,0),rgba(16,185,129,0.7),rgba(16,185,129,0))"></div>
        {{/if}}

      </div>
      {{/each}}

      <div id="judge-no-matches" class="hidden rounded-2xl py-10 text-center px-4"
        style="background:var(--bg-card);border:1px solid var(--border-subtle)" role="status">
        <h3 class="font-bold text-sm mb-1" style="color:var(--text-primary)">No matching events</h3>
        <p class="text-xs mb-4" style="color:var(--text-muted)">Try another search or show all events.</p>
        <button type="button" id="judge-clear-filters" class="btn-sm btn-sm-indigo">Show all events</button>
      </div>
    </div>

    {{else}}
    <div class="rounded-2xl py-20 text-center px-4"
      style="background:var(--bg-card);border:1px solid var(--border-subtle)">
      <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5"
        style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.2)">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <h3 class="font-bold text-base mb-2" style="color:var(--text-primary)">No Events Yet</h3>
      <p class="text-sm max-w-xs mx-auto leading-relaxed" style="color:var(--text-faint)">
        You haven't been assigned to any events. Contact your administrator to be added as a judge.
      </p>
    </div>
    {{/if}}
  </div>

  <!-- ── Quick Tips ── -->
  {{#if isTabulator}}
  <div class="grid sm:grid-cols-3 gap-3 animate-fadeup-2">
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(234,179,8,0.06);border:1px solid rgba(234,179,8,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(234,179,8,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fde047" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="m9 10 2 2 4-4"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#fde047">Review All Scores</div>
        <p class="text-[11px] leading-relaxed" style="color:var(--text-faint)">Click <strong style="color:#fde047">View Results</strong> to see every judge's individual scores per contestant.</p>
      </div>
    </div>
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(16,185,129,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#6ee7b7">Edit Any Score</div>
        <p class="text-[11px] leading-relaxed" style="color:var(--text-faint)">Correct any judge's score entry. All edits are logged in the audit trail.</p>
      </div>
    </div>
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(239,68,68,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fca5a5" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#fca5a5">Locked Events</div>
        <p class="text-[11px] leading-relaxed" style="color:var(--text-faint)">When scoring is locked by the admin, scores are read-only — no edits allowed.</p>
      </div>
    </div>
  </div>
  {{else}}
  <div class="grid sm:grid-cols-3 gap-3 animate-fadeup-2">
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(99,102,241,0.06);border:1px solid rgba(99,102,241,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(99,102,241,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#a5b4fc">Anonymous Scoring</div>
        <p class="text-[11px] leading-relaxed" style="color:var(--text-faint)">Your identity is hidden from participants. Results show Judge 1, 2, 3.</p>
      </div>
    </div>
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(16,185,129,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#6ee7b7">Draft Auto-Save</div>
        <p class="text-[11px] leading-relaxed" style="color:var(--text-faint)">Scores are saved locally as you type. No data loss on refresh.</p>
      </div>
    </div>
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(245,158,11,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fcd34d" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#fcd34d">Live Leaderboard</div>
        <p class="text-[11px] leading-relaxed" style="color:var(--text-faint)">Results update in real-time as all judges submit scores.</p>
      </div>
    </div>
  </div>
  {{/if}}

</main>
</div>
{{> footer }}

<script>
(() => {
  // ── Auto-sort: ongoing first, then pending, then completed ──
  const list = document.getElementById('judge-event-list');
  if (list) {
    const cards = Array.from(list.querySelectorAll('[data-judge-event]'));
    cards.sort((a, b) => Number(a.dataset.sort) - Number(b.dataset.sort));
    cards.forEach(c => list.appendChild(c));
  }

  // ── Filter + search ──
  const cards = Array.from(document.querySelectorAll('[data-judge-event]'));
  const search = document.getElementById('judge-event-search');
  const filters = Array.from(document.querySelectorAll('.judge-event-filter'));
  const count = document.getElementById('judge-event-count');
  const noMatches = document.getElementById('judge-no-matches');
  const clearFilters = document.getElementById('judge-clear-filters');
  let activeFilter = 'all';

  if (!cards.length || !search || !count || !noMatches) return;

  const getStatusCount = s => cards.filter(c => c.dataset.status === s).length;
  document.querySelector('[data-filter-count="ongoing"]').textContent = getStatusCount('ongoing');
  document.querySelector('[data-filter-count="completed"]').textContent = getStatusCount('completed');

  const updateEvents = () => {
    const term = search.value.trim().toLocaleLowerCase();
    let visible = 0;
    cards.forEach(card => {
      const status = card.dataset.status;
      const assigned = card.dataset.assigned === 'true';
      const matchesFilter =
        activeFilter === 'all' ||
        (activeFilter === 'ready' && status === 'ongoing' && assigned) ||
        status === activeFilter;
      const matchesSearch = card.textContent.toLocaleLowerCase().includes(term);
      const show = matchesFilter && matchesSearch;
      card.hidden = !show;
      if (show) visible++;
    });
    count.textContent = `${visible} of ${cards.length} event(s)`;
    noMatches.classList.toggle('hidden', visible !== 0);
  };

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.eventFilter;
      filters.forEach(f => {
        const sel = f === btn;
        f.setAttribute('aria-pressed', String(sel));
        f.classList.toggle('btn-sm-indigo', sel);
        f.classList.toggle('btn-sm-gray', !sel);
      });
      updateEvents();
    });
  });

  search.addEventListener('input', updateEvents);
  if (clearFilters) {
    clearFilters.addEventListener('click', () => {
      activeFilter = 'all';
      search.value = '';
      filters[0].click();
      search.focus();
    });
  }

  // ── Highlight active step based on state ──
  const hasOngoing = cards.some(c => c.dataset.status === 'ongoing' && c.dataset.assigned === 'true');
  const allDone = cards.every(c => {
    if (c.dataset.status !== 'ongoing') return true;
    const pct = parseInt(c.querySelector('[data-completion]')?.textContent || '0');
    return pct >= 100;
  });
  const stepCards = document.querySelectorAll('.step-card');
  if (stepCards.length === 3) {
    if (!hasOngoing) {
      stepCards[0].style.boxShadow = '0 0 0 2px rgba(99,102,241,0.5)';
    } else if (hasOngoing && !allDone) {
      stepCards[1].style.boxShadow = '0 0 0 2px rgba(16,185,129,0.5)';
    } else {
      stepCards[2].style.boxShadow = '0 0 0 2px rgba(245,158,11,0.5)';
    }
  }
})();
</script>
</body>
</html>
