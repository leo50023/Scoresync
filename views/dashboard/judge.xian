{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0a0f1e">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- ── Hero Header ── -->
  <div class="relative rounded-2xl overflow-hidden animate-fadeup"
    style="background:linear-gradient(135deg,#1e1b4b 0%,#2e1065 40%,#1e3a8a 100%);border:1px solid rgba(139,92,246,0.25)">
    <!-- Glow orbs -->
    <div class="absolute -right-16 -top-16 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background:rgba(139,92,246,0.15)"></div>
    <div class="absolute -left-8 -bottom-8 w-48 h-48 rounded-full blur-3xl pointer-events-none" style="background:rgba(37,99,235,0.12)"></div>

    <div class="relative px-6 sm:px-8 py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
      <div class="space-y-3">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-extrabold"
          style="background:rgba(139,92,246,0.2);color:#c4b5fd;border:1px solid rgba(139,92,246,0.35)">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          {{#if isTabulator}}Official Tabulator Panel{{else}}Official Judge Panel{{/if}}
        </div>
        <!-- Welcome -->
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight">
          Welcome back, <span style="background:linear-gradient(90deg,#a78bfa,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent">{{userName}}</span> 👋
        </h1>
        <p class="text-sm font-medium" style="color:rgba(196,181,253,0.7)">{{#if isTabulator}}Enter and review scores for any event from one account.{{else}}Select an active event to score contestants — one at a time, in order.{{/if}}</p>
      </div>

      <!-- Stats mini row -->
      <div class="flex items-center gap-3 flex-wrap flex-shrink-0">
        <div class="rounded-2xl px-5 py-4 text-center min-w-[90px]" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1)">
          <div class="text-2xl font-black text-white">{{recentEvents.length}}</div>
          <div class="text-[10px] font-bold uppercase tracking-wider mt-0.5" style="color:rgba(196,181,253,0.7)">Events</div>
        </div>
        <div class="rounded-2xl px-5 py-4 text-center min-w-[90px]" style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.2)">
          <div class="text-2xl font-black" style="color:#6ee7b7">
            {{readyEventCount}}
          </div>
          <div class="text-[10px] font-bold uppercase tracking-wider mt-0.5" style="color:rgba(110,231,183,0.7)">Ready to score</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Scoring Guideline Banner ── -->
  <div class="rounded-2xl p-4 sm:p-5 flex items-start gap-4 animate-fadeup-1"
    style="background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.2)">
    <div class="w-10 h-10 rounded-2xl flex items-center justify-center flex-shrink-0 text-white shadow"
      style="background:linear-gradient(135deg,#4f46e5,#7c3aed)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <div class="flex-1">
      <h3 class="font-extrabold text-sm" style="color:#a5b4fc">{{#if isTabulator}}Tabulator Guidelines{{else}}Scoring Guidelines{{/if}}</h3>
      <p class="text-xs font-medium mt-1 leading-relaxed" style="color:#6366f1">
        {{#if isTabulator}}
        Click <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold text-white" style="background:#6366f1">Review / Edit Scores</span> on any event to see all judges' scores.
        You can correct any score entry — all edits are logged in the audit trail.
        Locked events are <strong style="color:#a5b4fc">read-only</strong>.
        {{else}}
        Click <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold text-white" style="background:#6366f1">
          <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg> Score Now
        </span> on <strong style="color:#a5b4fc">Ongoing</strong> events only.
        Scores are saved per contestant — one at a time. All criteria weights must add up to <strong style="color:#a5b4fc">100%</strong>.
        Your scores are <strong style="color:#a5b4fc">anonymous</strong> to participants.
        {{/if}}
      </p>
    </div>
  </div>

  <!-- ── Events List ── -->
  <div class="space-y-4 animate-fadeup-2">
    <div class="flex items-center justify-between px-1">
      <h2 class="font-extrabold text-base" style="color:#e2e8f0">{{#if isTabulator}}All Event Scores{{else}}Events Available for Scoring{{/if}}</h2>
      <span id="judge-event-count" class="text-xs font-bold" style="color:#64748b" aria-live="polite">{{recentEvents.length}} event(s)</span>
    </div>

    {{#if recentEvents.length}}
    <div class="rounded-2xl p-3 sm:p-4 space-y-3" style="background:#111827;border:1px solid rgba(255,255,255,0.07)">
      <div class="flex flex-col sm:flex-row gap-3">
        <label class="relative flex-1">
          <span class="sr-only">Search events</span>
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input id="judge-event-search" type="search" autocomplete="off" placeholder="Search by event, venue, or type"
            class="w-full rounded-xl pl-10 pr-3 py-2.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500"
            style="background:#0a0f1e;border:1px solid rgba(255,255,255,0.1);color:#e2e8f0">
        </label>
        <div class="flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Filter events">
          <button type="button" data-event-filter="all" aria-pressed="true" class="judge-event-filter whitespace-nowrap rounded-xl px-3 py-2 text-xs font-bold transition"
            style="background:rgba(99,102,241,0.2);border:1px solid rgba(99,102,241,0.4);color:#c7d2fe">
            All <span data-filter-count="all">{{recentEvents.length}}</span>
          </button>
          <button type="button" data-event-filter="ready" aria-pressed="false" class="judge-event-filter whitespace-nowrap rounded-xl px-3 py-2 text-xs font-bold transition"
            style="background:transparent;border:1px solid rgba(255,255,255,0.1);color:#94a3b8">
            Ready to score <span data-filter-count="ready">{{readyEventCount}}</span>
          </button>
          <button type="button" data-event-filter="ongoing" aria-pressed="false" class="judge-event-filter whitespace-nowrap rounded-xl px-3 py-2 text-xs font-bold transition"
            style="background:transparent;border:1px solid rgba(255,255,255,0.1);color:#94a3b8">
            Ongoing <span data-filter-count="ongoing">{{ongoingCount}}</span>
          </button>
          <button type="button" data-event-filter="completed" aria-pressed="false" class="judge-event-filter whitespace-nowrap rounded-xl px-3 py-2 text-xs font-bold transition"
            style="background:transparent;border:1px solid rgba(255,255,255,0.1);color:#94a3b8">
            Completed <span data-filter-count="completed">{{completedEventCount}}</span>
          </button>
        </div>
      </div>
    </div>

    <div id="judge-event-list" class="space-y-3">
      {{#each recentEvents}}

      <div class="rounded-2xl overflow-hidden transition-all duration-300
        {{#if (eq status 'ongoing')}}hover:-translate-y-0.5 hover:shadow-xl{{/if}}"
        data-judge-event data-status="{{status}}" data-assigned="{{isAssigned}}"
        style="background:#111827;border:1px solid {{#if (eq status 'ongoing')}}rgba(16,185,129,0.3){{else}}{{#if (eq status 'completed')}}rgba(59,130,246,0.2){{else}}rgba(255,255,255,0.07){{/if}}{{/if}};box-shadow:{{#if (eq status 'ongoing')}}0 4px 24px rgba(16,185,129,0.1){{else}}none{{/if}}">

        <div class="px-5 sm:px-6 py-4 flex flex-col sm:flex-row sm:items-center gap-4">

          <!-- Event icon + info -->
          <div class="flex items-center gap-4 flex-1 min-w-0">
            <!-- Icon with theme gradient -->
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0 shadow-lg"
              style="background:{{themeGradient theme}}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-0.5">
                <h3 class="font-extrabold text-base truncate" style="color:#e2e8f0">{{name}}</h3>
                {{#if (eq status 'ongoing')}}
                <span class="flex-shrink-0 w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                {{/if}}
              </div>
              <div class="flex flex-wrap items-center gap-2 text-xs" style="color:#64748b">
                {{#if venue}}<span class="flex items-center gap-1"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/></svg>{{venue}}</span>{{/if}}
                {{#if date}}<span class="flex items-center gap-1"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{{date}}{{#if time}} at {{time}}{{/if}}</span>{{/if}}
                <span class="capitalize px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:rgba(255,255,255,0.07);color:#94a3b8">{{#if (eq type 'other')}}{{#if otherType}}{{otherType}}{{else}}Other{{/if}}{{else}}{{type}}{{/if}}</span>
              </div>

              <!-- Stats row -->
              {{#if contestantCount}}
              <div class="flex items-center gap-3 mt-2 flex-wrap">
                <span class="flex items-center gap-1.5 text-[11px] font-semibold" style="color:#94a3b8">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                  {{contestantCount}} contestant{{#if (gt contestantCount 1)}}s{{/if}}
                </span>
                <span class="flex items-center gap-1.5 text-[11px] font-semibold" style="color:#94a3b8">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                  {{criteriaCount}} criteri{{#if (gt criteriaCount 1)}}a{{else}}on{{/if}}
                </span>
                {{#if myScoreCount}}
                <span class="flex items-center gap-1.5 text-[11px] font-bold" style="color:#6ee7b7">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  {{myScoreCount}} scored
                </span>
                {{/if}}
              </div>
              {{/if}}

              <!-- Completion progress bar (for ongoing, judges only) -->
              {{#unless @root.isTabulator}}
              {{#if (eq status 'ongoing')}}
              {{#if contestantCount}}
              <div class="mt-2.5">
                <div class="flex justify-between text-[10px] mb-1" style="color:#64748b">
                  <span>My progress</span>
                  <span class="font-bold" style="color:#e2e8f0">{{completionPct}}%</span>
                </div>
                <div class="h-1.5 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.08)">
                  <div class="h-full rounded-full transition-all duration-700"
                    style="width:{{completionPct}}%;background:{{#if (gte completionPct 100)}}#10b981{{else}}linear-gradient(90deg,#6366f1,#8b5cf6){{/if}}"></div>
                </div>
              </div>
              {{/if}}
              {{/if}}
              {{/unless}}
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-2 self-end sm:self-center flex-shrink-0">
            <span class="badge {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}{{#if (eq status 'cancelled')}}badge-red{{else}}badge-yellow{{/if}}{{/if}}{{/if}} capitalize text-xs">
              {{status}}
            </span>
              {{#if @root.isTabulator}}
              <a href="/events/{{id}}/results" class="btn-sm btn-sm-blue text-xs">View Results</a>
              {{else}}{{#if (eq status 'ongoing')}}
            {{#if isAssigned}}
            <a href="/events/{{id}}/scoring"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-extrabold text-sm text-white transition active:scale-95 shadow-lg"
              style="background:linear-gradient(135deg,#4f46e5,#7c3aed);box-shadow:0 4px 16px rgba(99,102,241,0.4)">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              {{#if (gte completionPct 100)}}Review Scores{{else}}{{#if myScoreCount}}Continue Scoring{{else}}Score Now{{/if}}{{/if}}
            </a>
            {{else}}
            <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-extrabold text-xs cursor-not-allowed"
              style="background:rgba(239,68,68,0.1);color:#fca5a5;border:1px solid rgba(239,68,68,0.25)"
              title="You are not assigned to this event. Ask the organizer to assign you.">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
              Not Assigned
            </span>
            {{/if}}
            {{else}}{{#if (eq status 'completed')}}
            <div class="flex flex-wrap items-center justify-end gap-2">
              {{#if isAssigned}}
              <a href="/events/{{id}}/scoring" class="btn-sm btn-sm-gray text-xs">
                Review Scores
              </a>
              {{/if}}
              <a href="/events/{{id}}/results" class="btn-sm btn-sm-blue text-xs">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                View Results
              </a>
            </div>
            {{else}}
            <span class="btn-sm btn-sm-gray text-xs opacity-50 cursor-not-allowed">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              Not Started
            </span>
            {{/if}}{{/if}}{{/if}}
          </div>
        </div>

        <!-- Bottom accent bar for ongoing -->
        {{#if (eq status 'ongoing')}}
        <div class="h-0.5" style="background:linear-gradient(90deg,rgba(16,185,129,0),rgba(16,185,129,0.6),rgba(16,185,129,0))"></div>
        {{/if}}
      </div>

      {{/each}}
      <div id="judge-no-matches" class="hidden rounded-2xl py-10 text-center px-4"
        style="background:#111827;border:1px solid rgba(255,255,255,0.06)" role="status">
        <h3 class="font-bold text-sm mb-1" style="color:#e2e8f0">No matching events</h3>
        <p class="text-xs mb-4" style="color:#64748b">Try another search or show all events.</p>
        <button type="button" id="judge-clear-filters" class="rounded-xl px-4 py-2 text-xs font-bold"
          style="background:rgba(99,102,241,0.2);color:#c7d2fe">Show all events</button>
      </div>
    </div>

    {{else}}
    <!-- Empty state -->
    <div class="rounded-2xl py-20 text-center px-4"
      style="background:#111827;border:1px solid rgba(255,255,255,0.06)">
      <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5"
        style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.2)">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <h3 class="font-bold text-base mb-2" style="color:#e2e8f0">No Scoring Events Available</h3>
      <p class="text-sm max-w-xs mx-auto leading-relaxed" style="color:#475569">
        No events are currently assigned for scoring. Contact the administrator to set up an event and assign you as judge.
      </p>
    </div>
    {{/if}}
  </div>

  <!-- ── Quick Tips ── -->
  {{#if isTabulator}}
  <div class="grid sm:grid-cols-3 gap-3 animate-fadeup-2">
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(234,179,8,0.06);border:1px solid rgba(234,179,8,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(234,179,8,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fde047" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="m9 10 2 2 4-4"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#fde047">Review All Scores</div>
        <p class="text-[11px] leading-relaxed" style="color:#475569">Click <strong style="color:#fde047">Review / Edit Scores</strong> to see every judge's individual scores per contestant.</p>
      </div>
    </div>
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(16,185,129,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#6ee7b7">Edit Any Score</div>
        <p class="text-[11px] leading-relaxed" style="color:#475569">Correct any judge's score entry. All edits are logged in the audit trail.</p>
      </div>
    </div>
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(239,68,68,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fca5a5" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#fca5a5">Locked Events</div>
        <p class="text-[11px] leading-relaxed" style="color:#475569">When scoring is locked by the admin, scores are read-only — no edits allowed.</p>
      </div>
    </div>
  </div>
  {{else}}
  <div class="grid sm:grid-cols-3 gap-3 animate-fadeup-2">
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(99,102,241,0.06);border:1px solid rgba(99,102,241,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(99,102,241,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#a5b4fc">Anonymous Scoring</div>
        <p class="text-[11px] leading-relaxed" style="color:#475569">Your identity is hidden from participants. Results show Judge 1, 2, 3.</p>
      </div>
    </div>
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(16,185,129,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6ee7b7" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#6ee7b7">Draft Auto-Save</div>
        <p class="text-[11px] leading-relaxed" style="color:#475569">Scores are saved locally as you type. No data loss on refresh.</p>
      </div>
    </div>
    <div class="rounded-2xl p-4 flex items-start gap-3" style="background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.15)">
      <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5" style="background:rgba(245,158,11,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fcd34d" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </div>
      <div>
        <div class="text-xs font-bold mb-0.5" style="color:#fcd34d">Live Leaderboard</div>
        <p class="text-[11px] leading-relaxed" style="color:#475569">Results update in real-time as all judges submit scores.</p>
      </div>
    </div>
  </div>
  {{/if}}

</main>
</div>
{{> footer }}
<script>
  (() => {
    const cards = Array.from(document.querySelectorAll("[data-judge-event]"));
    const search = document.getElementById("judge-event-search");
    const filters = Array.from(document.querySelectorAll(".judge-event-filter"));
    const count = document.getElementById("judge-event-count");
    const noMatches = document.getElementById("judge-no-matches");
    const clearFilters = document.getElementById("judge-clear-filters");
    let activeFilter = "all";

    if (!cards.length || !search || !count || !noMatches) return;

    const getStatusCount = (status) => cards.filter((card) => card.dataset.status === status).length;
    document.querySelector('[data-filter-count="ongoing"]').textContent = getStatusCount("ongoing");
    document.querySelector('[data-filter-count="completed"]').textContent = getStatusCount("completed");

    const updateEvents = () => {
      const term = search.value.trim().toLocaleLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const status = card.dataset.status;
        const isAssigned = card.dataset.assigned === "true";
        const matchesFilter = activeFilter === "all"
          || (activeFilter === "ready" && status === "ongoing" && isAssigned)
          || status === activeFilter;
        const matchesSearch = card.textContent.toLocaleLowerCase().includes(term);
        const visible = matchesFilter && matchesSearch;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      count.textContent = `${visibleCount} of ${cards.length} event(s)`;
      noMatches.classList.toggle("hidden", visibleCount !== 0);
    };

    filters.forEach((button) => {
      button.addEventListener("click", () => {
        activeFilter = button.dataset.eventFilter;
        filters.forEach((filter) => {
          const selected = filter === button;
          filter.setAttribute("aria-pressed", String(selected));
          filter.style.background = selected ? "rgba(99,102,241,0.2)" : "transparent";
          filter.style.borderColor = selected ? "rgba(99,102,241,0.4)" : "rgba(255,255,255,0.1)";
          filter.style.color = selected ? "#c7d2fe" : "#94a3b8";
        });
        updateEvents();
      });
    });

    search.addEventListener("input", updateEvents);
    clearFilters.addEventListener("click", () => {
      activeFilter = "all";
      search.value = "";
      filters[0].click();
      search.focus();
    });
  })();
</script>
</body>
</html>
