{{> head }}
<body class="min-h-screen flex flex-col" class="ss-page-bg">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-5">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- ── Hero Header ── -->
  <div class="relative rounded-3xl overflow-hidden animate-fadeup"
    style="background:linear-gradient(135deg,#0d1117 0%,#111827 50%,#0d1117 100%);border:1px solid var(--border)">
    <!-- Ambient glow -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full blur-3xl" style="background:rgba(245,158,11,0.06)"></div>
      <div class="absolute -bottom-16 -left-16 w-56 h-56 rounded-full blur-3xl" style="background:rgba(16,185,129,0.04)"></div>
    </div>
    <div class="relative px-6 sm:px-8 py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
      <div class="space-y-1.5">
        <p class="text-[11px] font-extrabold uppercase tracking-[0.18em]" style="color:rgba(251,191,36,0.55)">Organizer Dashboard</p>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight leading-tight" style="color:#f8fafc">
          Welcome back, <span style="background:linear-gradient(90deg,#fbbf24,#fb923c);-webkit-background-clip:text;-webkit-text-fill-color:transparent">{{userName}}</span>
        </h1>
        <p class="text-sm" style="color:var(--text-faint)">Manage and oversee your live competition events.</p>
      </div>
      <div class="flex-shrink-0">
        <a href="/events/create"
          class="inline-flex items-center gap-2.5 px-5 py-3 rounded-2xl font-bold text-sm text-white transition-all active:scale-95"
          style="background:linear-gradient(135deg,#b45309,#d97706);box-shadow:0 4px 20px rgba(217,119,6,0.3),inset 0 1px 0 rgba(255,255,255,0.15)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New Event
        </a>
      </div>
    </div>
  </div>

  <!-- ── KPI Row ── -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 animate-fadeup-1">

    <!-- My Events -->
    <div class="rounded-2xl p-4 sm:p-5 group transition-all hover:-translate-y-0.5"
      style="background:var(--bg-card);border:1px solid var(--border)">
      <div class="flex items-center justify-between mb-4">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center"
          style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.18)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <a href="/events" class="opacity-0 group-hover:opacity-100 transition-opacity">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
      <div class="text-3xl font-black mb-1" style="color:var(--text-bright)">{{totalEvents}}</div>
      <div class="text-[11px] font-semibold" style="color:var(--text-faint)">My Events</div>
    </div>

    <!-- Live Now -->
    <div class="rounded-2xl p-4 sm:p-5 group transition-all hover:-translate-y-0.5"
      style="background:var(--bg-card);border:1px solid rgba(16,185,129,0.12)">
      <div class="flex items-center justify-between mb-4">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center"
          style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.22)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        </div>
        <span class="w-2 h-2 rounded-full" style="background:#10b981;box-shadow:0 0 8px #10b981"></span>
      </div>
      <div class="text-3xl font-black mb-1" style="color:var(--text-bright)">{{ongoingCount}}</div>
      <div class="text-[11px] font-semibold" style="color:var(--text-faint)">Live Now</div>
    </div>

    <!-- Judges -->
    <div class="rounded-2xl p-4 sm:p-5 group transition-all hover:-translate-y-0.5"
      style="background:var(--bg-card);border:1px solid var(--border)">
      <div class="flex items-center justify-between mb-4">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center"
          style="background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.18)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
      </div>
      <div class="text-3xl font-black mb-1" style="color:var(--text-bright)">{{judges.length}}</div>
      <div class="text-[11px] font-semibold" style="color:var(--text-faint)">Judges</div>
    </div>

    <!-- New Event CTA -->
    <div class="rounded-2xl p-4 sm:p-5 relative overflow-hidden transition-all hover:-translate-y-0.5"
      style="background:linear-gradient(135deg,#052e16,#064e3b);border:1px solid rgba(16,185,129,0.2)">
      <div class="absolute -right-6 -bottom-6 w-24 h-24 rounded-full" style="background:rgba(16,185,129,0.06)"></div>
      <div class="w-9 h-9 rounded-xl flex items-center justify-center mb-4"
        style="background:rgba(255,255,255,0.1)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </div>
      <div class="text-xs font-extrabold mb-1" style="color:#d1fae5">Create Event</div>
      <div class="text-[11px] mb-4" style="color:#6ee7b7;opacity:0.7">Pageant, sports, cultural</div>
      <a href="/events/create"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition"
        style="background:rgba(255,255,255,0.15);color:#fff">
        Start →
      </a>
    </div>

  </div>

  <!-- ── Live / Ongoing Events ── -->
  <div class="animate-fadeup-2 space-y-3">

    <div class="flex items-center justify-between px-0.5">
      <div class="flex items-center gap-3">
        <span class="flex h-2.5 w-2.5">
          <span class="animate-ping absolute h-2.5 w-2.5 rounded-full opacity-75" style="background:#10b981"></span>
          <span class="relative rounded-full h-2.5 w-2.5" style="background:#10b981"></span>
        </span>
        <h2 class="font-extrabold text-sm tracking-tight" style="color:var(--text-primary)">Live / Ongoing Events</h2>
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold"
          style="background:rgba(16,185,129,0.1);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2)">{{ongoingCount}} active</span>
      </div>
      <a href="/events" class="text-[11px] font-bold flex items-center gap-1" style="color:var(--text-muted)">
        All Events <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    {{#if ongoingEvents.length}}
    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3">
      {{#each ongoingEvents}}
      <div class="rounded-2xl overflow-hidden flex flex-col transition-all duration-200 hover:-translate-y-0.5"
        style="background:var(--bg-card);border:1px solid rgba(16,185,129,0.15);box-shadow:0 8px 32px rgba(0,0,0,0.35)">

        <!-- Card header with theme gradient -->
        <div class="px-5 py-4 relative overflow-hidden" style="background:{{themeGradient theme}};min-height:88px">
          {{#if coverPhoto}}
          <img src="{{coverPhoto}}" alt="{{name}}" class="absolute inset-0 w-full h-full object-cover" style="opacity:0.3"/>
          <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(0,0,0,0.1),rgba(0,0,0,0.6))"></div>
          {{/if}}
          <div class="absolute inset-0" style="background:linear-gradient(to bottom,transparent 50%,rgba(0,0,0,0.4))"></div>
          <div class="relative flex items-start justify-between gap-2">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 mb-1.5">
                <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background:#34d399;box-shadow:0 0 6px #10b981"></span>
                <span class="text-[9px] font-extrabold uppercase tracking-[0.18em]" style="color:rgba(110,231,183,0.9)">Ongoing</span>
              </div>
              <h3 class="font-extrabold text-white text-sm leading-tight truncate">{{name}}</h3>
              {{#if venue}}<p class="text-[11px] mt-0.5 truncate" style="color:rgba(255,255,255,0.5)">{{venue}}</p>{{/if}}
            </div>
            <span class="flex-shrink-0 px-2 py-0.5 rounded-md text-[9px] font-extrabold uppercase tracking-wide"
              style="background:rgba(0,0,0,0.35);color:rgba(255,255,255,0.7);backdrop-filter:blur(8px)">
              {{#if (eq type 'other')}}{{#if otherType}}{{otherType}}{{else}}Other{{/if}}{{else}}{{type}}{{/if}}
            </span>
          </div>
          {{#if date}}
          <div class="relative mt-2 text-[10px] flex items-center gap-1" style="color:rgba(255,255,255,0.4)">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {{date}}{{#if time}} · {{time}}{{/if}}
          </div>
          {{/if}}
        </div>

        <!-- Primary actions -->
        <div class="px-3 py-2.5 grid grid-cols-2 gap-1.5" style="border-bottom:1px solid var(--border-subtle)">
          <a href="/events/{{id}}"
            class="flex items-center justify-center gap-1.5 py-2 rounded-xl text-[11px] font-bold transition active:scale-95"
            style="background:rgba(16,185,129,0.1);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2)">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            View
          </a>
          <a href="/events/{{id}}/edit"
            class="flex items-center justify-center gap-1.5 py-2 rounded-xl text-[11px] font-bold transition active:scale-95"
            style="background:rgba(245,158,11,0.1);color:#fbbf24;border:1px solid rgba(245,158,11,0.2)">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit
          </a>
          <a href="/events/{{id}}/contestants/add"
            class="flex items-center justify-center gap-1.5 py-2 rounded-xl text-[11px] font-bold transition active:scale-95"
            style="background:rgba(99,102,241,0.1);color:#a5b4fc;border:1px solid rgba(99,102,241,0.2)">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            Add Contestant
          </a>
          <a href="/events/{{id}}/criteria"
            class="flex items-center justify-center gap-1.5 py-2 rounded-xl text-[11px] font-bold transition active:scale-95"
            style="background:rgba(139,92,246,0.1);color:#c4b5fd;border:1px solid rgba(139,92,246,0.2)">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            Criteria
          </a>
        </div>

        <!-- Results + End -->
        <div class="px-3 py-2.5 grid grid-cols-2 gap-1.5" style="border-bottom:1px solid var(--border-subtle)">
          <a href="/events/{{id}}/results"
            class="flex items-center justify-center gap-1.5 py-2 rounded-xl text-[11px] font-bold transition active:scale-95"
            style="background:rgba(16,185,129,0.07);color:#6ee7b7;border:1px solid rgba(16,185,129,0.12)">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Live Results
          </a>
          <form method="POST" action="/events/{{id}}/status" class="w-full"
            onsubmit="return confirm('End this event and mark as completed?')">
            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
            <input type="hidden" name="status" value="completed">
            <button type="submit"
              class="w-full flex items-center justify-center gap-1.5 py-2 rounded-xl text-[11px] font-bold transition active:scale-95"
              style="background:rgba(239,68,68,0.1);color:#fca5a5;border:1px solid rgba(239,68,68,0.2)">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              End Event
            </button>
          </form>
        </div>

        <!-- Judges + progress -->
        <div class="px-4 py-3 flex-1">
          {{#if ../judges.length}}
          <div class="text-[10px] font-extrabold uppercase tracking-wider mb-2" style="color:var(--text-faint)">Active Judges</div>
          <div class="flex flex-wrap gap-1 mb-3">
            {{#each ../judges}}
            <div class="flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-semibold"
              style="background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.12);color:#a5b4fc">
              <div class="w-4 h-4 rounded-full flex items-center justify-center text-[9px] font-extrabold text-white"
                style="background:linear-gradient(135deg,#1e3a8a,#4f46e5)">{{initial}}</div>
              {{alias}}
            </div>
            {{/each}}
          </div>
          <!-- Scoring progress bar -->
          <div id="judge-progress-{{id}}" data-event-id="{{id}}">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] font-bold" style="color:var(--text-faint)">Scoring Progress</span>
              <span class="text-[10px] font-bold judge-progress-pct" style="color:#6ee7b7">—</span>
            </div>
            <div class="h-1 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
              <div class="h-full rounded-full transition-all duration-700 judge-progress-bar" style="width:0%"></div>
            </div>
          </div>
          {{else}}
          <p class="text-[11px]" style="color:var(--text-faint)">No judges assigned yet.</p>
          {{/if}}
        </div>

      </div>
      {{/each}}
    </div>

    {{else}}
    <div class="rounded-2xl py-16 text-center px-4 flex flex-col items-center justify-center"
      style="background:var(--bg-card);border:1px solid var(--border-subtle)">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4"
        style="background:rgba(16,185,129,0.07);border:1px solid rgba(16,185,129,0.12)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
      </div>
      <h3 class="font-bold text-sm mb-1" style="color:var(--text-primary)">No live events</h3>
      <p class="text-xs mb-5 max-w-xs mx-auto" style="color:var(--text-faint)">Start an upcoming event or create a new one.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/events" class="btn-sm btn-sm-green text-xs">All Events</a>
        <a href="/events/create" class="btn-primary text-sm">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Create Event
        </a>
      </div>
    </div>
    {{/if}}
  </div>

  <!-- ── Quick Actions + Judges ── -->
  <div class="grid lg:grid-cols-3 gap-4 animate-fadeup-2">

    <!-- Quick Actions -->
    <div class="lg:col-span-2 rounded-2xl overflow-hidden" style="background:var(--bg-card);border:1px solid var(--border)">
      <div class="px-5 py-3.5 flex items-center gap-2.5" style="border-bottom:1px solid var(--border-subtle)">
        <div class="w-6 h-6 rounded-lg flex items-center justify-center"
          style="background:rgba(245,158,11,0.15)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="#fbbf24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <h2 class="text-sm font-extrabold tracking-tight" style="color:var(--text-primary)">Quick Actions</h2>
      </div>
      <div class="p-2 grid grid-cols-1 sm:grid-cols-2 gap-0.5">

        <a href="/events/create" class="flex items-center gap-3 px-3 py-3 rounded-xl transition group"
          style="border:1px solid transparent"
          onmouseover="this.style.background='rgba(245,158,11,0.06)';this.style.borderColor='rgba(245,158,11,0.12)'"
          onmouseout="this.style.background='';this.style.borderColor='transparent'">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 text-white"
            style="background:linear-gradient(135deg,#92400e,#b45309)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold" style="color:var(--text-primary)">Create Event</div>
            <div class="text-[11px]" style="color:var(--text-faint)">Set up a new competition</div>
          </div>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5" class="opacity-0 group-hover:opacity-100 transition-opacity"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/events" class="flex items-center gap-3 px-3 py-3 rounded-xl transition group"
          style="border:1px solid transparent"
          onmouseover="this.style.background='rgba(99,102,241,0.06)';this.style.borderColor='rgba(99,102,241,0.12)'"
          onmouseout="this.style.background='';this.style.borderColor='transparent'">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 text-white"
            style="background:linear-gradient(135deg,#1e3a8a,#3730a3)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold" style="color:var(--text-primary)">Manage All Events</div>
            <div class="text-[11px]" style="color:var(--text-faint)">View, edit &amp; delete events</div>
          </div>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5" class="opacity-0 group-hover:opacity-100 transition-opacity"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/inventory" class="flex items-center gap-3 px-3 py-3 rounded-xl transition group"
          style="border:1px solid transparent"
          onmouseover="this.style.background='rgba(16,185,129,0.06)';this.style.borderColor='rgba(16,185,129,0.12)'"
          onmouseout="this.style.background='';this.style.borderColor='transparent'">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 text-white"
            style="background:linear-gradient(135deg,#064e3b,#065f46)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold" style="color:var(--text-primary)">Ticket Sales &amp; Income</div>
            <div class="text-[11px]" style="color:var(--text-faint)">Track revenue per event</div>
          </div>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5" class="opacity-0 group-hover:opacity-100 transition-opacity"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

        <a href="/settings" class="flex items-center gap-3 px-3 py-3 rounded-xl transition group"
          style="border:1px solid transparent"
          onmouseover="this.style.background='rgba(139,92,246,0.06)';this.style.borderColor='rgba(139,92,246,0.12)'"
          onmouseout="this.style.background='';this.style.borderColor='transparent'">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 text-white"
            style="background:linear-gradient(135deg,#4c1d95,#6d28d9)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold" style="color:var(--text-primary)">Settings</div>
            <div class="text-[11px]" style="color:var(--text-faint)">Account &amp; preferences</div>
          </div>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5" class="opacity-0 group-hover:opacity-100 transition-opacity"><polyline points="9 18 15 12 9 6"/></svg>
        </a>

      </div>
    </div>

    <!-- Judges Panel -->
    <div class="rounded-2xl overflow-hidden flex flex-col" style="background:var(--bg-card);border:1px solid var(--border)">
      <div class="px-5 py-3.5 flex items-center justify-between" style="border-bottom:1px solid var(--border-subtle)">
        <div class="flex items-center gap-2.5">
          <div class="w-6 h-6 rounded-lg flex items-center justify-center"
            style="background:rgba(99,102,241,0.15)">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h2 class="text-sm font-extrabold tracking-tight" style="color:var(--text-primary)">All Judges</h2>
        </div>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold"
          style="background:rgba(99,102,241,0.1);color:#a5b4fc;border:1px solid rgba(99,102,241,0.18)">{{judges.length}}</span>
      </div>

      {{#if judges.length}}
      <div class="flex-1 divide-y" style="border-color:rgba(255,255,255,0.04)">
        {{#each judges}}
        <div class="flex items-center gap-3 px-4 py-2.5 transition"
          onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background=''">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-extrabold flex-shrink-0"
            style="background:linear-gradient(135deg,#1e3a8a,#4f46e5)">{{initial}}</div>
          <div class="flex-1 min-w-0">
            <div class="text-xs font-bold truncate" style="color:var(--text-primary)">{{alias}}</div>
            <div class="text-[10px]" style="color:var(--text-faint)">Active</div>
          </div>
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background:#10b981;box-shadow:0 0 4px #10b981"></span>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="flex-1 flex flex-col items-center justify-center py-10 px-4 text-center">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.5" class="mb-3"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <p class="text-xs" style="color:var(--text-faint)">No judges yet.</p>
      </div>
      {{/if}}

      <!-- Organizer info -->
      <div class="px-4 py-3" style="border-top:1px solid rgba(255,255,255,0.05)">
        <div class="flex items-center gap-3 p-3 rounded-xl" style="background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.12)">
          <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0"
            style="background:linear-gradient(135deg,#92400e,#b45309)">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <div class="min-w-0">
            <div class="text-xs font-extrabold truncate" style="color:#fbbf24">{{userName}}</div>
            <p class="text-[10px] leading-relaxed" style="color:var(--text-faint)">Organizer · Full event access</p>
          </div>
        </div>
      </div>
    </div>

  </div>

</main>
</div>
{{> footer }}
<script>
(function() {
  const cards = document.querySelectorAll('[data-event-id]');
  cards.forEach(function(card) {
    const eventId = card.getAttribute('data-event-id');
    if (!eventId) return;
    fetch('/events/' + eventId + '/scoring-progress', { cache: 'no-store' })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        const pctEl = card.querySelector('.judge-progress-pct');
        const barEl = card.querySelector('.judge-progress-bar');
        if (!Array.isArray(data) || data.length === 0) {
          if (pctEl) pctEl.textContent = 'No scores yet';
          return;
        }
        const avg = Math.round(data.reduce(function(s,j){return s+j.completionPct;},0)/data.length);
        if (pctEl) pctEl.textContent = avg + '%';
        if (barEl) {
          barEl.style.width = avg + '%';
          barEl.style.background = avg >= 100
            ? 'linear-gradient(90deg,#059669,#10b981)'
            : 'linear-gradient(90deg,#d97706,#fbbf24)';
        }
      })
      .catch(function(){});
  });
})();
</script>
</body>
</html>
