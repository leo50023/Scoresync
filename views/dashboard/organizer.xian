{{> head }}
<body class="min-h-screen flex flex-col ss-page-bg">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">
  <style>
    @media (max-width: 640px) {
      .organizer-kpi-grid { grid-template-columns: 1fr !important; }
    }

    /* KPI colored top border */
    .kpi-border-green  { border-top: 3px solid #10b981; }
    .kpi-border-emerald{ border-top: 3px solid #34d399; }
    .kpi-border-indigo { border-top: 3px solid #6366f1; }
    .kpi-border-amber  { border-top: 3px solid #f59e0b; }

    /* Quick action glow on hover */
    .qa-amber:hover  { box-shadow: 0 0 18px rgba(245,158,11,0.18); background: rgba(245,158,11,0.07) !important; border-color: rgba(245,158,11,0.22) !important; }
    .qa-indigo:hover { box-shadow: 0 0 18px rgba(99,102,241,0.18); background: rgba(99,102,241,0.07) !important; border-color: rgba(99,102,241,0.22) !important; }
    .qa-emerald:hover{ box-shadow: 0 0 18px rgba(16,185,129,0.18); background: rgba(16,185,129,0.07) !important; border-color: rgba(16,185,129,0.22) !important; }
    .qa-violet:hover { box-shadow: 0 0 18px rgba(139,92,246,0.18); background: rgba(139,92,246,0.07) !important; border-color: rgba(139,92,246,0.22) !important; }

    /* Glassmorphism event card */
    .event-glass {
      background: rgba(15,18,30,0.72) !important;
      backdrop-filter: blur(16px) saturate(160%);
      -webkit-backdrop-filter: blur(16px) saturate(160%);
      border: 1px solid rgba(99,102,241,0.14) !important;
      box-shadow: 0 8px 32px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.04) !important;
    }

    /* Section divider */
    .section-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(99,102,241,0.18), transparent);
      margin: 0.25rem 0;
    }
  </style>

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- -- Hero Header -- -->
  <div class="relative rounded-2xl overflow-hidden fm-fade-up"
    style="background:linear-gradient(135deg,#06040f 0%,#0d0a1f 40%,#0f0c1e 70%,#060412 100%);border:1px solid rgba(99,102,241,0.18);box-shadow:0 0 60px rgba(79,70,229,0.08)">
    <!-- Ambient purple/indigo glow blobs -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-28 -right-16 w-80 h-80 rounded-full blur-3xl" style="background:rgba(99,102,241,0.13)"></div>
      <div class="absolute top-0 left-1/3 w-64 h-64 rounded-full blur-3xl" style="background:rgba(139,92,246,0.07)"></div>
      <div class="absolute -bottom-16 -left-16 w-56 h-56 rounded-full blur-3xl" style="background:rgba(16,185,129,0.06)"></div>
      <!-- subtle grid overlay -->
      <div class="absolute inset-0 opacity-[0.03]"
        style="background-image:linear-gradient(rgba(255,255,255,0.4) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.4) 1px,transparent 1px);background-size:32px 32px"></div>
    </div>
    <div class="relative px-6 sm:px-10 py-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div class="space-y-2">
        <p class="text-[11px] font-extrabold uppercase tracking-[0.22em]"
          style="color:rgba(165,180,252,0.6)">Organizer Dashboard</p>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight" style="color:#f8fafc">
          Welcome back,&nbsp;<span style="background:linear-gradient(90deg,#a78bfa,#818cf8,#6366f1);-webkit-background-clip:text;-webkit-text-fill-color:transparent">{{userName}}</span>
        </h1>
        <p class="text-sm" style="color:rgba(165,180,252,0.5)">Manage and oversee your live competition events.</p>
      </div>
      <div class="flex-shrink-0">
        <a href="/events/create"
          class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full font-bold text-sm text-white transition-all active:scale-95"
          style="background:linear-gradient(135deg,#4f46e5,#7c3aed,#6d28d9);box-shadow:0 4px 24px rgba(99,102,241,0.45),inset 0 1px 0 rgba(255,255,255,0.18);letter-spacing:0.01em">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          New Event
        </a>
      </div>
    </div>
  </div>

  <!-- -- KPI Row -- -->
  <div class="organizer-kpi-grid grid grid-cols-2 lg:grid-cols-4 gap-3" data-stagger="fm-scale-in">

    <!-- My Events -->
    <div class="kpi-border-green rounded-2xl p-4 sm:p-5 group transition-all hover:-translate-y-1 hover:shadow-lg"
      style="background:var(--bg-card);border:1px solid var(--border);box-shadow:0 4px 16px rgba(0,0,0,0.3)">
      <div class="flex items-center justify-between mb-4">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center"
          style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.22)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <a href="/events" class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1 text-[10px] font-semibold" style="color:#34d399">
          View <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
      <div class="text-4xl font-black mb-1" style="color:var(--text-bright)">{{totalEvents}}</div>
      <div class="text-[11px] font-semibold flex items-center gap-1" style="color:var(--text-faint)">
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
        My Events
      </div>
    </div>

    <!-- Live Now -->
    <div class="kpi-border-emerald rounded-2xl p-4 sm:p-5 group transition-all hover:-translate-y-1 hover:shadow-lg"
      style="background:var(--bg-card);border:1px solid rgba(16,185,129,0.14);box-shadow:0 4px 16px rgba(0,0,0,0.3)">
      <div class="flex items-center justify-between mb-4">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center"
          style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.24)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        </div>
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style="background:#10b981"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background:#10b981;box-shadow:0 0 8px #10b981"></span>
        </span>
      </div>
      <div class="text-4xl font-black mb-1" style="color:var(--text-bright)">{{ongoingCount}}</div>
      <div class="text-[11px] font-semibold flex items-center gap-1" style="color:var(--text-faint)">
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        Live Now
      </div>
    </div>

    <!-- Judges -->
    <div class="kpi-border-indigo rounded-2xl p-4 sm:p-5 group transition-all hover:-translate-y-1 hover:shadow-lg"
      style="background:var(--bg-card);border:1px solid var(--border);box-shadow:0 4px 16px rgba(0,0,0,0.3)">
      <div class="flex items-center justify-between mb-4">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center"
          style="background:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.22)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2" class="opacity-50"><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="text-4xl font-black mb-1" style="color:var(--text-bright)">{{judges.length}}</div>
      <div class="text-[11px] font-semibold flex items-center gap-1" style="color:var(--text-faint)">
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        Judges
      </div>
    </div>

    <!-- New Event CTA -->
    <div class="kpi-border-amber rounded-2xl p-4 sm:p-5 relative overflow-hidden transition-all hover:-translate-y-1"
      style="background:linear-gradient(135deg,#0d0a1f,#1a1035);border:1px solid rgba(99,102,241,0.2);box-shadow:0 4px 16px rgba(0,0,0,0.3)">
      <div class="absolute -right-6 -bottom-6 w-28 h-28 rounded-full" style="background:rgba(99,102,241,0.08)"></div>
      <div class="absolute right-8 top-6 w-16 h-16 rounded-full blur-2xl" style="background:rgba(139,92,246,0.12)"></div>
      <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4"
        style="background:linear-gradient(135deg,#4f46e5,#7c3aed);box-shadow:0 2px 12px rgba(99,102,241,0.4)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </div>
      <div class="text-xs font-extrabold mb-1" style="color:#c7d2fe">Create Event</div>
      <div class="text-[11px] mb-4" style="color:rgba(165,180,252,0.55)">Pageant, sports, cultural</div>
      <a href="/events/create" class="btn-sm btn-sm-gray">
        Start &rarr;
      </a>
    </div>

  </div>

  <div class="section-divider"></div>

  <!-- -- Live / Ongoing Events -- -->
  <div class="fm-reveal space-y-4">

    <div class="flex items-center justify-between px-0.5">
      <div class="flex items-center gap-3">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style="background:#10b981"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background:#10b981"></span>
        </span>
        <h2 class="font-extrabold text-base tracking-tight" style="color:var(--text-primary)">Live / Ongoing Events</h2>
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold"
          style="background:rgba(16,185,129,0.1);color:#6ee7b7;border:1px solid rgba(16,185,129,0.22)">{{ongoingCount}} active</span>
      </div>
      <a href="/events" class="text-[11px] font-bold flex items-center gap-1 transition hover:opacity-80" style="color:var(--text-muted)">
        All Events <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    {{#if ongoingEvents.length}}
    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3">
      {{#each ongoingEvents}}
      <div class="event-glass rounded-2xl overflow-hidden flex flex-col transition-all duration-200 hover:-translate-y-1">

        <!-- Card header with theme gradient -->
        <div class="px-5 py-4 relative overflow-hidden" style="background:{{themeGradient theme}};min-height:96px">
          {{#if coverPhoto}}
          <img src="{{coverPhoto}}" alt="{{name}}" class="absolute inset-0 w-full h-full object-cover" style="opacity:0.28" loading="lazy"/>
          <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(0,0,0,0.1),rgba(0,0,0,0.65))"></div>
          {{/if}}
          <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(10,8,30,0.2) 0%,rgba(10,8,30,0.7) 100%)"></div>
          <!-- subtle shimmer line -->
          <div class="absolute top-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,rgba(165,180,252,0.3),transparent)"></div>
          <div class="relative flex items-start justify-between gap-2">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 mb-1.5">
                <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background:#34d399;box-shadow:0 0 6px #10b981"></span>
                <span class="text-[9px] font-extrabold uppercase tracking-[0.2em]" style="color:rgba(110,231,183,0.9)">Ongoing</span>
              </div>
              <h3 class="font-extrabold text-white text-sm leading-tight truncate">{{name}}</h3>
              {{#if venue}}<p class="text-[11px] mt-0.5 truncate" style="color:rgba(255,255,255,0.5)">{{venue}}</p>{{/if}}
            </div>
            <span class="flex-shrink-0 px-2 py-0.5 rounded-md text-[9px] font-extrabold uppercase tracking-wide"
              style="background:rgba(0,0,0,0.4);color:rgba(255,255,255,0.75);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.08)">
              {{#if (eq type 'other')}}{{#if otherType}}{{otherType}}{{else}}Other{{/if}}{{else}}{{type}}{{/if}}
            </span>
          </div>
          {{#if date}}
          <div class="relative mt-2 text-[10px] flex items-center gap-1" style="color:rgba(255,255,255,0.45)">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {{date}}{{#if time}} &mdash; {{time}}{{/if}}
          </div>
          {{/if}}
        </div>

        <!-- Consolidated action row -->
        <div class="px-3 py-2.5 grid grid-cols-3 gap-1.5" style="border-bottom:1px solid rgba(99,102,241,0.1)">
          <a href="/events/{{id}}"
            class="flex items-center justify-center gap-1.5 h-8 rounded-xl text-[11px] font-bold transition active:scale-95"
            style="background:rgba(16,185,129,0.1);color:#6ee7b7;border:1px solid rgba(16,185,129,0.2)">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            View
          </a>
          <a href="/events/{{id}}/edit"
            class="flex items-center justify-center gap-1.5 h-8 rounded-xl text-[11px] font-bold transition active:scale-95"
            style="background:rgba(245,158,11,0.1);color:#fbbf24;border:1px solid rgba(245,158,11,0.2)">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit
          </a>
          <form method="POST" action="/events/{{id}}/status" style="display:contents"
            onsubmit="return false" data-confirm-title="End Event" data-confirm-msg="End this event and mark as completed?" data-confirm-ok="End Event" data-confirm-type="warning">
            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
            <input type="hidden" name="status" value="completed">
            <button type="submit"
              class="flex items-center justify-center gap-1.5 h-8 rounded-xl text-[11px] font-bold transition active:scale-95"
              style="background:rgba(239,68,68,0.1);color:#fca5a5;border:1px solid rgba(239,68,68,0.2)">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              End
            </button>
          </form>
        </div>

        <!-- Secondary actions row -->
        {{#unless isEventSeries}}
        <div class="px-3 py-2.5 grid grid-cols-3 gap-1.5" style="border-bottom:1px solid rgba(99,102,241,0.1)">
          <a href="/events/{{id}}/contestants/add"
            class="flex items-center justify-center gap-1 h-8 rounded-xl text-[10px] font-bold transition active:scale-95"
            style="background:rgba(99,102,241,0.1);color:#a5b4fc;border:1px solid rgba(99,102,241,0.2)">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            Add
          </a>
          <a href="/events/{{id}}/categories"
            class="flex items-center justify-center gap-1 h-8 rounded-xl text-[10px] font-bold transition active:scale-95"
            style="background:rgba(59,130,246,0.1);color:#93c5fd;border:1px solid rgba(59,130,246,0.2)">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
            Categories
          </a>
          <a href="/events/{{id}}/results"
            class="flex items-center justify-center gap-1 h-8 rounded-xl text-[10px] font-bold transition active:scale-95"
            style="background:rgba(16,185,129,0.07);color:#6ee7b7;border:1px solid rgba(16,185,129,0.14)">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Results
          </a>
        </div>
        {{/unless}}

        <!-- Judges + scoring progress -->
        <div class="px-4 py-3 flex-1">
          {{#if ../judges.length}}
          <div class="text-[10px] font-extrabold uppercase tracking-wider mb-2" style="color:var(--text-faint)">Assigned Judges</div>
          <div class="flex flex-wrap gap-1 mb-3">
            {{#each ../judges}}
            {{#if (includes ../../assignedJudges id)}}
            <div class="flex items-center gap-1 px-2 py-1 rounded-lg text-[10px] font-semibold"
              style="background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.14);color:#a5b4fc">
              <div class="w-4 h-4 rounded-full flex items-center justify-center text-[9px] font-extrabold text-white"
                style="background:linear-gradient(135deg,#1e3a8a,#4f46e5)">{{initial}}</div>
              {{alias}}
            </div>
            {{/if}}
            {{/each}}
          </div>
          <!-- Scoring progress bar -->
          <div id="judge-progress-{{id}}" data-event-id="{{id}}">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[10px] font-bold" style="color:var(--text-faint)">Scoring Progress</span>
              <span class="text-[10px] font-bold judge-progress-pct" style="color:#6ee7b7">&mdash;</span>
            </div>
            <div class="h-1.5 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
              <div class="h-full rounded-full transition-all duration-700 judge-progress-bar" style="width:0%"></div>
            </div>
          </div>
          {{else}}
          <p class="text-[11px]" style="color:var(--text-faint)">No judges assigned yet.</p>
          {{/if}}
        </div>

      </div>
      {{/each}}
    </div>

    {{else}}
    <div class="rounded-2xl py-16 text-center px-4 flex flex-col items-center justify-center"
      style="background:var(--bg-card);border:1px solid var(--border-subtle)">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4"
        style="background:rgba(16,185,129,0.07);border:1px solid rgba(16,185,129,0.12)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
      </div>
      <h3 class="font-bold text-sm mb-1" style="color:var(--text-primary)">No live events</h3>
      <p class="text-xs mb-5 max-w-xs mx-auto" style="color:var(--text-faint)">Start an upcoming event or create a new one.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/events" class="btn-sm btn-sm-green text-xs">All Events</a>
        <a href="/events/create" class="btn-primary text-sm">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Create Event
        </a>
      </div>
    </div>
    {{/if}}
  </div>

  <div class="section-divider"></div>

  <!-- -- Quick Actions -- -->
  <div class="animate-fadeup-2">
    <div class="flex items-center gap-2.5 mb-4 px-0.5">
      <div class="w-7 h-7 rounded-lg flex items-center justify-center"
        style="background:rgba(245,158,11,0.15)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="#fbbf24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      </div>
      <h2 class="text-base font-extrabold tracking-tight" style="color:var(--text-primary)">Quick Actions</h2>
    </div>

    <div class="grid grid-cols-2 gap-3">

      <!-- Create Event -->
      <a href="/events/create"
        class="qa-amber flex flex-col items-center gap-3 p-5 rounded-2xl transition-all duration-200 group"
        style="background:var(--bg-card);border:1px solid rgba(245,158,11,0.1)">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 text-white transition-transform group-hover:scale-105"
          style="background:linear-gradient(135deg,#92400e,#b45309);box-shadow:0 4px 16px rgba(180,83,9,0.3)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <div class="text-center">
          <div class="text-sm font-bold" style="color:var(--text-primary)">Create Event</div>
          <div class="text-[11px] mt-0.5" style="color:var(--text-faint)">New competition</div>
        </div>
      </a>

      <!-- Manage Events -->
      <a href="/events"
        class="qa-indigo flex flex-col items-center gap-3 p-5 rounded-2xl transition-all duration-200 group"
        style="background:var(--bg-card);border:1px solid rgba(99,102,241,0.1)">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 text-white transition-transform group-hover:scale-105"
          style="background:linear-gradient(135deg,#1e3a8a,#3730a3);box-shadow:0 4px 16px rgba(55,48,163,0.3)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
        </div>
        <div class="text-center">
          <div class="text-sm font-bold" style="color:var(--text-primary)">All Events</div>
          <div class="text-[11px] mt-0.5" style="color:var(--text-faint)">View, edit &amp; delete</div>
        </div>
      </a>

      <!-- Ticket Sales -->
      <a href="/inventory"
        class="qa-emerald flex flex-col items-center gap-3 p-5 rounded-2xl transition-all duration-200 group"
        style="background:var(--bg-card);border:1px solid rgba(16,185,129,0.1)">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 text-white transition-transform group-hover:scale-105"
          style="background:linear-gradient(135deg,#064e3b,#065f46);box-shadow:0 4px 16px rgba(6,78,59,0.4)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v2z"/></svg>
        </div>
        <div class="text-center">
          <div class="text-sm font-bold" style="color:var(--text-primary)">Ticket Sales</div>
          <div class="text-[11px] mt-0.5" style="color:var(--text-faint)">Track revenue</div>
        </div>
      </a>

      <!-- Settings -->
      <a href="/settings"
        class="qa-violet flex flex-col items-center gap-3 p-5 rounded-2xl transition-all duration-200 group"
        style="background:var(--bg-card);border:1px solid rgba(139,92,246,0.1)">
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 text-white transition-transform group-hover:scale-105"
          style="background:linear-gradient(135deg,#4c1d95,#6d28d9);box-shadow:0 4px 16px rgba(109,40,217,0.3)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </div>
        <div class="text-center">
          <div class="text-sm font-bold" style="color:var(--text-primary)">Settings</div>
          <div class="text-[11px] mt-0.5" style="color:var(--text-faint)">Account &amp; preferences</div>
        </div>
      </a>

    </div>
  </div>

</main>
</div>

<script>
(function() {
  const cards = document.querySelectorAll('[data-event-id]');
  cards.forEach(function(card) {
    const eventId = card.getAttribute('data-event-id');
    if (!eventId) return;
    fetch('/events/' + eventId + '/scoring-progress', { cache: 'no-store' })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        const pctEl = card.querySelector('.judge-progress-pct');
        const barEl = card.querySelector('.judge-progress-bar');
        if (!Array.isArray(data) || data.length === 0) {
          if (pctEl) pctEl.textContent = 'No scores yet';
          return;
        }
        const avg = Math.round(data.reduce(function(s,j){return s+j.completionPct;},0)/data.length);
        if (pctEl) pctEl.textContent = avg + '%';
        if (barEl) {
          barEl.style.width = avg + '%';
          barEl.style.background = avg >= 100
            ? 'linear-gradient(90deg,#059669,#10b981)'
            : 'linear-gradient(90deg,#d97706,#fbbf24)';
        }
      })
      .catch(function(){});
  });
})();
</script>

<script>
/* -- 15s smart auto-refresh: reloads the dashboard only when the user is idle,
   so admin/organizer changes appear for judges & other roles automatically. -- */
(() => {
  const REFRESH_MS = 15000;
  let lastActivity = Date.now();          // last user-interaction timestamp
  let nextRefreshAt = Date.now() + REFRESH_MS;
  let refreshing = false;

  // Any real interaction resets the idle clock (capture so inner scroll fires too).
  const touch = () => { lastActivity = Date.now(); };
  ['mousemove', 'keydown', 'click', 'touchstart', 'wheel'].forEach(ev =>
    window.addEventListener(ev, touch, { passive: true, capture: true }));
  window.addEventListener('scroll', touch, { passive: true, capture: true });

  // -- Guards: never reload while the user is mid-interaction --
  const isInputFocused = () => {
    const ae = document.activeElement;
    if (!ae) return false;
    const t = ae.tagName;
    return t === 'INPUT' || t === 'TEXTAREA' || t === 'SELECT' || ae.isContentEditable;
  };
  const isModalOpen = () => {
    const nodes = document.querySelectorAll('.fixed.inset-0, [role="dialog"], .modal, #ss-confirm-overlay');
    for (const m of nodes) {
      if (m.id === 'ss-confirm-overlay') { if (m.classList.contains('active')) return true; continue; }
      if (m.classList.contains('hidden')) continue;
      const cs = getComputedStyle(m);
      if (cs.display === 'none' || cs.visibility === 'hidden') continue;
      return true;                       // a full-screen overlay is on screen
    }
    return false;
  };
  const scrollDepth = () => {
    let top = window.scrollY || document.documentElement.scrollTop || 0;
    document.querySelectorAll('main, [class*="overflow-y-auto"], [class*="overflow-auto"]')
      .forEach(el => { top = Math.max(top, el.scrollTop || 0); });
    return top;
  };
  const canRefresh = () => {
    if (refreshing) return false;
    if (document.hidden) return false;                 // tab in background
    if (Date.now() - lastActivity < REFRESH_MS) return false;  // active < 15s ago
    if (isInputFocused()) return false;                // typing / searching
    if (isModalOpen()) return false;                   // confirm dialog / modal open
    if (scrollDepth() > 300) return false;             // scrolled down reading
    return true;
  };

  // -- Unobtrusive "Live" indicator (bottom-right, dark theme) --

  // 1s ticker: countdown + idle/active state
  setInterval(() => {
    if (refreshing) return;
    const remain = Math.max(0, Math.ceil((nextRefreshAt - Date.now()) / 1000));
    const idle = Date.now() - lastActivity >= REFRESH_MS;
    if (idle) {                          // eligible to refresh ? steady green
      dot.style.opacity = '1';
    } else {                             // user active ? paused (dim grey)
      dot.style.background = '#64748b';
      dot.style.opacity = '.55';
    }
  }, 1000);

  // -- Main reload poll (every 15s) --
  const poll = () => {
    nextRefreshAt = Date.now() + REFRESH_MS;     // reset countdown either way
    if (!canRefresh()) return;                   // try again next tick
    refreshing = true;
    dot.style.background = '#fbbf24';
    label.textContent = 'Refreshing...';         // flash "Refreshing..." for 1s
    setTimeout(() => location.reload(), 1000);
  };
  setInterval(poll, REFRESH_MS);
})();
</script>
</body>
</html>
