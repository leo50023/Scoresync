{{> head }}
<body class="min-h-screen flex flex-col ss-page-bg">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}

<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">
  <style>
    .dashboard-event-actions { display:flex; flex-wrap:nowrap; align-items:center; justify-content:flex-end; gap:6px; white-space:nowrap; }
    .dashboard-event-action { display:inline-flex; width:44px; min-width:44px; height:44px; min-height:44px; align-items:center; justify-content:center; flex:0 0 44px; }
    .dashboard-event-action svg { width:14px; height:14px; }
    @media (max-width:640px) {
      .dashboard-events-scroll { overflow-x:hidden !important; }
      .dashboard-recent-events-table { display:block; width:100% !important; min-width:0 !important; table-layout:fixed; }
      .dashboard-recent-events-table thead,
      .dashboard-recent-events-table tbody { display:block; width:100%; }
      .dashboard-recent-events-table thead tr { display:block; }
      .dashboard-recent-events-table thead th:first-child { display:block; padding:10px 12px; }
      .dashboard-recent-events-table thead th:not(:first-child) { display:none; }
      .dashboard-recent-events-table tbody tr {
        display:grid;
        grid-template-columns:minmax(0,1fr) auto;
        grid-template-areas:"event event" "status actions";
        align-items:center;
        width:100%;
      }
      .dashboard-recent-events-table tbody td { min-width:0; }
      .dashboard-recent-events-table tbody td:first-child { grid-area:event; padding:12px; }
      .dashboard-recent-events-table tbody td:first-child > div { min-width:0; }
      .dashboard-recent-events-table tbody td:first-child > div > div:last-child { min-width:0; }
      .dashboard-recent-events-table tbody td:first-child a { display:block; overflow-wrap:anywhere; }
      .dashboard-recent-events-table tbody td:nth-child(3) { grid-area:status; padding:0 12px 10px; }
      .dashboard-recent-events-table tbody td:nth-child(4) { grid-area:actions; padding:0 8px 6px; }
      .dashboard-event-actions { gap:4px; }
    }
  </style>

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- -- Header -- -->
  <div class="animate-fadeup rounded-2xl p-5 sm:p-6 relative overflow-hidden"
    style="background:linear-gradient(135deg,#071a0e 0%,#0a2a14 50%,#0d1f2d 100%);border:1px solid rgba(16,185,129,0.18)">
    <!-- subtle glow blobs -->
    <div class="absolute top-0 right-0 w-48 h-48 rounded-full pointer-events-none" style="background:radial-gradient(circle,rgba(16,185,129,0.12) 0%,transparent 70%);transform:translate(30%,-30%)"></div>
    <div class="absolute bottom-0 left-0 w-32 h-32 rounded-full pointer-events-none" style="background:radial-gradient(circle,rgba(37,99,235,0.08) 0%,transparent 70%);transform:translate(-30%,30%)"></div>

    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400" style="box-shadow:0 0 6px #10b981"></span>
          <span class="text-xs font-bold uppercase tracking-widest" style="color:#34d399">System Online</span>
          <span class="text-xs font-medium" style="color:#1f4037">·</span>
          <span id="today-date" class="text-xs font-medium" style="color:var(--text-faint)"></span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight" style="color:var(--text-bright)">
          Welcome, <span style="color:#34d399">{{userName}}</span>
        </h1>
        <p class="text-sm mt-1" style="color:#4b7a5e">ScoreSync — Competition Management for Gloria, Oriental Mindoro</p>
      </div>
      <a href="/events/create"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm flex-shrink-0"
        style="background:linear-gradient(135deg,#059669,#10b981);color:#fff;box-shadow:0 4px 16px rgba(16,185,129,0.3);border:1px solid rgba(16,185,129,0.4)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Event
      </a>
    </div>
  </div>

  {{#if pendingCount}}
  <div class="animate-fadeup flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-2xl"
    style="background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.22)">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
        style="background:linear-gradient(135deg,#b45309,#d97706)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <p class="text-sm font-extrabold" style="color:#fcd34d">{{pendingCount}} Pending Account Request(s)</p>
        <p class="text-xs" style="color:#78350f">Awaiting your approval</p>
      </div>
    </div>
    <a href="/users" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs text-white flex-shrink-0"
      style="background:#d97706">
      Review Now
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
  {{/if}}

  <!-- -- KPI Cards -- -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 animate-fadeup-1">

    <!-- Total Events -->
    <div class="rounded-2xl p-4 sm:p-5 relative overflow-hidden"
      style="background:var(--bg-card);border:1px solid var(--border)">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center"
          style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.2)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
      </div>
      <p class="text-3xl font-black kpi-number" style="color:var(--text-bright);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{totalEvents}}</p>
      <p class="text-xs font-semibold mt-1" style="color:#374151;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Total Events</p>
      <a href="/events" class="text-xs font-bold mt-2 inline-flex items-center gap-1" style="color:#34d399">
        View all <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    <!-- Active Users -->
    <div class="rounded-2xl p-4 sm:p-5 relative overflow-hidden"
      style="background:var(--bg-card);border:1px solid var(--border)">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center"
          style="background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.2)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
      </div>
      <p class="text-3xl font-black kpi-number" style="color:var(--text-bright);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{totalUsers}}</p>
      <p class="text-xs font-semibold mt-1" style="color:#374151;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Active Users</p>
      <a href="/users" class="text-xs font-bold mt-2 inline-flex items-center gap-1" style="color:#60a5fa">
        Manage <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    <!-- Ongoing -->
    <div class="rounded-2xl p-4 sm:p-5 relative overflow-hidden"
      style="background:var(--bg-card);border:1px solid var(--border)">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center"
          style="background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.2)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        </div>
        <span class="w-2 h-2 rounded-full bg-emerald-400" style="box-shadow:0 0 6px #10b981"></span>
      </div>
      <p class="text-3xl font-black kpi-number" style="color:var(--text-bright);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ongoingCount}}</p>
      <p class="text-xs font-semibold mt-1" style="color:#374151;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Live Now</p>
      <a href="/events" class="text-xs font-bold mt-2 inline-flex items-center gap-1" style="color:#a78bfa">
        Open events <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    <!-- Quick Launch -->
    <div class="rounded-2xl p-4 sm:p-5 relative overflow-hidden"
      style="background:linear-gradient(135deg,#064e3b,#065f46);border:1px solid rgba(16,185,129,0.25)">
      <div class="flex items-center justify-between mb-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center"
          style="background:rgba(255,255,255,0.12)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
        </div>
      </div>
      <p class="text-sm font-extrabold leading-tight" style="color:#d1fae5">Create New Competition</p>
      <p class="text-xs mt-1 mb-3" style="color:#6ee7b7">Pageant, sports, cultural</p>
      <a href="/events/create" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold"
        style="background:rgba(255,255,255,0.18);color:#fff">
        Start
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

  </div>

  <!-- -- Main Grid -- -->
  <div class="grid lg:grid-cols-3 gap-5 animate-fadeup-2">

    <!-- Recent Events -->
    <div class="lg:col-span-2 rounded-2xl overflow-hidden"
      style="background:var(--bg-card);border:1px solid var(--border)">
      <div class="px-5 py-3.5 flex items-center justify-between"
        style="border-bottom:1px solid var(--border-subtle)">
        <h2 class="text-sm font-extrabold flex items-center gap-2" style="color:var(--text-primary)">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Recent Competitions
        </h2>
        <a href="/events" class="text-xs font-bold flex items-center gap-1" style="color:#34d399">
          View All <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>

      {{#if recentEvents.length}}
      <div class="dashboard-events-scroll overflow-x-auto">
        <table class="dashboard-recent-events-table w-full text-left" style="border-collapse:collapse">
          <thead>
            <tr style="background:rgba(255,255,255,0.02)">
              <th class="py-2.5 px-5 text-[10px] font-extrabold uppercase tracking-wider" style="color:var(--text-faint)">Event</th>
              <th class="py-2.5 px-3 text-[10px] font-extrabold uppercase tracking-wider hidden sm:table-cell" style="color:var(--text-faint)">Date</th>
              <th class="py-2.5 px-3 text-[10px] font-extrabold uppercase tracking-wider" style="color:var(--text-faint)">Status</th>
              <th class="py-2.5 px-5 text-[10px] font-extrabold uppercase tracking-wider text-right" style="color:var(--text-faint)">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentEvents}}
            <tr style="border-top:1px solid rgba(255,255,255,0.04)"
              onmouseover="this.style.background='rgba(16,185,129,0.04)'" onmouseout="this.style.background=''">
              <td class="py-3 px-5">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0"
                    style="position:relative;overflow:hidden;background:{{themeGradient theme}}">
                    {{#if coverPhoto}}
                    <img src="{{coverPhoto}}" alt="" aria-hidden="true" loading="lazy"
                      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"/>
                    <span aria-hidden="true" style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,0,0,0.08),rgba(0,0,0,0.45))"></span>
                    {{else}}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#bfdbfe" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="5" width="18" height="16" rx="2"/>
                      <path d="M16 3v4M8 3v4M3 11h18"/>
                    </svg>
                    {{/if}}
                  </div>
                  <div>
                    <a href="/events/{{id}}" class="text-sm font-bold" style="color:var(--text-primary)">{{name}}</a>
                    {{#if venue}}<div class="text-[11px]" style="color:var(--text-faint)">{{venue}}</div>{{/if}}
                  </div>
                </div>
              </td>
              <td class="py-3 px-3 text-xs hidden sm:table-cell" style="color:var(--text-faint)">{{date}}</td>
              <td class="py-3 px-3">
                <span class="badge {{#if (eq status 'ongoing')}}badge-green{{else}}{{#if (eq status 'completed')}}badge-blue{{else}}{{#if (eq status 'cancelled')}}badge-red{{else}}badge-yellow{{/if}}{{/if}}{{/if}} capitalize">{{status}}</span>
              </td>
              <td class="py-3 px-3 sm:px-5 text-right">
                <div class="dashboard-event-actions">
                  <a href="/events/{{id}}" class="dashboard-event-action rounded-lg" style="background:rgba(16,185,129,0.10);color:#34d399" title="View" aria-label="View event">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  </a>
                  <a href="/events/{{id}}/edit" class="dashboard-event-action rounded-lg hidden sm:inline-flex" style="background:rgba(255,255,255,0.06);color:var(--text-secondary)" title="Edit" aria-label="Edit event">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  </a>
                  <a href="/events/{{id}}/results" class="dashboard-event-action rounded-lg" style="background:rgba(59,130,246,0.10);color:#60a5fa" title="Results" aria-label="View event results">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                  </a>
                </div>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="py-14 text-center">
        <div class="w-12 h-12 rounded-2xl flex items-center justify-center mx-auto mb-3"
          style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <p class="text-sm font-bold mb-1" style="color:var(--text-primary)">No events yet</p>
        <p class="text-xs mb-4" style="color:var(--text-faint)">Create your first competition to get started.</p>
        <a href="/events/create" class="btn-primary text-xs">+ New Event</a>
      </div>
      {{/if}}
    </div>

    <!-- Right Column -->
    <div class="space-y-4">

      <!-- Quick Actions -->
      <div class="rounded-2xl overflow-hidden"
        style="background:var(--bg-card);border:1px solid var(--border)">
        <div class="px-5 py-3.5" style="border-bottom:1px solid var(--border-subtle)">
          <h2 class="text-sm font-extrabold" style="color:var(--text-primary)">Quick Actions</h2>
        </div>
        <div class="p-3 space-y-1">

          <a href="/events/create" class="flex items-center gap-3 p-3 rounded-xl transition"
            style="border:1px solid transparent"
            onmouseover="this.style.background='rgba(16,185,129,0.07)';this.style.borderColor='rgba(16,185,129,0.18)'"
            onmouseout="this.style.background='';this.style.borderColor='transparent'">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0"
              style="background:linear-gradient(135deg,#059669,#10b981)">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
            <div class="flex-1">
              <div class="text-xs font-bold" style="color:var(--text-primary)">Create Competition</div>
              <div class="text-[11px]" style="color:var(--text-faint)">New event &amp; venue</div>
            </div>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="/events" class="flex items-center gap-3 p-3 rounded-xl transition"
            style="border:1px solid transparent"
            onmouseover="this.style.background='rgba(59,130,246,0.07)';this.style.borderColor='rgba(59,130,246,0.18)'"
            onmouseout="this.style.background='';this.style.borderColor='transparent'">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0"
              style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
            </div>
            <div class="flex-1">
              <div class="text-xs font-bold" style="color:var(--text-primary)">All Events</div>
              <div class="text-[11px]" style="color:var(--text-faint)">Contestants &amp; judges</div>
            </div>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="/users" class="flex items-center gap-3 p-3 rounded-xl transition"
            style="border:1px solid transparent"
            onmouseover="this.style.background='rgba(245,158,11,0.07)';this.style.borderColor='rgba(245,158,11,0.18)'"
            onmouseout="this.style.background='';this.style.borderColor='transparent'">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0"
              style="background:linear-gradient(135deg,#b45309,#d97706)">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <div class="flex-1">
              <div class="text-xs font-bold" style="color:var(--text-primary)">User Management</div>
              <div class="text-[11px]" style="color:var(--text-faint)">Judges &amp; participants</div>
            </div>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="/analytics" class="flex items-center gap-3 p-3 rounded-xl transition"
            style="border:1px solid transparent"
            onmouseover="this.style.background='rgba(139,92,246,0.07)';this.style.borderColor='rgba(139,92,246,0.18)'"
            onmouseout="this.style.background='';this.style.borderColor='transparent'">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0"
              style="background:linear-gradient(135deg,#4c1d95,#7c3aed)">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <div class="flex-1">
              <div class="text-xs font-bold" style="color:var(--text-primary)">Analytics</div>
              <div class="text-[11px]" style="color:var(--text-faint)">Score insights</div>
            </div>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="/admin/backup"
            class="flex items-center gap-3 p-3 rounded-xl transition"
            style="border:1px solid transparent"
            onmouseover="this.style.background='rgba(20,184,166,0.07)';this.style.borderColor='rgba(20,184,166,0.18)'"
            onmouseout="this.style.background='';this.style.borderColor='transparent'">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0"
              style="background:linear-gradient(135deg,#134e4a,#14b8a6)">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
            </div>
            <div class="flex-1">
              <div class="text-xs font-bold" style="color:var(--text-primary)">Download Backup</div>
              <div class="text-[11px]" style="color:var(--text-faint)">Full JSON export</div>
            </div>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

        </div>
      </div>

      <!-- System Info -->
      <div class="rounded-2xl overflow-hidden"
        style="background:var(--bg-card);border:1px solid var(--border)">
        <div class="px-5 py-3.5" style="border-bottom:1px solid var(--border-subtle)">
          <h2 class="text-sm font-extrabold" style="color:var(--text-primary)">System Info</h2>
        </div>
        <div class="px-5 py-4 space-y-3 text-xs">
          <div class="flex items-center justify-between">
            <span style="color:var(--text-faint)">Role</span>
            <span class="badge badge-green uppercase text-[10px]">{{userRole}}</span>
          </div>
          <div class="flex items-center justify-between pt-2" style="border-top:1px solid rgba(255,255,255,0.05)">
            <span style="color:var(--text-faint)">Sync Status</span>
            <span class="inline-flex items-center gap-1.5 font-bold" style="color:#34d399">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400" style="box-shadow:0 0 5px #10b981"></span>
              Connected
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>

</main>
</div>
{{> footer }}
<script>
  const d=new Date();
  const days=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const months=['January','February','March','April','May','June','July','August','September','October','November','December'];
  const el=document.getElementById('today-date');
  if(el) el.textContent=days[d.getDay()]+', '+months[d.getMonth()]+' '+d.getDate()+', '+d.getFullYear();
</script>
</body>
</html>
