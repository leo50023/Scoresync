{{> head }}
<body class="min-h-screen flex flex-col" class="ss-page-bg">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">

  {{#if success_msg}}<div class="alert-success animate-fadeup">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup">{{error_msg}}</div>{{/if}}

  <!-- Header -->
  <div class="rounded-2xl p-5 sm:p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-5 relative overflow-hidden animate-fadeup"
    style="background:var(--bg-card);border:1px solid var(--border)">
    <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full blur-3xl pointer-events-none" style="background:rgba(5,150,105,0.07)"></div>
    <div class="relative z-10 space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold"
        style="background:rgba(16,185,129,0.15);color:#6ee7b7;border:1px solid rgba(16,185,129,0.25)">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        Data Participant Panel
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight" style="color:var(--text-bright)">
        Welcome, <span style="background:linear-gradient(90deg,#34d399,#14b8a6);-webkit-background-clip:text;-webkit-text-fill-color:transparent">{{userName}}</span> 👋
      </h1>
      <p class="text-sm font-medium" style="color:var(--text-faint)">Manage contestant rosters, numbers, photos, and team details for active events.</p>
    </div>
  </div>

  <!-- Instruction Banner -->
  <div class="p-4 sm:p-5 rounded-2xl flex items-start gap-4 animate-fadeup-1"
    style="background:rgba(16,185,129,0.07);border:1px solid rgba(16,185,129,0.2)">
    <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl flex items-center justify-center flex-shrink-0 text-white shadow-md"
      style="background:linear-gradient(135deg,#059669,#0d9488)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
    </div>
    <div>
      <h3 class="font-extrabold text-sm" style="color:#6ee7b7">Participant Responsibilities</h3>
      <p class="text-xs font-medium mt-1 leading-relaxed" style="color:#059669">
        Select an event below and click <span class="px-2 py-0.5 rounded font-bold text-[11px] text-white" style="background:#059669">Contestants</span> to input participant names, bio/details, and numbers before scoring starts.
      </p>
    </div>
  </div>

  <!-- Events List -->
  <div class="rounded-2xl overflow-hidden animate-fadeup-2"
    style="background:var(--bg-card);border:1px solid var(--border)">
    <div class="px-5 sm:px-6 py-4 flex items-center justify-between"
      style="border-bottom:1px solid var(--border);background:rgba(255,255,255,0.02)">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center"
          style="background:rgba(16,185,129,0.2);border:1px solid rgba(16,185,129,0.3)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        </div>
        <h2 class="text-sm sm:text-base font-extrabold tracking-tight" style="color:var(--text-primary)">Events — Contestant Management</h2>
      </div>
    </div>

    {{#if recentEvents.length}}
    <div>
      {{#each recentEvents}}
      <div class="p-4 sm:p-5 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition"
        style="border-top:1px solid rgba(255,255,255,0.05)"
        onmouseover="this.style.background='rgba(16,185,129,0.04)'" onmouseout="this.style.background=''">
        <div class="flex items-center gap-3 sm:gap-4">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl flex items-center justify-center flex-shrink-0 text-white shadow-sm"
            style="background:linear-gradient(135deg,#064e3b,#059669)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <h3 class="font-bold text-sm sm:text-base" style="color:var(--text-primary)">{{name}}</h3>
            <p class="text-xs mt-0.5 capitalize" style="color:var(--text-faint)">{{type}} &bull; {{date}}</p>
          </div>
        </div>
        <div class="flex items-center gap-2.5 self-end sm:self-center flex-shrink-0">
          <a href="/events/{{id}}" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs text-white transition"
            style="background:linear-gradient(135deg,#1d4ed8,#2563eb);box-shadow:0 4px 12px rgba(37,99,235,0.3)">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            Contestants
          </a>
          <a href="/events/{{id}}/results" class="btn-sm btn-sm-gray text-xs">Results</a>
        </div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="py-16 text-center px-4">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4"
        style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.15)">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#4b5563" stroke-width="1.8"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      </div>
      <h3 class="font-bold text-sm mb-1" style="color:var(--text-primary)">No Events Assigned</h3>
      <p class="text-xs max-w-xs mx-auto" style="color:var(--text-faint)">There are currently no active competition events for contestant encoding.</p>
    </div>
    {{/if}}
  </div>

</main>
</div>
{{> footer }}
</body>
</html>
