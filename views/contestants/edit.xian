{{> head }}
<body class="min-h-screen flex flex-col" style="background:#0a0f1e">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">
  {{#if error_msg}}<div class="alert-error mb-6 animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/></svg>{{error_msg}}</div>{{/if}}

  <div class="page-header animate-fadeup">
    <div class="breadcrumb"><a href="/events/{{event.id}}">Back to {{event.name}}</a></div>
    <h1>Edit Contestant</h1>
    <p>Update details for <span class="font-semibold text-blue-600">{{contestant.name}}</span>.</p>
  </div>

  <div class="grid lg:grid-cols-3 gap-5 animate-fadeup-1">

    <!-- LEFT: Photo -->
    <div class="lg:col-span-1">
      <div class="card-flat overflow-hidden sticky top-6">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-3">
          <div class="w-8 h-8 grad-rose rounded-lg flex items-center justify-center shadow-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
          <h2 class="font-bold text-slate-800">Contestant Photo</h2>
        </div>
        <div class="px-5 py-5 space-y-4">
          <div class="relative mx-auto" style="width:200px">
            <div id="photo-frame" class="relative rounded-2xl overflow-hidden border-4 shadow-xl" style="width:200px;height:260px;background:linear-gradient(160deg,#0f1e3d,#1a2f5a);border-color:rgba(255,255,255,0.12)">
              {{#if contestant.photo}}
              <img id="photo-preview" src="{{contestant.photo}}" alt="{{contestant.name}}" class="w-full h-full object-cover" style="object-position:center top"/>
              <div id="photo-placeholder" class="absolute inset-0 flex flex-col items-center justify-center gap-2" style="display:none">
              {{else}}
              <img id="photo-preview" src="" alt="Contestant photo" class="w-full h-full object-cover hidden" style="object-position:center top"/>
              <div id="photo-placeholder" class="absolute inset-0 flex flex-col items-center justify-center gap-2">
              {{/if}}
                <div class="w-16 h-16 rounded-full flex items-center justify-center shadow-inner" style="background:rgba(99,102,241,0.12)">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <span class="text-xs text-indigo-300 font-semibold">No photo</span>
              </div>
              <!-- Name overlay -->
              <div id="number-overlay" class="absolute bottom-0 left-0 right-0 px-3 py-2 {{#unless contestant.photo}}hidden{{/unless}}" style="background:linear-gradient(0deg,rgba(0,0,0,0.6),transparent)">
                <div class="text-white text-xs font-extrabold tracking-widest uppercase text-center" id="overlay-name">{{contestant.name}}</div>
                <div class="text-white/70 text-[10px] text-center" id="overlay-number">{{#if contestant.number}}No. {{contestant.number}}{{/if}}</div>
              </div>
            </div>
            <button type="button" onclick="document.getElementById('photo-file').click()"
              class="absolute -bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-bold text-white shadow-lg border-2 border-white transition hover:scale-105"
              style="background:linear-gradient(135deg,#7c3aed,#a78bfa)">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              {{#if contestant.photo}}Replace{{else}}Upload{{/if}} Photo
            </button>
          </div>

          <input type="file" id="photo-file" accept="image/png,image/jpeg,image/jpg,image/webp" class="hidden" onchange="handlePhotoUpload(this)"/>

          <div class="text-center mt-6 pt-2">
            <p class="text-[11px] text-slate-400 leading-relaxed">Portrait orientation recommended.<br/>PNG or JPG, max 3MB.</p>
          </div>

          <div id="remove-photo-wrap" class="{{#unless contestant.photo}}hidden{{/unless}}">
            <button type="button" onclick="clearPhoto()" class="btn-sm btn-sm-red text-xs w-full justify-center">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              Remove Photo
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Form -->
    <div class="lg:col-span-2">
      <div class="card-flat">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-3">
          <div class="w-9 h-9 grad-blue rounded-xl flex items-center justify-center shadow-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </div>
          <div>
            <h2 class="font-bold text-slate-800">Contestant #{{contestant.number}}</h2>
            <p class="text-slate-400 text-xs">{{contestant.name}}</p>
          </div>
        </div>
        <form method="POST" action="/events/{{event.id}}/contestants/{{contestant.id}}/update" class="px-6 py-5 space-y-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <input type="hidden" name="photo" id="photo-b64-form" value="{{contestant.photo}}"/>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Full Name <span class="text-red-500">*</span></label>
              <input type="text" name="name" id="field-name" value="{{contestant.name}}" required class="form-input-bare" oninput="updateOverlay()"/>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Contestant No.</label>
              <input type="text" name="number" id="field-number" value="{{contestant.number}}" class="form-input-bare" oninput="updateOverlay()"/>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Barangay</label>
              <input type="text" name="barangay" value="{{contestant.barangay}}" class="form-input-bare"/>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Age</label>
              <input type="number" name="age" value="{{contestant.age}}" min="1" max="100" class="form-input-bare"/>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Gender</label>
              <select name="gender" class="form-input-bare">
                <option value="">Select...</option>
                <option value="female" {{#if (eq contestant.gender 'female')}}selected{{/if}}>Female</option>
                <option value="male"   {{#if (eq contestant.gender 'male')}}selected{{/if}}>Male</option>
                <option value="other"  {{#if (eq contestant.gender 'other')}}selected{{/if}}>Other</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Platform / Advocacy</label>
              <input type="text" name="platform" value="{{contestant.platform}}" placeholder="e.g. Environmental Awareness" class="form-input-bare"/>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Bio / Notes</label>
            <textarea name="description" rows="3" class="form-input-bare resize-none">{{contestant.description}}</textarea>
          </div>

          <!-- Registration fee — read-only info on edit -->
          {{#if contestant.registrationFee}}
          <div class="rounded-xl px-4 py-3 flex items-center gap-3" style="background:rgba(16,185,129,0.07);border:1px solid rgba(16,185,129,0.18)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <div>
              <div class="text-xs font-extrabold uppercase tracking-widest" style="color:#10b981">Registration Fee Recorded</div>
              <div class="text-sm font-black mt-0.5" style="color:#e2e8f0">₱{{contestant.registrationFee}} <span class="text-xs font-normal" style="color:#4b5563">— logged in Ticket Sales &amp; Income</span></div>
            </div>
          </div>
          {{/if}}

          <div class="flex gap-3 pt-2">
            <button type="submit" class="btn-primary text-sm">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Save Changes
            </button>
            <a href="/events/{{event.id}}" class="btn-secondary text-sm">Cancel</a>
          </div>
        </form>
      </div>
    </div>

  </div>
</main>
</div>

<script>
function handlePhotoUpload(input) {
  const file = input.files[0];
  if (!file) return;
  if (file.size > 3 * 1024 * 1024) { alert('Image too large. Max 3MB.'); input.value=''; return; }
  const reader = new FileReader();
  reader.onload = function(e) {
    const b64 = e.target.result;
    document.getElementById('photo-b64-form').value = b64;
    const img = document.getElementById('photo-preview');
    img.src = b64; img.classList.remove('hidden');
    document.getElementById('photo-placeholder').style.display = 'none';
    document.getElementById('remove-photo-wrap').classList.remove('hidden');
    updateOverlay();
  };
  reader.readAsDataURL(file);
}
function clearPhoto() {
  document.getElementById('photo-b64-form').value = '';
  const img = document.getElementById('photo-preview');
  img.src = ''; img.classList.add('hidden');
  document.getElementById('photo-placeholder').style.display = '';
  document.getElementById('remove-photo-wrap').classList.add('hidden');
  document.getElementById('number-overlay').classList.add('hidden');
  document.getElementById('photo-file').value = '';
}
function updateOverlay() {
  const name   = document.getElementById('field-name')?.value || '';
  const number = document.getElementById('field-number')?.value || '';
  const overlay = document.getElementById('number-overlay');
  const img = document.getElementById('photo-preview');
  const hasPhoto = img.src && !img.classList.contains('hidden');
  if (hasPhoto && (name || number)) {
    document.getElementById('overlay-name').textContent   = name;
    document.getElementById('overlay-number').textContent = number ? 'No. ' + number : '';
    overlay.classList.remove('hidden');
  } else { overlay.classList.add('hidden'); }
}
</script>

{{> footer }}
</body>
</html>
