{{> head }}
<body class="min-h-screen flex flex-col ss-page-bg">
{{> navbar }}
<div class="flex flex-1 overflow-hidden">
{{> sidebar }}
<main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5">
  {{#if success_msg}}<div class="alert-success animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert-error animate-fadeup"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>{{error_msg}}</div>{{/if}}

  <div class="page-header animate-fadeup">
    <div class="breadcrumb"><a href="/events/{{event.id}}">Back to {{event.name}}</a></div>
    <h1>Scoring Criteria</h1>
    <p>Define judging categories and weights. All weights must total <span class="font-semibold text-purple-600">100%</span>.</p>
  </div>

  <div class="grid lg:grid-cols-5 gap-5 animate-fadeup-1">
    <div class="lg:col-span-3 section-card">
      <div class="section-header">
        <h2>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          Current Criteria
        </h2>
        <div class="flex items-center gap-1.5 text-sm font-bold {{#if (eq totalWeight 100)}}text-emerald-600{{else}}{{#if (gt totalWeight 100)}}text-red-600{{else}}text-amber-500{{/if}}{{/if}}">
          {{totalWeight}}% / 100%
          {{#if (eq totalWeight 100)}}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>{{/if}}
        </div>
      </div>
      <div class="px-6 py-3 border-b" style="background:rgba(255,255,255,0.03);border-color:rgba(255,255,255,0.07)">
        <div class="flex justify-between text-xs mb-1.5" style="color:var(--text-muted)"><span>Weight allocated</span><span class="font-semibold" style="color:var(--text-primary)">{{totalWeight}} / 100%</span></div>
        <div class="w-full rounded-full h-2 overflow-hidden" style="background:rgba(255,255,255,0.08)">
          <div class="h-2 rounded-full transition-all duration-500 {{#if (eq totalWeight 100)}}bg-emerald-500{{else}}{{#if (gt totalWeight 100)}}bg-red-500{{else}}bg-blue-500{{/if}}{{/if}}" style="width:{{totalWeight}}%"></div>
        </div>
      </div>
      {{#if criteria.length}}
      <div class="divide-y" style="border-color:rgba(255,255,255,0.05)">
        {{#each criteria}}
        <div class="px-6 py-4 flex items-center gap-4 transition group" style="border-top:1px solid rgba(255,255,255,0.05)"
          onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
          <div class="w-12 h-12 grad-purple rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm text-white font-extrabold text-sm">{{weight}}<span class="text-[10px] font-normal">%</span></div>
          <div class="flex-1 min-w-0">
            <div class="font-semibold text-sm" style="color:var(--text-primary)">{{name}}</div>
            {{#if description}}<div class="text-xs mt-0.5 truncate" style="color:var(--text-muted)">{{description}}</div>{{/if}}
            <div class="text-xs mt-1" style="color:var(--text-muted)">Max score: <span class="font-semibold" style="color:var(--text-secondary)">{{maxScore}} pts</span></div>
          </div>
          {{#if ../isAdmin}}
          <form method="POST" action="/events/{{../event.id}}/criteria/{{id}}/delete" onsubmit="return confirm('Remove this criteria?')">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button class="btn-sm btn-sm-red text-xs px-2.5 py-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></button>
          </form>
          {{/if}}
          {{#if ../isOrganizer}}
          <form method="POST" action="/events/{{../event.id}}/criteria/{{id}}/delete" onsubmit="return confirm('Remove this criteria?')">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button class="btn-sm btn-sm-red text-xs px-2.5 py-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></button>
          </form>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="py-12 text-center" style="color:var(--text-faint)">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#e2e8f0" stroke-width="1.5" class="mx-auto mb-3"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        <p class="font-medium text-sm">No criteria added yet.</p>
      </div>
      {{/if}}
    </div>

    {{#if isAdmin}}
    <div class="lg:col-span-2 section-card self-start sticky top-4">
      <div class="section-header">
        <h2>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Criteria
        </h2>
      </div>
      <form method="POST" action="/events/{{event.id}}/criteria" class="px-6 py-5 space-y-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div><label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Criteria Name <span class="text-red-500">*</span></label><input type="text" name="name" placeholder="e.g. Beauty of Face" required class="form-input-bare"/></div>
        <div><label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Description</label><input type="text" name="description" placeholder="Optional description" class="form-input-bare"/></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Weight % <span class="text-red-500">*</span></label><input type="number" name="weight" placeholder="30" min="1" max="100" required class="form-input-bare"/></div>
          <div><label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Max Score</label><input type="number" name="maxScore" placeholder="100" min="1" value="100" class="form-input-bare"/></div>
        </div>
        <div class="rounded-lg px-3 py-2 text-xs flex items-center gap-2" style="background:rgba(139,92,246,0.10);border:1px solid rgba(139,92,246,0.25);color:#c4b5fd">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Weight used so far: <strong>{{totalWeight}}%</strong>
        </div>
        <button type="submit" class="btn-sm btn-solid-indigo w-full justify-center">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" style="display:inline;margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Criteria
        </button>
      </form>
    </div>
    {{/if}}
    {{#if isOrganizer}}
    <div class="lg:col-span-2 section-card self-start sticky top-4">
      <div class="section-header">
        <h2>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Criteria
        </h2>
      </div>
      <form method="POST" action="/events/{{event.id}}/criteria" class="px-6 py-5 space-y-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div><label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Criteria Name <span class="text-red-500">*</span></label><input type="text" name="name" placeholder="e.g. Beauty of Face" required class="form-input-bare"/></div>
        <div><label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Description</label><input type="text" name="description" placeholder="Optional description" class="form-input-bare"/></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Weight % <span class="text-red-500">*</span></label><input type="number" name="weight" placeholder="30" min="1" max="100" required class="form-input-bare"/></div>
          <div><label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Max Score</label><input type="number" name="maxScore" placeholder="100" min="1" value="100" class="form-input-bare"/></div>
        </div>
        <div class="rounded-lg px-3 py-2 text-xs flex items-center gap-2" style="background:rgba(139,92,246,0.10);border:1px solid rgba(139,92,246,0.25);color:#c4b5fd">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Weight used so far: <strong>{{totalWeight}}%</strong>
        </div>
        <button type="submit" class="btn-sm btn-solid-indigo w-full justify-center">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" style="display:inline;margin-right:4px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Criteria
        </button>
      </form>
    </div>
    {{/if}}
  </div>
</main>
</div>
{{> footer }}
</body>
</html>
